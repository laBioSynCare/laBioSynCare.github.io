@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix voaf:  <http://purl.org/vocommons/voaf#> .
@prefix void:  <http://rdfs.org/ns/void#> .
@prefix vann:  <http://purl.org/vocab/vann/> .
@prefix cc:    <http://creativecommons.org/ns#> .
@prefix bibo:  <http://purl.org/ontology/bibo/> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix mod:   <https://w3id.org/mod#> .

@prefix bfo:   <http://purl.obolibrary.org/obo/BFO_> .


###########################################################################
# Ontology Metadata
###########################################################################

<https://w3id.org/sstim>
    a owl:Ontology, voaf:Vocabulary ;
    # No version IRI while under development: SSTIM is versioned as one
    # synchronized set, and release preparation adds the whole-set version IRI
    # https://w3id.org/sstim/<version> here — and only here. See ADR 0020.
    # /sstim is also the Full namespace catalogue, so profiles import the exact
    # Kernel retrieval endpoint https://w3id.org/sstim/kernel. That endpoint
    # need not be an ontology or version IRI of this module: an OWL 2 import
    # names an ontology *document* (Structural Specification 3.4,
    # directlyImportsDocuments), not an ontology IRI.
    owl:versionInfo "0.13.0-dev" ;
    owl:priorVersion <https://w3id.org/sstim/0.12.0> ;
    dct:title "Sensory Stimulation Ontology (SSTIM)"@en,
              "Ontologia della Stimolazione Sensoriale (SSTIM)"@it,
              "Ontologia de Estimulação Sensorial (SSTIM)"@pt,
              "Ontología de Estimulación Sensorial (SSTIM)"@es ;
    dct:description "An OWL 2 ontology for describing parameter-specified delivery of structured sensory input, including techniques, protocols, implementations, exposure conditions, observations, safety metadata, and evidence-qualified claims."@en ;
    dct:creator <https://orcid.org/0000-0002-9699-629X> ;
    dct:publisher <https://github.com/laBioSynCare> ;
    dct:created "2026-04-12"^^xsd:date ;
    dct:issued "2026-07-31"^^xsd:date ;
    dct:modified "2026-08-01"^^xsd:date ;
    dct:identifier "10.5281/zenodo.21286974" ;
    bibo:doi "10.5281/zenodo.21286974" ;
    # dct:hasVersion / dct:bibliographicCitation intentionally omitted on the
    # mutable 0.13.0-dev line. They are added with the version-specific DOI when
    # a release is frozen; the latest citable release remains 0.12.0.
    dct:source <https://github.com/laBioSynCare/laBioSynCare.github.io/blob/main/docs/concept/SENSORY_STIMULATION.md> ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    cc:license <https://creativecommons.org/licenses/by/4.0/> ;
    mod:status "under development"@en ;
    foaf:logo <https://labiosyncare.github.io/icons/icon.svg> ;
    vann:preferredNamespacePrefix "sstim" ;
    vann:preferredNamespaceUri "https://w3id.org/sstim#" ;
    void:inDataset <https://w3id.org/sstim/void> ;
    dct:hasPart
        <https://w3id.org/sstim/profile/kernel>,
        <https://w3id.org/sstim/profile/core>,
        <https://w3id.org/sstim/profile/core-plus>,
        <https://w3id.org/sstim/profile/full> ;
    rdfs:seeAlso <https://github.com/laBioSynCare/laBioSynCare.github.io> ,
        <https://github.com/laBioSynCare/laBioSynCare.github.io/blob/main/docs/decisions/0016-publication-obo-posture-and-registries.md> ,
        <https://github.com/laBioSynCare/laBioSynCare.github.io/blob/main/docs/ontology/MODULE_ARCHITECTURE.md> ,
        <https://w3id.org/sstim/manifest> ,
        <https://labiosyncare.github.io/ontology/docs/> ;
    skos:historyNote "v0.1.0 (2026-04): Initial public release. Vocabulary seeded from BSC preset catalog v0.9.1. Term 'Sensory Stimulation' adopted as the established umbrella over the coined term 'Sensory Harnessing'."@en,
        "v0.2.0 (2026-06): Added sstim:CautionTag, sstim:VoiceType, and sstim:PermutationFunction classification classes and the sstim:hasCautionTag property; dual-typed the caution, voice-type, permutation, and stimulus-temporal-structure SKOS concepts; added the StimulusTemporalStructure concept scheme; completed it/pt/es prefLabel coverage across the vocabulary; added external upper-ontology label stubs. Backward-compatible minor release (no terms removed or renamed)."@en,
        "v0.2.0 erratum (2026-06): Corrected external alignment IRIs that had been wrong since 0.1.0: every Wikidata QID (all resolved to unrelated entities), the EvidenceClaim parent (iao:0000001 'conditional specification' → iao:0000030 'information content entity'), the obsolete OBI planned-process parent (added cob:0000082), a non-existent ORCID (replaced with the verified ORCID 0000-0002-9699-629X), and a dead repository link. No vocabulary terms changed."@en,
        "v0.3.0 (2026-06): Added sstim-v:TechniqueScheme — a vendor-neutral controlled vocabulary of auditory and cross-modal sensory stimulation techniques — together with seven new StimulationMechanism concepts (ASSR, auditory-motor coupling, closed-loop phase reinforcement, masking, vibrotactile mechanoreception, acoustic startle, ultrasonic neuromodulation) and the sstim:techniqueModality property. Two non-evidence-bearing folk techniques are catalogued and explicitly flagged via skos:editorialNote. Additive, backward-compatible release (no terms removed or renamed)."@en,
        "v0.5.0 (2026-07): Domain-content coverage (P5) and evidence-integrity governance (P7). Added visual, tactile, and cross-modal techniques with the steady-state evoked-potential mechanism family (SSVEP, SSSEP, multisensory integration) (ADR 0015); reference-pitch retuning with the carrier-vs-modulation evidence firewall (ADR 0017); the modality-nomenclature cleanup — the somatosensory/haptic/tactile/vibrotactile convention and the sstim-v: to sstim-ex: perceived-modality closeMatch bridge (ADR 0019); visual/tactile/multisensory evidence-modality tags (VIS, TACTILE, MULTISENSORY); the C0-C5 public-claim-level taxonomy with SHACL claim-legality and the conditional-citation constraint (ADR 0018); and the first populated technique EvidenceClaim instances (P5.4, instance data). Version 0.4.0 was the standalone exposure / Sensory Field module release (ADR 0010, 0011). Additive, backward-compatible (no terms removed or renamed)."@en,
        "v0.6.0 (2026-07): Semantic-quality release. Controlled vocabulary categories are modeled consistently as information content entities; session specifications are PROV plans and session instances are stimulation interventions; self-reports support explicit collection phases; caution tags carry machine-readable severity and action metadata; scalar cardinalities, definitions, evidence provenance, and integrity constraints are strengthened. An external automated audit removed the obsolete OBI planned-process superclass, narrowed the technique upper alignment, completed FAIR metadata, and corrected safety-source attribution. The maintainer guided and accepted the release review; independent human ontology review is deferred. See ADR 0021, ADR 0022, and the 2026-07-10 external automated review report."@en,
        "v0.9.0 (2026-07): Stimulation and neuromodulation release (ADR 0034). Adds a neutral sstim:Stimulation umbrella and sstim:Neuromodulation sibling at the process, intervention, technique, and protocol layers, with the overlap named at each layer as a defined intersection class requiring an intended canonical sensory-transduction route: neither family subsumes the other. Adds five orthogonal facet axes — neural access route, delivery approach, neural target site, neural system, and neural phenomenon — kept separate because a route, a dynamic, a system, and an outcome domain are not values on one scale, and reused across intended, proposed-mechanism, and observed-outcome roles by distinct properties. Shared domains and ranges widen to the neutral parents so a non-sensory technique can be the subject of a conformant evidence assessment. Retypes focused-ultrasound neuromodulation off the sensory hierarchy and redefines it by its intended focused neural target rather than by absence of an audible percept; deprecates five response-as-mechanism entries (FFR, ASSR, SSVEP, SSSEP, acoustic startle) in favour of typed neural-phenomenon concepts, removing their mechanism typing and scheme topology rather than deprecating alone. Relabels TechniqueScheme, whose IRI was never sensory-scoped. Catalogues a six-technique non-sensory contrast set (rTMS, tDCS, tACS, DBS, VNS, targeted intrathecal delivery) so the route axis is exercised; none is referenced by any BSC preset, framework, protocol, or implementation, and inclusion asserts neither capability nor efficacy nor safety. Replaces the SHACL escape hatch in which any skos:editorialNote suppressed structural requirements with composed, disjointly-targeted shapes. Breaking on mutable latest for consumers of the retyped focused-ultrasound entry and the five deprecated mechanism IRIs; frozen 0.3.0-0.8.0 snapshots retain their published entailments."@en,
        "v0.7.0 (2026-07): Evidence and ecosystem governance release. ADR 0027 replaces overloaded evidence claims with immutable assessment revisions, atomic bounded propositions, qualified evidence bases, explicit scope axes, source/search governance, and PROV review decisions while retaining deprecated compatibility terms. ADRs 0024 and 0031 add the neutral EcosystemAgent module, qualified relationships and memberships, implementation responsibility, purpose-scoped admission activities, a closed public projection, and separate access-controlled audit shapes. Public fixtures are synthetic; real live-only ecosystem records remain outside the Zenodo-tracked release repository."@en,
        "v0.10.0 (2026-07-24): Participant-engagement and contrast-set completion release (ADR 0035), from the 2026-07-22 Theo Marins interview. Adds a sixth orthogonal facet, sstim:ParticipantEngagementMode with the sstim:participantEngagementMode property and a passive-receptive / guided-following / active-self-regulatory scheme, distinguishing self-regulatory and cue-following practices from receptive exposure without touching the ADR 0034 axes. Catalogues electroconvulsive therapy in the non-sensory neuromodulation contrast set, and catalogues neurofeedback and biofeedback at the neutral sstim:StimulationTechnique layer — sensory-in, endogenous self-regulation out — rather than reopening sstim:Neuromodulation's exclusion of endogenous physiological neuromodulation. Names an invasive/minimally-invasive/non-invasive rollup over the delivery-approach values as SKOS collections, not a new primitive axis. ADR 0036 then resolves the two questions ADR 0035 parked: it disambiguates neuromodulation's intervention sense (pinned on sstim:Neuromodulation, its exclusion refined to admit deliberate self-directed but not spontaneous physiological modulation) from its effect sense (kept as a facet over sstim:outcomeNeuralPhenomenon, named by the sstim-v:NeuromodulatoryEffectCollection); adds sstim:Neurostimulation as the stimulation-based branch of interventional neuromodulation, with electric/magnetic/sensory as facet views rather than subclasses; adds the sstim:SelfDirectedNeuromodulation / sstim:InterventionalNeuromodulation split and re-types neurofeedback and biofeedback as self-directed neuromodulation techniques; and adds sstim:Neuroplasticity as a disposition stub. Additive and backward-compatible on mutable latest apart from one scope-note refinement on sstim:Neuromodulation and the two technique re-typings; no term removed or renamed."@en,
        "v0.11.0 (2026-07-24): Gate A/B stabilization release (2026-07-24 RDF structure and publication audit). Gate A (release integrity, RDF-01/02/03/11/12): the frozen 0.8.0-0.10.0 snapshots each self-cite the v0.7.0 Zenodo DOI (10.5281/zenodo.21380171) and citation string instead of their own version DOI, uncaught for lack of a release gate cross-checking header version, status, history text, version DOI, and citation together; corrected going forward by removing the stale dct:hasVersion / dct:bibliographicCitation pending this version's Zenodo DOI reservation (0.5.0 precedent), fixing the v0.10.0 history entry's leftover 'under development' qualifier, and synchronizing every module's owl:versionInfo and header comment. The affected 0.8.0-0.10.0 snapshots remain byte-identical historical records pending a visible erratum. Gate B (semantic stabilization, ADR 0037): adds sstim:DeliberateSelfRegulation as the neutral genus above no-applied-stimulus self-directed practices, narrowing sstim:SelfDirectedNeuromodulation to stimulus-mediated cases only (RDF-04); asserts sstim:SensoryNeurostimulation / sstim:SensoryNeurostimulationTechnique below sstim:Neurostimulation as an intersection class, retyping sstim-v:techGamma40Auditory accordingly (RDF-05); repairs three sstim-exposure.ttl property domains to union types matching their own definitions (RDF-09); removes two duplicate scheme definitions and completes the EvidenceModalityScheme/EvidenceModalityTag deprecation (RDF-13/RDF-15); adds sstim:primaryFrequencyBand replacing the unordered-property 'first entry is primary' claim, and downgrades five frequency-band-to-Wikidata mappings from exactMatch to closeMatch pending the deferred oscillation-band/stimulus-target split (RDF-08 partial); and adds the missing bfo:0000016 display-label stub (RDF-17). Additive and backward-compatible: no term removed; the only narrowing (SelfDirectedNeuromodulation) had zero instance-level blast radius."@en ,
        "v0.12.0 (2026-07-31): Description-layer release (ADR 0041, ADR 0042). Separates four layers that were conflated: the stimulation process, an engine-independent description of it, the engine configuration that produces it, and the execution of that configuration. sstim:Preset is redefined as the engine-configuration layer and is engine-dependent by nature — its former definition named \"audio architecture\" as a constituent, which described the BSC catalog format rather than presets and contradicted sstim-ex:StimulusChannel in this same ontology; skos:altLabel \"Patch\" records that the two words name one thing, and engine-specific schemas are conformance profiles rather than classes. sstim:Patch, added in 0.11.x under ADR 0040, is withdrawn on those grounds before any consumer depended on it; sstim:Track and its four disjoint subtypes are retained as genuinely general, and sstim:Voice is now asserted below sstim:AudioTrack, a subsumption ADR 0040 declined and ADR 0041 reinstates once the Patch Studio control tracks were renamed LFO and Permutation so that one name no longer covered both an audible layer and a silent one. New module sstim-stimulus.ttl supplies the missing description layer: sstim:StimulusSpecification states what reaches the target in physical or perceptual units (dB SPL, cd/m2, Hz) rather than engine controls, over the existing sstim-ex:StimulusChannel set, with a required regime facet — determinate, stochastic, or adaptive — because a closed-loop stimulus has no static description in principle and what is describable there is a control law. It also adds the stimulation target axis, admitting people, non-human animals, plants, objects and unoccupied space, with absence permitted and carrying no claim that a target perceives, responds or benefits; and three session liberties that had nowhere to live: disablesTrack, masterBrightness and scheduledStart. Additive and backward-compatible apart from the withdrawal of the three-day-old sstim:Patch: no other term removed, and the widened property domains are unions, which weaken entailment rather than invalidate any existing assertion."@en .

###########################################################################
# Core process kernel
###########################################################################

sstim:Stimulation a owl:Class ;
    rdfs:subClassOf bfo:0000015 ;
    rdfs:label "Stimulation"@en,
               "Stimolazione"@it,
               "Estimulação"@pt,
               "Estimulación"@es ;
    skos:definition "A deliberately parameterized process in which structured physical energy, mechanical input, a chemical agent, or another controlled input is applied as a stimulus with a declared design intent to elicit, perturb, regulate, or probe an identified biological, sensory, or neural process. Mere exposure, administration, or energy transfer without that stimulation intent is insufficient. Classification does not assert excitation, conscious perception, response, benefit, or safety."@en ;
    skos:scopeNote "The neutral umbrella over sensory stimulation and interventional neuromodulation. It carries no commitment to an applied medium, delivery approach, biological access route, or anatomical target; those are recorded on separate facets (ADR 0034)."@en ;
    rdfs:seeAlso <https://github.com/laBioSynCare/laBioSynCare.github.io/blob/main/docs/decisions/0034-neuromodulation-relation-and-neural-target-axis.md> ;
    rdfs:isDefinedBy <https://w3id.org/sstim> .

sstim:SensoryStimulation a owl:Class ;
    rdfs:subClassOf bfo:0000015 ;
    rdfs:subClassOf sstim:Stimulation ;
    rdfs:label "Sensory Stimulation"@en,
               "Stimolazione Sensoriale"@it,
               "Estimulação Sensorial"@pt,
               "Estimulación Sensorial"@es ;
    skos:definition "A stimulation process whose defining intervention route engages canonical sensory transduction and afferent processing with structured input delivered according to specified parameters for a declared purpose. The class identifies the delivery process; any mechanism, response, or outcome is represented separately and requires its own evidence."@en ;
    skos:scopeNote "Conscious perception is not required, and an incidental sensation arising from another primary route is insufficient. Covers entrainment-based stimulation (binaural beats, isochronous tones), non-entrainment stimulation (stochastic resonance, attentional anchoring), and autonomic stimulation (paced respiratory entrainment). Does not include passive incidental sensory exposure."@en ;
    rdfs:seeAlso <https://github.com/laBioSynCare/laBioSynCare.github.io/blob/main/docs/decisions/0034-neuromodulation-relation-and-neural-target-axis.md> ;
    rdfs:isDefinedBy <https://w3id.org/sstim> .

###########################################################################
# End of sstim-core.ttl
###########################################################################
