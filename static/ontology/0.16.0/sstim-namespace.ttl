###########################################################################
# Part 12 — Evidence Basis and Review Provenance Schemes (ADR 0027)
#
# Controlled values for the orthogonal evidence-basis axes and the review
# axes. Pattern-2 dual typing (ADR 0002). English-only labels at
# introduction; translations follow the normal review process.
###########################################################################

sstim-v:ModalityApplicabilityScheme a skos:ConceptScheme ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    skos:definition "Controlled statements of how sensory modality applies to an evidence source: mixed, unknown/not reported, or not applicable (ADR 0027)."@en ;
    skos:prefLabel "SSTIM Evidence Modality Applicability Vocabulary"@en ;
    skos:hasTopConcept sstim-v:applicabilityMixedModalities,
                       sstim-v:applicabilityUnknownModality,
                       sstim-v:applicabilityNotApplicable .

sstim-v:applicabilityMixedModalities a owl:NamedIndividual, sstim:ModalityApplicability, skos:Concept ;
    skos:inScheme sstim-v:ModalityApplicabilityScheme ;
    skos:prefLabel "Mixed modalities"@en,
                   "Modalità multiple"@it,
                   "Modalidades mistas"@pt,
                   "Modalidades mixtas"@es ;
    skos:notation "mixed-modalities" ;
    skos:definition "The source spans several sensory modalities; every canonical modality it actually supports is still listed explicitly."@en .

sstim-v:applicabilityUnknownModality a owl:NamedIndividual, sstim:ModalityApplicability, skos:Concept ;
    skos:inScheme sstim-v:ModalityApplicabilityScheme ;
    skos:prefLabel "Unknown / not reported"@en,
                   "Sconosciuta / non riportata"@it,
                   "Desconhecida / não relatada"@pt,
                   "Desconocida / no informada"@es ;
    skos:notation "unknown-modality" ;
    skos:definition "The source does not report, or the extraction did not establish, the sensory modality."@en .

sstim-v:applicabilityNotApplicable a owl:NamedIndividual, sstim:ModalityApplicability, skos:Concept ;
    skos:inScheme sstim-v:ModalityApplicabilityScheme ;
    skos:prefLabel "Not applicable"@en,
                   "Non applicabile"@it,
                   "Não aplicável"@pt,
                   "No aplicable"@es ;
    skos:notation "not-applicable-modality" ;
    skos:definition "Sensory modality does not apply to this source (for example a paced-breathing intervention with no sensory delivery claim)."@en .


sstim-v:StudyDesignScheme a skos:ConceptScheme ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    skos:definition "Controlled designs of the underlying studies contributing to an evidence source (ADR 0027)."@en ;
    skos:prefLabel "SSTIM Study Design Vocabulary"@en ;
    skos:hasTopConcept sstim-v:designRandomizedControlledTrial, sstim-v:designControlledTrial,
                       sstim-v:designObservational, sstim-v:designCaseReport,
                       sstim-v:designPreclinicalExperiment, sstim-v:designMixedDesigns,
                       sstim-v:designUnknownDesign .

sstim-v:designRandomizedControlledTrial a owl:NamedIndividual, sstim:StudyDesign, skos:Concept ;
    skos:inScheme sstim-v:StudyDesignScheme ;
    skos:prefLabel "Randomized controlled trial"@en,
                   "Studio controllato randomizzato"@it,
                   "Ensaio controlado randomizado"@pt,
                   "Ensayo controlado aleatorizado"@es ;
    skos:notation "rct" ;
    skos:definition "Randomized allocation to intervention and control conditions."@en .

sstim-v:designControlledTrial a owl:NamedIndividual, sstim:StudyDesign, skos:Concept ;
    skos:inScheme sstim-v:StudyDesignScheme ;
    skos:prefLabel "Controlled trial (non-randomized)"@en,
                   "Studio controllato (non randomizzato)"@it,
                   "Ensaio controlado (não randomizado)"@pt,
                   "Ensayo controlado (no aleatorizado)"@es ;
    skos:notation "controlled-trial" ;
    skos:definition "Controlled comparison without randomized allocation."@en .

sstim-v:designObservational a owl:NamedIndividual, sstim:StudyDesign, skos:Concept ;
    skos:inScheme sstim-v:StudyDesignScheme ;
    skos:prefLabel "Observational"@en,
                   "Osservazionale"@it,
                   "Observacional"@pt,
                   "Observacional"@es ;
    skos:notation "observational" ;
    skos:definition "Observational design without experimenter-controlled allocation."@en .

sstim-v:designCaseReport a owl:NamedIndividual, sstim:StudyDesign, skos:Concept ;
    skos:inScheme sstim-v:StudyDesignScheme ;
    skos:prefLabel "Case report / case series"@en,
                   "Descrizione di caso / serie di casi"@it,
                   "Relato de caso / série de casos"@pt,
                   "Reporte de caso / serie de casos"@es ;
    skos:notation "case-report" ;
    skos:definition "Individual case descriptions without systematic comparison."@en .

sstim-v:designPreclinicalExperiment a owl:NamedIndividual, sstim:StudyDesign, skos:Concept ;
    skos:inScheme sstim-v:StudyDesignScheme ;
    skos:prefLabel "Preclinical experiment"@en,
                   "Esperimento preclinico"@it,
                   "Experimento pré-clínico"@pt,
                   "Experimento preclínico"@es ;
    skos:notation "preclinical-experiment" ;
    skos:definition "Controlled experiment in a preclinical model rather than human participants."@en .

sstim-v:designMixedDesigns a owl:NamedIndividual, sstim:StudyDesign, skos:Concept ;
    skos:inScheme sstim-v:StudyDesignScheme ;
    skos:prefLabel "Mixed designs"@en,
                   "Disegni misti"@it,
                   "Delineamentos mistos"@pt,
                   "Diseños mixtos"@es ;
    skos:notation "mixed-designs" ;
    skos:definition "The source aggregates studies of several designs (typical of reviews)."@en .

sstim-v:designUnknownDesign a owl:NamedIndividual, sstim:StudyDesign, skos:Concept ;
    skos:inScheme sstim-v:StudyDesignScheme ;
    skos:prefLabel "Unknown design"@en,
                   "Disegno sconosciuto"@it,
                   "Delineamento desconhecido"@pt,
                   "Diseño desconocido"@es ;
    skos:notation "unknown-design" ;
    skos:definition "The underlying design was not reported or has not been extracted."@en .


sstim-v:StudyModelScheme a skos:ConceptScheme ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    skos:definition "Controlled models or stages in which evidence was produced: human, preclinical animal, in vitro, computational (ADR 0027)."@en ;
    skos:prefLabel "SSTIM Study Model Vocabulary"@en ;
    skos:hasTopConcept sstim-v:modelHuman, sstim-v:modelPreclinicalAnimal,
                       sstim-v:modelInVitro, sstim-v:modelComputational,
                       sstim-v:modelMixedModels, sstim-v:modelUnknownModel .

sstim-v:modelHuman a owl:NamedIndividual, sstim:StudyModel, skos:Concept ;
    skos:inScheme sstim-v:StudyModelScheme ;
    skos:prefLabel "Human participants"@en,
                   "Partecipanti umani"@it,
                   "Participantes humanos"@pt,
                   "Participantes humanos"@es ;
    skos:notation "human" ;
    skos:definition "Findings produced with human participants."@en .

sstim-v:modelPreclinicalAnimal a owl:NamedIndividual, sstim:StudyModel, skos:Concept ;
    skos:inScheme sstim-v:StudyModelScheme ;
    skos:prefLabel "Preclinical animal model"@en,
                   "Modello animale preclinico"@it,
                   "Modelo animal pré-clínico"@pt,
                   "Modelo animal preclínico"@es ;
    skos:notation "preclinical-animal" ;
    skos:definition "Findings produced in a non-human animal model. Replaces the modality-tag misuse of PRECLINICAL as a modality."@en .

sstim-v:modelInVitro a owl:NamedIndividual, sstim:StudyModel, skos:Concept ;
    skos:inScheme sstim-v:StudyModelScheme ;
    skos:prefLabel "In vitro"@en,
                   "In vitro"@it,
                   "In vitro"@pt,
                   "In vitro"@es ;
    skos:notation "in-vitro" ;
    skos:definition "Findings produced in vitro."@en .

sstim-v:modelComputational a owl:NamedIndividual, sstim:StudyModel, skos:Concept ;
    skos:inScheme sstim-v:StudyModelScheme ;
    skos:prefLabel "Computational model"@en,
                   "Modello computazionale"@it,
                   "Modelo computacional"@pt,
                   "Modelo computacional"@es ;
    skos:notation "computational" ;
    skos:definition "Findings produced by simulation or computational modeling."@en .

sstim-v:modelMixedModels a owl:NamedIndividual, sstim:StudyModel, skos:Concept ;
    skos:inScheme sstim-v:StudyModelScheme ;
    skos:prefLabel "Mixed models"@en,
                   "Modelli misti"@it,
                   "Modelos mistos"@pt,
                   "Modelos mixtos"@es ;
    skos:notation "mixed-models" ;
    skos:definition "The source aggregates findings across several models or stages."@en .

sstim-v:modelUnknownModel a owl:NamedIndividual, sstim:StudyModel, skos:Concept ;
    skos:inScheme sstim-v:StudyModelScheme ;
    skos:prefLabel "Unknown model"@en,
                   "Modello sconosciuto"@it,
                   "Modelo desconhecido"@pt,
                   "Modelo desconocido"@es ;
    skos:notation "unknown-model" ;
    skos:definition "The model or stage was not reported or has not been extracted."@en .


sstim-v:EvidenceSynthesisTypeScheme a skos:ConceptScheme ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    skos:definition "Controlled synthesis levels of an evidence source, from primary study to meta-analysis (ADR 0027)."@en ;
    skos:prefLabel "SSTIM Evidence Synthesis Type Vocabulary"@en ;
    skos:hasTopConcept sstim-v:synthesisPrimaryStudy, sstim-v:synthesisNarrativeReview,
                       sstim-v:synthesisSystematicReview, sstim-v:synthesisMetaAnalysis,
                       sstim-v:synthesisLiteratureReview, sstim-v:synthesisTutorial .

sstim-v:synthesisPrimaryStudy a owl:NamedIndividual, sstim:EvidenceSynthesisType, skos:Concept ;
    skos:inScheme sstim-v:EvidenceSynthesisTypeScheme ;
    skos:prefLabel "Primary study"@en,
                   "Studio primario"@it,
                   "Estudo primário"@pt,
                   "Estudio primario"@es ;
    skos:notation "primary-study" ;
    skos:definition "An original empirical study, not a synthesis of other studies."@en .

sstim-v:synthesisNarrativeReview a owl:NamedIndividual, sstim:EvidenceSynthesisType, skos:Concept ;
    skos:inScheme sstim-v:EvidenceSynthesisTypeScheme ;
    skos:prefLabel "Narrative review"@en,
                   "Rassegna narrativa"@it,
                   "Revisão narrativa"@pt,
                   "Revisión narrativa"@es ;
    skos:notation "narrative-review" ;
    skos:definition "A review without a systematic search and selection protocol."@en .

sstim-v:synthesisSystematicReview a owl:NamedIndividual, sstim:EvidenceSynthesisType, skos:Concept ;
    skos:inScheme sstim-v:EvidenceSynthesisTypeScheme ;
    skos:prefLabel "Systematic review"@en,
                   "Revisione sistematica"@it,
                   "Revisão sistemática"@pt,
                   "Revisión sistemática"@es ;
    skos:notation "systematic-review" ;
    skos:definition "A review with a documented systematic search, selection, and appraisal protocol. Matches the narrower meaning the legacy REVIEW tag claimed."@en .

sstim-v:synthesisMetaAnalysis a owl:NamedIndividual, sstim:EvidenceSynthesisType, skos:Concept ;
    skos:inScheme sstim-v:EvidenceSynthesisTypeScheme ;
    skos:prefLabel "Meta-analysis"@en,
                   "Meta-analisi"@it,
                   "Meta-análise"@pt,
                   "Metaanálisis"@es ;
    skos:notation "meta-analysis" ;
    skos:definition "A quantitative synthesis of results across studies."@en .

sstim-v:synthesisLiteratureReview a owl:NamedIndividual, sstim:EvidenceSynthesisType, skos:Concept ;
    skos:inScheme sstim-v:EvidenceSynthesisTypeScheme ;
    skos:prefLabel "Literature review"@en,
                   "Rassegna della letteratura"@it,
                   "Revisão da literatura"@pt,
                   "Revisión de la literatura"@es ;
    skos:notation "literature-review" ;
    skos:definition "A survey of the literature without a documented systematic protocol or quantitative synthesis."@en .

sstim-v:synthesisTutorial a owl:NamedIndividual, sstim:EvidenceSynthesisType, skos:Concept ;
    skos:inScheme sstim-v:EvidenceSynthesisTypeScheme ;
    skos:prefLabel "Tutorial"@en,
                   "Tutorial"@it,
                   "Tutorial"@pt,
                   "Tutorial"@es ;
    skos:notation "tutorial" ;
    skos:definition "An instructional source synthesizing established methods and findings."@en .


sstim-v:EvidencePropositionFormScheme a skos:ConceptScheme ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    skos:definition "Controlled logical forms of an assessment proposition; universal absence is named so validation can reject it (ADR 0027)."@en ;
    skos:prefLabel "SSTIM Evidence Proposition Form Vocabulary"@en ;
    skos:hasTopConcept sstim-v:formBoundedRelation, sstim-v:formBoundedNullResult,
                       sstim-v:formScopedSearchFinding, sstim-v:formUniversalAbsence .

sstim-v:formBoundedRelation a owl:NamedIndividual, sstim:EvidencePropositionForm, skos:Concept ;
    skos:inScheme sstim-v:EvidencePropositionFormScheme ;
    skos:prefLabel "Bounded relation"@en,
                   "Relazione delimitata"@it,
                   "Relação delimitada"@pt,
                   "Relación delimitada"@es ;
    skos:notation "bounded-relation" ;
    skos:definition "The proposition asserts a relation, difference, or response within an explicit scope."@en .

sstim-v:formBoundedNullResult a owl:NamedIndividual, sstim:EvidencePropositionForm, skos:Concept ;
    skos:inScheme sstim-v:EvidencePropositionFormScheme ;
    skos:prefLabel "Bounded null result"@en,
                   "Risultato nullo delimitato"@it,
                   "Resultado nulo delimitado"@pt,
                   "Resultado nulo delimitado"@es ;
    skos:notation "bounded-null-result" ;
    skos:definition "The proposition asserts the absence of an effect within an explicit scope, backed by evidence that tested it."@en .

sstim-v:formScopedSearchFinding a owl:NamedIndividual, sstim:EvidencePropositionForm, skos:Concept ;
    skos:inScheme sstim-v:EvidencePropositionFormScheme ;
    skos:prefLabel "Scoped search finding"@en,
                   "Esito di ricerca circoscritto"@it,
                   "Achado de busca delimitado"@pt,
                   "Hallazgo de búsqueda delimitado"@es ;
    skos:notation "scoped-search-finding" ;
    skos:definition "The proposition states that no eligible evidence was found within a documented search scope as of a date. Requires an evidence search record basis."@en .

sstim-v:formUniversalAbsence a owl:NamedIndividual, sstim:EvidencePropositionForm, skos:Concept ;
    skos:inScheme sstim-v:EvidencePropositionFormScheme ;
    skos:prefLabel "Universal absence"@en,
                   "Assenza universale"@it,
                   "Ausência universal"@pt,
                   "Ausencia universal"@es ;
    skos:notation "universal-absence" ;
    skos:definition "The proposition asserts that no evidence or mechanism exists at all. Never conformant: a finite search cannot support it. Present in the vocabulary so validation can name and reject it."@en .


sstim-v:ScopeMarkerScheme a skos:ConceptScheme ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    skos:definition "Controlled markers stating that a proposition scope axis is unknown, not reported, or not applicable (ADR 0027)."@en ;
    skos:prefLabel "SSTIM Scope Marker Vocabulary"@en ;
    skos:hasTopConcept sstim-v:scopeUnknown, sstim-v:scopeNotReported, sstim-v:scopeNotApplicable .

sstim-v:scopeUnknown a owl:NamedIndividual, sstim:ScopeMarker, skos:Concept ;
    skos:inScheme sstim-v:ScopeMarkerScheme ;
    skos:prefLabel "Unknown"@en,
                   "Sconosciuto"@it,
                   "Desconhecido"@pt,
                   "Desconocido"@es ;
    skos:notation "scope-unknown" ;
    skos:definition "The value of this scope axis is unknown."@en .

sstim-v:scopeNotReported a owl:NamedIndividual, sstim:ScopeMarker, skos:Concept ;
    skos:inScheme sstim-v:ScopeMarkerScheme ;
    skos:prefLabel "Not reported"@en,
                   "Non riportato"@it,
                   "Não relatado"@pt,
                   "No informado"@es ;
    skos:notation "scope-not-reported" ;
    skos:definition "The sources did not report a value for this scope axis."@en .

sstim-v:scopeNotApplicable a owl:NamedIndividual, sstim:ScopeMarker, skos:Concept ;
    skos:inScheme sstim-v:ScopeMarkerScheme ;
    skos:prefLabel "Not applicable"@en,
                   "Non applicabile"@it,
                   "Não aplicável"@pt,
                   "No aplicable"@es ;
    skos:notation "scope-not-applicable" ;
    skos:definition "This scope axis does not apply to the proposition."@en .


sstim-v:ReviewerRelationshipScheme a skos:ConceptScheme ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    skos:definition "Controlled relationships of a review agent to the assessed work (ADR 0027)."@en ;
    skos:prefLabel "SSTIM Reviewer Relationship Vocabulary"@en ;
    skos:hasTopConcept sstim-v:reviewerSelf, sstim-v:reviewerSameOrganization,
                       sstim-v:reviewerExternal, sstim-v:reviewerUnknownRelationship .

sstim-v:reviewerSelf a owl:NamedIndividual, sstim:ReviewerRelationship, skos:Concept ;
    skos:inScheme sstim-v:ReviewerRelationshipScheme ;
    skos:prefLabel "Self"@en,
                   "Autore stesso"@it,
                   "O próprio autor"@pt,
                   "El propio autor"@es ;
    skos:notation "self" ;
    skos:definition "The reviewer is the author of the assessed work."@en .

sstim-v:reviewerSameOrganization a owl:NamedIndividual, sstim:ReviewerRelationship, skos:Concept ;
    skos:inScheme sstim-v:ReviewerRelationshipScheme ;
    skos:prefLabel "Same organization"@en,
                   "Stessa organizzazione"@it,
                   "Mesma organização"@pt,
                   "Misma organización"@es ;
    skos:notation "same-organization" ;
    skos:definition "The reviewer belongs to the same organization as the assessed work's authors."@en .

sstim-v:reviewerExternal a owl:NamedIndividual, sstim:ReviewerRelationship, skos:Concept ;
    skos:inScheme sstim-v:ReviewerRelationshipScheme ;
    skos:prefLabel "External"@en,
                   "Esterno"@it,
                   "Externo"@pt,
                   "Externo"@es ;
    skos:notation "external" ;
    skos:definition "The reviewer is external to the authoring organization. Never implies independence by itself."@en .

sstim-v:reviewerUnknownRelationship a owl:NamedIndividual, sstim:ReviewerRelationship, skos:Concept ;
    skos:inScheme sstim-v:ReviewerRelationshipScheme ;
    skos:prefLabel "Unknown relationship"@en,
                   "Relazione sconosciuta"@it,
                   "Relação desconhecida"@pt,
                   "Relación desconocida"@es ;
    skos:notation "unknown-relationship" ;
    skos:definition "The reviewer's relationship to the assessed work is not established."@en .


sstim-v:IndependenceDeterminationScheme a skos:ConceptScheme ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    skos:definition "Controlled policy-based reviewer-independence determinations (ADR 0027)."@en ;
    skos:prefLabel "SSTIM Independence Determination Vocabulary"@en ;
    skos:hasTopConcept sstim-v:independenceIndependent, sstim-v:independenceNotIndependent,
                       sstim-v:independenceUndetermined .

sstim-v:independenceIndependent a owl:NamedIndividual, sstim:IndependenceDetermination, skos:Concept ;
    skos:inScheme sstim-v:IndependenceDeterminationScheme ;
    skos:prefLabel "Independent"@en,
                   "Indipendente"@it,
                   "Independente"@pt,
                   "Independiente"@es ;
    skos:notation "independent" ;
    skos:definition "Determined independent under a named policy, with recorded conflict disclosure."@en .

sstim-v:independenceNotIndependent a owl:NamedIndividual, sstim:IndependenceDetermination, skos:Concept ;
    skos:inScheme sstim-v:IndependenceDeterminationScheme ;
    skos:prefLabel "Not independent"@en,
                   "Non indipendente"@it,
                   "Não independente"@pt,
                   "No independiente"@es ;
    skos:notation "not-independent" ;
    skos:definition "Determined not independent under a named policy, with recorded conflict disclosure."@en .

sstim-v:independenceUndetermined a owl:NamedIndividual, sstim:IndependenceDetermination, skos:Concept ;
    skos:inScheme sstim-v:IndependenceDeterminationScheme ;
    skos:prefLabel "Undetermined"@en,
                   "Non determinato"@it,
                   "Não determinado"@pt,
                   "No determinado"@es ;
    skos:notation "undetermined" ;
    skos:definition "No independence determination has been made."@en .


sstim-v:ReviewDecisionScheme a skos:ConceptScheme ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    skos:definition "Controlled outcomes of an evidence review decision (ADR 0027)."@en ;
    skos:prefLabel "SSTIM Review Decision Vocabulary"@en ;
    skos:hasTopConcept sstim-v:reviewConfirm, sstim-v:reviewRequestRevision, sstim-v:reviewReject .

sstim-v:reviewConfirm a owl:NamedIndividual, sstim:ReviewDecisionValue, skos:Concept ;
    skos:inScheme sstim-v:ReviewDecisionScheme ;
    skos:prefLabel "Confirm"@en,
                   "Conferma"@it,
                   "Confirmação"@pt,
                   "Confirmación"@es ;
    skos:notation "confirm" ;
    skos:definition "The review confirms the assessment revision under the named rubric."@en .

sstim-v:reviewRequestRevision a owl:NamedIndividual, sstim:ReviewDecisionValue, skos:Concept ;
    skos:inScheme sstim-v:ReviewDecisionScheme ;
    skos:prefLabel "Request revision"@en,
                   "Richiesta di revisione"@it,
                   "Solicitação de revisão"@pt,
                   "Solicitud de revisión"@es ;
    skos:notation "request-revision" ;
    skos:definition "The review requests a new assessment revision."@en .

sstim-v:reviewReject a owl:NamedIndividual, sstim:ReviewDecisionValue, skos:Concept ;
    skos:inScheme sstim-v:ReviewDecisionScheme ;
    skos:prefLabel "Reject"@en,
                   "Rifiuto"@it,
                   "Rejeição"@pt,
                   "Rechazo"@es ;
    skos:notation "reject" ;
    skos:definition "The review rejects the assessment revision under the named rubric."@en .


sstim-v:ConflictDisclosureScheme a skos:ConceptScheme ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    skos:definition "Controlled conflict-of-interest disclosure records for reviews (ADR 0027)."@en ;
    skos:prefLabel "SSTIM Conflict Disclosure Vocabulary"@en ;
    skos:hasTopConcept sstim-v:noConflictDeclared .

sstim-v:noConflictDeclared a owl:NamedIndividual, sstim:ConflictDisclosure, skos:Concept ;
    skos:inScheme sstim-v:ConflictDisclosureScheme ;
    skos:prefLabel "No conflict declared"@en,
                   "Nessun conflitto dichiarato"@it,
                   "Nenhum conflito declarado"@pt,
                   "Ningún conflicto declarado"@es ;
    skos:notation "no-conflict-declared" ;
    skos:definition "The explicit declaration that the reviewer declared no conflict of interest. Case-specific disclosures are separate ConflictDisclosure records."@en .


# Materialized inverses for the Part 12 schemes (raw-RDF clients do not run inference).
sstim-v:applicabilityMixedModalities skos:topConceptOf sstim-v:ModalityApplicabilityScheme .
sstim-v:applicabilityUnknownModality skos:topConceptOf sstim-v:ModalityApplicabilityScheme .
sstim-v:applicabilityNotApplicable skos:topConceptOf sstim-v:ModalityApplicabilityScheme .
sstim-v:designRandomizedControlledTrial skos:topConceptOf sstim-v:StudyDesignScheme .
sstim-v:designControlledTrial skos:topConceptOf sstim-v:StudyDesignScheme .
sstim-v:designObservational skos:topConceptOf sstim-v:StudyDesignScheme .
sstim-v:designCaseReport skos:topConceptOf sstim-v:StudyDesignScheme .
sstim-v:designPreclinicalExperiment skos:topConceptOf sstim-v:StudyDesignScheme .
sstim-v:designMixedDesigns skos:topConceptOf sstim-v:StudyDesignScheme .
sstim-v:designUnknownDesign skos:topConceptOf sstim-v:StudyDesignScheme .
sstim-v:modelHuman skos:topConceptOf sstim-v:StudyModelScheme .
sstim-v:modelPreclinicalAnimal skos:topConceptOf sstim-v:StudyModelScheme .
sstim-v:modelInVitro skos:topConceptOf sstim-v:StudyModelScheme .
sstim-v:modelComputational skos:topConceptOf sstim-v:StudyModelScheme .
sstim-v:modelMixedModels skos:topConceptOf sstim-v:StudyModelScheme .
sstim-v:modelUnknownModel skos:topConceptOf sstim-v:StudyModelScheme .
sstim-v:synthesisPrimaryStudy skos:topConceptOf sstim-v:EvidenceSynthesisTypeScheme .
sstim-v:synthesisNarrativeReview skos:topConceptOf sstim-v:EvidenceSynthesisTypeScheme .
sstim-v:synthesisSystematicReview skos:topConceptOf sstim-v:EvidenceSynthesisTypeScheme .
sstim-v:synthesisMetaAnalysis skos:topConceptOf sstim-v:EvidenceSynthesisTypeScheme .
sstim-v:synthesisLiteratureReview skos:topConceptOf sstim-v:EvidenceSynthesisTypeScheme .
sstim-v:synthesisTutorial skos:topConceptOf sstim-v:EvidenceSynthesisTypeScheme .
sstim-v:formBoundedRelation skos:topConceptOf sstim-v:EvidencePropositionFormScheme .
sstim-v:formBoundedNullResult skos:topConceptOf sstim-v:EvidencePropositionFormScheme .
sstim-v:formScopedSearchFinding skos:topConceptOf sstim-v:EvidencePropositionFormScheme .
sstim-v:formUniversalAbsence skos:topConceptOf sstim-v:EvidencePropositionFormScheme .
sstim-v:scopeUnknown skos:topConceptOf sstim-v:ScopeMarkerScheme .
sstim-v:scopeNotReported skos:topConceptOf sstim-v:ScopeMarkerScheme .
sstim-v:scopeNotApplicable skos:topConceptOf sstim-v:ScopeMarkerScheme .
sstim-v:reviewerSelf skos:topConceptOf sstim-v:ReviewerRelationshipScheme .
sstim-v:reviewerSameOrganization skos:topConceptOf sstim-v:ReviewerRelationshipScheme .
sstim-v:reviewerExternal skos:topConceptOf sstim-v:ReviewerRelationshipScheme .
sstim-v:reviewerUnknownRelationship skos:topConceptOf sstim-v:ReviewerRelationshipScheme .
sstim-v:independenceIndependent skos:topConceptOf sstim-v:IndependenceDeterminationScheme .
sstim-v:independenceNotIndependent skos:topConceptOf sstim-v:IndependenceDeterminationScheme .
sstim-v:independenceUndetermined skos:topConceptOf sstim-v:IndependenceDeterminationScheme .
sstim-v:reviewConfirm skos:topConceptOf sstim-v:ReviewDecisionScheme .
sstim-v:reviewRequestRevision skos:topConceptOf sstim-v:ReviewDecisionScheme .
sstim-v:reviewReject skos:topConceptOf sstim-v:ReviewDecisionScheme .
sstim-v:noConflictDeclared skos:topConceptOf sstim-v:ConflictDisclosureScheme .


###########################################################################
# End of sstim-vocab.ttl
###########################################################################


###########################################################################
# Part 12 — Stimulation Facet Schemes (ADR 0034)
#
# Route, approach, target site, neural system, and neural phenomenon answer
# different questions and are therefore five schemes, not one "level" axis.
# "Transcranial", "implanted", "acoustic", "chemical", "oscillatory",
# "autonomic", and "cognitive" are not values on a common scale.
###########################################################################

sstim-v:NeuralAccessRouteScheme a skos:ConceptScheme ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    skos:prefLabel "SSTIM Neural Access Route Vocabulary"@en ,
                   "Vocabolario delle Vie di Accesso Neurale SSTIM"@it ,
                   "Vocabulário de Vias de Acesso Neural SSTIM"@pt ,
                   "Vocabulario de Vías de Acceso Neural SSTIM"@es ;
    skos:definition "Causal-route categories for how a stimulation process is intended to engage a neural target. Contains routes only — not media, approaches, targets, or outcomes."@en ;
    skos:scopeNote "'Receptor' here means a canonical sensory receptor, never a molecular drug receptor. Mixed access is several values; an unresolved route is an epistemic status recorded elsewhere, not a pseudo-route."@en ;
    skos:hasTopConcept sstim-v:routeCanonicalSensoryTransductionAfferent,
        sstim-v:routeBypassesCanonicalSensoryTransduction .

sstim-v:routeCanonicalSensoryTransductionAfferent a owl:NamedIndividual, sstim:CanonicalSensoryTransductionAccessRoute, skos:Concept ;
    skos:inScheme sstim-v:NeuralAccessRouteScheme ;
    skos:topConceptOf sstim-v:NeuralAccessRouteScheme ;
    skos:prefLabel "canonical sensory transduction and afferent access"@en,
                   "accesso per trasduzione sensoriale canonica e via afferente"@it,
                   "acesso por transdução sensorial canónica e via aferente"@pt,
                   "acceso por transducción sensorial canónica y vía aferente"@es ;
    skos:notation "route-canonical-sensory-transduction-afferent" ;
    skos:definition "Engagement of a neural target through canonical sensory receptor transduction and afferent processing."@en ;
    skos:scopeNote "Within the neuromodulation population this is not a redundant value: it is the fact that distinguishes the sensory-route overlap from approaches that bypass canonical sensory transduction. Conscious perception is not required."@en .

sstim-v:routeBypassesCanonicalSensoryTransduction a owl:NamedIndividual, sstim:SensoryTransductionBypassingAccessRoute, skos:Concept ;
    skos:inScheme sstim-v:NeuralAccessRouteScheme ;
    skos:topConceptOf sstim-v:NeuralAccessRouteScheme ;
    skos:narrower sstim-v:routePhysicalNeuralInteraction, sstim-v:routeBiochemicalPharmacologicalNeuralInteraction, sstim-v:routeIndirectNonSensoryPhysiologicalMediation ;
    skos:prefLabel "bypasses canonical sensory transduction"@en,
                   "elude la trasduzione sensoriale canonica"@it,
                   "contorna a transdução sensorial canónica"@pt,
                   "elude la transducción sensorial canónica"@es ;
    skos:notation "route-bypasses-canonical-sensory-transduction" ;
    skos:definition "Engagement of a neural target without canonical sensory receptor transduction."@en ;
    skos:scopeNote "Asserting this route positively identifies such a route; it does not prove the technique is non-sensory, because a hybrid may also declare an intended sensory route."@en .

sstim-v:routePhysicalNeuralInteraction a owl:NamedIndividual, sstim:SensoryTransductionBypassingAccessRoute, skos:Concept ;
    skos:inScheme sstim-v:NeuralAccessRouteScheme ;
    skos:broader sstim-v:routeBypassesCanonicalSensoryTransduction ;
    skos:prefLabel "physical neural interaction"@en,
                   "interazione neurale fisica"@it,
                   "interação neural física"@pt,
                   "interacción neural física"@es ;
    skos:notation "route-physical-neural-interaction" ;
    skos:definition "Direct physical interaction with neural tissue by an applied electric current or field, magnetic field, acoustic energy, or comparable physical means."@en ;
    skos:scopeNote "Both an intended cortical tACS interaction and a competing peripheral-nerve explanation use this broad route; they are separated by the intended target site versus the evaluated outcome target site, not by inventing two routes."@en .

sstim-v:routeBiochemicalPharmacologicalNeuralInteraction a owl:NamedIndividual, sstim:SensoryTransductionBypassingAccessRoute, skos:Concept ;
    skos:inScheme sstim-v:NeuralAccessRouteScheme ;
    skos:broader sstim-v:routeBypassesCanonicalSensoryTransduction ;
    skos:prefLabel "biochemical or pharmacological neural interaction"@en,
                   "interazione neurale biochimica o farmacologica"@it,
                   "interação neural bioquímica ou farmacológica"@pt,
                   "interacción neural bioquímica o farmacológica"@es ;
    skos:notation "route-biochemical-pharmacological-neural-interaction" ;
    skos:definition "Engagement of a neural target by a chemical or pharmacological agent acting on neural tissue."@en .

sstim-v:routeIndirectNonSensoryPhysiologicalMediation a owl:NamedIndividual, sstim:SensoryTransductionBypassingAccessRoute, skos:Concept ;
    skos:inScheme sstim-v:NeuralAccessRouteScheme ;
    skos:broader sstim-v:routeBypassesCanonicalSensoryTransduction ;
    skos:prefLabel "indirect non-sensory physiological mediation"@en,
                   "mediazione fisiologica indiretta non sensoriale"@it,
                   "mediação fisiológica indireta não sensorial"@pt,
                   "mediación fisiológica indirecta no sensorial"@es ;
    skos:notation "route-indirect-non-sensory-physiological-mediation" ;
    skos:definition "Engagement of a neural target through an intermediate physiological process that is not canonical sensory transduction, such as a vascular, endocrine, or muscular pathway."@en .

sstim-v:StimulationDeliveryApproachScheme a skos:ConceptScheme ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    skos:prefLabel "SSTIM Stimulation Delivery Approach Vocabulary"@en ,
                   "Vocabolario degli Approcci di Somministrazione della Stimolazione SSTIM"@it ,
                   "Vocabulário de Abordagens de Administração da Estimulação SSTIM"@pt ,
                   "Vocabulario de Enfoques de Administración de la Estimulación SSTIM"@es ;
    skos:definition "Coarse, non-exclusive operational tags summarizing administration, invasiveness, and interface placement for cross-technique navigation."@en ;
    skos:scopeNote "Deliberately non-exclusive and deliberately coarse: a method may be external, transcutaneous, and transcranial at once. Detailed device, body placement, administration, and dose remain in the exposure profile, and no approach tag is inferred from another facet."@en ;
    skos:hasTopConcept sstim-v:approachExternal, sstim-v:approachEnvironmentalReceptorFacing, sstim-v:approachTranscutaneous, sstim-v:approachTranscranial, sstim-v:approachPercutaneous, sstim-v:approachImplanted, sstim-v:approachIntracranial, sstim-v:approachEpidural, sstim-v:approachTargetedLocalInfusion, sstim-v:approachIntrathecal, sstim-v:approachSystemic .

sstim-v:approachExternal a owl:NamedIndividual, sstim:StimulationDeliveryApproach, skos:Concept ;
    skos:inScheme sstim-v:StimulationDeliveryApproachScheme ;
    skos:topConceptOf sstim-v:StimulationDeliveryApproachScheme ;
    skos:prefLabel "external"@en,
                   "esterno"@it,
                   "externo"@pt,
                   "externo"@es ;
    skos:notation "approach-external" ;
    skos:definition "Applied from outside the body without breaching the skin."@en .

sstim-v:approachEnvironmentalReceptorFacing a owl:NamedIndividual, sstim:StimulationDeliveryApproach, skos:Concept ;
    skos:inScheme sstim-v:StimulationDeliveryApproachScheme ;
    skos:topConceptOf sstim-v:StimulationDeliveryApproachScheme ;
    skos:prefLabel "environmental / receptor-facing"@en,
                   "ambientale / rivolto ai recettori"@it,
                   "ambiental / voltado para recetores"@pt,
                   "ambiental / orientado a receptores"@es ;
    skos:notation "approach-environmental-receptor-facing" ;
    skos:definition "Presented in the surrounding environment toward sensory receptors, without a body-mounted interface."@en .

sstim-v:approachTranscutaneous a owl:NamedIndividual, sstim:StimulationDeliveryApproach, skos:Concept ;
    skos:inScheme sstim-v:StimulationDeliveryApproachScheme ;
    skos:topConceptOf sstim-v:StimulationDeliveryApproachScheme ;
    skos:prefLabel "transcutaneous"@en,
                   "transcutaneo"@it,
                   "transcutâneo"@pt,
                   "transcutáneo"@es ;
    skos:notation "approach-transcutaneous" ;
    skos:definition "Delivered across intact skin, without breaching it. Distinguished from the epidural and intrathecal approaches, which place the agent or electrode inside the body."@en .

sstim-v:approachTranscranial a owl:NamedIndividual, sstim:StimulationDeliveryApproach, skos:Concept ;
    skos:inScheme sstim-v:StimulationDeliveryApproachScheme ;
    skos:topConceptOf sstim-v:StimulationDeliveryApproachScheme ;
    skos:prefLabel "transcranial"@en,
                   "transcranico"@it,
                   "transcraniano"@pt,
                   "transcraneal"@es ;
    skos:notation "approach-transcranial" ;
    skos:definition "Delivered across the skull toward an intracranial target."@en .

sstim-v:approachPercutaneous a owl:NamedIndividual, sstim:StimulationDeliveryApproach, skos:Concept ;
    skos:inScheme sstim-v:StimulationDeliveryApproachScheme ;
    skos:topConceptOf sstim-v:StimulationDeliveryApproachScheme ;
    skos:prefLabel "percutaneous"@en,
                   "percutaneo"@it,
                   "percutâneo"@pt,
                   "percutáneo"@es ;
    skos:notation "approach-percutaneous" ;
    skos:definition "Delivered through a needle or comparable skin puncture without a permanent implant."@en .

sstim-v:approachImplanted a owl:NamedIndividual, sstim:StimulationDeliveryApproach, skos:Concept ;
    skos:inScheme sstim-v:StimulationDeliveryApproachScheme ;
    skos:topConceptOf sstim-v:StimulationDeliveryApproachScheme ;
    skos:prefLabel "implanted"@en,
                   "impiantato"@it,
                   "implantado"@pt,
                   "implantado"@es ;
    skos:notation "approach-implanted" ;
    skos:definition "Delivered by a surgically placed device remaining in the body."@en .

sstim-v:approachIntracranial a owl:NamedIndividual, sstim:StimulationDeliveryApproach, skos:Concept ;
    skos:inScheme sstim-v:StimulationDeliveryApproachScheme ;
    skos:topConceptOf sstim-v:StimulationDeliveryApproachScheme ;
    skos:prefLabel "intracranial"@en,
                   "intracranico"@it,
                   "intracraniano"@pt,
                   "intracraneal"@es ;
    skos:notation "approach-intracranial" ;
    skos:definition "Delivered from within the cranial cavity."@en .

sstim-v:approachEpidural a owl:NamedIndividual, sstim:StimulationDeliveryApproach, skos:Concept ;
    skos:inScheme sstim-v:StimulationDeliveryApproachScheme ;
    skos:topConceptOf sstim-v:StimulationDeliveryApproachScheme ;
    skos:prefLabel "epidural"@en,
                   "epidurale"@it,
                   "epidural"@pt,
                   "epidural"@es ;
    skos:notation "approach-epidural" ;
    skos:definition "Delivered into the epidural space."@en .

sstim-v:approachTargetedLocalInfusion a owl:NamedIndividual, sstim:StimulationDeliveryApproach, skos:Concept ;
    skos:inScheme sstim-v:StimulationDeliveryApproachScheme ;
    skos:topConceptOf sstim-v:StimulationDeliveryApproachScheme ;
    skos:prefLabel "targeted local infusion"@en,
                   "infusione locale mirata"@it,
                   "infusão local dirigida"@pt,
                   "infusión local dirigida"@es ;
    skos:notation "approach-targeted-local-infusion" ;
    skos:definition "An agent infused at or near an identified target rather than distributed systemically."@en .

sstim-v:approachIntrathecal a owl:NamedIndividual, sstim:StimulationDeliveryApproach, skos:Concept ;
    skos:inScheme sstim-v:StimulationDeliveryApproachScheme ;
    skos:topConceptOf sstim-v:StimulationDeliveryApproachScheme ;
    skos:prefLabel "intrathecal"@en,
                   "intratecale"@it,
                   "intratecal"@pt,
                   "intratecal"@es ;
    skos:notation "approach-intrathecal" ;
    skos:definition "Delivered into the intrathecal space."@en .

sstim-v:approachSystemic a owl:NamedIndividual, sstim:StimulationDeliveryApproach, skos:Concept ;
    skos:inScheme sstim-v:StimulationDeliveryApproachScheme ;
    skos:topConceptOf sstim-v:StimulationDeliveryApproachScheme ;
    skos:prefLabel "systemic"@en,
                   "sistemico"@it,
                   "sistémico"@pt,
                   "sistémico"@es ;
    skos:notation "approach-systemic" ;
    skos:definition "Distributed through the body as a whole rather than applied at an identified site."@en .

# Invasiveness rollup (ADR 0035, from the 2026-07-22 Theo Marins interview, who
# noted that neuromodulation divides first into invasive and non-invasive
# techniques). Expressed as SKOS collections that GROUP the delivery-approach
# values, not as a new primitive axis or a subsumption layer: ADR 0034
# deliberately kept delivery approach coarse and non-exclusive, and invasive vs.
# non-invasive is a rollup of it, not an independent facet. Collections leave the
# scheme's top-concept structure untouched and add no OWL entailment. Systemic
# distribution is deliberately in none of them: it is a route of distribution,
# orthogonal to depth of tissue penetration.
sstim-v:NonInvasiveApproachCollection a skos:Collection ;
    rdfs:label "Non-invasive delivery approaches"@en ;
    skos:definition "The rollup of delivery approaches that do not breach the skin or body: external, environmental / receptor-facing, transcutaneous, and transcranial."@en ;
    rdfs:seeAlso <https://github.com/laBioSynCare/laBioSynCare.github.io/blob/main/docs/decisions/0035-participant-engagement-mode-and-endogenous-self-regulation.md> ;
    skos:member sstim-v:approachExternal, sstim-v:approachEnvironmentalReceptorFacing,
        sstim-v:approachTranscutaneous, sstim-v:approachTranscranial .

sstim-v:MinimallyInvasiveApproachCollection a skos:Collection ;
    rdfs:label "Minimally-invasive delivery approaches"@en ;
    skos:definition "The rollup of delivery approaches that cross the skin by needle puncture without leaving a permanent implant: percutaneous."@en ;
    rdfs:seeAlso <https://github.com/laBioSynCare/laBioSynCare.github.io/blob/main/docs/decisions/0035-participant-engagement-mode-and-endogenous-self-regulation.md> ;
    skos:member sstim-v:approachPercutaneous .

sstim-v:InvasiveApproachCollection a skos:Collection ;
    rdfs:label "Invasive delivery approaches"@en ;
    skos:definition "The rollup of delivery approaches that place a device or agent inside the body: implanted, intracranial, epidural, targeted local infusion, and intrathecal."@en ;
    rdfs:seeAlso <https://github.com/laBioSynCare/laBioSynCare.github.io/blob/main/docs/decisions/0035-participant-engagement-mode-and-endogenous-self-regulation.md> ;
    skos:member sstim-v:approachImplanted, sstim-v:approachIntracranial, sstim-v:approachEpidural,
        sstim-v:approachTargetedLocalInfusion, sstim-v:approachIntrathecal .

sstim-v:NeuralTargetSiteScheme a skos:ConceptScheme ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    skos:prefLabel "SSTIM Neural Target Site Vocabulary"@en ,
                   "Vocabolario dei Siti Bersaglio Neurali SSTIM"@it ,
                   "Vocabulário de Locais-Alvo Neurais SSTIM"@pt ,
                   "Vocabulario de Sitios Diana Neurales SSTIM"@es ;
    skos:definition "Controlled information categories for broad anatomical targets of stimulation. These classify a target; they are not the anatomical entities themselves."@en ;
    skos:scopeNote "A category may have more than one broader concept; no forced single-parent tree is required. External anatomy alignment is a separate, evidence-checked pass."@en ;
    skos:hasTopConcept sstim-v:targetCentralNervousSystem,
        sstim-v:targetPeripheralNervousSystem, sstim-v:targetCranialNerve .

sstim-v:targetCentralNervousSystem a owl:NamedIndividual, sstim:NeuralTargetSite, skos:Concept ;
    skos:inScheme sstim-v:NeuralTargetSiteScheme ;
    skos:topConceptOf sstim-v:NeuralTargetSiteScheme ;
    skos:narrower sstim-v:targetBrain, sstim-v:targetSpinalCord ;
    skos:prefLabel "central nervous system"@en,
                   "sistema nervoso centrale"@it,
                   "sistema nervoso central"@pt,
                   "sistema nervioso central"@es ;
    skos:notation "target-central-nervous-system" ;
    skos:definition "The brain and spinal cord as a broad stimulation target."@en .

sstim-v:targetBrain a owl:NamedIndividual, sstim:NeuralTargetSite, skos:Concept ;
    skos:inScheme sstim-v:NeuralTargetSiteScheme ;
    skos:broader sstim-v:targetCentralNervousSystem ;
    skos:narrower sstim-v:targetCortex, sstim-v:targetDeepBrainStructure ;
    skos:prefLabel "brain"@en,
                   "encefalo"@it,
                   "encéfalo"@pt,
                   "encéfalo"@es ;
    skos:notation "target-brain" ;
    skos:definition "The brain as a broad stimulation target."@en .

sstim-v:targetCortex a owl:NamedIndividual, sstim:NeuralTargetSite, skos:Concept ;
    skos:inScheme sstim-v:NeuralTargetSiteScheme ;
    skos:broader sstim-v:targetBrain ;
    skos:prefLabel "cortex"@en,
                   "corteccia"@it,
                   "córtex"@pt,
                   "corteza"@es ;
    skos:notation "target-cortex" ;
    skos:definition "Cortical tissue as a stimulation target."@en .

sstim-v:targetDeepBrainStructure a owl:NamedIndividual, sstim:NeuralTargetSite, skos:Concept ;
    skos:inScheme sstim-v:NeuralTargetSiteScheme ;
    skos:broader sstim-v:targetBrain ;
    skos:prefLabel "deep brain structure"@en,
                   "struttura cerebrale profonda"@it,
                   "estrutura cerebral profunda"@pt,
                   "estructura cerebral profunda"@es ;
    skos:notation "target-deep-brain-structure" ;
    skos:definition "A subcortical or deep brain structure as a stimulation target."@en .

sstim-v:targetSpinalCord a owl:NamedIndividual, sstim:NeuralTargetSite, skos:Concept ;
    skos:inScheme sstim-v:NeuralTargetSiteScheme ;
    skos:broader sstim-v:targetCentralNervousSystem ;
    skos:prefLabel "spinal cord"@en,
                   "midollo spinale"@it,
                   "medula espinal"@pt,
                   "médula espinal"@es ;
    skos:notation "target-spinal-cord" ;
    skos:definition "The spinal cord as a stimulation target."@en .

sstim-v:targetPeripheralNervousSystem a owl:NamedIndividual, sstim:NeuralTargetSite, skos:Concept ;
    skos:inScheme sstim-v:NeuralTargetSiteScheme ;
    skos:topConceptOf sstim-v:NeuralTargetSiteScheme ;
    skos:narrower sstim-v:targetPeripheralNerve ;
    skos:prefLabel "peripheral nervous system"@en,
                   "sistema nervoso periferico"@it,
                   "sistema nervoso periférico"@pt,
                   "sistema nervioso periférico"@es ;
    skos:notation "target-peripheral-nervous-system" ;
    skos:definition "Neural tissue outside the brain and spinal cord as a broad stimulation target."@en .

sstim-v:targetPeripheralNerve a owl:NamedIndividual, sstim:NeuralTargetSite, skos:Concept ;
    skos:inScheme sstim-v:NeuralTargetSiteScheme ;
    skos:broader sstim-v:targetPeripheralNervousSystem ;
    skos:prefLabel "peripheral nerve"@en,
                   "nervo periferico"@it,
                   "nervo periférico"@pt,
                   "nervio periférico"@es ;
    skos:notation "target-peripheral-nerve" ;
    skos:definition "A peripheral nerve as a stimulation target."@en .

sstim-v:targetCranialNerve a owl:NamedIndividual, sstim:NeuralTargetSite, skos:Concept ;
    skos:inScheme sstim-v:NeuralTargetSiteScheme ;
    skos:topConceptOf sstim-v:NeuralTargetSiteScheme ;
    skos:prefLabel "cranial nerve"@en,
                   "nervo cranico"@it,
                   "nervo craniano"@pt,
                   "nervio craneal"@es ;
    skos:notation "target-cranial-nerve" ;
    skos:definition "A cranial nerve as a stimulation target."@en ;
    skos:scopeNote "Kept as a separate seed category rather than a blanket child of the peripheral nervous system, because cranial-nerve anatomy is not uniformly peripheral."@en .

sstim-v:NeuralSystemScheme a skos:ConceptScheme ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    skos:prefLabel "SSTIM Neural System Vocabulary"@en ,
                   "Vocabolario dei Sistemi Neurali SSTIM"@it ,
                   "Vocabulário de Sistemas Neurais SSTIM"@pt ,
                   "Vocabulario de Sistemas Neurales SSTIM"@es ;
    skos:definition "Distributed organizational neural systems used as a target axis, aligned to but not identified with the sensory modality vocabulary."@en ;
    skos:scopeNote "This is the axis for neuromodulation OF a sensory system. It says nothing about the entry route: a cochlear or retinal neural interface targets a sensory system without using the canonical receptor route."@en ;
    skos:hasTopConcept sstim-v:systemSensory, sstim-v:systemMotor, sstim-v:systemAutonomic .

sstim-v:systemSensory a owl:NamedIndividual, sstim:NeuralSystem, skos:Concept ;
    skos:inScheme sstim-v:NeuralSystemScheme ;
    skos:topConceptOf sstim-v:NeuralSystemScheme ;
    skos:narrower sstim-v:systemAuditory, sstim-v:systemVisual, sstim-v:systemSomatosensory, sstim-v:systemOlfactory, sstim-v:systemGustatory, sstim-v:systemVestibular, sstim-v:systemProprioceptive, sstim-v:systemInteroceptive ;
    skos:prefLabel "sensory system"@en,
                   "sistema sensoriale"@it,
                   "sistema sensorial"@pt,
                   "sistema sensorial"@es ;
    skos:notation "system-sensory" ;
    skos:definition "The sensory nervous system as a distributed target."@en .

sstim-v:systemMotor a owl:NamedIndividual, sstim:NeuralSystem, skos:Concept ;
    skos:inScheme sstim-v:NeuralSystemScheme ;
    skos:topConceptOf sstim-v:NeuralSystemScheme ;
    skos:prefLabel "motor system"@en,
                   "sistema motorio"@it,
                   "sistema motor"@pt,
                   "sistema motor"@es ;
    skos:notation "system-motor" ;
    skos:definition "The motor nervous system as a distributed target."@en .

sstim-v:systemAutonomic a owl:NamedIndividual, sstim:NeuralSystem, skos:Concept ;
    skos:inScheme sstim-v:NeuralSystemScheme ;
    skos:topConceptOf sstim-v:NeuralSystemScheme ;
    skos:prefLabel "autonomic system"@en,
                   "sistema autonomo"@it,
                   "sistema autónomo"@pt,
                   "sistema autónomo"@es ;
    skos:notation "system-autonomic" ;
    skos:definition "The autonomic nervous system as a distributed target."@en .

sstim-v:systemAuditory a owl:NamedIndividual, sstim:NeuralSystem, skos:Concept ;
    skos:inScheme sstim-v:NeuralSystemScheme ;
    skos:broader sstim-v:systemSensory ;
    skos:prefLabel "auditory system"@en,
                   "sistema uditivo"@it,
                   "sistema auditivo"@pt,
                   "sistema auditivo"@es ;
    skos:notation "system-auditory" ;
    skos:definition "The auditory neural system as a distributed target."@en .

sstim-v:systemVisual a owl:NamedIndividual, sstim:NeuralSystem, skos:Concept ;
    skos:inScheme sstim-v:NeuralSystemScheme ;
    skos:broader sstim-v:systemSensory ;
    skos:prefLabel "visual system"@en,
                   "sistema visivo"@it,
                   "sistema visual"@pt,
                   "sistema visual"@es ;
    skos:notation "system-visual" ;
    skos:definition "The visual neural system as a distributed target."@en .

sstim-v:systemSomatosensory a owl:NamedIndividual, sstim:NeuralSystem, skos:Concept ;
    skos:inScheme sstim-v:NeuralSystemScheme ;
    skos:broader sstim-v:systemSensory ;
    skos:prefLabel "somatosensory system"@en,
                   "sistema somatosensoriale"@it,
                   "sistema somatossensorial"@pt,
                   "sistema somatosensorial"@es ;
    skos:notation "system-somatosensory" ;
    skos:definition "The somatosensory neural system as a distributed target."@en .

sstim-v:systemOlfactory a owl:NamedIndividual, sstim:NeuralSystem, skos:Concept ;
    skos:inScheme sstim-v:NeuralSystemScheme ;
    skos:broader sstim-v:systemSensory ;
    skos:prefLabel "olfactory system"@en,
                   "sistema olfattivo"@it,
                   "sistema olfativo"@pt,
                   "sistema olfativo"@es ;
    skos:notation "system-olfactory" ;
    skos:definition "The olfactory neural system as a distributed target."@en .

sstim-v:systemGustatory a owl:NamedIndividual, sstim:NeuralSystem, skos:Concept ;
    skos:inScheme sstim-v:NeuralSystemScheme ;
    skos:broader sstim-v:systemSensory ;
    skos:prefLabel "gustatory system"@en,
                   "sistema gustativo"@it,
                   "sistema gustativo"@pt,
                   "sistema gustativo"@es ;
    skos:notation "system-gustatory" ;
    skos:definition "The gustatory neural system as a distributed target."@en .

sstim-v:systemVestibular a owl:NamedIndividual, sstim:NeuralSystem, skos:Concept ;
    skos:inScheme sstim-v:NeuralSystemScheme ;
    skos:broader sstim-v:systemSensory ;
    skos:prefLabel "vestibular system"@en,
                   "sistema vestibolare"@it,
                   "sistema vestibular"@pt,
                   "sistema vestibular"@es ;
    skos:notation "system-vestibular" ;
    skos:definition "The vestibular neural system as a distributed target."@en .

sstim-v:systemProprioceptive a owl:NamedIndividual, sstim:NeuralSystem, skos:Concept ;
    skos:inScheme sstim-v:NeuralSystemScheme ;
    skos:broader sstim-v:systemSensory ;
    skos:prefLabel "proprioceptive system"@en,
                   "sistema propriocettivo"@it,
                   "sistema propriocetivo"@pt,
                   "sistema propioceptivo"@es ;
    skos:notation "system-proprioceptive" ;
    skos:definition "The proprioceptive neural system as a distributed target."@en .

sstim-v:systemInteroceptive a owl:NamedIndividual, sstim:NeuralSystem, skos:Concept ;
    skos:inScheme sstim-v:NeuralSystemScheme ;
    skos:broader sstim-v:systemSensory ;
    skos:prefLabel "interoceptive system"@en,
                   "sistema interocettivo"@it,
                   "sistema interocetivo"@pt,
                   "sistema interoceptivo"@es ;
    skos:notation "system-interoceptive" ;
    skos:definition "The interoceptive neural system as a distributed target."@en .

sstim-v:NeuralPhenomenonScheme a skos:ConceptScheme ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    skos:prefLabel "SSTIM Neural Phenomenon Vocabulary"@en ,
                   "Vocabolario dei Fenomeni Neurali SSTIM"@it ,
                   "Vocabulário de Fenómenos Neurais SSTIM"@pt ,
                   "Vocabulario de Fenómenos Neurales SSTIM"@es ;
    skos:definition "Coherent functional neural phenomena, reused across the proposed-mechanism, intended-target, and observed-outcome roles by three separate properties."@en ;
    skos:scopeNote "This scheme replaces any single target-level axis. A route, a dynamic, a system, and an outcome domain are not values on one scale, and an autonomic outcome can also be neural. Perceptual, cognitive, motor, physiological, and behavioural outcome domains are modelled separately and non-exclusively; a controlled vocabulary must not force false partitions to simplify a query."@en ;
    skos:hasTopConcept sstim-v:phenomenonExcitabilityOrFiring, sstim-v:phenomenonOscillatoryDynamics, sstim-v:phenomenonTemporalCoordination, sstim-v:phenomenonSynapticTransmission, sstim-v:phenomenonNeurochemicalSignaling, sstim-v:phenomenonConnectivityOrPlasticity, sstim-v:phenomenonAutonomicNeuralRegulation, sstim-v:phenomenonEvokedResponse, sstim-v:phenomenonReflexResponse .

sstim-v:phenomenonExcitabilityOrFiring a owl:NamedIndividual, sstim:NeuralPhenomenon, skos:Concept ;
    skos:inScheme sstim-v:NeuralPhenomenonScheme ;
    skos:topConceptOf sstim-v:NeuralPhenomenonScheme ;
    skos:prefLabel "excitability or firing"@en,
                   "eccitabilità o scarica"@it,
                   "excitabilidade ou disparo"@pt,
                   "excitabilidad o descarga"@es ;
    skos:notation "phenomenon-excitability-or-firing" ;
    skos:definition "Change in neuronal excitability or firing."@en .

sstim-v:phenomenonOscillatoryDynamics a owl:NamedIndividual, sstim:NeuralPhenomenon, skos:Concept ;
    skos:inScheme sstim-v:NeuralPhenomenonScheme ;
    skos:topConceptOf sstim-v:NeuralPhenomenonScheme ;
    skos:prefLabel "oscillatory dynamics"@en,
                   "dinamiche oscillatorie"@it,
                   "dinâmicas oscilatórias"@pt,
                   "dinámicas oscilatorias"@es ;
    skos:notation "phenomenon-oscillatory-dynamics" ;
    skos:definition "Change in the amplitude, frequency, or phase of neural oscillations."@en .

sstim-v:phenomenonTemporalCoordination a owl:NamedIndividual, sstim:NeuralPhenomenon, skos:Concept ;
    skos:inScheme sstim-v:NeuralPhenomenonScheme ;
    skos:topConceptOf sstim-v:NeuralPhenomenonScheme ;
    skos:prefLabel "temporal coordination"@en,
                   "coordinazione temporale"@it,
                   "coordenação temporal"@pt,
                   "coordinación temporal"@es ;
    skos:notation "phenomenon-temporal-coordination" ;
    skos:definition "Change in the temporal alignment or coordination of neural activity."@en .

sstim-v:phenomenonSynapticTransmission a owl:NamedIndividual, sstim:NeuralPhenomenon, skos:Concept ;
    skos:inScheme sstim-v:NeuralPhenomenonScheme ;
    skos:topConceptOf sstim-v:NeuralPhenomenonScheme ;
    skos:prefLabel "synaptic transmission"@en,
                   "trasmissione sinaptica"@it,
                   "transmissão sináptica"@pt,
                   "transmisión sináptica"@es ;
    skos:notation "phenomenon-synaptic-transmission" ;
    skos:definition "Change in synaptic transmission."@en .

sstim-v:phenomenonNeurochemicalSignaling a owl:NamedIndividual, sstim:NeuralPhenomenon, skos:Concept ;
    skos:inScheme sstim-v:NeuralPhenomenonScheme ;
    skos:topConceptOf sstim-v:NeuralPhenomenonScheme ;
    skos:prefLabel "neurochemical signaling"@en,
                   "segnalazione neurochimica"@it,
                   "sinalização neuroquímica"@pt,
                   "señalización neuroquímica"@es ;
    skos:notation "phenomenon-neurochemical-signaling" ;
    skos:definition "Change in neurochemical or neurotransmitter signaling."@en .

sstim-v:phenomenonConnectivityOrPlasticity a owl:NamedIndividual, sstim:NeuralPhenomenon, skos:Concept ;
    skos:inScheme sstim-v:NeuralPhenomenonScheme ;
    skos:topConceptOf sstim-v:NeuralPhenomenonScheme ;
    skos:prefLabel "connectivity or plasticity"@en,
                   "connettività o plasticità"@it,
                   "conetividade ou plasticidade"@pt,
                   "conectividad o plasticidad"@es ;
    skos:notation "phenomenon-connectivity-or-plasticity" ;
    skos:definition "Change in functional connectivity or in plasticity."@en .

sstim-v:phenomenonAutonomicNeuralRegulation a owl:NamedIndividual, sstim:NeuralPhenomenon, skos:Concept ;
    skos:inScheme sstim-v:NeuralPhenomenonScheme ;
    skos:topConceptOf sstim-v:NeuralPhenomenonScheme ;
    skos:prefLabel "autonomic neural regulation"@en,
                   "regolazione neurale autonoma"@it,
                   "regulação neural autónoma"@pt,
                   "regulación neural autónoma"@es ;
    skos:notation "phenomenon-autonomic-neural-regulation" ;
    skos:definition "Change in autonomic neural regulation."@en .

sstim-v:temporalContinuousTonic a owl:NamedIndividual, sstim:StimulusTemporalStructure, skos:Concept ;
    skos:inScheme sstim-v:StimulusTemporalStructureScheme ;
    skos:topConceptOf sstim-v:StimulusTemporalStructureScheme ;
    skos:prefLabel "Continuous / Tonic"@en, "Continuo/Tonico"@it, "Contínuo/Tónico"@pt, "Continuo/Tónico"@es ;
    skos:notation "temporal-continuous-tonic" ;
    skos:definition "Applied continuously at a sustained level rather than as discrete events, such as a constant direct current."@en .

sstim-v:temporalSingleEvent a owl:NamedIndividual, sstim:StimulusTemporalStructure, skos:Concept ;
    skos:inScheme sstim-v:StimulusTemporalStructureScheme ;
    skos:topConceptOf sstim-v:StimulusTemporalStructureScheme ;
    skos:prefLabel "Single Event"@en, "Evento Singolo"@it, "Evento Único"@pt, "Evento Único"@es ;
    skos:notation "temporal-single-event" ;
    skos:definition "A single discrete application, such as one pulse."@en .

sstim-v:temporalPulseTrainOrBurst a owl:NamedIndividual, sstim:StimulusTemporalStructure, skos:Concept ;
    skos:inScheme sstim-v:StimulusTemporalStructureScheme ;
    skos:topConceptOf sstim-v:StimulusTemporalStructureScheme ;
    skos:prefLabel "Pulse Train / Burst"@en, "Treno di Impulsi/Raffica"@it, "Trem de Impulsos/Rajada"@pt, "Tren de Pulsos/Ráfaga"@es ;
    skos:notation "temporal-pulse-train-or-burst" ;
    skos:definition "Discrete pulses delivered in trains or bursts."@en ;
    skos:scopeNote "Combinable with a carrier periodicity value: a pulse train may itself be periodic or irregular."@en .

sstim-v:temporalIntermittentScheduled a owl:NamedIndividual, sstim:StimulusTemporalStructure, skos:Concept ;
    skos:inScheme sstim-v:StimulusTemporalStructureScheme ;
    skos:topConceptOf sstim-v:StimulusTemporalStructureScheme ;
    skos:prefLabel "Intermittent / Scheduled"@en, "Intermittente/Programmato"@it, "Intermitente/Programado"@pt, "Intermitente/Programado"@es ;
    skos:notation "temporal-intermittent-scheduled" ;
    skos:definition "Applied in separated episodes on a schedule rather than continuously."@en .

sstim-v:temporalBolus a owl:NamedIndividual, sstim:StimulusTemporalStructure, skos:Concept ;
    skos:inScheme sstim-v:StimulusTemporalStructureScheme ;
    skos:topConceptOf sstim-v:StimulusTemporalStructureScheme ;
    skos:prefLabel "Bolus"@en, "Bolo"@it, "Bólus"@pt, "Bolo"@es ;
    skos:notation "temporal-bolus" ;
    skos:definition "An agent administered as a single discrete dose."@en .

sstim-v:temporalContinuousInfusion a owl:NamedIndividual, sstim:StimulusTemporalStructure, skos:Concept ;
    skos:inScheme sstim-v:StimulusTemporalStructureScheme ;
    skos:topConceptOf sstim-v:StimulusTemporalStructureScheme ;
    skos:prefLabel "Continuous Infusion"@en, "Infusione Continua"@it, "Infusão Contínua"@pt, "Infusión Continua"@es ;
    skos:notation "temporal-continuous-infusion" ;
    skos:definition "An agent administered continuously over time."@en .

sstim-v:phenomenonEvokedResponse a owl:NamedIndividual, sstim:NeuralPhenomenon, skos:Concept ;
    skos:inScheme sstim-v:NeuralPhenomenonScheme ;
    skos:topConceptOf sstim-v:NeuralPhenomenonScheme ;
    skos:narrower sstim-v:phenomenonFrequencyFollowingResponse, sstim-v:phenomenonAuditorySteadyStateResponse, sstim-v:phenomenonVisualSteadyStateResponse, sstim-v:phenomenonSomatosensorySteadyStateResponse ;
    skos:prefLabel "evoked or driven response"@en,
                   "risposta evocata o indotta"@it,
                   "resposta evocada ou induzida"@pt,
                   "respuesta evocada o inducida"@es ;
    skos:notation "phenomenon-evoked-response" ;
    skos:definition "A neural response evoked or driven by an applied stimulus."@en ;
    skos:scopeNote "These are response forms, not causal mechanisms. They replace the mechanism-scheme entries deprecated in 0.9.0: a measurable evoked response describes what happens, while how it arises remains a separate mechanism and evidence question."@en .

sstim-v:phenomenonFrequencyFollowingResponse a owl:NamedIndividual, sstim:NeuralPhenomenon, skos:Concept ;
    skos:inScheme sstim-v:NeuralPhenomenonScheme ;
    skos:broader sstim-v:phenomenonEvokedResponse ;
    skos:prefLabel "frequency-following response"@en,
                   "risposta di inseguimento della frequenza"@it,
                   "resposta de seguimento de frequência"@pt,
                   "respuesta de seguimiento de frecuencia"@es ;
    skos:notation "phenomenon-frequency-following-response" ;
    skos:definition "A neural response that follows the periodicity of an applied stimulus."@en .

sstim-v:phenomenonAuditorySteadyStateResponse a owl:NamedIndividual, sstim:NeuralPhenomenon, skos:Concept ;
    skos:inScheme sstim-v:NeuralPhenomenonScheme ;
    skos:broader sstim-v:phenomenonEvokedResponse ;
    skos:prefLabel "auditory steady-state response"@en,
                   "risposta uditiva di stato stazionario"@it,
                   "resposta auditiva de estado estacionário"@pt,
                   "respuesta auditiva de estado estacionario"@es ;
    skos:notation "phenomenon-auditory-steady-state-response" ;
    skos:definition "A steady-state neural response frequency-tagged to a periodic auditory stimulus."@en .

sstim-v:phenomenonVisualSteadyStateResponse a owl:NamedIndividual, sstim:NeuralPhenomenon, skos:Concept ;
    skos:inScheme sstim-v:NeuralPhenomenonScheme ;
    skos:broader sstim-v:phenomenonEvokedResponse ;
    skos:prefLabel "visual steady-state response"@en,
                   "risposta visiva di stato stazionario"@it,
                   "resposta visual de estado estacionário"@pt,
                   "respuesta visual de estado estacionario"@es ;
    skos:notation "phenomenon-visual-steady-state-response" ;
    skos:definition "A steady-state neural response frequency-tagged to a periodic visual stimulus."@en .

sstim-v:phenomenonSomatosensorySteadyStateResponse a owl:NamedIndividual, sstim:NeuralPhenomenon, skos:Concept ;
    skos:inScheme sstim-v:NeuralPhenomenonScheme ;
    skos:broader sstim-v:phenomenonEvokedResponse ;
    skos:prefLabel "somatosensory steady-state response"@en,
                   "risposta somatosensoriale di stato stazionario"@it,
                   "resposta somatossensorial de estado estacionário"@pt,
                   "respuesta somatosensorial de estado estacionario"@es ;
    skos:notation "phenomenon-somatosensory-steady-state-response" ;
    skos:definition "A steady-state neural response frequency-tagged to a periodic somatosensory stimulus."@en .

sstim-v:phenomenonReflexResponse a owl:NamedIndividual, sstim:NeuralPhenomenon, skos:Concept ;
    skos:inScheme sstim-v:NeuralPhenomenonScheme ;
    skos:topConceptOf sstim-v:NeuralPhenomenonScheme ;
    skos:narrower sstim-v:phenomenonAcousticStartleReflex ;
    skos:prefLabel "reflex response"@en,
                   "risposta riflessa"@it,
                   "resposta reflexa"@pt,
                   "respuesta refleja"@es ;
    skos:notation "phenomenon-reflex-response" ;
    skos:definition "A reflex response elicited by an applied stimulus."@en .

sstim-v:phenomenonAcousticStartleReflex a owl:NamedIndividual, sstim:NeuralPhenomenon, skos:Concept ;
    skos:inScheme sstim-v:NeuralPhenomenonScheme ;
    skos:broader sstim-v:phenomenonReflexResponse ;
    skos:prefLabel "acoustic startle reflex"@en,
                   "riflesso di trasalimento acustico"@it,
                   "reflexo de sobressalto acústico"@pt,
                   "reflejo de sobresalto acústico"@es ;
    skos:notation "phenomenon-acoustic-startle-reflex" ;
    skos:definition "The startle reflex elicited by a sudden intense acoustic stimulus."@en .

# ADR 0036: names "neuromodulation-as-effect" WITHOUT minting a class. A SKOS
# collection grouping the state-change neural phenomena — the outcomes that
# constitute an ongoing or lasting modulation of neural state — and deliberately
# EXCLUDING the evoked/driven and reflex responses, which are the nervous system
# following a stimulus rather than a modulation of its state. The effect sense
# stays a facet over sstim:outcomeNeuralPhenomenon; this collection is the
# queryable, legible handle (ADR 0036 Q2).
sstim-v:NeuromodulatoryEffectCollection a skos:Collection ;
    rdfs:label "Neuromodulatory effect (neural phenomena)"@en ;
    skos:definition "The state-change neural phenomena that constitute a neuromodulatory effect when asserted in the outcome role (sstim:outcomeNeuralPhenomenon): changes in excitability or firing, oscillatory dynamics, temporal coordination, synaptic transmission, neurochemical signaling, connectivity or plasticity, and autonomic neural regulation. Evoked or driven responses and reflex responses are excluded: they are the nervous system following a stimulus, not a modulation of its state (ADR 0036)."@en ;
    rdfs:seeAlso <https://github.com/laBioSynCare/laBioSynCare.github.io/blob/main/docs/decisions/0036-neurostimulation-neuromodulation-senses-and-self-directed-split.md> ;
    skos:member sstim-v:phenomenonExcitabilityOrFiring, sstim-v:phenomenonOscillatoryDynamics,
        sstim-v:phenomenonTemporalCoordination, sstim-v:phenomenonSynapticTransmission,
        sstim-v:phenomenonNeurochemicalSignaling, sstim-v:phenomenonConnectivityOrPlasticity,
        sstim-v:phenomenonAutonomicNeuralRegulation .


###########################################################################
# Part 12b — Participant Engagement Mode Facet (ADR 0035)
#
# The sixth facet, orthogonal to the five ADR 0034 axes. It answers a question
# none of them does: how much active participation does the method demand of the
# individual? Raised in the 2026-07-22 Theo Marins interview, from the
# observation that neurofeedback, biofeedback, meditation, and breathwork are set
# apart from receptive stimulation by requiring the individual's own engagement.
###########################################################################

sstim-v:ParticipantEngagementModeScheme a skos:ConceptScheme ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    skos:prefLabel "SSTIM Participant Engagement Mode Vocabulary"@en ,
                   "Vocabolario delle Modalità di Coinvolgimento del Partecipante SSTIM"@it ,
                   "Vocabulário de Modos de Envolvimento do Participante SSTIM"@pt ,
                   "Vocabulario de Modos de Participación del Participante SSTIM"@es ;
    skos:definition "The degree and kind of active participation a method requires of the individual, from passive reception through cue-following to active self-regulation."@en ;
    skos:scopeNote "A single coarse ordinal-ish axis, deliberately orthogonal to route, approach, target site, system, and phenomenon (ADR 0034). Engagement mode is a property of the method, not a claim about efficacy, and does not by itself decide whether a method is neuromodulation (ADR 0035)."@en ;
    rdfs:seeAlso <https://github.com/laBioSynCare/laBioSynCare.github.io/blob/main/docs/decisions/0035-participant-engagement-mode-and-endogenous-self-regulation.md> ;
    skos:hasTopConcept sstim-v:engagementPassiveReceptive, sstim-v:engagementGuidedFollowing,
        sstim-v:engagementActiveSelfRegulatory .

sstim-v:engagementPassiveReceptive a owl:NamedIndividual, sstim:ParticipantEngagementMode, skos:Concept ;
    skos:inScheme sstim-v:ParticipantEngagementModeScheme ;
    skos:topConceptOf sstim-v:ParticipantEngagementModeScheme ;
    skos:prefLabel "Passive / Receptive"@en, "Passivo / Ricettivo"@it,
                   "Passivo / Recetivo"@pt, "Pasivo / Receptivo"@es ;
    skos:notation "engagement-passive-receptive" ;
    skos:definition "The method delivers to a receptive individual who is not required to act on their own state — for example binaural beats played to a resting listener, photic driving, or an anaesthetised recipient of ECT. A closed-loop automated system (such as sleep-phase-locked auditory stimulation) is still passive when the individual does not self-regulate."@en .

sstim-v:engagementGuidedFollowing a owl:NamedIndividual, sstim:ParticipantEngagementMode, skos:Concept ;
    skos:inScheme sstim-v:ParticipantEngagementModeScheme ;
    skos:topConceptOf sstim-v:ParticipantEngagementModeScheme ;
    skos:prefLabel "Guided / Cue-Following"@en, "Guidato / A Seguito di Segnale"@it,
                   "Guiado / A Seguir Sinal"@pt, "Guiado / Siguiendo Señal"@es ;
    skos:notation "engagement-guided-following" ;
    skos:definition "The individual actively follows an external pacing cue but does not regulate from their own internal feedback — for example following BSC's Martigli paced-breathing guidance or a movement cue. Between passive reception and self-regulation."@en .

sstim-v:engagementActiveSelfRegulatory a owl:NamedIndividual, sstim:ParticipantEngagementMode, skos:Concept ;
    skos:inScheme sstim-v:ParticipantEngagementModeScheme ;
    skos:topConceptOf sstim-v:ParticipantEngagementModeScheme ;
    skos:prefLabel "Active / Self-Regulatory"@en, "Attivo / Autoregolatorio"@it,
                   "Ativo / Autorregulatório"@pt, "Activo / Autorregulatorio"@es ;
    skos:notation "engagement-active-self-regulatory" ;
    skos:definition "The method's mechanism requires the individual to actively regulate their own state, typically toward a goal they perceive — for example meditation, volitional breathwork, neurofeedback, and biofeedback. The modulation is produced endogenously by the individual, which is the crux discussed in ADR 0035."@en .

# ── ADR 0034: non-sensory neuromodulation contrast set ──────────────────
# Catalogued so the ontology can DESCRIBE these boundary methods, and so the
# neural-access-route axis is exercised across three distinct routes rather
# than left single-valued. None is referenced by any BSC preset, framework,
# protocol, or implementation, and none is linked by definesTechnique or
# incorporatesTechnique: inclusion asserts neither BSC Lab capability, nor
# efficacy, nor safety. Characteristic delivery media are asserted in the
# sstim-technique-exposure.ttl bridge, which depends on both concerns.

sstim-v:techRepetitiveTMS a owl:NamedIndividual, sstim:NeuromodulationTechnique, sstim:NeurostimulationTechnique, skos:Concept ;
    skos:inScheme sstim-v:TechniqueScheme ;
    skos:prefLabel "Repetitive Transcranial Magnetic Stimulation"@en,
                   "Stimolazione Magnetica Transcranica Ripetitiva"@it,
                   "Estimulação Magnética Transcraniana Repetitiva"@pt,
                   "Estimulación Magnética Transcraneal Repetitiva"@es ;
    skos:notation "repetitive-tms" ;
    skos:definition "Repeated magnetic pulses applied by a coil over the scalp, inducing an electric field in underlying tissue, with the objective of altering cortical activity or excitability."@en ;
    skos:scopeNote "Typed as neuromodulation because the modulation objective is definitional for the repetitive protocol. A single-pulse probe used only to elicit and measure a response is stimulation without being neuromodulation, since measuring is not modulating. The induced electric field is an established physical transformation and belongs in the exposure or device description, not in a proposed mechanism; how that field produces a neural response remains an evidence question."@en ;
    sstim:hasStimulusTemporalStructure sstim-v:temporalPulseTrainOrBurst ;
    sstim:neuralAccessRoute sstim-v:routePhysicalNeuralInteraction ;
    sstim:stimulationDeliveryApproach sstim-v:approachExternal, sstim-v:approachTranscranial ;
    sstim:intendedNeuralTargetSite sstim-v:targetBrain, sstim-v:targetCortex ;
    sstim:intendedNeuralPhenomenon sstim-v:phenomenonExcitabilityOrFiring ;
    skos:editorialNote "Catalogued for domain completeness. Not deliverable by BSC Lab and not consumer-platform feasible."@en .

sstim-v:techTDCS a owl:NamedIndividual, sstim:NeuromodulationTechnique, sstim:NeurostimulationTechnique, skos:Concept ;
    skos:inScheme sstim-v:TechniqueScheme ;
    skos:prefLabel "Transcranial Direct Current Stimulation"@en,
                   "Stimolazione Transcranica a Corrente Continua"@it,
                   "Estimulação Transcraniana por Corrente Contínua"@pt,
                   "Estimulación Transcraneal por Corriente Continua"@es ;
    skos:notation "tdcs" ;
    skos:definition "A weak constant electric current applied through scalp electrodes with the objective of altering cortical excitability."@en ;
    skos:scopeNote "Applied electric current is not by itself brain stimulation — peripheral, muscular, and cardiac applications share the medium and are separated here by route, approach, and target."@en ;
    sstim:hasStimulusTemporalStructure sstim-v:temporalContinuousTonic ;
    sstim:neuralAccessRoute sstim-v:routePhysicalNeuralInteraction ;
    sstim:stimulationDeliveryApproach sstim-v:approachExternal, sstim-v:approachTranscutaneous, sstim-v:approachTranscranial ;
    sstim:intendedNeuralTargetSite sstim-v:targetBrain, sstim-v:targetCortex ;
    sstim:intendedNeuralPhenomenon sstim-v:phenomenonExcitabilityOrFiring ;
    skos:editorialNote "Catalogued for domain completeness. Not deliverable by BSC Lab."@en .

sstim-v:techTACS a owl:NamedIndividual, sstim:NeuromodulationTechnique, sstim:NeurostimulationTechnique, skos:Concept ;
    skos:inScheme sstim-v:TechniqueScheme ;
    skos:prefLabel "Transcranial Alternating Current Stimulation"@en,
                   "Stimolazione Transcranica a Corrente Alternata"@it,
                   "Estimulação Transcraniana por Corrente Alternada"@pt,
                   "Estimulación Transcraneal por Corriente Alterna"@es ;
    skos:notation "tacs" ;
    skos:definition "An oscillating electric current applied through scalp electrodes with the objective of altering the amplitude, frequency, or phase of cortical oscillations."@en ;
    skos:scopeNote "The direct non-sensory analogue of sensory entrainment: periodic, and targeting oscillatory dynamics. Its intended route is a physical cortical interaction, but reported effects can also arise through transcutaneous peripheral-nerve stimulation. That competing account is an evidence question, recorded on an outcome concept via sstim:outcomeNeuralTargetSite, and it never rewrites this declared intended route."@en ;
    sstim:hasStimulusTemporalStructure sstim-v:temporalPeriodic ;
    sstim:neuralAccessRoute sstim-v:routePhysicalNeuralInteraction ;
    sstim:stimulationDeliveryApproach sstim-v:approachExternal, sstim-v:approachTranscutaneous, sstim-v:approachTranscranial ;
    sstim:intendedNeuralTargetSite sstim-v:targetBrain, sstim-v:targetCortex ;
    sstim:intendedNeuralPhenomenon sstim-v:phenomenonOscillatoryDynamics ;
    skos:editorialNote "Catalogued for domain completeness. Not deliverable by BSC Lab."@en .

sstim-v:techDBS a owl:NamedIndividual, sstim:NeuromodulationTechnique, sstim:NeurostimulationTechnique, skos:Concept ;
    skos:inScheme sstim-v:TechniqueScheme ;
    skos:prefLabel "Deep Brain Stimulation"@en,
                   "Stimolazione Cerebrale Profonda"@it,
                   "Estimulação Cerebral Profunda"@pt,
                   "Estimulación Cerebral Profunda"@es ;
    skos:notation "dbs" ;
    skos:definition "Electrical stimulation delivered by surgically implanted intracranial electrodes to a deep brain structure with the objective of altering its activity."@en ;
    skos:scopeNote "A clinical neurosurgical method, catalogued so the ontology can describe the implanted-electrode route. It is emphatically outside any consumer or wellness context."@en ;
    sstim:hasStimulusTemporalStructure sstim-v:temporalPulseTrainOrBurst ;
    sstim:neuralAccessRoute sstim-v:routePhysicalNeuralInteraction ;
    sstim:stimulationDeliveryApproach sstim-v:approachImplanted, sstim-v:approachIntracranial ;
    sstim:intendedNeuralTargetSite sstim-v:targetDeepBrainStructure ;
    sstim:intendedNeuralPhenomenon sstim-v:phenomenonExcitabilityOrFiring ;
    skos:editorialNote "Catalogued for domain completeness. Not deliverable by BSC Lab and outside its scope entirely."@en .

sstim-v:techVagusNerveStimulation a owl:NamedIndividual, sstim:NeuromodulationTechnique, sstim:NeurostimulationTechnique, skos:Concept ;
    skos:inScheme sstim-v:TechniqueScheme ;
    skos:prefLabel "Vagus Nerve Stimulation"@en,
                   "Stimolazione del Nervo Vago"@it,
                   "Estimulação do Nervo Vago"@pt,
                   "Estimulación del Nervio Vago"@es ;
    skos:notation "vagus-nerve-stimulation" ;
    skos:definition "Electrical stimulation of the vagus nerve, by an implanted device or through the skin at an accessible branch, with the objective of altering autonomic neural regulation."@en ;
    skos:scopeNote "Shows why route, approach, and target must stay independent: implanted and transcutaneous variants share a target and a route while differing in approach. Targeting a cranial nerve and the autonomic system says nothing about entering through a sensory system."@en ;
    sstim:hasStimulusTemporalStructure sstim-v:temporalPulseTrainOrBurst ;
    sstim:neuralAccessRoute sstim-v:routePhysicalNeuralInteraction ;
    sstim:stimulationDeliveryApproach sstim-v:approachImplanted, sstim-v:approachExternal, sstim-v:approachTranscutaneous ;
    sstim:intendedNeuralTargetSite sstim-v:targetCranialNerve ;
    sstim:intendedNeuralSystem sstim-v:systemAutonomic ;
    sstim:intendedNeuralPhenomenon sstim-v:phenomenonAutonomicNeuralRegulation ;
    skos:editorialNote "Catalogued for domain completeness. Not deliverable by BSC Lab."@en .

sstim-v:techIntrathecalNeuromodulatoryAgentDelivery a owl:NamedIndividual, sstim:NeuromodulationTechnique, skos:Concept ;
    skos:inScheme sstim-v:TechniqueScheme ;
    skos:prefLabel "Targeted Intrathecal Neuromodulatory Agent Delivery"@en,
                   "Somministrazione Intratecale Mirata di Agente Neuromodulatore"@it,
                   "Administração Intratecal Dirigida de Agente Neuromodulador"@pt,
                   "Administración Intratecal Dirigida de Agente Neuromodulador"@es ;
    skos:notation "intrathecal-neuromodulatory-agent-delivery" ;
    skos:definition "Infusion of a neuromodulatory agent into the intrathecal space, targeted at an identified central nervous system site with the objective of altering its activity or function."@en ;
    skos:scopeNote "The populated chemical example, included because an empty route category would not demonstrate that the model works. It qualifies as neuromodulation only because the neuromodulatory objective and the identified neural target are definitional; ordinary systemic neuroactive pharmacotherapy does not qualify, since drug administration alone is insufficient."@en ;
    sstim:hasStimulusTemporalStructure sstim-v:temporalContinuousInfusion ;
    sstim:neuralAccessRoute sstim-v:routeBiochemicalPharmacologicalNeuralInteraction ;
    sstim:stimulationDeliveryApproach sstim-v:approachTargetedLocalInfusion, sstim-v:approachIntrathecal ;
    sstim:intendedNeuralTargetSite sstim-v:targetCentralNervousSystem, sstim-v:targetSpinalCord ;
    sstim:intendedNeuralPhenomenon sstim-v:phenomenonNeurochemicalSignaling ;
    skos:editorialNote "Catalogued for domain completeness. A clinical method, not deliverable by BSC Lab."@en .

# ADR 0035: electroconvulsive therapy, added at the suggestion of Theo Marins
# (2026-07-22). It completes the contrast set's coverage of the established
# convulsive branch of brain-stimulation therapies and, as the recipient is
# anaesthetised, exercises the passive extreme of the new engagement axis.
sstim-v:techElectroconvulsiveTherapy a owl:NamedIndividual, sstim:NeuromodulationTechnique, sstim:NeurostimulationTechnique, skos:Concept ;
    skos:inScheme sstim-v:TechniqueScheme ;
    skos:prefLabel "Electroconvulsive Therapy"@en,
                   "Terapia Elettroconvulsivante"@it,
                   "Eletroconvulsoterapia"@pt,
                   "Terapia Electroconvulsiva"@es ;
    skos:notation "electroconvulsive-therapy" ;
    skos:definition "Brief electrical stimulation applied through scalp electrodes to deliberately induce a generalized seizure under anaesthesia, with the objective of altering brain activity."@en ;
    skos:scopeNote "A clinical psychiatric neuromodulation method, catalogued only so the ontology can describe the convulsive branch of established brain-stimulation therapy. Emphatically outside any consumer or wellness context and not deliverable by BSC Lab. The induced seizure is the deliberate mechanism, which separates it from stimulation applied merely to probe a response; efficacy and safety remain evidence questions this catalogue does not answer."@en ;
    sstim:hasStimulusTemporalStructure sstim-v:temporalPulseTrainOrBurst ;
    sstim:neuralAccessRoute sstim-v:routePhysicalNeuralInteraction ;
    sstim:stimulationDeliveryApproach sstim-v:approachExternal, sstim-v:approachTranscutaneous, sstim-v:approachTranscranial ;
    sstim:intendedNeuralTargetSite sstim-v:targetBrain ;
    sstim:intendedNeuralPhenomenon sstim-v:phenomenonExcitabilityOrFiring ;
    sstim:participantEngagementMode sstim-v:engagementPassiveReceptive ;
    skos:editorialNote "Catalogued for domain completeness at the suggestion of Theo Marins (2026-07-22 interview, ADR 0035). Not deliverable by BSC Lab and outside its scope entirely."@en .


# ── ADR 0035: closed-loop self-regulation techniques ────────────────────
# Neurofeedback and biofeedback. Theo Marins (2026-07-22) places both closer to
# neuromodulation than to neurostimulation. They are typed at the NEUTRAL
# sstim:StimulationTechnique layer, not as sstim:NeuromodulationTechnique or
# sstim:SensoryStimulationTechnique: the feedback signal enters through canonical
# sensory transduction, yet the modulation is produced by the individual's own
# endogenous self-regulation, which the current sstim:Neuromodulation definition
# excludes. Neutral typing records the method without prejudging that scope
# question, which ADR 0035 keeps open rather than reopening ADR 0034's frozen
# 0.9.0 decision. They exercise the active extreme of the engagement axis.

sstim-v:techNeurofeedback a owl:NamedIndividual, sstim:NeuromodulationTechnique, skos:Concept ;
    skos:inScheme sstim-v:TechniqueScheme ;
    skos:prefLabel "Neurofeedback"@en,
                   "Neurofeedback"@it,
                   "Neurofeedback"@pt,
                   "Neurofeedback"@es ;
    skos:notation "neurofeedback" ;
    skos:definition "A closed-loop practice in which a measured brain signal (typically EEG) is rendered back to the individual as sensory feedback so that they can learn to self-regulate that neural activity."@en ;
    skos:scopeNote "Self-directed neuromodulation (ADR 0036): a neuromodulation technique whose agency is the individual's own regulation, marked by the active-self-regulatory engagement mode. The feedback enters through canonical sensory transduction (its declared route) and is presented externally; the neural change itself is the intended effect, recorded on the outcome facet, not asserted as achieved here. Theo Marins (2026-07-22) placed neurofeedback closer to neuromodulation than to neurostimulation, which ADR 0036 adopts."@en ;
    sstim:hasStimulusTemporalStructure sstim-v:temporalAdaptive ;
    sstim:neuralAccessRoute sstim-v:routeCanonicalSensoryTransductionAfferent ;
    sstim:stimulationDeliveryApproach sstim-v:approachExternal ;
    sstim:intendedNeuralTargetSite sstim-v:targetBrain, sstim-v:targetCortex ;
    sstim:participantEngagementMode sstim-v:engagementActiveSelfRegulatory ;
    skos:related sstim-v:techSonification, sstim-v:techClosedLoopAuditory ;
    skos:editorialNote "Added from the 2026-07-22 Theo Marins interview; typed as self-directed neuromodulation by ADR 0036."@en .

sstim-v:techBiofeedback a owl:NamedIndividual, sstim:NeuromodulationTechnique, skos:Concept ;
    skos:inScheme sstim-v:TechniqueScheme ;
    skos:prefLabel "Biofeedback"@en,
                   "Biofeedback"@it,
                   "Biofeedback"@pt,
                   "Biofeedback"@es ;
    skos:notation "biofeedback" ;
    skos:definition "A closed-loop practice in which a measured physiological signal (heart rate, heart-rate variability, respiration, muscle tension, or skin conductance) is rendered back to the individual as sensory feedback so that they can learn to self-regulate that function."@en ;
    skos:scopeNote "Self-directed neuromodulation (ADR 0036), marked by the active-self-regulatory engagement mode. Its neuromodulation status is clearest for autonomically mediated forms — heart-rate-variability biofeedback trains vagal and baroreflex regulation; peripheral forms such as EMG muscle biofeedback sit closer to motor self-regulation than to neural modulation, so the neural target is recorded broadly. Auditory biofeedback is the sonification case (sstim-v:techSonification); HRV/paced-breathing biofeedback connects to BSC's Martigli breathing component. Theo Marins (2026-07-22) placed biofeedback closer to neuromodulation than to neurostimulation, which ADR 0036 adopts."@en ;
    skos:editorialNote "Deliberately kept as one neutral technique rather than split into narrower neural-only and peripheral-only variants (ADR 0037, RDF-05 of the 2026-07-24 audit): the neural-modulation objective is not equally definitional across its autonomic, muscular, and electrodermal forms, so a narrower neuromodulation-only subtype would misrepresent the peripheral cases. sstim:techNeurofeedback already exists as the separate, narrower technique for which the neural-modulation objective is definitional."@en ;
    sstim:hasStimulusTemporalStructure sstim-v:temporalAdaptive ;
    sstim:neuralAccessRoute sstim-v:routeCanonicalSensoryTransductionAfferent ;
    sstim:stimulationDeliveryApproach sstim-v:approachExternal ;
    sstim:intendedNeuralTargetSite sstim-v:targetPeripheralNervousSystem ;
    sstim:intendedNeuralSystem sstim-v:systemAutonomic ;
    sstim:participantEngagementMode sstim-v:engagementActiveSelfRegulatory ;
    skos:related sstim-v:techSonification ;
    skos:editorialNote "Added from the 2026-07-22 Theo Marins interview; typed as self-directed neuromodulation by ADR 0036."@en .


###########################################################################
# Observation role scheme
#
# What a participant observation observes. Added 2026-08-13 (ADR 0048).
# Every role here is answerable by a participant about their own experience;
# none is an outcome measurement, and none belongs to a clinician.
###########################################################################

sstim-v:ObservationRoleScheme a skos:ConceptScheme ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    skos:prefLabel "SSTIM Observation Role Vocabulary"@en ;
    skos:definition "Controlled categories of what a qualified participant observation observes."@en ;
    skos:hasTopConcept sstim-v:roleStatedGoal, sstim-v:rolePerceivedHelpfulness,
        sstim-v:rolePrimaryAffect, sstim-v:roleFocus, sstim-v:roleSleepiness,
        sstim-v:roleSubjectiveQuality, sstim-v:roleGoalAchieved,
        sstim-v:roleUnwantedExperienceReport .

sstim-v:roleStatedGoal a owl:NamedIndividual, sstim:ObservationRole, skos:Concept ;
    skos:inScheme sstim-v:ObservationRoleScheme ;
    skos:topConceptOf sstim-v:ObservationRoleScheme ;
    skos:prefLabel "Stated goal"@en, "Obiettivo dichiarato"@it,
        "Objetivo declarado"@pt, "Objetivo declarado"@es ;
    skos:notation "stated-goal" ;
    skos:definition "What the participant said they wanted from the session, in their own words."@en ;
    skos:editorialNote "A participant's intention, not a clinical target, and it establishes no expected outcome. Recording it is what makes a later helpfulness or goal-achieved answer interpretable at all."@en .

sstim-v:rolePerceivedHelpfulness a owl:NamedIndividual, sstim:ObservationRole, skos:Concept ;
    skos:inScheme sstim-v:ObservationRoleScheme ;
    skos:topConceptOf sstim-v:ObservationRoleScheme ;
    skos:prefLabel "Perceived helpfulness"@en, "Utilità percepita"@it,
        "Utilidade percebida"@pt, "Utilidad percibida"@es ;
    skos:notation "perceived-helpfulness" ;
    skos:definition "How much the participant felt the session helped with what they wanted from it, on a declared scale."@en ;
    skos:scopeNote "A magnitude, unlike the yes/no goal-achieved item, and about the participant's own stated goal rather than the session's designed effect."@en .

sstim-v:rolePrimaryAffect a owl:NamedIndividual, sstim:ObservationRole, skos:Concept ;
    skos:inScheme sstim-v:ObservationRoleScheme ;
    skos:topConceptOf sstim-v:ObservationRoleScheme ;
    skos:prefLabel "Primary affect"@en, "Affetto primario"@it,
        "Afeto primário"@pt, "Afecto primario"@es ;
    skos:notation "primary-affect" ;
    skos:definition "How the participant felt at the report's collection phase, on a declared scale."@en .

sstim-v:roleFocus a owl:NamedIndividual, sstim:ObservationRole, skos:Concept ;
    skos:inScheme sstim-v:ObservationRoleScheme ;
    skos:topConceptOf sstim-v:ObservationRoleScheme ;
    skos:prefLabel "Focus"@en, "Concentrazione"@it,
        "Foco"@pt, "Foco"@es ;
    skos:notation "focus" ;
    skos:definition "How the participant described their attention at the report's collection phase."@en .

sstim-v:roleSleepiness a owl:NamedIndividual, sstim:ObservationRole, skos:Concept ;
    skos:inScheme sstim-v:ObservationRoleScheme ;
    skos:topConceptOf sstim-v:ObservationRoleScheme ;
    skos:prefLabel "Sleepiness"@en, "Sonnolenza"@it,
        "Sonolência"@pt, "Somnolencia"@es ;
    skos:notation "sleepiness" ;
    skos:definition "How alert or drowsy the participant felt at the report's collection phase."@en .

sstim-v:roleSubjectiveQuality a owl:NamedIndividual, sstim:ObservationRole, skos:Concept ;
    skos:inScheme sstim-v:ObservationRoleScheme ;
    skos:topConceptOf sstim-v:ObservationRoleScheme ;
    skos:prefLabel "Subjective quality"@en, "Qualità soggettiva"@it,
        "Qualidade subjetiva"@pt, "Calidad subjetiva"@es ;
    skos:notation "subjective-quality" ;
    skos:definition "How the participant rated the session itself."@en .

sstim-v:roleGoalAchieved a owl:NamedIndividual, sstim:ObservationRole, skos:Concept ;
    skos:inScheme sstim-v:ObservationRoleScheme ;
    skos:topConceptOf sstim-v:ObservationRoleScheme ;
    skos:prefLabel "Goal achieved"@en, "Obiettivo raggiunto"@it,
        "Objetivo alcançado"@pt, "Objetivo alcanzado"@es ;
    skos:notation "goal-achieved" ;
    skos:definition "Whether the participant judged that the session did what they wanted from it."@en ;
    skos:editorialNote "A self-assessment against the participant's own stated goal. It is not an efficacy measure and does not become one by aggregation."@en .

sstim-v:roleUnwantedExperienceReport a owl:NamedIndividual, sstim:ObservationRole, skos:Concept ;
    skos:inScheme sstim-v:ObservationRoleScheme ;
    skos:topConceptOf sstim-v:ObservationRoleScheme ;
    skos:prefLabel "Unwanted experience report"@en, "Segnalazione di esperienze indesiderate"@it,
        "Relato de experiências indesejadas"@pt, "Informe de experiencias no deseadas"@es ;
    skos:notation "unwanted-experience-report" ;
    skos:definition "The act of asking whether the participant had any unwanted experience, carrying its own response state and linking to whatever they described."@en ;
    skos:scopeNote "Modelling the asking as an observation is what keeps 'asked, none reported' distinct from 'never asked' and from 'declined to answer'. An empty list of experiences cannot express that difference."@en .


###########################################################################
# Response state scheme
#
# Why a value is or is not present. Six states rather than presence and
# absence, because a missing triple says only that a triple is missing.
###########################################################################

sstim-v:ResponseStateScheme a skos:ConceptScheme ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    skos:prefLabel "SSTIM Response State Vocabulary"@en ;
    skos:definition "Controlled categories stating why a participant observation does or does not carry a value."@en ;
    skos:hasTopConcept sstim-v:responseSupplied, sstim-v:responseNoneReported,
        sstim-v:responseNotAsked, sstim-v:responseDeclined,
        sstim-v:responseUnknown, sstim-v:responseNotApplicable .

sstim-v:responseSupplied a owl:NamedIndividual, sstim:ResponseState, skos:Concept ;
    skos:inScheme sstim-v:ResponseStateScheme ;
    skos:topConceptOf sstim-v:ResponseStateScheme ;
    skos:prefLabel "Supplied"@en, "Fornita"@it,
        "Fornecida"@pt, "Proporcionada"@es ;
    skos:notation "supplied" ;
    skos:definition "The participant gave an answer, which is recorded as this observation's value."@en .

sstim-v:responseNoneReported a owl:NamedIndividual, sstim:ResponseState, skos:Concept ;
    skos:inScheme sstim-v:ResponseStateScheme ;
    skos:topConceptOf sstim-v:ResponseStateScheme ;
    skos:prefLabel "None reported"@en, "Nessuna segnalata"@it,
        "Nenhuma relatada"@pt, "Ninguna informada"@es ;
    skos:notation "none-reported" ;
    skos:definition "The participant was asked and reported nothing to record. A positive finding of absence, not a gap."@en .

sstim-v:responseNotAsked a owl:NamedIndividual, sstim:ResponseState, skos:Concept ;
    skos:inScheme sstim-v:ResponseStateScheme ;
    skos:topConceptOf sstim-v:ResponseStateScheme ;
    skos:prefLabel "Not asked"@en, "Non richiesta"@it,
        "Não perguntada"@pt, "No preguntada"@es ;
    skos:notation "not-asked" ;
    skos:definition "The instrument did not put this question, so nothing about the participant follows from the absence."@en .

sstim-v:responseDeclined a owl:NamedIndividual, sstim:ResponseState, skos:Concept ;
    skos:inScheme sstim-v:ResponseStateScheme ;
    skos:topConceptOf sstim-v:ResponseStateScheme ;
    skos:prefLabel "Declined"@en, "Rifiutata"@it,
        "Recusada"@pt, "Rechazada"@es ;
    skos:notation "declined" ;
    skos:definition "The participant was asked and chose not to answer. Declining is always available and is never treated as a missing value to be imputed."@en .

sstim-v:responseUnknown a owl:NamedIndividual, sstim:ResponseState, skos:Concept ;
    skos:inScheme sstim-v:ResponseStateScheme ;
    skos:topConceptOf sstim-v:ResponseStateScheme ;
    skos:prefLabel "Unknown"@en, "Sconosciuta"@it,
        "Desconhecida"@pt, "Desconocida"@es ;
    skos:notation "unknown" ;
    skos:definition "Whether the question was put, or what was answered, is not recoverable from the record."@en .

sstim-v:responseNotApplicable a owl:NamedIndividual, sstim:ResponseState, skos:Concept ;
    skos:inScheme sstim-v:ResponseStateScheme ;
    skos:topConceptOf sstim-v:ResponseStateScheme ;
    skos:prefLabel "Not applicable"@en, "Non applicabile"@it,
        "Não aplicável"@pt, "No aplicable"@es ;
    skos:notation "not-applicable" ;
    skos:definition "The question does not apply to this session, as when a session ended too early for an item about how it went."@en .


sstim-v:eventParameterChanged a owl:NamedIndividual, sstim:SessionEventType, skos:Concept ;
    skos:inScheme sstim-v:SessionEventTypeScheme ;
    skos:topConceptOf sstim-v:SessionEventTypeScheme ;
    skos:prefLabel "Parameter changed"@en, "Parametro modificato"@it,
        "Parâmetro alterado"@pt, "Parámetro modificado"@es ;
    skos:notation "parameter-changed" ;
    skos:definition "A delivery quantity was set to a new value part-way through the session, by the participant or by the protocol. Carries the parameter kind and the value it took, so a segmented stimulus is recoverable from the timeline rather than only from the specification."@en ;
    skos:editorialNote "Added 2026-08-18 (ADR 0025 decision 5). Without it a stimulus that steps between values mid-session could only be described by flattening it into one row, which that decision forbids. A modulation the specification already declares in full stays declarative and is rendered as a linked trace; this type is for changes the plan does not contain."@en .


###########################################################################
# Stimulation parameter kind scheme
#
# Which delivery quantity a mid-session change acted on. Added 2026-08-18
# (ADR 0025 decision 5). Deliberately small and modality-neutral: SSTIM is a
# universal standard and one application's field list is not one. Each kind
# names a quantity an auditory, visual or haptic channel can all be said to
# have, and an implementation maps its own field onto the kind.
###########################################################################

sstim-v:StimulationParameterKindScheme a skos:ConceptScheme ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    skos:prefLabel "SSTIM Stimulation Parameter Kind Vocabulary"@en ;
    skos:definition "Controlled, modality-neutral categories for the delivery quantity that a mid-session parameter change acted on."@en ;
    skos:editorialNote "Kept short on purpose. A scheme that tried to enumerate every adjustable field would track one implementation's UI and would be wrong for the next; these are the quantities that recur across modalities."@en ;
    skos:hasTopConcept sstim-v:paramLevel, sstim-v:paramCarrierFrequency,
        sstim-v:paramModulationFrequency, sstim-v:paramDutyCycle,
        sstim-v:paramPhaseOffset .

sstim-v:paramLevel a owl:NamedIndividual, sstim:StimulationParameterKind, skos:Concept ;
    skos:inScheme sstim-v:StimulationParameterKindScheme ;
    skos:topConceptOf sstim-v:StimulationParameterKindScheme ;
    skos:prefLabel "Level"@en, "Livello"@it,
        "Nível"@pt, "Nivel"@es ;
    skos:notation "level" ;
    skos:definition "How strongly the channel is presented: sound amplitude, display luminance, or vibration intensity, as a fraction of the channel's own full scale."@en .

sstim-v:paramCarrierFrequency a owl:NamedIndividual, sstim:StimulationParameterKind, skos:Concept ;
    skos:inScheme sstim-v:StimulationParameterKindScheme ;
    skos:topConceptOf sstim-v:StimulationParameterKindScheme ;
    skos:prefLabel "Carrier frequency"@en, "Frequenza portante"@it,
        "Frequência da portadora"@pt, "Frecuencia portadora"@es ;
    skos:notation "carrier-frequency" ;
    skos:definition "The frequency of the signal that bears the modulation, in hertz — the tone a beat is built on rather than the rate of the beat itself."@en .

sstim-v:paramModulationFrequency a owl:NamedIndividual, sstim:StimulationParameterKind, skos:Concept ;
    skos:inScheme sstim-v:StimulationParameterKindScheme ;
    skos:topConceptOf sstim-v:StimulationParameterKindScheme ;
    skos:prefLabel "Modulation frequency"@en, "Frequenza di modulazione"@it,
        "Frequência de modulação"@pt, "Frecuencia de modulación"@es ;
    skos:notation "modulation-frequency" ;
    skos:definition "The rate at which something about the channel varies, in hertz: a flicker rate, a beat frequency, or a pulse rate."@en .

sstim-v:paramDutyCycle a owl:NamedIndividual, sstim:StimulationParameterKind, skos:Concept ;
    skos:inScheme sstim-v:StimulationParameterKindScheme ;
    skos:topConceptOf sstim-v:StimulationParameterKindScheme ;
    skos:prefLabel "Duty cycle"@en, "Ciclo di lavoro"@it,
        "Ciclo de trabalho"@pt, "Ciclo de trabajo"@es ;
    skos:notation "duty-cycle" ;
    skos:definition "The fraction of each modulation period during which the channel is presented rather than silent or dark, between zero and one."@en .

sstim-v:paramPhaseOffset a owl:NamedIndividual, sstim:StimulationParameterKind, skos:Concept ;
    skos:inScheme sstim-v:StimulationParameterKindScheme ;
    skos:topConceptOf sstim-v:StimulationParameterKindScheme ;
    skos:prefLabel "Phase offset"@en, "Sfasamento"@it,
        "Deslocamento de fase"@pt, "Desfase"@es ;
    skos:notation "phase-offset" ;
    skos:definition "Where this channel's modulation sits relative to another's, as a fraction of a cycle between zero and one."@en .


###########################################################################
# Unwanted experience category scheme
#
# Everyday descriptions of unwanted experience, in the participant's terms.
# None of these is a diagnosis, a symptom classification, or a clinical
# adverse-event category, and none may be read as one. "Other" plus free
# text is preferred over forcing a poor fit.
###########################################################################

sstim-v:UnwantedExperienceCategoryScheme a skos:ConceptScheme ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    skos:prefLabel "SSTIM Unwanted Experience Category Vocabulary"@en ;
    skos:definition "Controlled, non-diagnostic categories for describing an unwanted experience a participant reported around a session."@en ;
    skos:editorialNote "Descriptive rather than clinical by design. These categories support noticing patterns and responding conservatively; they do not support classifying harm, and no mapping to a clinical adverse-event terminology is provided or implied."@en ;
    skos:hasTopConcept sstim-v:experienceAuditoryDiscomfort, sstim-v:experienceVisualDiscomfort,
        sstim-v:experienceEyeStrain, sstim-v:experienceHeadSensation,
        sstim-v:experienceDizziness, sstim-v:experienceNausea,
        sstim-v:experienceRestlessness, sstim-v:experienceLowMood,
        sstim-v:experienceSleepDisruption, sstim-v:experienceOther .

sstim-v:experienceAuditoryDiscomfort a owl:NamedIndividual, sstim:UnwantedExperienceCategory, skos:Concept ;
    skos:inScheme sstim-v:UnwantedExperienceCategoryScheme ;
    skos:topConceptOf sstim-v:UnwantedExperienceCategoryScheme ;
    skos:prefLabel "Auditory discomfort"@en, "Disagio uditivo"@it,
        "Desconforto auditivo"@pt, "Molestia auditiva"@es ;
    skos:notation "auditory-discomfort" ;
    skos:definition "Sound that the participant found uncomfortable, harsh, or too loud."@en .

sstim-v:experienceVisualDiscomfort a owl:NamedIndividual, sstim:UnwantedExperienceCategory, skos:Concept ;
    skos:inScheme sstim-v:UnwantedExperienceCategoryScheme ;
    skos:topConceptOf sstim-v:UnwantedExperienceCategoryScheme ;
    skos:prefLabel "Visual discomfort"@en, "Disagio visivo"@it,
        "Desconforto visual"@pt, "Molestia visual"@es ;
    skos:notation "visual-discomfort" ;
    skos:definition "Light or visual pattern that the participant found uncomfortable, too bright, or unpleasant to look at."@en .

sstim-v:experienceEyeStrain a owl:NamedIndividual, sstim:UnwantedExperienceCategory, skos:Concept ;
    skos:inScheme sstim-v:UnwantedExperienceCategoryScheme ;
    skos:topConceptOf sstim-v:UnwantedExperienceCategoryScheme ;
    skos:prefLabel "Eye strain"@en, "Affaticamento visivo"@it,
        "Fadiga ocular"@pt, "Fatiga visual"@es ;
    skos:notation "eye-strain" ;
    skos:definition "Tired, aching, or effortful eyes reported around the session."@en ;
    skos:scopeNote "Common with free-viewing techniques that ask the eyes to hold an unusual convergence, and worth recording separately from general visual discomfort for that reason."@en .

sstim-v:experienceHeadSensation a owl:NamedIndividual, sstim:UnwantedExperienceCategory, skos:Concept ;
    skos:inScheme sstim-v:UnwantedExperienceCategoryScheme ;
    skos:topConceptOf sstim-v:UnwantedExperienceCategoryScheme ;
    skos:prefLabel "Head sensation"@en, "Sensazione alla testa"@it,
        "Sensação na cabeça"@pt, "Sensación en la cabeza"@es ;
    skos:notation "head-sensation" ;
    skos:definition "Pressure, heaviness, aching, or other sensation in the head that the participant described."@en ;
    skos:editorialNote "Deliberately broad and non-diagnostic. Recording a participant's description of a head sensation is not recording a headache as a clinical finding."@en .

sstim-v:experienceDizziness a owl:NamedIndividual, sstim:UnwantedExperienceCategory, skos:Concept ;
    skos:inScheme sstim-v:UnwantedExperienceCategoryScheme ;
    skos:topConceptOf sstim-v:UnwantedExperienceCategoryScheme ;
    skos:prefLabel "Dizziness"@en, "Vertigine"@it,
        "Tontura"@pt, "Mareo"@es ;
    skos:notation "dizziness" ;
    skos:definition "Light-headedness or unsteadiness the participant described."@en .

sstim-v:experienceNausea a owl:NamedIndividual, sstim:UnwantedExperienceCategory, skos:Concept ;
    skos:inScheme sstim-v:UnwantedExperienceCategoryScheme ;
    skos:topConceptOf sstim-v:UnwantedExperienceCategoryScheme ;
    skos:prefLabel "Nausea"@en, "Nausea"@it,
        "Náusea"@pt, "Náusea"@es ;
    skos:notation "nausea" ;
    skos:definition "Queasiness the participant described."@en .

sstim-v:experienceRestlessness a owl:NamedIndividual, sstim:UnwantedExperienceCategory, skos:Concept ;
    skos:inScheme sstim-v:UnwantedExperienceCategoryScheme ;
    skos:topConceptOf sstim-v:UnwantedExperienceCategoryScheme ;
    skos:prefLabel "Restlessness"@en, "Irrequietezza"@it,
        "Inquietação"@pt, "Inquietud"@es ;
    skos:notation "restlessness" ;
    skos:definition "Agitation or difficulty settling that the participant described."@en .

sstim-v:experienceLowMood a owl:NamedIndividual, sstim:UnwantedExperienceCategory, skos:Concept ;
    skos:inScheme sstim-v:UnwantedExperienceCategoryScheme ;
    skos:topConceptOf sstim-v:UnwantedExperienceCategoryScheme ;
    skos:prefLabel "Low mood"@en, "Umore basso"@it,
        "Humor baixo"@pt, "Ánimo bajo"@es ;
    skos:notation "low-mood" ;
    skos:definition "A downward shift in mood the participant described around the session."@en ;
    skos:editorialNote "A mood report, never a mood disorder. Nothing in this vocabulary supports a psychiatric inference."@en .

sstim-v:experienceSleepDisruption a owl:NamedIndividual, sstim:UnwantedExperienceCategory, skos:Concept ;
    skos:inScheme sstim-v:UnwantedExperienceCategoryScheme ;
    skos:topConceptOf sstim-v:UnwantedExperienceCategoryScheme ;
    skos:prefLabel "Sleep disruption"@en, "Disturbo del sonno"@it,
        "Perturbação do sono"@pt, "Alteración del sueño"@es ;
    skos:notation "sleep-disruption" ;
    skos:definition "Difficulty sleeping, or disturbed sleep, that the participant reported after a session."@en ;
    skos:scopeNote "Typically a follow-up rather than an immediate-post observation, which is why onset phase and report phase are recorded separately."@en .

sstim-v:experienceOther a owl:NamedIndividual, sstim:UnwantedExperienceCategory, skos:Concept ;
    skos:inScheme sstim-v:UnwantedExperienceCategoryScheme ;
    skos:topConceptOf sstim-v:UnwantedExperienceCategoryScheme ;
    skos:prefLabel "Other"@en, "Altro"@it,
        "Outro"@pt, "Otro"@es ;
    skos:notation "other" ;
    skos:definition "An unwanted experience that none of the listed categories describes."@en ;
    skos:editorialNote "Preferred over forcing a poor fit. A rising count here is a signal that the scheme needs a category, not that participants are describing things badly."@en .


###########################################################################
# Reported severity scheme
#
# How severe the participant said it was. Three magnitudes plus two states
# for the absence of a magnitude — no clinical grading scale is implied,
# and none of these values may be mapped onto one.
###########################################################################

sstim-v:ReportedSeverityScheme a skos:ConceptScheme ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    skos:prefLabel "SSTIM Reported Severity Vocabulary"@en ;
    skos:definition "Controlled categories recording how severe a participant said an unwanted experience was."@en ;
    skos:editorialNote "Participant-reported throughout. These are not clinical severity grades and carry no threshold for action, reporting, or classification."@en ;
    skos:hasTopConcept sstim-v:severityMild, sstim-v:severityModerate,
        sstim-v:severitySevere, sstim-v:severityDeclined, sstim-v:severityUnknown .

sstim-v:severityMild a owl:NamedIndividual, sstim:ReportedSeverity, skos:Concept ;
    skos:inScheme sstim-v:ReportedSeverityScheme ;
    skos:topConceptOf sstim-v:ReportedSeverityScheme ;
    skos:prefLabel "Mild"@en, "Lieve"@it, "Leve"@pt, "Leve"@es ;
    skos:notation "mild" ;
    skos:definition "The participant described the experience as slight or easily tolerated."@en .

sstim-v:severityModerate a owl:NamedIndividual, sstim:ReportedSeverity, skos:Concept ;
    skos:inScheme sstim-v:ReportedSeverityScheme ;
    skos:topConceptOf sstim-v:ReportedSeverityScheme ;
    skos:prefLabel "Moderate"@en, "Moderata"@it, "Moderada"@pt, "Moderada"@es ;
    skos:notation "moderate" ;
    skos:definition "The participant described the experience as noticeable and bothersome."@en .

sstim-v:severitySevere a owl:NamedIndividual, sstim:ReportedSeverity, skos:Concept ;
    skos:inScheme sstim-v:ReportedSeverityScheme ;
    skos:topConceptOf sstim-v:ReportedSeverityScheme ;
    skos:prefLabel "Severe"@en, "Grave"@it, "Grave"@pt, "Grave"@es ;
    skos:notation "severe" ;
    skos:definition "The participant described the experience as strong or hard to tolerate."@en .

sstim-v:severityDeclined a owl:NamedIndividual, sstim:ReportedSeverity, skos:Concept ;
    skos:inScheme sstim-v:ReportedSeverityScheme ;
    skos:topConceptOf sstim-v:ReportedSeverityScheme ;
    skos:prefLabel "Severity declined"@en, "Gravità non dichiarata"@it,
        "Gravidade recusada"@pt, "Gravedad no declarada"@es ;
    skos:notation "severity-declined" ;
    skos:definition "The participant described the experience but chose not to rate its severity."@en .

sstim-v:severityUnknown a owl:NamedIndividual, sstim:ReportedSeverity, skos:Concept ;
    skos:inScheme sstim-v:ReportedSeverityScheme ;
    skos:topConceptOf sstim-v:ReportedSeverityScheme ;
    skos:prefLabel "Severity unknown"@en, "Gravità sconosciuta"@it,
        "Gravidade desconhecida"@pt, "Gravedad desconocida"@es ;
    skos:notation "severity-unknown" ;
    skos:definition "No severity is recoverable from the record."@en .


###########################################################################
# Experience onset phase scheme
###########################################################################

sstim-v:ExperienceOnsetPhaseScheme a skos:ConceptScheme ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    skos:prefLabel "SSTIM Experience Onset Phase Vocabulary"@en ;
    skos:definition "Controlled categories locating when an unwanted experience began, relative to the session."@en ;
    skos:scopeNote "Separate from the self-report phase scheme: when an experience began and when it was reported are different facts, and an experience is often described later than it started."@en ;
    skos:hasTopConcept sstim-v:onsetBeforeSession, sstim-v:onsetDuringSession,
        sstim-v:onsetImmediatelyAfter, sstim-v:onsetLaterSameDay,
        sstim-v:onsetNextDay, sstim-v:onsetUnknown .

sstim-v:onsetBeforeSession a owl:NamedIndividual, sstim:ExperienceOnsetPhase, skos:Concept ;
    skos:inScheme sstim-v:ExperienceOnsetPhaseScheme ;
    skos:topConceptOf sstim-v:ExperienceOnsetPhaseScheme ;
    skos:prefLabel "Before session"@en, "Prima della sessione"@it,
        "Antes da sessão"@pt, "Antes de la sesión"@es ;
    skos:notation "onset-before" ;
    skos:definition "The experience was already present before delivery began."@en ;
    skos:scopeNote "Worth recording rather than discarding: an experience present beforehand is the clearest case in which the session cannot be its origin."@en .

sstim-v:onsetDuringSession a owl:NamedIndividual, sstim:ExperienceOnsetPhase, skos:Concept ;
    skos:inScheme sstim-v:ExperienceOnsetPhaseScheme ;
    skos:topConceptOf sstim-v:ExperienceOnsetPhaseScheme ;
    skos:prefLabel "During session"@en, "Durante la sessione"@it,
        "Durante a sessão"@pt, "Durante la sesión"@es ;
    skos:notation "onset-during" ;
    skos:definition "The experience began while delivery was in progress; an onset offset locates it on the session's timing context where the participant could place it."@en .

sstim-v:onsetImmediatelyAfter a owl:NamedIndividual, sstim:ExperienceOnsetPhase, skos:Concept ;
    skos:inScheme sstim-v:ExperienceOnsetPhaseScheme ;
    skos:topConceptOf sstim-v:ExperienceOnsetPhaseScheme ;
    skos:prefLabel "Immediately after"@en, "Subito dopo"@it,
        "Imediatamente depois"@pt, "Inmediatamente después"@es ;
    skos:notation "onset-immediately-after" ;
    skos:definition "The experience began shortly after delivery ended."@en .

sstim-v:onsetLaterSameDay a owl:NamedIndividual, sstim:ExperienceOnsetPhase, skos:Concept ;
    skos:inScheme sstim-v:ExperienceOnsetPhaseScheme ;
    skos:topConceptOf sstim-v:ExperienceOnsetPhaseScheme ;
    skos:prefLabel "Later the same day"@en, "Più tardi lo stesso giorno"@it,
        "Mais tarde no mesmo dia"@pt, "Más tarde el mismo día"@es ;
    skos:notation "onset-later-same-day" ;
    skos:definition "The experience began later on the day of the session."@en .

sstim-v:onsetNextDay a owl:NamedIndividual, sstim:ExperienceOnsetPhase, skos:Concept ;
    skos:inScheme sstim-v:ExperienceOnsetPhaseScheme ;
    skos:topConceptOf sstim-v:ExperienceOnsetPhaseScheme ;
    skos:prefLabel "Next day"@en, "Il giorno dopo"@it,
        "No dia seguinte"@pt, "Al día siguiente"@es ;
    skos:notation "onset-next-day" ;
    skos:definition "The experience began on the day after the session."@en .

sstim-v:onsetUnknown a owl:NamedIndividual, sstim:ExperienceOnsetPhase, skos:Concept ;
    skos:inScheme sstim-v:ExperienceOnsetPhaseScheme ;
    skos:topConceptOf sstim-v:ExperienceOnsetPhaseScheme ;
    skos:prefLabel "Onset unknown"@en, "Insorgenza sconosciuta"@it,
        "Início desconhecido"@pt, "Inicio desconocido"@es ;
    skos:notation "onset-unknown" ;
    skos:definition "When the experience began is not recoverable from the record."@en .


###########################################################################
# Experience persistence scheme
###########################################################################

sstim-v:ExperiencePersistenceScheme a skos:ConceptScheme ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    skos:prefLabel "SSTIM Experience Persistence Vocabulary"@en ;
    skos:definition "Controlled categories recording how long an unwanted experience lasted, as the participant described it."@en ;
    skos:hasTopConcept sstim-v:persistenceResolvedDuringSession,
        sstim-v:persistenceResolvedSameDay, sstim-v:persistenceResolvedLater,
        sstim-v:persistenceOngoing, sstim-v:persistenceUnknown .

sstim-v:persistenceResolvedDuringSession a owl:NamedIndividual, sstim:ExperiencePersistence, skos:Concept ;
    skos:inScheme sstim-v:ExperiencePersistenceScheme ;
    skos:topConceptOf sstim-v:ExperiencePersistenceScheme ;
    skos:prefLabel "Resolved during session"@en, "Risolta durante la sessione"@it,
        "Resolvida durante a sessão"@pt, "Resuelta durante la sesión"@es ;
    skos:notation "resolved-during-session" ;
    skos:definition "The experience passed before delivery ended."@en .

sstim-v:persistenceResolvedSameDay a owl:NamedIndividual, sstim:ExperiencePersistence, skos:Concept ;
    skos:inScheme sstim-v:ExperiencePersistenceScheme ;
    skos:topConceptOf sstim-v:ExperiencePersistenceScheme ;
    skos:prefLabel "Resolved the same day"@en, "Risolta lo stesso giorno"@it,
        "Resolvida no mesmo dia"@pt, "Resuelta el mismo día"@es ;
    skos:notation "resolved-same-day" ;
    skos:definition "The experience passed on the day of the session."@en .

sstim-v:persistenceResolvedLater a owl:NamedIndividual, sstim:ExperiencePersistence, skos:Concept ;
    skos:inScheme sstim-v:ExperiencePersistenceScheme ;
    skos:topConceptOf sstim-v:ExperiencePersistenceScheme ;
    skos:prefLabel "Resolved later"@en, "Risolta più tardi"@it,
        "Resolvida mais tarde"@pt, "Resuelta más tarde"@es ;
    skos:notation "resolved-later" ;
    skos:definition "The experience passed after the day of the session."@en .

sstim-v:persistenceOngoing a owl:NamedIndividual, sstim:ExperiencePersistence, skos:Concept ;
    skos:inScheme sstim-v:ExperiencePersistenceScheme ;
    skos:topConceptOf sstim-v:ExperiencePersistenceScheme ;
    skos:prefLabel "Ongoing"@en, "In corso"@it,
        "Em curso"@pt, "En curso"@es ;
    skos:notation "ongoing" ;
    skos:definition "The experience had not passed when the participant reported it."@en .

sstim-v:persistenceUnknown a owl:NamedIndividual, sstim:ExperiencePersistence, skos:Concept ;
    skos:inScheme sstim-v:ExperiencePersistenceScheme ;
    skos:topConceptOf sstim-v:ExperiencePersistenceScheme ;
    skos:prefLabel "Persistence unknown"@en, "Durata sconosciuta"@it,
        "Persistência desconhecida"@pt, "Persistencia desconocida"@es ;
    skos:notation "persistence-unknown" ;
    skos:definition "How long the experience lasted is not recoverable from the record."@en .


###########################################################################
# Experience response action scheme
###########################################################################

sstim-v:ExperienceResponseActionScheme a skos:ConceptScheme ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    skos:prefLabel "SSTIM Experience Response Action Vocabulary"@en ;
    skos:definition "Controlled categories recording what a participant did in response to an unwanted experience."@en ;
    skos:scopeNote "What the participant did, not what they were advised to do. Recording the action makes a later resolution interpretable."@en ;
    skos:hasTopConcept sstim-v:actionNone, sstim-v:actionReducedIntensity,
        sstim-v:actionPausedSession, sstim-v:actionStoppedSession,
        sstim-v:actionChangedDelivery, sstim-v:actionOther,
        sstim-v:actionDeclined, sstim-v:actionUnknown .

sstim-v:actionNone a owl:NamedIndividual, sstim:ExperienceResponseAction, skos:Concept ;
    skos:inScheme sstim-v:ExperienceResponseActionScheme ;
    skos:topConceptOf sstim-v:ExperienceResponseActionScheme ;
    skos:prefLabel "No action"@en, "Nessuna azione"@it,
        "Nenhuma ação"@pt, "Ninguna acción"@es ;
    skos:notation "action-none" ;
    skos:definition "The participant continued without changing anything."@en .

sstim-v:actionReducedIntensity a owl:NamedIndividual, sstim:ExperienceResponseAction, skos:Concept ;
    skos:inScheme sstim-v:ExperienceResponseActionScheme ;
    skos:topConceptOf sstim-v:ExperienceResponseActionScheme ;
    skos:prefLabel "Reduced intensity"@en, "Intensità ridotta"@it,
        "Intensidade reduzida"@pt, "Intensidad reducida"@es ;
    skos:notation "action-reduced-intensity" ;
    skos:definition "The participant lowered volume, brightness, or another delivery level."@en .

sstim-v:actionPausedSession a owl:NamedIndividual, sstim:ExperienceResponseAction, skos:Concept ;
    skos:inScheme sstim-v:ExperienceResponseActionScheme ;
    skos:topConceptOf sstim-v:ExperienceResponseActionScheme ;
    skos:prefLabel "Paused the session"@en, "Sessione messa in pausa"@it,
        "Sessão pausada"@pt, "Sesión pausada"@es ;
    skos:notation "action-paused-session" ;
    skos:definition "The participant paused delivery and later resumed."@en .

sstim-v:actionStoppedSession a owl:NamedIndividual, sstim:ExperienceResponseAction, skos:Concept ;
    skos:inScheme sstim-v:ExperienceResponseActionScheme ;
    skos:topConceptOf sstim-v:ExperienceResponseActionScheme ;
    skos:prefLabel "Stopped the session"@en, "Sessione fermata"@it,
        "Sessão parada"@pt, "Sesión detenida"@es ;
    skos:notation "action-stopped-session" ;
    skos:definition "The participant ended delivery."@en .

sstim-v:actionChangedDelivery a owl:NamedIndividual, sstim:ExperienceResponseAction, skos:Concept ;
    skos:inScheme sstim-v:ExperienceResponseActionScheme ;
    skos:topConceptOf sstim-v:ExperienceResponseActionScheme ;
    skos:prefLabel "Changed the delivery"@en, "Modalità di erogazione cambiata"@it,
        "Entrega alterada"@pt, "Entrega modificada"@es ;
    skos:notation "action-changed-delivery" ;
    skos:definition "The participant changed how the stimulus reached them, such as removing headphones or looking away."@en .

sstim-v:actionOther a owl:NamedIndividual, sstim:ExperienceResponseAction, skos:Concept ;
    skos:inScheme sstim-v:ExperienceResponseActionScheme ;
    skos:topConceptOf sstim-v:ExperienceResponseActionScheme ;
    skos:prefLabel "Other action"@en, "Altra azione"@it,
        "Outra ação"@pt, "Otra acción"@es ;
    skos:notation "action-other" ;
    skos:definition "An action none of the listed categories describes."@en .

sstim-v:actionDeclined a owl:NamedIndividual, sstim:ExperienceResponseAction, skos:Concept ;
    skos:inScheme sstim-v:ExperienceResponseActionScheme ;
    skos:topConceptOf sstim-v:ExperienceResponseActionScheme ;
    skos:prefLabel "Action declined"@en, "Azione non dichiarata"@it,
        "Ação não declarada"@pt, "Acción no declarada"@es ;
    skos:notation "action-declined" ;
    skos:definition "The participant chose not to say what they did."@en .

sstim-v:actionUnknown a owl:NamedIndividual, sstim:ExperienceResponseAction, skos:Concept ;
    skos:inScheme sstim-v:ExperienceResponseActionScheme ;
    skos:topConceptOf sstim-v:ExperienceResponseActionScheme ;
    skos:prefLabel "Action unknown"@en, "Azione sconosciuta"@it,
        "Ação desconhecida"@pt, "Acción desconocida"@es ;
    skos:notation "action-unknown" ;
    skos:definition "What the participant did is not recoverable from the record."@en .


###########################################################################
# Experience resolution scheme
###########################################################################

sstim-v:ExperienceResolutionScheme a skos:ConceptScheme ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    skos:prefLabel "SSTIM Experience Resolution Vocabulary"@en ;
    skos:definition "Controlled categories recording the state an unwanted experience reached."@en ;
    skos:hasTopConcept sstim-v:resolutionResolved, sstim-v:resolutionImproved,
        sstim-v:resolutionUnchanged, sstim-v:resolutionWorsened,
        sstim-v:resolutionUnknown .

sstim-v:resolutionResolved a owl:NamedIndividual, sstim:ExperienceResolution, skos:Concept ;
    skos:inScheme sstim-v:ExperienceResolutionScheme ;
    skos:topConceptOf sstim-v:ExperienceResolutionScheme ;
    skos:prefLabel "Resolved"@en, "Risolta"@it, "Resolvida"@pt, "Resuelta"@es ;
    skos:notation "resolution-resolved" ;
    skos:definition "The experience passed completely."@en .

sstim-v:resolutionImproved a owl:NamedIndividual, sstim:ExperienceResolution, skos:Concept ;
    skos:inScheme sstim-v:ExperienceResolutionScheme ;
    skos:topConceptOf sstim-v:ExperienceResolutionScheme ;
    skos:prefLabel "Improved"@en, "Migliorata"@it, "Melhorada"@pt, "Mejorada"@es ;
    skos:notation "resolution-improved" ;
    skos:definition "The experience lessened without passing entirely."@en .

sstim-v:resolutionUnchanged a owl:NamedIndividual, sstim:ExperienceResolution, skos:Concept ;
    skos:inScheme sstim-v:ExperienceResolutionScheme ;
    skos:topConceptOf sstim-v:ExperienceResolutionScheme ;
    skos:prefLabel "Unchanged"@en, "Invariata"@it, "Inalterada"@pt, "Sin cambios"@es ;
    skos:notation "resolution-unchanged" ;
    skos:definition "The experience stayed as it was."@en .

sstim-v:resolutionWorsened a owl:NamedIndividual, sstim:ExperienceResolution, skos:Concept ;
    skos:inScheme sstim-v:ExperienceResolutionScheme ;
    skos:topConceptOf sstim-v:ExperienceResolutionScheme ;
    skos:prefLabel "Worsened"@en, "Peggiorata"@it, "Piorada"@pt, "Empeorada"@es ;
    skos:notation "resolution-worsened" ;
    skos:definition "The experience became stronger or more troublesome."@en ;
    skos:editorialNote "Recording a worsening is a description of what the participant reported. It is not a safety determination, and acting on a pattern of them is a human decision made outside this vocabulary."@en .

sstim-v:resolutionUnknown a owl:NamedIndividual, sstim:ExperienceResolution, skos:Concept ;
    skos:inScheme sstim-v:ExperienceResolutionScheme ;
    skos:topConceptOf sstim-v:ExperienceResolutionScheme ;
    skos:prefLabel "Resolution unknown"@en, "Esito sconosciuto"@it,
        "Resolução desconhecida"@pt, "Resolución desconocida"@es ;
    skos:notation "resolution-unknown" ;
    skos:definition "What became of the experience is not recoverable from the record."@en .


###########################################################################
# Perceived relatedness scheme
#
# The participant's own view of whether the session was involved. It is a
# perception and is never promoted to an attribution by any query, export,
# or aggregation.
###########################################################################

sstim-v:PerceivedRelatednessScheme a skos:ConceptScheme ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    skos:prefLabel "SSTIM Perceived Relatedness Vocabulary"@en ;
    skos:definition "Controlled categories recording whether a participant perceived an experience as connected to the session."@en ;
    skos:editorialNote "Records a perception only. Temporal association is not causation, and neither is a participant's belief about it; establishing any causal relation requires the separate governed assessment process, not this property."@en ;
    skos:hasTopConcept sstim-v:relatednessRelated, sstim-v:relatednessPossiblyRelated,
        sstim-v:relatednessUnrelated, sstim-v:relatednessUnknown,
        sstim-v:relatednessDeclined .

sstim-v:relatednessRelated a owl:NamedIndividual, sstim:PerceivedRelatedness, skos:Concept ;
    skos:inScheme sstim-v:PerceivedRelatednessScheme ;
    skos:topConceptOf sstim-v:PerceivedRelatednessScheme ;
    skos:prefLabel "Perceived as related"@en, "Percepita come correlata"@it,
        "Percebida como relacionada"@pt, "Percibida como relacionada"@es ;
    skos:notation "relatedness-related" ;
    skos:definition "The participant thought the session was involved."@en .

sstim-v:relatednessPossiblyRelated a owl:NamedIndividual, sstim:PerceivedRelatedness, skos:Concept ;
    skos:inScheme sstim-v:PerceivedRelatednessScheme ;
    skos:topConceptOf sstim-v:PerceivedRelatednessScheme ;
    skos:prefLabel "Perceived as possibly related"@en, "Percepita come forse correlata"@it,
        "Percebida como possivelmente relacionada"@pt, "Percibida como posiblemente relacionada"@es ;
    skos:notation "relatedness-possibly-related" ;
    skos:definition "The participant was unsure whether the session was involved."@en .

sstim-v:relatednessUnrelated a owl:NamedIndividual, sstim:PerceivedRelatedness, skos:Concept ;
    skos:inScheme sstim-v:PerceivedRelatednessScheme ;
    skos:topConceptOf sstim-v:PerceivedRelatednessScheme ;
    skos:prefLabel "Perceived as unrelated"@en, "Percepita come non correlata"@it,
        "Percebida como não relacionada"@pt, "Percibida como no relacionada"@es ;
    skos:notation "relatedness-unrelated" ;
    skos:definition "The participant thought the session was not involved."@en .

sstim-v:relatednessUnknown a owl:NamedIndividual, sstim:PerceivedRelatedness, skos:Concept ;
    skos:inScheme sstim-v:PerceivedRelatednessScheme ;
    skos:topConceptOf sstim-v:PerceivedRelatednessScheme ;
    skos:prefLabel "Relatedness unknown"@en, "Correlazione sconosciuta"@it,
        "Correlação desconhecida"@pt, "Correlación desconocida"@es ;
    skos:notation "relatedness-unknown" ;
    skos:definition "The participant's view is not recoverable from the record."@en .

sstim-v:relatednessDeclined a owl:NamedIndividual, sstim:PerceivedRelatedness, skos:Concept ;
    skos:inScheme sstim-v:PerceivedRelatednessScheme ;
    skos:topConceptOf sstim-v:PerceivedRelatednessScheme ;
    skos:prefLabel "Relatedness declined"@en, "Correlazione non dichiarata"@it,
        "Correlação não declarada"@pt, "Correlación no declarada"@es ;
    skos:notation "relatedness-declined" ;
    skos:definition "The participant chose not to say whether they thought the session was involved."@en .


###########################################################################
# Part 12 — Signals and renderings (ADR 0052)
#
# One vocabulary of shapes serves both the signal and the waveform it is
# presented as: the same fact seen from either side. Mechanism and presence
# describe the rendering rather than the signal, because a carrier is a fact
# about the sense being addressed and not about what is being delivered.
###########################################################################

sstim-v:SignalShapeScheme a skos:ConceptScheme ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    skos:prefLabel "SSTIM Signal Shape Vocabulary"@en ;
    dct:description "The form of a time-varying signal, and equally the waveform a rendering presents."@en ;
    skos:hasTopConcept sstim-v:shapeSine, sstim-v:shapeSquare, sstim-v:shapeSawtooth, sstim-v:shapeTriangle, sstim-v:shapeEnvelope, sstim-v:shapeNoise, sstim-v:shapeSampled .

sstim-v:RenderingMechanismScheme a skos:ConceptScheme ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    skos:prefLabel "SSTIM Rendering Mechanism Vocabulary"@en ;
    dct:description "How a signal is made to reach a subject through one channel."@en ;
    skos:hasTopConcept sstim-v:mechanismDirectPresentation, sstim-v:mechanismAmplitudeModulation, sstim-v:mechanismFrequencyModulation, sstim-v:mechanismBinauralBeat, sstim-v:mechanismMonauralBeat .

sstim-v:RenderingPresenceScheme a skos:ConceptScheme ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    skos:prefLabel "SSTIM Rendering Presence Vocabulary"@en ;
    dct:description "Whether a rendering puts the signal physically into the world or produces it perceptually."@en ;
    skos:hasTopConcept sstim-v:presencePhysical, sstim-v:presencePerceptual .

sstim-v:RenderableParameterScheme a skos:ConceptScheme ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    skos:prefLabel "SSTIM Renderable Parameter Vocabulary"@en ;
    dct:description "The parameter a signal is rendered onto. Also the modulation relation."@en ;
    skos:hasTopConcept sstim-v:paramAmplitude, sstim-v:paramFrequency, sstim-v:paramLuminance, sstim-v:paramSize, sstim-v:paramSpatialPosition, sstim-v:paramVibrationIntensity .

sstim-v:shapeSine a owl:NamedIndividual, sstim:SignalShape, skos:Concept ;
    skos:inScheme sstim-v:SignalShapeScheme ;
    skos:prefLabel "Sine"@en,
                   "Sinusoide"@it,
                   "Senoide"@pt,
                   "Senoide"@es ;
    skos:notation "sine" ;
    skos:definition "A single-frequency sinusoid. The default periodic shape, and the only one the BSC catalog ever used."@en .

sstim-v:shapeSquare a owl:NamedIndividual, sstim:SignalShape, skos:Concept ;
    skos:inScheme sstim-v:SignalShapeScheme ;
    skos:prefLabel "Square"@en,
                   "Onda quadra"@it,
                   "Onda quadrada"@pt,
                   "Onda cuadrada"@es ;
    skos:notation "square" ;
    skos:definition "A periodic shape alternating between two levels with a duty cycle. Its harmonic content makes it audibly and visually harsher than a sinusoid at the same rate."@en .

sstim-v:shapeSawtooth a owl:NamedIndividual, sstim:SignalShape, skos:Concept ;
    skos:inScheme sstim-v:SignalShapeScheme ;
    skos:prefLabel "Sawtooth"@en,
                   "Dente di sega"@it,
                   "Dente de serra"@pt,
                   "Diente de sierra"@es ;
    skos:notation "sawtooth" ;
    skos:definition "A periodic shape rising linearly and resetting sharply, or its mirror image."@en .

sstim-v:shapeTriangle a owl:NamedIndividual, sstim:SignalShape, skos:Concept ;
    skos:inScheme sstim-v:SignalShapeScheme ;
    skos:prefLabel "Triangle"@en,
                   "Onda triangolare"@it,
                   "Onda triangular"@pt,
                   "Onda triangular"@es ;
    skos:notation "triangle" ;
    skos:definition "A periodic shape rising and falling linearly, with weaker harmonics than a square at the same rate."@en .

sstim-v:shapeEnvelope a owl:NamedIndividual, sstim:SignalShape, skos:Concept ;
    skos:inScheme sstim-v:SignalShapeScheme ;
    skos:prefLabel "Envelope"@en,
                   "Inviluppo"@it,
                   "Envelope"@pt,
                   "Envolvente"@es ;
    skos:notation "envelope" ;
    skos:definition "A non-repeating contour over time, such as a period ramping from one value to another across a session. Shape and repetition are independent: an envelope may modulate a periodic signal."@en .

sstim-v:shapeNoise a owl:NamedIndividual, sstim:SignalShape, skos:Concept ;
    skos:inScheme sstim-v:SignalShapeScheme ;
    skos:prefLabel "Noise"@en,
                   "Rumore"@it,
                   "Ruído"@pt,
                   "Ruido"@es ;
    skos:notation "noise" ;
    skos:scopeNote "The clearest case for the interval model: noise cannot be described by a single frequency number, so a signal states a lower and an upper bound and relates to a band by containment or overlap rather than membership."@en ;
    skos:definition "A stochastic signal occupying a frequency extent rather than a point. White noise spans the whole audible range and band-limited noise a named interval; both are this shape with different bounds."@en .

sstim-v:shapeSampled a owl:NamedIndividual, sstim:SignalShape, skos:Concept ;
    skos:inScheme sstim-v:SignalShapeScheme ;
    skos:prefLabel "Sampled"@en,
                   "Campionato"@it,
                   "Amostrado"@pt,
                   "Muestreado"@es ;
    skos:notation "sampled" ;
    skos:scopeNote "The one shape that is an asset rather than a function, which is why it needs provenance and a checksum where a sine needs neither."@en ;
    skos:definition "A signal whose form is a recording rather than a function — a violin note, a voice, rainfall. Carries a source asset, without which the signal is not reproducible."@en .

sstim-v:mechanismDirectPresentation a owl:NamedIndividual, sstim:RenderingMechanism, skos:Concept ;
    sstim:impliesPresence sstim-v:presencePhysical ;
    skos:inScheme sstim-v:RenderingMechanismScheme ;
    skos:prefLabel "Direct presentation"@en,
                   "Presentazione diretta"@it,
                   "Apresentação direta"@pt,
                   "Presentación directa"@es ;
    skos:notation "direct-presentation" ;
    skos:definition "The signal is presented as itself, with no carrier — a light flickering at the signal rate, or a vibration at it."@en .

sstim-v:mechanismAmplitudeModulation a owl:NamedIndividual, sstim:RenderingMechanism, skos:Concept ;
    sstim:impliesPresence sstim-v:presencePhysical ;
    skos:inScheme sstim-v:RenderingMechanismScheme ;
    skos:prefLabel "Amplitude modulation"@en,
                   "Modulazione di ampiezza"@it,
                   "Modulação de amplitude"@pt,
                   "Modulación de amplitud"@es ;
    skos:notation "amplitude-modulation" ;
    skos:definition "The signal modulates the amplitude of a carrier. The isochronic case: a 10 Hz signal on an audible tone."@en .

sstim-v:mechanismFrequencyModulation a owl:NamedIndividual, sstim:RenderingMechanism, skos:Concept ;
    sstim:impliesPresence sstim-v:presencePhysical ;
    skos:inScheme sstim-v:RenderingMechanismScheme ;
    skos:prefLabel "Frequency modulation"@en,
                   "Modulazione di frequenza"@it,
                   "Modulação de frequência"@pt,
                   "Modulación de frecuencia"@es ;
    skos:notation "frequency-modulation" ;
    skos:definition "The signal modulates the frequency of a carrier."@en .

sstim-v:mechanismBinauralBeat a owl:NamedIndividual, sstim:RenderingMechanism, skos:Concept ;
    sstim:impliesPresence sstim-v:presencePerceptual ;
    skos:inScheme sstim-v:RenderingMechanismScheme ;
    skos:prefLabel "Binaural beat"@en,
                   "Battimento binaurale"@it,
                   "Batimento binaural"@pt,
                   "Batido binaural"@es ;
    skos:notation "binaural-beat" ;
    skos:definition "Two carriers differing by the signal frequency are presented dichotically. The signal is absent from each ear and constructed by the auditory system, so this mechanism is perceptual rather than physical."@en .

sstim-v:mechanismMonauralBeat a owl:NamedIndividual, sstim:RenderingMechanism, skos:Concept ;
    sstim:impliesPresence sstim-v:presencePhysical ;
    skos:inScheme sstim-v:RenderingMechanismScheme ;
    skos:prefLabel "Monaural beat"@en,
                   "Battimento monoaurale"@it,
                   "Batimento monoaural"@pt,
                   "Batido monoaural"@es ;
    skos:notation "monaural-beat" ;
    skos:definition "Two carriers differing by the signal frequency are summed acoustically before delivery, so the signal is physically present in the combined waveform."@en .

sstim-v:presencePhysical a owl:NamedIndividual, sstim:RenderingPresence, skos:Concept ;
    skos:inScheme sstim-v:RenderingPresenceScheme ;
    skos:prefLabel "Physically present"@en,
                   "Fisicamente presente"@it,
                   "Fisicamente presente"@pt,
                   "Físicamente presente"@es ;
    skos:notation "physical" ;
    skos:definition "The signal exists as a real modulation in what reaches the subject, and could be measured at the point of delivery."@en .

sstim-v:presencePerceptual a owl:NamedIndividual, sstim:RenderingPresence, skos:Concept ;
    skos:inScheme sstim-v:RenderingPresenceScheme ;
    skos:prefLabel "Perceptually constructed"@en,
                   "Costruito percettivamente"@it,
                   "Construído perceptualmente"@pt,
                   "Construido perceptualmente"@es ;
    skos:notation "perceptual" ;
    skos:definition "The signal does not exist in what reaches the subject and is constructed by the nervous system — a binaural beat being the standard case. Evidence about a physically present signal does not transfer to this without argument."@en .

sstim-v:paramAmplitude a owl:NamedIndividual, sstim:RenderableParameter, skos:Concept ;
    skos:inScheme sstim-v:RenderableParameterScheme ;
    skos:prefLabel "Amplitude"@en,
                   "Ampiezza"@it,
                   "Amplitude"@pt,
                   "Amplitud"@es ;
    skos:notation "amplitude" ;
    skos:definition "The intensity of the stimulus in its own units."@en .

sstim-v:paramFrequency a owl:NamedIndividual, sstim:RenderableParameter, skos:Concept ;
    skos:inScheme sstim-v:RenderableParameterScheme ;
    skos:prefLabel "Frequency"@en,
                   "Frequenza"@it,
                   "Frequência"@pt,
                   "Frecuencia"@es ;
    skos:notation "frequency" ;
    skos:definition "The frequency of a carrier or tone the signal drives."@en .

sstim-v:paramLuminance a owl:NamedIndividual, sstim:RenderableParameter, skos:Concept ;
    skos:inScheme sstim-v:RenderableParameterScheme ;
    skos:prefLabel "Luminance"@en,
                   "Luminanza"@it,
                   "Luminância"@pt,
                   "Luminancia"@es ;
    skos:notation "luminance" ;
    skos:definition "The brightness of a visual stimulus."@en .

sstim-v:paramSize a owl:NamedIndividual, sstim:RenderableParameter, skos:Concept ;
    skos:inScheme sstim-v:RenderableParameterScheme ;
    skos:prefLabel "Size"@en,
                   "Dimensione"@it,
                   "Tamanho"@pt,
                   "Tamaño"@es ;
    skos:notation "size" ;
    skos:definition "The extent of a visual stimulus, as used by an expanding and contracting breathing guide."@en .

sstim-v:paramSpatialPosition a owl:NamedIndividual, sstim:RenderableParameter, skos:Concept ;
    skos:inScheme sstim-v:RenderableParameterScheme ;
    skos:prefLabel "Spatial position"@en,
                   "Posizione spaziale"@it,
                   "Posição espacial"@pt,
                   "Posición espacial"@es ;
    skos:notation "spatial-position" ;
    skos:definition "Where the stimulus appears in space. A signal rendered onto this parameter is what the BSC catalog encoded as a Martigli-synced panning mode."@en .

sstim-v:paramVibrationIntensity a owl:NamedIndividual, sstim:RenderableParameter, skos:Concept ;
    skos:inScheme sstim-v:RenderableParameterScheme ;
    skos:prefLabel "Vibration intensity"@en,
                   "Intensità di vibrazione"@it,
                   "Intensidade de vibração"@pt,
                   "Intensidad de vibración"@es ;
    skos:notation "vibration-intensity" ;
    skos:definition "The strength of a haptic stimulus."@en .

sstim-v:shapeSine skos:topConceptOf sstim-v:SignalShapeScheme .
sstim-v:shapeSquare skos:topConceptOf sstim-v:SignalShapeScheme .
sstim-v:shapeSawtooth skos:topConceptOf sstim-v:SignalShapeScheme .
sstim-v:shapeTriangle skos:topConceptOf sstim-v:SignalShapeScheme .
sstim-v:shapeEnvelope skos:topConceptOf sstim-v:SignalShapeScheme .
sstim-v:shapeNoise skos:topConceptOf sstim-v:SignalShapeScheme .
sstim-v:shapeSampled skos:topConceptOf sstim-v:SignalShapeScheme .

sstim-v:mechanismDirectPresentation skos:topConceptOf sstim-v:RenderingMechanismScheme .
sstim-v:mechanismAmplitudeModulation skos:topConceptOf sstim-v:RenderingMechanismScheme .
sstim-v:mechanismFrequencyModulation skos:topConceptOf sstim-v:RenderingMechanismScheme .
sstim-v:mechanismBinauralBeat skos:topConceptOf sstim-v:RenderingMechanismScheme .
sstim-v:mechanismMonauralBeat skos:topConceptOf sstim-v:RenderingMechanismScheme .

sstim-v:presencePhysical skos:topConceptOf sstim-v:RenderingPresenceScheme .
sstim-v:presencePerceptual skos:topConceptOf sstim-v:RenderingPresenceScheme .

sstim-v:paramAmplitude skos:topConceptOf sstim-v:RenderableParameterScheme .
sstim-v:paramFrequency skos:topConceptOf sstim-v:RenderableParameterScheme .
sstim-v:paramLuminance skos:topConceptOf sstim-v:RenderableParameterScheme .
sstim-v:paramSize skos:topConceptOf sstim-v:RenderableParameterScheme .
sstim-v:paramSpatialPosition skos:topConceptOf sstim-v:RenderableParameterScheme .
sstim-v:paramVibrationIntensity skos:topConceptOf sstim-v:RenderableParameterScheme .

###########################################################################
#
#  SSTIM Exposure and Experiment Module  —  sstim-exposure.ttl
#
#  Namespace:  https://w3id.org/sstim/exposure#
#  Module IRI: https://w3id.org/sstim/exposure
#  Version:    0.16.0
#  Date:       2026-08-18
#  Author:     Renato Fabbri <renato@junto.space>
#  License:    CC BY 4.0
#
#  Flat Turtle module. Runtime named graph:
#  https://w3id.org/sstim/graph/exposure
#
###########################################################################

@prefix sstim:    <https://w3id.org/sstim#> .
@prefix sstim-ex: <https://w3id.org/sstim/exposure#> .
@prefix sstim-v:  <https://w3id.org/sstim/vocab#> .

@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix iao:   <http://purl.obolibrary.org/obo/IAO_> .
@prefix obi:   <http://purl.obolibrary.org/obo/OBI_> .


###########################################################################
# Module metadata
###########################################################################

<https://w3id.org/sstim/exposure> a owl:Ontology ;
    # No version IRI / prior version: SSTIM is versioned as a whole set — the
    # frozen snapshot at static/ontology/<version>/ (identified by the core
    # version IRI) is the citable unit. Modules carry owl:versionInfo only, as a
    # module-level change counter. See ADR 0020.
    # /sstim/exposure serves the Stimulus + Exposure namespace catalogue after
    # ADR 0044, so profiles import the exact module retrieval endpoint
    # https://w3id.org/sstim/module/exposure. An OWL 2 import names an
    # ontology *document*, not an ontology IRI, so no version IRI is needed.
    owl:versionInfo "0.16.0" ;
    dct:title "SSTIM Exposure and Experiment Module"@en ;
    dct:description "Reusable SSTIM module for separating physical delivery medium, perceived modality, device capability, body placement, comfort boundary, experiment context, effect claims, and knowledge status."@en ;
    dct:isPartOf <https://w3id.org/sstim> ;
    dct:requires <https://w3id.org/sstim>, <https://w3id.org/sstim/configuration>, <https://w3id.org/sstim/evidence>, <https://w3id.org/sstim/stimulus>, <https://w3id.org/sstim/technique>, <https://w3id.org/sstim/vocab> ;
    dct:creator <https://orcid.org/0000-0002-9699-629X> ;
    dct:publisher <https://github.com/laBioSynCare> ;
    dct:created "2026-06-18"^^xsd:date ;
    dct:issued "2026-08-18"^^xsd:date ;
    dct:modified "2026-08-18"^^xsd:date ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    rdfs:seeAlso <https://github.com/laBioSynCare/laBioSynCare.github.io/blob/main/docs/decisions/0010-exposure-delivery-modality.md> ,
        <https://github.com/laBioSynCare/laBioSynCare.github.io/blob/main/docs/decisions/0011-sensory-field-and-flash-safety.md> ;
    skos:historyNote "Initial exposure module for post-0.3.0 ontology work. The module does not assert physiological or health effects directly; those statements must be modeled as qualified claims with evidence or knowledge status."@en ;
    skos:historyNote "0.4.0 — added left/right laterality body placements, quantitative stimulus datatype properties (frequency, flicker rate, beat frequency, duty cycle, gain, phase), the ExposureLimit class with quantified optical/flicker/hearing safety boundaries citing external standards, and the affordsDeliveryMedium capability-to-medium relation. Grounds the Sensory Field interface (ADR 0011)."@en ;
    skos:historyNote "0.4.1 — added the sstim-ex: to sstim-v: perceived-modality/sensory-channel closeMatch bridge and the somatosensory/haptic/tactile/vibrotactile convention scope notes (ADR 0019, P5.5). Released as part of SSTIM 0.5.0. Additive; no terms removed or renamed."@en ;
    skos:historyNote "0.6.0 — completes operational definitions for every exposure concept, materializes SKOS inverse links for non-reasoning clients, adds precise union domains and scalar cardinalities, and strengthens exposure SHACL coverage. Additive at the term level."@en .


###########################################################################
# Core classes
###########################################################################

sstim-ex:ExposureProfile a owl:Class ;
    rdfs:subClassOf iao:0000030 ;
    rdfs:label "Exposure Profile"@en ;
    skos:definition "Information artifact describing how one exploratory or operational stimulation exposure is delivered, perceived, placed, bounded, and interpreted."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> ;
    rdfs:seeAlso <https://github.com/laBioSynCare/laBioSynCare.github.io/blob/main/docs/decisions/0010-exposure-delivery-modality.md> .

sstim-ex:PhysicalDeliveryMedium a owl:Class ;
    rdfs:subClassOf iao:0000030 ;
    rdfs:label "Physical Delivery Medium"@en ;
    skos:definition "Controlled vocabulary class for the physical medium, energy, material, or environmental interface through which a stimulus or exposure reaches a person."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:PerceivedModality a owl:Class ;
    rdfs:subClassOf iao:0000030 ;
    rdfs:label "Perceived Modality"@en ;
    skos:definition "Controlled vocabulary class for the sensory, perceptual, behavioral, interoceptive, or social-perceptual channel engaged by an exposure."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:DeviceCapability a owl:Class ;
    rdfs:subClassOf iao:0000030 ;
    rdfs:label "Device Capability"@en ;
    skos:definition "Controlled vocabulary class for hardware or environmental capabilities required to deliver, separate, sense, or shape an exposure."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:BodyPlacement a owl:Class ;
    rdfs:subClassOf iao:0000030 ;
    rdfs:label "Body Placement"@en ;
    skos:definition "Controlled vocabulary class for where a device, medium, or exposure is placed on, in, or near the body."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:ComfortBoundary a owl:Class ;
    rdfs:subClassOf iao:0000030 ;
    rdfs:label "Comfort Boundary"@en ;
    skos:definition "A boundary or caution condition for comfort, discomfort, awareness, fatigue, or risk during an exposure."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:ExposureEffectClaim a owl:Class ;
    owl:deprecated true ;
    rdfs:subClassOf sstim:EvidenceClaim ;
    rdfs:label "Exposure Effect Claim (deprecated)"@en ;
    skos:definition "Deprecated ADR 0027: this class mixed hypotheses, questions, boundary applicability, requirements, design objectives, planned outcomes, and status assertions under evidence semantics. Its instances migrate to the role-specific statement classes; removed no earlier than 1.0."@en ;
    skos:historyNote "Deprecated 2026-07-13 by ADR 0027; the 27 live instances migrate per the ADR 0027 migration ledger."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> ;
    rdfs:seeAlso <https://github.com/laBioSynCare/laBioSynCare.github.io/blob/main/docs/decisions/0010-exposure-delivery-modality.md> ,
        <https://github.com/laBioSynCare/laBioSynCare.github.io/blob/main/docs/decisions/0027-evidence-claim-family-and-public-claim-gate.md> .

sstim-ex:ExperimentContext a owl:Class ;
    rdfs:subClassOf iao:0000030 ;
    rdfs:label "Experiment Context"@en ;
    skos:definition "Information artifact describing the local context of an exploratory protocol or exposure example."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:BiohackingContext a owl:Class ;
    rdfs:subClassOf sstim-ex:ExperimentContext ;
    rdfs:label "Biohacking Context"@en ;
    skos:definition "Experiment context for exploratory self-observation, sensory experimentation, or non-clinical biohacking practice."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:ExploratoryProtocol a owl:Class ;
    rdfs:subClassOf iao:0000030 ;
    rdfs:subClassOf obi:0000272 ;
    rdfs:label "Exploratory Protocol"@en ;
    skos:definition "Non-clinical protocol used to explore an exposure idea, capability boundary, or perceptual hypothesis without asserting treatment, diagnosis, cure, or guaranteed effect."@en ;
    skos:scopeNote "Deliberately not a subclass of any stimulation protocol: a baseline defined by the absence of stimulation, or a mere-exposure hypothesis, must not become stimulation by inheritance. An exploratory protocol that is genuinely stimulation declares that type explicitly (ADR 0034 §7)."@en ;
    rdfs:seeAlso <https://github.com/laBioSynCare/laBioSynCare.github.io/blob/main/docs/decisions/0034-neuromodulation-relation-and-neural-target-axis.md> ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:PerceptualGain a owl:Class ;
    rdfs:subClassOf iao:0000030 ;
    rdfs:label "Perceptual Gain"@en ;
    skos:definition "A perceived capability, salience, immersion, or access gained by an exposure setup."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:PerceptualLoss a owl:Class ;
    rdfs:subClassOf iao:0000030 ;
    rdfs:label "Perceptual Loss"@en ;
    skos:definition "A perceived field, awareness, comfort, capability, or certainty lost or reduced by an exposure setup."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:KnowledgeStatus a owl:Class ;
    rdfs:subClassOf iao:0000030 ;
    rdfs:label "Knowledge Status"@en ;
    skos:definition "Local status vocabulary for distinguishing known SSTIM patterns, hypotheses, unknowns, lack of known SSTIM evidence, and BSC Lab capability boundaries."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:StimulusPattern a owl:Class ;
    rdfs:subClassOf iao:0000030 ;
    rdfs:label "Stimulus Pattern"@en ;
    skos:definition "Controlled vocabulary class for temporal, spatial, color, or stochastic stimulus patterns."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:AudioNoiseColor a owl:Class ;
    rdfs:subClassOf sstim-ex:StimulusPattern ;
    rdfs:label "Audio Noise Color"@en ;
    skos:definition "Controlled vocabulary class for named audio-noise color conventions. Names vary across communities and should be defined by spectral slope when possible."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:VisualNoiseType a owl:Class ;
    rdfs:subClassOf sstim-ex:StimulusPattern ;
    rdfs:label "Visual Noise Type"@en ;
    skos:definition "Controlled vocabulary class for visual noise, visual field, and simple visual stimulus types."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:EffectDimension a owl:Class ;
    rdfs:subClassOf sstim:EvidenceOutcomeConcept ;
    rdfs:label "Effect Dimension"@en ;
    skos:definition "Controlled vocabulary class for comfort, risk, perception, and physiological dimensions that a hypothesis, research question, design objective, or planned outcome can concern. A subclass of sstim:EvidenceOutcomeConcept (ADR 0027), so existing dimension values are reusable as outcome concepts without ad hoc dual typing."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:ExposureLimit a owl:Class ;
    rdfs:subClassOf iao:0000030 ;
    rdfs:label "Exposure Limit"@en ;
    skos:definition "A quantified safety limit for an exposure, such as a maximum flash frequency, a sound-level dose, or an optical-radiation exposure boundary. An exposure limit carries a value and/or maximum frequency, an optional averaging time and body placement, and should cite the external standard it is derived from. It does not itself assert that any specific delivery is safe; it records the threshold against which a delivery is checked."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> ;
    rdfs:seeAlso <https://github.com/laBioSynCare/laBioSynCare.github.io/blob/main/docs/decisions/0011-sensory-field-and-flash-safety.md> .


###########################################################################
# Core properties
###########################################################################

sstim-ex:hasExposureProfile a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( sstim:StimulationProtocol sstim:StimulationTechnique sstim:Stimulation sstim:Preset ) ] ;
    rdfs:range sstim-ex:ExposureProfile ;
    rdfs:label "has exposure profile"@en ;
    skos:definition "Links a protocol, technique, represented stimulation process or intervention, preset, or experiment instance to a structured exposure profile."@en ;
    rdfs:seeAlso <https://github.com/laBioSynCare/laBioSynCare.github.io/blob/main/docs/decisions/0034-neuromodulation-relation-and-neural-target-axis.md> ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:usesStimulusChannel a owl:ObjectProperty ;
    rdfs:domain sstim-ex:ExposureProfile ;
    rdfs:range sstim-ex:StimulusChannel ;
    rdfs:label "uses stimulus channel"@en ;
    skos:definition "Links an exposure profile to a channel through which part of the exposure is delivered or modeled."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

# ADR 0034 §4. Channel role separates an intended causal channel from an
# associated one, so a TMS click or an ultrasound-associated sound can be
# recorded without silently reclassifying the primary technique as sensory.
# Only an intended channel is eligible to participate in sensory-route
# classification, and its asserted neural access route still decides the
# question — channel role alone never does. Omission is unknown, not
# "intended". Role and perceived modality are independent.
sstim-ex:StimulusChannelRole a owl:Class ;
    rdfs:subClassOf iao:0000030 ;
    rdfs:label "Stimulus Channel Role"@en ;
    skos:definition "A controlled category for the part a stimulus channel plays in an exposure: an intended causal intervention path, an associated concomitant exposure, a control or sham path, or a feedback path."@en ;
    rdfs:seeAlso <https://github.com/laBioSynCare/laBioSynCare.github.io/blob/main/docs/decisions/0034-neuromodulation-relation-and-neural-target-axis.md> ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:channelRole a owl:ObjectProperty ;
    rdfs:domain sstim-ex:StimulusChannel ;
    rdfs:range sstim-ex:StimulusChannelRole ;
    rdfs:label "channel role"@en ;
    skos:definition "Links a stimulus channel to the role it plays in the exposure. Deliberate co-stimulation is not concomitant: two or more causal channels may each be intended."@en ;
    rdfs:seeAlso <https://github.com/laBioSynCare/laBioSynCare.github.io/blob/main/docs/decisions/0034-neuromodulation-relation-and-neural-target-axis.md> ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

# ADR 0034 §4. Coarse technique-level characteristic for catalog navigation and
# querying, analogous to the retained coarse sstim:techniqueModality relation.
# Exposure owns this delivery-semantics property. Assertions whose subjects are
# vocabulary-owned techniques live in the Technique–Exposure bridge, so neither
# concern becomes the authoritative owner of cross-concern instance statements.
sstim-ex:characteristicDeliveryMedium a owl:ObjectProperty ;
    rdfs:domain sstim:StimulationTechnique ;
    rdfs:range sstim-ex:PhysicalDeliveryMedium ;
    rdfs:label "characteristic delivery medium"@en ;
    skos:definition "Links a stimulation technique to a physical energy, material, or chemical agent characteristic of the method. It does not describe an executed dose or imply perception or effect; use an exposure profile for channel-level delivery."@en ;
    rdfs:seeAlso <https://github.com/laBioSynCare/laBioSynCare.github.io/blob/main/docs/decisions/0034-neuromodulation-relation-and-neural-target-axis.md> ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:deliveryMedium a owl:ObjectProperty ;
    rdfs:domain sstim-ex:StimulusChannel ;
    rdfs:range sstim-ex:PhysicalDeliveryMedium ;
    rdfs:label "delivery medium"@en ;
    skos:definition "Links a stimulus channel to the physical medium, energy, material, or interface used for delivery."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:perceivedModality a owl:ObjectProperty ;
    rdfs:domain sstim-ex:StimulusChannel ;
    rdfs:range sstim-ex:PerceivedModality ;
    rdfs:label "perceived modality"@en ;
    skos:definition "Links a stimulus channel to the sensory, perceptual, behavioral, interoceptive, or social-perceptual modality it engages."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:requiresDeviceCapability a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( sstim-ex:ExposureProfile sstim-ex:StimulusChannel sstim:StimulationProtocol ) ] ;
    rdfs:range sstim-ex:DeviceCapability ;
    rdfs:label "requires device capability"@en ;
    skos:definition "Links an exposure profile, stimulus channel, or protocol to a hardware or environmental capability required for delivery."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:hasBodyPlacement a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf
        ( sstim-ex:ExposureProfile sstim-ex:StimulusChannel sstim-ex:DeviceCapability ) ] ;
    rdfs:range sstim-ex:BodyPlacement ;
    rdfs:label "has body placement"@en ;
    skos:definition "Links an exposure profile, stimulus channel, or capability to a body or near-body placement."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:hasComfortBoundary a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( sstim-ex:ExposureProfile sstim-ex:StimulusChannel ) ] ;
    rdfs:range sstim-ex:ComfortBoundary ;
    rdfs:label "has comfort boundary"@en ;
    skos:definition "Links an exposure profile or stimulus channel to a comfort, discomfort, fatigue, awareness, or risk boundary."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:hasPerceptualGain a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf
        ( sstim-ex:ExposureProfile sstim:StimulationProtocol ) ] ;
    rdfs:range sstim-ex:PerceptualGain ;
    rdfs:label "has perceptual gain"@en ;
    skos:definition "Links an exposure profile or protocol to a perceived gain created by the setup."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:hasPerceptualLoss a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf
        ( sstim-ex:ExposureProfile sstim:StimulationProtocol ) ] ;
    rdfs:range sstim-ex:PerceptualLoss ;
    rdfs:label "has perceptual loss"@en ;
    skos:definition "Links an exposure profile or protocol to a perceived loss, cost, or limitation created by the setup."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:hasEffectClaim a owl:ObjectProperty ;
    owl:deprecated true ;
    rdfs:range sstim-ex:ExposureEffectClaim ;
    rdfs:label "has effect claim (deprecated)"@en ;
    skos:definition "Deprecated ADR 0027: the single link mixed hypotheses, questions, boundary applicability, requirements, design objectives, and planned outcomes. Use the role-specific hasHypothesis, hasResearchQuestion, hasBoundaryApplicability, hasProtocolRequirement, hasDesignObjective, hasPlannedOutcome, or hasKnowledgeStatusAssertion; removed no earlier than 1.0."@en ;
    rdfs:seeAlso <https://github.com/laBioSynCare/laBioSynCare.github.io/blob/main/docs/decisions/0027-evidence-claim-family-and-public-claim-gate.md> ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:hasExperimentContext a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( sstim:StimulationProtocol sstim-ex:ExposureProfile ) ] ;
    rdfs:range sstim-ex:ExperimentContext ;
    rdfs:label "has experiment context"@en ;
    skos:definition "Links an exploratory protocol or exposure profile to the context in which it is proposed or used."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:hasKnowledgeStatus a owl:ObjectProperty ;
    rdfs:range sstim-ex:KnowledgeStatus ;
    rdfs:label "has knowledge status"@en ;
    skos:definition "Links a protocol, exposure profile, channel, device capability, statement role, or knowledge-status assertion to a controlled SSTIM/BSC Lab knowledge or capability status value. Carries no OWL domain (ADR 0027, KR-05): SHACL enforces allowed subjects, admitting the DeviceCapability use promised here and preventing status links from re-inferring evidence semantics."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:hasStimulusPattern a owl:ObjectProperty ;
    rdfs:domain sstim-ex:StimulusChannel ;
    rdfs:range sstim-ex:StimulusPattern ;
    rdfs:label "has stimulus pattern"@en ;
    skos:definition "Links a stimulus channel to a temporal, spatial, color, noise, or texture pattern."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:concernsEffectDimension a owl:ObjectProperty ;
    rdfs:range sstim-ex:EffectDimension ;
    rdfs:label "concerns effect dimension"@en ;
    skos:definition "Links a hypothesis, research question, design objective, or planned-outcome specification to the comfort, risk, perception, or physiological dimension it concerns. Carries no OWL domain (ADR 0027): allowed subjects are enforced in SHACL so use on a non-evidence statement cannot re-infer the deprecated ExposureEffectClaim."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:hasExposureLimit a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf
        ( sstim-ex:ComfortBoundary sstim-ex:DeviceCapability ) ] ;
    rdfs:range sstim-ex:ExposureLimit ;
    rdfs:label "has exposure limit"@en ;
    skos:definition "Links a comfort boundary or device capability to a quantified exposure limit against which a delivery is checked."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:conformsToStandard a owl:ObjectProperty ;
    rdfs:domain sstim-ex:ExposureLimit ;
    rdfs:range dct:Standard ;
    rdfs:label "conforms to standard"@en ;
    skos:definition "Links an exposure limit to the external standard, guideline, or recommendation it is derived from."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:appliesToPlacement a owl:ObjectProperty ;
    rdfs:domain sstim-ex:ExposureLimit ;
    rdfs:range sstim-ex:BodyPlacement ;
    rdfs:label "applies to placement"@en ;
    skos:definition "Links an exposure limit to the body or near-body placement it applies to, since limits differ by site (for example eyes are more vulnerable than hands to optical radiation)."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:affordsDeliveryMedium a owl:ObjectProperty ;
    rdfs:domain sstim-ex:DeviceCapability ;
    rdfs:range sstim-ex:PhysicalDeliveryMedium ;
    rdfs:label "affords delivery medium"@en ;
    skos:definition "Links a device capability to the physical delivery medium it produces or affords, making the capability-to-medium pairing explicit rather than implied by naming."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

# ADR 0052. hasFrequencyHz meant "carrier or tone frequency" — two things under
# one name. Rather than deprecate it, it becomes the generic parent of a family
# that says which role a frequency plays, so existing assertions stay valid and
# a consumer asking "what frequencies does this channel present?" still gets an
# answer from one property.
#
# The parent loses owl:FunctionalProperty in the process, and must: a channel
# presenting a 200 Hz carrier modulated at 10 Hz has two frequencies, and a
# functional parent would have entailed 200 = 10 and made the graph
# inconsistent. Each subproperty stays functional, which is where the constraint
# actually belongs.
sstim-ex:hasFrequencyHz a owl:DatatypeProperty ;
    rdfs:domain sstim-ex:StimulusChannel ;
    rdfs:range xsd:decimal ;
    rdfs:label "frequency (Hz)"@en ;
    skos:definition "A frequency this stimulus channel presents, in hertz, without saying what role it plays. The generic parent of the frequency family; assert a subproperty where the role is known, and this one only where it genuinely is not."@en ;
    skos:historyNote "Until 0.15 this was defined as \"carrier or tone frequency\" and was functional. Both were wrong for a generic: the two senses are different things, and a channel may present several frequencies at once. ADR 0052 made it the parent of hasCarrierFrequencyHz, hasToneFrequencyHz and hasModulationFrequencyHz, and dropped functionality, which is a weakening — every existing assertion remains valid and now also entails nothing it did not before."@en ;
    rdfs:seeAlso <https://github.com/laBioSynCare/laBioSynCare.github.io/blob/main/docs/decisions/0052-abstract-signals-and-sensory-renderings.md> ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:hasCarrierFrequencyHz a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:subPropertyOf sstim-ex:hasFrequencyHz ;
    rdfs:domain sstim-ex:StimulusChannel ;
    rdfs:range xsd:decimal ;
    rdfs:label "carrier frequency (Hz)"@en ;
    skos:definition "The frequency of a carrier this channel presents: a frequency whose job is to bear a signal the sense cannot receive directly. The 200 and 210 Hz tones of a 10 Hz binaural beat are carriers, as is the audible tone an isochronic rate modulates."@en ;
    skos:scopeNote "A carrier exists because of a limitation of the sense addressed, not because of anything about the signal: 10 Hz falls below the audible range and must be carried, while a 10 Hz light flicker or vibration is presented directly and has no carrier at all. Beside sstim:renderingCarrierHz, which states the same quantity one layer up, on the rendering that chose it. This one describes emission and joins the sstim-ex:hasFrequencyHz family so a consumer can ask what a channel presents without knowing how it was specified; that one describes a binding. Where both are asserted they must agree, which SHACL enforces."@en ;
    rdfs:seeAlso <https://github.com/laBioSynCare/laBioSynCare.github.io/blob/main/docs/decisions/0052-abstract-signals-and-sensory-renderings.md> ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:hasToneFrequencyHz a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:subPropertyOf sstim-ex:hasFrequencyHz ;
    rdfs:domain sstim-ex:StimulusChannel ;
    rdfs:range xsd:decimal ;
    rdfs:label "tone frequency (Hz)"@en ;
    skos:definition "The frequency of a tone or periodic stimulus that is itself what reaches the subject, carrying nothing — a 440 Hz reference tone, or a 10 Hz vibration delivered as itself."@en ;
    rdfs:seeAlso <https://github.com/laBioSynCare/laBioSynCare.github.io/blob/main/docs/decisions/0052-abstract-signals-and-sensory-renderings.md> ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:hasModulationFrequencyHz a owl:DatatypeProperty ;
    rdfs:subPropertyOf sstim-ex:hasFrequencyHz ;
    rdfs:domain sstim-ex:StimulusChannel ;
    rdfs:range xsd:decimal ;
    rdfs:label "modulation frequency (Hz)"@en ;
    skos:definition "The rate at which something about this channel varies, as distinct from a carrier that bears it. The general case of a flicker rate and of a beat frequency, both of which specialise it."@en ;
    skos:scopeNote "Not functional, because a channel may be modulated in more than one respect at once — amplitude at one rate and spatial position at another. Where the modulation is a flicker or a beat, assert the specific subproperty."@en ;
    rdfs:seeAlso <https://github.com/laBioSynCare/laBioSynCare.github.io/blob/main/docs/decisions/0052-abstract-signals-and-sensory-renderings.md> ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:hasFlickerRateHz a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:subPropertyOf sstim-ex:hasModulationFrequencyHz ;
    rdfs:domain sstim-ex:StimulusChannel ;
    rdfs:range xsd:decimal ;
    rdfs:label "flicker rate (Hz)"@en ;
    skos:definition "Blink, pulse, or flicker rate of a stimulus channel, in hertz. Visual flicker rate is subject to photosensitivity exposure limits."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:hasBeatFrequencyHz a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:subPropertyOf sstim-ex:hasModulationFrequencyHz ;
    rdfs:domain sstim-ex:StimulusChannel ;
    rdfs:range xsd:decimal ;
    rdfs:label "beat frequency (Hz)"@en ;
    skos:definition "Monaural or binaural beat frequency (the difference frequency) of an audio stimulus channel, in hertz."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:hasDutyCycle a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain sstim-ex:StimulusChannel ;
    rdfs:range xsd:decimal ;
    rdfs:label "duty cycle"@en ;
    skos:definition "On-fraction of each blink or pulse cycle for a stimulus channel, between 0 and 1."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:hasGainLevel a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain sstim-ex:StimulusChannel ;
    rdfs:range xsd:decimal ;
    rdfs:label "gain level"@en ;
    skos:definition "Relative output amplitude of a stimulus channel, between 0 and 1. This is a relative level, not a calibrated physical intensity."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:hasPhaseOffset a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain sstim-ex:StimulusChannel ;
    rdfs:range xsd:decimal ;
    rdfs:label "phase offset"@en ;
    skos:definition "Phase offset of a stimulus channel's modulation relative to other channels, as a fraction of a cycle between 0 and 1."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

# Reference-pitch / carrier-tuning properties (ADR 0017). These describe the
# absolute pitch (carrier) of an audio stimulus channel — orthogonal to the
# modulation/beat frequency (sstim-ex:hasBeatFrequencyHz, sstim:FrequencyBand).
# Keep any reference-pitch effect claim disjoint from entrainment/beat evidence.
sstim-ex:referencePitchNote a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain sstim-ex:StimulusChannel ;
    rdfs:range xsd:string ;
    rdfs:label "reference pitch note"@en ;
    skos:definition "Named reference note whose pitch a tuning sets, commonly \"A4\"."@en ;
    rdfs:seeAlso <https://github.com/laBioSynCare/laBioSynCare.github.io/blob/main/docs/decisions/0017-reference-pitch-retuning.md> ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:referencePitchHz a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain sstim-ex:StimulusChannel ;
    rdfs:range xsd:decimal ;
    rdfs:label "reference pitch (Hz)"@en ;
    skos:definition "Frequency in hertz assigned to the reference note (e.g. 432 or 440 for A4). This is a carrier/absolute-pitch attribute, not a modulation or beat frequency."@en ;
    rdfs:seeAlso <https://github.com/laBioSynCare/laBioSynCare.github.io/blob/main/docs/decisions/0017-reference-pitch-retuning.md> ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:retunedFromReferenceHz a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain sstim-ex:StimulusChannel ;
    rdfs:range xsd:decimal ;
    rdfs:label "retuned from reference (Hz)"@en ;
    skos:definition "Standard reference frequency the tuning departs from, typically 440 Hz for A4."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:pitchShiftCents a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain sstim-ex:StimulusChannel ;
    rdfs:range xsd:decimal ;
    rdfs:label "pitch shift (cents)"@en ;
    skos:definition "Resulting pitch shift in cents relative to the standard reference (e.g. about -31.77 cents for A4=432 versus A4=440)."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:limitValue a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain sstim-ex:ExposureLimit ;
    rdfs:range xsd:decimal ;
    rdfs:label "limit value"@en ;
    skos:definition "Numeric value of an exposure limit, interpreted together with limitUnit and limitQuantity."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:limitUnit a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain sstim-ex:ExposureLimit ;
    rdfs:range xsd:string ;
    rdfs:label "limit unit"@en ;
    skos:definition "Unit of an exposure limit value (for example \"dBA\" or \"J/m2\"). A QUDT unit IRI may be linked separately where precision is required."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:limitQuantity a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain sstim-ex:ExposureLimit ;
    rdfs:range xsd:string ;
    rdfs:label "limit quantity"@en ;
    skos:definition "Physical quantity an exposure limit constrains (for example \"flash frequency\", \"sound pressure level\", or \"effective irradiance\")."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:limitAveragingTimeSeconds a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain sstim-ex:ExposureLimit ;
    rdfs:range xsd:decimal ;
    rdfs:label "limit averaging time (s)"@en ;
    skos:definition "Averaging or reference time over which an exposure limit is defined, in seconds — an 8-hour dose is 28800. Seconds rather than a duration literal because xsd:duration is only partially ordered (P1M and P30D are not comparable) and is therefore outside the OWL 2 datatype map, which put every Full closure in OWL Full. Carrying the unit in the property name follows the SSTIM parameter convention."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:limitAveragingTime a owl:DatatypeProperty, owl:FunctionalProperty ;
    owl:deprecated true ;
    dct:isReplacedBy sstim-ex:limitAveragingTimeSeconds ;
    rdfs:domain sstim-ex:ExposureLimit ;
    rdfs:label "limit averaging time"@en ;
    skos:definition "Averaging or reference time over which an exposure limit is defined, as an xsd:duration. Deprecated: xsd:duration is outside the OWL 2 datatype map, so its use made the Full closure OWL Full rather than OWL 2 DL. Replaced by sstim-ex:limitAveragingTimeSeconds. The range axiom is withdrawn rather than retyped, so that no xsd:duration reference remains anywhere in the closure."@en ;
    skos:historyNote "Deprecated 2026-08-17. Both public values were \"PT8H\" and are now 28800 seconds on the replacement property."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:limitMaxFrequencyHz a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain sstim-ex:ExposureLimit ;
    rdfs:range xsd:decimal ;
    rdfs:label "limit maximum frequency (Hz)"@en ;
    skos:definition "Maximum frequency permitted by a cited exposure or accessibility rule, in hertz; compliance with the value is not an individual safety guarantee."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .


###########################################################################
# Controlled vocabulary schemes
###########################################################################

sstim-ex:StimulusChannelRoleScheme a skos:ConceptScheme ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    skos:prefLabel "Stimulus Channel Role Scheme"@en ;
    skos:definition "Roles a stimulus channel can play in an exposure profile: intended causal intervention, concomitant exposure, control or sham, or feedback."@en ;
    skos:hasTopConcept
        sstim-ex:roleIntendedIntervention,
        sstim-ex:roleConcomitant,
        sstim-ex:roleControlOrSham,
        sstim-ex:roleFeedback .

sstim-ex:roleIntendedIntervention a owl:NamedIndividual, sstim-ex:StimulusChannelRole, skos:Concept ;
    skos:inScheme sstim-ex:StimulusChannelRoleScheme ;
    skos:topConceptOf sstim-ex:StimulusChannelRoleScheme ;
    skos:prefLabel "intended intervention channel"@en,
                   "canale di intervento previsto"@it,
                   "canal de intervenção pretendida"@pt,
                   "canal de intervención prevista"@es ;
    skos:notation "intended-intervention" ;
    skos:definition "A channel intended to mediate the intervention objective. Only an intended channel is eligible to participate in sensory-route classification, and its asserted neural access route still decides that question."@en ;
    skos:scopeNote "Deliberate co-stimulation is not concomitant: two or more causal channels may each carry this role."@en .

sstim-ex:roleConcomitant a owl:NamedIndividual, sstim-ex:StimulusChannelRole, skos:Concept ;
    skos:inScheme sstim-ex:StimulusChannelRoleScheme ;
    skos:topConceptOf sstim-ex:StimulusChannelRoleScheme ;
    skos:prefLabel "concomitant channel"@en,
                   "canale concomitante"@it,
                   "canal concomitante"@pt,
                   "canal concomitante"@es ;
    skos:notation "concomitant" ;
    skos:definition "An associated channel or exposure that accompanies the intervention but is not intended to mediate its objective — for example a TMS coil click or an ultrasound-associated sound."@en ;
    skos:scopeNote "Reserved for unintended accompaniment. Recording a concomitant channel never reclassifies the primary technique, and such a channel cannot satisfy a route-consistency requirement."@en .

sstim-ex:roleControlOrSham a owl:NamedIndividual, sstim-ex:StimulusChannelRole, skos:Concept ;
    skos:inScheme sstim-ex:StimulusChannelRoleScheme ;
    skos:topConceptOf sstim-ex:StimulusChannelRoleScheme ;
    skos:prefLabel "control or sham channel"@en,
                   "canale di controllo o sham"@it,
                   "canal de controle ou sham"@pt,
                   "canal de control o sham"@es ;
    skos:notation "control-or-sham" ;
    skos:definition "A channel serving as a control or sham condition rather than as the intended causal path."@en .

sstim-ex:roleFeedback a owl:NamedIndividual, sstim-ex:StimulusChannelRole, skos:Concept ;
    skos:inScheme sstim-ex:StimulusChannelRoleScheme ;
    skos:topConceptOf sstim-ex:StimulusChannelRoleScheme ;
    skos:prefLabel "feedback channel"@en,
                   "canale di feedback"@it,
                   "canal de retroalimentação"@pt,
                   "canal de retroalimentación"@es ;
    skos:notation "feedback" ;
    skos:definition "A channel that returns a measured or derived signal to the participant."@en .

sstim-ex:DeliveryMediumScheme a skos:ConceptScheme ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    skos:prefLabel "Delivery Medium Scheme"@en ;
    skos:definition "Physical media, energies, materials, and interfaces used to deliver or model an exposure."@en ;
    skos:hasTopConcept
