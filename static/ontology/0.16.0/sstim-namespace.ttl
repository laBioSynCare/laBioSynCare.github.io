###########################################################################

@prefix sstim:     <https://w3id.org/sstim#> .
@prefix sstim-v:   <https://w3id.org/sstim/vocab#> .
@prefix sstim-sh:  <https://w3id.org/sstim/shapes#> .
@prefix sstim-ex:  <https://w3id.org/sstim/exposure#> .
@prefix sstim-eco: <https://w3id.org/sstim/ecosystem#> .

@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix mod:   <https://w3id.org/mod#> .

@prefix bfo:   <http://purl.obolibrary.org/obo/BFO_> .
@prefix obi:   <http://purl.obolibrary.org/obo/OBI_> .
@prefix iao:   <http://purl.obolibrary.org/obo/IAO_> .
@prefix cob:   <http://purl.obolibrary.org/obo/COB_> .
@prefix ro:    <http://purl.obolibrary.org/obo/RO_> .


###########################################################################
# Module metadata
###########################################################################

<https://w3id.org/sstim/evidence-exposure> a owl:Ontology ;
    owl:versionInfo "0.16.0" ;
    dct:title "SSTIM Evidence–Exposure Bridge Module"@en ;
    dct:description "Optional range axioms connecting generic evidence scope and basis relations to exposure profiles and experiment contexts."@en ;
    dct:isPartOf <https://w3id.org/sstim> ;
    dct:requires <https://w3id.org/sstim/evidence>, <https://w3id.org/sstim/exposure>, <https://w3id.org/sstim/configuration>, <https://w3id.org/sstim/technique>, <https://w3id.org/sstim/session> ;
    dct:creator <https://orcid.org/0000-0002-9699-629X> ;
    dct:publisher <https://github.com/laBioSynCare> ;
    dct:created "2026-08-01"^^xsd:date ;
    dct:issued "2026-08-18"^^xsd:date ;
    dct:modified "2026-08-18"^^xsd:date ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> .


###########################################################################
# Evidence scope and basis exposure ranges
###########################################################################

sstim:scopeInterventionOrContext rdfs:range [ a owl:Class ; owl:unionOf ( sstim:Preset sstim:StimulationTechnique sstim:StimulationProtocol sstim:StimulationIntervention sstim-ex:ExperimentContext sstim-ex:ExposureProfile sstim:ScopeMarker ) ] .

sstim:basisIntervention rdfs:range [ a owl:Class ; owl:unionOf ( sstim:StimulationTechnique sstim:StimulationProtocol sstim:StimulationIntervention sstim-ex:ExposureProfile ) ] .


###########################################################################
# End of evidence-exposure
###########################################################################

###########################################################################
#
#  SSTIM Technique–Exposure Bridge Module
#
#  Version:    0.16.0
