sstim-ex:audioNoiseWhite a owl:NamedIndividual, sstim-ex:AudioNoiseColor, skos:Concept ;
    skos:inScheme sstim-ex:AudioNoiseColorScheme ;
    skos:topConceptOf sstim-ex:AudioNoiseColorScheme ;
    skos:prefLabel "white noise"@en,
                   "rumore bianco"@it,
                   "ruído branco"@pt,
                   "ruido blanco"@es ;
    skos:definition "Noise with equal power per unit frequency, so its spectrum is flat. Perceptually bright, because hearing resolves higher frequencies into wider bands."@en ;
    skos:notation "white" ;
    skos:scopeNote "Define by spectral slope or generation method when used in a protocol."@en .

sstim-ex:audioNoisePink a owl:NamedIndividual, sstim-ex:AudioNoiseColor, skos:Concept ;
    skos:inScheme sstim-ex:AudioNoiseColorScheme ;
    skos:topConceptOf sstim-ex:AudioNoiseColorScheme ;
    skos:prefLabel "pink noise"@en,
                   "rumore rosa"@it,
                   "ruído rosa"@pt,
                   "ruido rosa"@es ;
    skos:definition "Noise with equal power per octave, falling at about 3 dB per octave. The closest of the coloured noises to how broadband sound is heard."@en ;
    skos:notation "pink" ;
    skos:scopeNote "Define by spectral slope or generation method when used in a protocol."@en .

sstim-ex:audioNoiseBrownRed a owl:NamedIndividual, sstim-ex:AudioNoiseColor, skos:Concept ;
    skos:inScheme sstim-ex:AudioNoiseColorScheme ;
    skos:topConceptOf sstim-ex:AudioNoiseColorScheme ;
    skos:prefLabel "brown/red noise"@en,
                   "rumore marrone/rosso"@it,
                   "ruído marrom/vermelho"@pt,
                   "ruido marrón/rojo"@es ;
    skos:definition "Noise falling at about 6 dB per octave, weighting low frequencies heavily. Perceptually deep and rumbling."@en ;
    skos:notation "brown-red" ;
    skos:altLabel "Brownian noise"@en, "red noise"@en ;
    skos:scopeNote "Define by spectral slope or generation method when used in a protocol."@en .

sstim-ex:audioNoiseBlue a owl:NamedIndividual, sstim-ex:AudioNoiseColor, skos:Concept ;
    skos:inScheme sstim-ex:AudioNoiseColorScheme ;
    skos:topConceptOf sstim-ex:AudioNoiseColorScheme ;
    skos:prefLabel "blue noise"@en,
                   "rumore blu"@it,
                   "ruído azul"@pt,
                   "ruido azul"@es ;
    skos:definition "Noise rising at about 3 dB per octave, the inverse of pink. Perceptually thin and hissing."@en ;
    skos:notation "blue" ;
    skos:scopeNote "Define by spectral slope or generation method when used in a protocol."@en .

sstim-ex:audioNoiseVioletPurple a owl:NamedIndividual, sstim-ex:AudioNoiseColor, skos:Concept ;
    skos:inScheme sstim-ex:AudioNoiseColorScheme ;
    skos:topConceptOf sstim-ex:AudioNoiseColorScheme ;
    skos:prefLabel "violet/purple noise"@en,
                   "rumore violetto/porpora"@it,
                   "ruído violeta/púrpura"@pt,
                   "ruido violeta/púrpura"@es ;
    skos:definition "Noise rising at about 6 dB per octave, the inverse of brown. The brightest of the coloured noises."@en ;
    skos:notation "violet-purple" ;
    skos:altLabel "purple noise"@en ;
    skos:scopeNote "Define by spectral slope or generation method when used in a protocol."@en .

sstim-ex:audioNoiseGrey a owl:NamedIndividual, sstim-ex:AudioNoiseColor, skos:Concept ;
    skos:inScheme sstim-ex:AudioNoiseColorScheme ;
    skos:topConceptOf sstim-ex:AudioNoiseColorScheme ;
    skos:prefLabel "grey noise"@en,
                   "rumore grigio"@it,
                   "ruído cinza"@pt,
                   "ruido gris"@es ;
