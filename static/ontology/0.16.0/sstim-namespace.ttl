sstim-ex:modalityTactile a owl:NamedIndividual, sstim-ex:PerceivedModality, skos:Concept ;
    skos:inScheme sstim-ex:PerceivedModalityScheme ;
    skos:topConceptOf sstim-ex:PerceivedModalityScheme ;
    skos:prefLabel "tactile"@en,
                   "tattile"@it,
                   "tátil"@pt,
                   "táctil"@es ;
    skos:notation "tactile" ;
    skos:definition "Perceived cutaneous touch, pressure, vibration, texture, or temperature."@en ;
    skos:scopeNote "The tactile percept is a sub-modality of the somatosensory body-sense channel (sstim-ex:modalitySomatosensory); distinct from the haptic device path and the vibrotactile mechanism (P5.5 convention; ADR 0019)."@en .

sstim-ex:modalitySomatosensory a owl:NamedIndividual, sstim-ex:PerceivedModality, skos:Concept ;
    skos:inScheme sstim-ex:PerceivedModalityScheme ;
    skos:topConceptOf sstim-ex:PerceivedModalityScheme ;
    skos:prefLabel "somatosensory"@en,
                   "somatosensoriale"@it,
                   "somatossensorial"@pt,
                   "somatosensorial"@es ;
    skos:notation "somatosensory" ;
    skos:definition "Body-perceived sensation including touch, vibration, pressure, proprioception, or related body sensation."@en ;
    skos:scopeNote "Superordinate body-sense channel: the tactile percept (sstim-ex:modalityTactile) is a sub-modality, the haptic actuator is the device path, and vibrotactile is the mechanism (P5.5 convention; ADR 0019)."@en ;
    skos:closeMatch sstim-v:modalitySomatosensory .

sstim-ex:modalityInteroceptive a owl:NamedIndividual, sstim-ex:PerceivedModality, skos:Concept ;
