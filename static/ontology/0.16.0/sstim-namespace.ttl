###########################################################################
# Operational definitions completed in 0.6.0
#
# These annotations complete the previously label-only exposure concepts.
# Effect terms name dimensions that may be measured or hypothesized; they do
# not assert that an exposure changes the dimension.
###########################################################################

# Materialized inverse hierarchy links for clients without OWL inference.
sstim-ex:placementEars skos:narrower sstim-ex:placementEarLeft, sstim-ex:placementEarRight .
sstim-ex:placementEyes skos:narrower sstim-ex:placementEyeLeft, sstim-ex:placementEyeRight .

# Body placements
sstim-ex:placementEars skos:definition "Placement at, over, in, or immediately adjacent to both ears, including bilateral headphones or ear-level transducers."@en .
sstim-ex:placementEyes skos:definition "Placement in front of or optically directed toward both eyes, including screens, head-mounted displays, and light sources."@en .
sstim-ex:placementFeet skos:definition "Placement on, under, or mechanically coupled to one or both feet."@en .
sstim-ex:placementHands skos:definition "Placement in contact with, held by, or immediately directed toward one or both hands."@en .
sstim-ex:placementJoints skos:definition "Placement at or mechanically coupled to one or more articulated body joints."@en .
sstim-ex:placementMouth skos:definition "Placement in, at, or immediately adjacent to the mouth for gustatory, airflow, or oral-contact delivery."@en .
sstim-ex:placementNearbyEnvironment skos:definition "Placement in the participant's immediate environment without direct body contact, such as room speakers, lighting, or tracked objects."@en .
sstim-ex:placementNose skos:definition "Placement at or immediately adjacent to the nose for olfactory or airflow delivery."@en .
sstim-ex:placementTopOfHead skos:definition "Placement on or immediately above the superior surface of the head."@en .
sstim-ex:placementTorso skos:definition "Placement on, around, or mechanically coupled to the chest, abdomen, or back."@en .
sstim-ex:placementWholeBody skos:definition "Placement or exposure distributed across most of the body rather than localized to one site."@en .

# Comfort and safety boundaries
sstim-ex:boundaryBalanceRisk skos:definition "Boundary for loss of stable posture or spatial orientation during immersive, moving, or mechanically perturbed exposure."@en .
sstim-ex:boundaryBodyContactComfort skos:definition "Boundary for pressure, friction, restriction, or other discomfort caused by direct-contact equipment or materials."@en .
sstim-ex:boundaryEnvironmentalAwareness skos:definition "Boundary for retaining sufficient awareness of nearby people, obstacles, alarms, traffic, and other environmental events."@en .
sstim-ex:boundaryEyeStrain skos:definition "Boundary for visual fatigue or discomfort associated with luminance, contrast, focus demand, stereo disparity, motion, or prolonged viewing."@en .
sstim-ex:boundaryHearingRisk skos:definition "Boundary for calibrated sound level and exposure duration intended to limit excessive acoustic dose; consumer gain values alone cannot establish compliance."@en .
sstim-ex:boundaryIsolation skos:definition "Boundary for discomfort, reduced situational awareness, or inability to communicate caused by sensory or social isolation."@en .
sstim-ex:boundaryPhotosensitivity skos:definition "Boundary for flashing, rapid contrast change, or repetitive visual pattern exposure that requires photosensitivity safeguards."@en .
sstim-ex:boundaryThermalComfort skos:definition "Boundary for avoiding uncomfortably hot or cold contact, airflow, liquid, or ambient conditions."@en .

# Device capabilities
sstim-ex:capabilityAirflowActuation skos:definition "Capability to produce controllable airflow with specified direction, rate, or temporal modulation."@en .
sstim-ex:capabilityArGlasses skos:definition "Capability to overlay tracked visual content on a direct view of the physical environment through augmented-reality eyewear."@en .
sstim-ex:capabilityBodyPositionTracking skos:definition "Capability to estimate the position or orientation of the head, limbs, torso, or whole body over time."@en .
sstim-ex:capabilityDisplayFlicker skos:definition "Capability to modulate display luminance or contrast at a specified temporal frequency while enforcing flash-safety limits."@en .
sstim-ex:capabilityDisplayLightOutput skos:definition "Capability to present controlled visible-light color and luminance through a display or luminaire."@en .
sstim-ex:capabilityGravityCueing skos:definition "Capability to apply controlled inertial, tilt, load, or orientation cues that alter perceived body relation to gravity."@en .
sstim-ex:capabilityHapticActuator skos:definition "Capability to deliver controlled tactile or mechanical stimulation through a contact actuator."@en .
sstim-ex:capabilityHeadphones skos:definition "Capability to deliver ear-level audio with left and right channels isolated sufficiently for the intended presentation."@en .
sstim-ex:capabilityHrtfSpatialAudio skos:definition "Capability to render direction-dependent binaural audio using head-related transfer functions or an equivalent spatialization model."@en .
sstim-ex:capabilityJointForceActuation skos:definition "Capability to apply measured or controlled force, resistance, or motion at an articulated joint."@en .
sstim-ex:capabilityLiquidGelTactileImmersion skos:definition "Capability to expose body surfaces to controlled liquid, gel, or compliant material for distributed tactile contact."@en .
sstim-ex:capabilityMultiDeviceBodyPlacement skos:definition "Capability to coordinate multiple devices positioned at distinct body sites within one exposure."@en .
sstim-ex:capabilityPhoneVibration skos:definition "Capability to deliver timed vibration through a mobile device's built-in actuator."@en .
sstim-ex:capabilityRoomScaleTracking skos:definition "Capability to track participant movement and orientation across a defined physical area."@en .
sstim-ex:capabilityScentDelivery skos:definition "Capability to release and clear identified odorants with controlled timing and exposure handling."@en .
sstim-ex:capabilitySensorInput skos:definition "Capability to acquire a measured signal for monitoring, adaptation, or closed-loop control."@en .
sstim-ex:capabilityStereoSeparation skos:definition "Capability to deliver distinguishable left and right audio signals without unacceptable channel leakage."@en .
sstim-ex:capabilityTasteDelivery skos:definition "Capability to present identified gustatory substances or controlled taste-related stimulation with appropriate hygiene controls."@en .
sstim-ex:capabilityThermalActuation skos:definition "Capability to apply controlled warming or cooling within defined contact and exposure limits."@en .
sstim-ex:capabilityVrHeadset skos:definition "Capability to present tracked, stereoscopic, head-mounted virtual visual and audio content."@en .
sstim-ex:capabilityWearableLightArray skos:definition "Capability to coordinate multiple body-worn visible-light emitters with specified spatial and temporal patterns."@en .
sstim-ex:capabilityWearableSpeakerArray skos:definition "Capability to coordinate multiple body-worn or near-body acoustic transducers."@en .

# Effect dimensions
sstim-ex:effectArousal skos:definition "Measurement or hypothesis dimension concerning alertness, activation, or subjective arousal."@en .
sstim-ex:effectBalanceRisk skos:definition "Measurement or risk-assessment dimension concerning postural instability, disorientation, or loss of balance."@en .
sstim-ex:effectBloodPressure skos:definition "Physiological measurement dimension concerning arterial blood pressure; no direction or benefit is implied."@en .
sstim-ex:effectBodyVibration skos:definition "Perceptual or physical measurement dimension concerning vibration transmitted to or perceived across the body."@en .
sstim-ex:effectBreathRate skos:definition "Physiological measurement dimension concerning respiratory cycle frequency or pacing adherence."@en .
sstim-ex:effectCalm skos:definition "Self-report dimension concerning perceived calmness or low activation."@en .
sstim-ex:effectDiscomfort skos:definition "Self-report or observational dimension concerning unpleasant, painful, fatiguing, or intolerable experience."@en .
sstim-ex:effectEyeStrain skos:definition "Self-report or observational dimension concerning visual fatigue, headache-like discomfort, focus demand, or ocular discomfort."@en .
sstim-ex:effectGravityPerception skos:definition "Perceptual dimension concerning sensed orientation, load, or motion relative to gravity."@en .
sstim-ex:effectHearingRisk skos:definition "Risk-assessment dimension concerning excessive sound level or duration and potential auditory harm."@en .
sstim-ex:effectHeartRate skos:definition "Physiological measurement dimension concerning cardiac rate; no direction or health interpretation is implied."@en .
sstim-ex:effectImmersion skos:definition "Self-report or behavioral dimension concerning the sense of presence, absorption, or enclosure in an exposure."@en .
sstim-ex:effectPhotosensitivityRisk skos:definition "Risk-assessment dimension concerning adverse responses to flashing, rapid contrast changes, or repetitive visual patterns."@en .
sstim-ex:effectPleasantness skos:definition "Self-report dimension concerning hedonic valence or how pleasant an exposure is perceived to be."@en .
sstim-ex:effectProprioception skos:definition "Perceptual dimension concerning sensed body position, movement, and force."@en .
sstim-ex:effectSocialConnectedness skos:definition "Self-report or behavioral dimension concerning perceived connection, coordination, or shared attention with other people."@en .
sstim-ex:effectStress skos:definition "Self-report or physiological measurement dimension concerning perceived or measured stress; the term alone asserts no change."@en .
sstim-ex:effectTactileSensation skos:definition "Perceptual dimension concerning touch, pressure, texture, or vibration sensed at the body."@en .
sstim-ex:effectTemperaturePerception skos:definition "Perceptual dimension concerning sensed warmth, coolness, or thermal change."@en .

# Experiment contexts and local knowledge status
sstim-ex:contextBiohacking skos:definition "Exploratory self-experimentation context outside clinical care, requiring explicit uncertainty and safety boundaries."@en .
sstim-ex:contextBscLabPrototype skos:definition "Prototype context used to test BSC Lab representation, controls, or delivery capabilities."@en .
sstim-ex:contextCapabilityBoundary skos:definition "Design-analysis context used to document what current hardware or software can and cannot deliver."@en .
sstim-ex:contextExploratoryNonClinical skos:definition "Research or demonstration context that does not provide clinical care, diagnosis, or treatment."@en .
sstim-ex:contextSelfObservation skos:definition "Context in which a participant records their own experience or measurements without inferring general efficacy."@en .
sstim-ex:contextSocialProtocol skos:definition "Context in which two or more participants coordinate, communicate, or share sensory events under an explicit protocol."@en .
sstim-ex:notCurrentlyDeliverableByBSCLab skos:definition "Local status indicating that the current BSC Lab implementation cannot deliver the described exposure, even if the concept remains relevant to the domain."@en .
sstim-ex:notCurrentlyUsedInBSCLab skos:definition "Local status indicating that BSC Lab does not currently use the described technique, capability, or exposure in its public implementation."@en .
sstim-ex:outsideBSCLabScope skos:definition "Local status indicating that the resource is useful for boundary documentation but is not planned as a BSC Lab delivery feature."@en .

# Perceived modalities
sstim-ex:modalityAuditory skos:definition "Perceived-modality category for hearing or sound-related experience, independent of the physical delivery device."@en .
sstim-ex:modalityVisual skos:definition "Perceived-modality category for sight, luminance, color, form, motion, or depth-related experience."@en .

# Perceptual gains and losses
sstim-ex:gainAudioImmersion skos:definition "Setup characteristic in which acoustic presentation increases perceived enclosure, presence, or separation from ambient sound."@en .
sstim-ex:gainBodyVibration skos:definition "Setup characteristic in which mechanical coupling adds perceivable whole-body or localized vibration."@en .
sstim-ex:gainSocialReflection skos:definition "Setup characteristic in which shared or represented participant activity supports reflection on social coordination or connection."@en .
sstim-ex:gainSpatialAudio skos:definition "Setup characteristic in which directional rendering adds perceivable location, distance, or movement to sound."@en .
sstim-ex:gainStereoDepth skos:definition "Setup characteristic in which binocular disparity or equivalent cues add perceived visual depth."@en .
sstim-ex:gainTactileImmersion skos:definition "Setup characteristic in which distributed contact, texture, pressure, or vibration adds bodily presence."@en .
sstim-ex:gainThermalProximity skos:definition "Setup characteristic in which localized temperature or airflow cues add a sense of nearness or environmental change."@en .
sstim-ex:lossClaimCertainty skos:definition "Interpretive limitation indicating that evidence or mechanism uncertainty constrains what can responsibly be claimed."@en .
sstim-ex:lossComfort skos:definition "Setup cost indicating reduced comfort or tolerability from equipment, intensity, posture, duration, or isolation."@en .
sstim-ex:lossDeliverability skos:definition "Implementation limitation indicating that the described exposure cannot be delivered with the current platform."@en .
sstim-ex:lossDeviceFeasibility skos:definition "Engineering limitation indicating unresolved hardware, calibration, synchronization, hygiene, or control requirements."@en .
sstim-ex:lossEnvironmentalAwareness skos:definition "Setup cost indicating reduced awareness of nearby events, people, obstacles, or alarms."@en .
sstim-ex:lossHorizontalField skos:definition "Visual limitation indicating a reduced horizontal field of view or occlusion of peripheral content."@en .
sstim-ex:lossOutsideVision skos:definition "Visual limitation indicating that content outside the display or optical field cannot be perceived."@en .

# Stimulus patterns and visual noise fields
sstim-ex:patternAdaptive skos:definition "Pattern whose parameters change in response to time, participant input, sensed state, or a control algorithm."@en .
sstim-ex:patternBlinking skos:definition "Pattern that alternates visible and non-visible or high- and low-luminance states with discrete transitions."@en .
sstim-ex:patternChangingColor skos:definition "Pattern in which hue, saturation, or color mixture varies over time."@en .
sstim-ex:patternContinuous skos:definition "Pattern delivered without intentional gaps across the specified exposure interval."@en .
sstim-ex:patternFixedColor skos:definition "Pattern maintaining one specified color or color mixture over the exposure interval."@en .
sstim-ex:patternMoving skos:definition "Pattern with controlled spatial translation, rotation, deformation, or apparent motion."@en .
sstim-ex:patternNoise skos:definition "Pattern generated from a stochastic or pseudo-random distribution over time, space, intensity, or frequency."@en .
sstim-ex:patternPulsed skos:definition "Pattern delivered as discrete on/off or amplitude-modulated events with specified timing."@en .
sstim-ex:patternRhythmic skos:definition "Pattern with recurring temporal organization, whether strictly periodic or intentionally varied."@en .
sstim-ex:patternStatic skos:definition "Pattern whose intended spatial and temporal parameters remain unchanged during presentation."@en .
sstim-ex:patternStochastic skos:definition "Pattern whose event timing or values are sampled from a stated random process."@en .
sstim-ex:patternTextured skos:definition "Pattern containing structured local variation in surface, spectrum, image, or amplitude rather than a uniform field."@en .
sstim-ex:visualFieldBlack skos:definition "Uniform or near-uniform visual field rendered at the implementation's minimum available luminance."@en .
sstim-ex:visualFieldStaticColor skos:definition "Uniform or spatially stable visual field rendered with a specified fixed color."@en .
sstim-ex:visualFieldWhite skos:definition "Uniform or near-uniform high-luminance achromatic visual field within device and comfort limits."@en .
sstim-ex:visualNoiseChromatic skos:definition "Visual noise whose random variation occurs primarily in color channels."@en .
sstim-ex:visualNoiseLuminance skos:definition "Visual noise whose random variation occurs primarily in luminance or contrast."@en .
sstim-ex:visualNoiseMoving skos:definition "Visual noise field whose samples or texture translate, flow, or otherwise evolve spatially over time."@en .
sstim-ex:visualNoisePixel skos:definition "Visual noise represented as independently or locally varying display pixels or small image elements."@en .


###########################################################################
# Exposure limits (quantified safety thresholds, citing external standards)
#
# These record recognized thresholds against which a delivery is checked.
# They do not assert that any delivery is safe; runtime enforcement of the
# flicker limit lives in src/ui/safety/flashSafety.js (ADR 0011).
###########################################################################

sstim-ex:limitFlickerWcag a owl:NamedIndividual, sstim-ex:ExposureLimit ;
    rdfs:label "three-flash accessibility safeguard"@en ;
    sstim-ex:limitQuantity "flash frequency" ;
    sstim-ex:limitMaxFrequencyHz "3"^^xsd:decimal ;
    sstim-ex:limitUnit "Hz" ;
    sstim-ex:appliesToPlacement sstim-ex:placementEyes ;
    sstim-ex:conformsToStandard <https://www.w3.org/TR/WCAG22/#three-flashes-or-below-threshold> ,
        <https://www.itu.int/rec/R-REC-BT.1702> ;
    skos:definition "Accessibility safeguard derived from WCAG 2.2 success criterion 2.3.1 and ITU-R BT.1702: content should not exceed three general flashes or three red flashes in one second unless the applicable below-threshold test is satisfied. This simplified frequency bound does not establish individual safety."@en .

sstim-ex:limitHearingNiosh a owl:NamedIndividual, sstim-ex:ExposureLimit ;
    rdfs:label "recommended sound-exposure limit"@en ;
    sstim-ex:limitQuantity "sound pressure level" ;
    sstim-ex:limitValue "85"^^xsd:decimal ;
    sstim-ex:limitUnit "dBA" ;
    sstim-ex:limitAveragingTimeSeconds "28800"^^xsd:decimal ;
    sstim-ex:appliesToPlacement sstim-ex:placementEars ;
    sstim-ex:conformsToStandard <https://www.cdc.gov/niosh/docs/98-126/> ;
    skos:definition "NIOSH occupational recommended exposure limit of 85 dBA as an 8-hour time-weighted average, with a 3 dB exchange rate (each 3 dB increase halves the recommended duration). This occupational limit is not a general-public listening recommendation. BSC Lab cannot measure delivered sound pressure level and treats this record as advisory rather than a safety guarantee."@en .

sstim-ex:limitUvActinicIec a owl:NamedIndividual, sstim-ex:ExposureLimit ;
    rdfs:label "actinic ultraviolet exposure limit"@en ;
    sstim-ex:limitQuantity "effective radiant exposure" ;
    sstim-ex:limitValue "30"^^xsd:decimal ;
    sstim-ex:limitUnit "J/m2" ;
    sstim-ex:limitAveragingTimeSeconds "28800"^^xsd:decimal ;
    sstim-ex:appliesToPlacement sstim-ex:placementEyes , sstim-ex:placementWholeBody ;
    sstim-ex:conformsToStandard <https://www.icnirp.org/cms/upload/publications/ICNIRPUV2004.pdf> ,
        <https://webstore.iec.ch/publication/7076> ;
    skos:definition "ICNIRP daily exposure limit of 30 J/m2 spectrally weighted effective ultraviolet radiant exposure for unprotected skin and eye, calculated over 180-400 nm. IEC 62471 supplies lamp photobiological risk classification; it is not the source of the 30 J/m2 value. BSC Lab does not deliver ultraviolet radiation at the body."@en ;
    skos:editorialNote "The historical IRI suffix 'Iec' is retained for identifier stability. The value is attributed explicitly to ICNIRP after the 2026-07-10 external review."@en .


###########################################################################
# Statement roles (ADR 0027)
#
# Non-evidence statement classes replacing the deprecated ExposureEffectClaim.
# Exactly one epistemic role per statement node; the roles are pairwise
# disjoint with sstim:EvidenceAssessmentClaim and with each other (intentional
# subclassing such as ExposureMeasurementRequirement ⊑ ProtocolRequirement is
# not a second role). Link properties carry no OWL domain; SHACL enforces the
# allowed source classes.
###########################################################################

sstim-ex:ExposureHypothesis a owl:Class ;
    rdfs:subClassOf iao:0000030 ;
    rdfs:label "Exposure Hypothesis"@en ;
    skos:definition "A testable proposition asserting an expected relation, difference, or direction for an exposure. Not evidence: it carries no tier, direction, basis, or review metadata and can never satisfy an evidence-assessment shape."@en ;
    rdfs:seeAlso <https://github.com/laBioSynCare/laBioSynCare.github.io/blob/main/docs/decisions/0027-evidence-claim-family-and-public-claim-gate.md> ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:ResearchQuestion a owl:Class ;
    rdfs:subClassOf iao:0000030 ;
    rdfs:label "Research Question"@en ;
    skos:definition "An open question about an exposure that asserts no expected result."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:BoundaryApplicabilityStatement a owl:Class ;
    rdfs:subClassOf iao:0000030 ;
    rdfs:label "Boundary Applicability Statement"@en ;
    skos:definition "A reasoned statement that a named comfort or safety boundary or exposure limit applies to a profile or channel. An applicability judgment, not an evidential finding."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:ProtocolRequirement a owl:Class ;
    rdfs:subClassOf iao:0000030 ;
    rdfs:label "Protocol Requirement"@en ;
    skos:definition "A reproducibility, measurement, context, or study-design requirement constraining a protocol, profile, or channel."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:ExposureMeasurementRequirement a owl:Class ;
    rdfs:subClassOf sstim-ex:ProtocolRequirement ;
    rdfs:label "Exposure Measurement Requirement"@en ;
    skos:definition "A protocol requirement identifying the exposure quantities and sensor capability that must be measured or recorded."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:ExposureDesignObjective a owl:Class ;
    rdfs:subClassOf iao:0000030 ;
    rdfs:label "Exposure Design Objective"@en ;
    skos:definition "A desired delivery capability or experience that does not predict an observed effect. Any empirical expectation belongs in a separate hypothesis."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:PlannedOutcomeSpecification a owl:Class ;
    rdfs:subClassOf iao:0000030 ;
    rdfs:label "Planned Outcome Specification"@en ;
    skos:definition "A dimension and collection/comparison plan for an exposure — what would be collected and compared, not an observation result."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:KnowledgeStatusAssertion a owl:Class ;
    rdfs:subClassOf iao:0000030 ;
    rdfs:label "Knowledge Status Assertion"@en ;
    skos:definition "An immutable, scoped, dated assertion assigning an existing controlled KnowledgeStatus value to an identified subject: exactly one subject link, one status value, one as-of date, and a named corpus scope or scope note. It states what a named corpus records as of a date — never a universal claim — and carries no evidence tier, direction, basis, or review metadata."@en ;
    rdfs:seeAlso <https://github.com/laBioSynCare/laBioSynCare.github.io/blob/main/docs/decisions/0027-evidence-claim-family-and-public-claim-gate.md> ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:KnowledgeStatusActivity a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Knowledge Status Activity"@en ;
    skos:definition "The PROV activity that generates a knowledge-status assertion, recording time, method/corpus revision, and a qualified responsible agent/role."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

# The epistemic roles are pairwise disjoint (ADR 0027). SHACL additionally
# rejects any node carrying two top-level roles; these axioms reinforce, but
# do not replace, the operational checks.
[] a owl:AllDisjointClasses ;
    owl:members ( sstim:EvidenceAssessmentClaim
                  sstim-ex:ExposureHypothesis
                  sstim-ex:ResearchQuestion
                  sstim-ex:BoundaryApplicabilityStatement
                  sstim-ex:ProtocolRequirement
                  sstim-ex:ExposureDesignObjective
                  sstim-ex:PlannedOutcomeSpecification
                  sstim-ex:KnowledgeStatusAssertion ) .

# ── Role-specific link properties (no OWL domains; SHACL enforces sources) ─

sstim-ex:hasHypothesis a owl:ObjectProperty ;
    rdfs:range sstim-ex:ExposureHypothesis ;
    rdfs:label "has hypothesis"@en ;
    skos:definition "Links an exposure profile or protocol to a stated hypothesis. Optional: a delivery-only profile states none, and generators must never fabricate one."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:hasResearchQuestion a owl:ObjectProperty ;
    rdfs:range sstim-ex:ResearchQuestion ;
    rdfs:label "has research question"@en ;
    skos:definition "Links an exposure profile or protocol to an open research question."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:hasBoundaryApplicability a owl:ObjectProperty ;
    rdfs:range sstim-ex:BoundaryApplicabilityStatement ;
    rdfs:label "has boundary applicability"@en ;
    skos:definition "Links an exposure profile or stimulus channel to a qualified boundary-applicability statement. Direct hasComfortBoundary / hasExposureLimit links remain valid structural shortcuts; the qualified statement carries the rationale."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:hasProtocolRequirement a owl:ObjectProperty ;
    rdfs:range sstim-ex:ProtocolRequirement ;
    rdfs:label "has protocol requirement"@en ;
    skos:definition "Links an exposure profile, stimulus channel, or protocol to a requirement that constrains it."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:hasDesignObjective a owl:ObjectProperty ;
    rdfs:range sstim-ex:ExposureDesignObjective ;
    rdfs:label "has design objective"@en ;
    skos:definition "Links an exposure profile or protocol to a desired delivery capability or experience objective."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:hasPlannedOutcome a owl:ObjectProperty ;
    rdfs:range sstim-ex:PlannedOutcomeSpecification ;
    rdfs:label "has planned outcome"@en ;
    skos:definition "Links an exposure profile or protocol to a planned outcome-collection specification."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:hasKnowledgeStatusAssertion a owl:ObjectProperty ;
    rdfs:range sstim-ex:KnowledgeStatusAssertion ;
    rdfs:label "has knowledge status assertion"@en ;
    skos:definition "Links a preset, technique, protocol, exposure profile, or stimulus channel to a scoped, dated knowledge-status assertion about it. Each assertion has exactly one incoming subject link."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:appliesBoundary a owl:ObjectProperty ;
    rdfs:range [ a owl:Class ; owl:unionOf ( sstim-ex:ComfortBoundary sstim-ex:ExposureLimit ) ] ;
    rdfs:label "applies boundary"@en ;
    skos:definition "The named comfort boundary or exposure limit a boundary-applicability statement applies. Every such statement uses it at least once; the incoming profile/channel link identifies the application target."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:knowledgeAsOfDate a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:range xsd:date ;
    rdfs:label "knowledge as-of date"@en ;
    skos:definition "The date as of which a knowledge-status assertion holds for its named corpus."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:knowledgeScope a owl:ObjectProperty ;
    rdfs:label "knowledge scope"@en ;
    skos:definition "The identified corpus or repository a knowledge-status assertion is scoped to."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:knowledgeScopeNote a owl:DatatypeProperty ;
    rdfs:range rdf:langString ;
    rdfs:label "knowledge scope note"@en ;
    skos:definition "A language-tagged description of the corpus or scope of a knowledge-status assertion, used when no scope IRI exists."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .


###########################################################################
# End of sstim-exposure.ttl
###########################################################################

###########################################################################
#
#  SSTIM Ecosystem Module  —  sstim-ecosystem.ttl
#
#  Namespace:  https://w3id.org/sstim/ecosystem#
#  Module IRI: https://w3id.org/sstim/ecosystem
#  Version:    0.16.0
#  Date:       2026-08-18
#  Author:     Renato Fabbri <renato@junto.space>
#  License:    CC BY 4.0
#
#  Reusable terms for describing the people and organizations of the
#  sensory-stimulation field and their engagement with SSTIM. Design and
#  governance: ADR 0024. This module carries NO personal data — only the
#  agent umbrella, the engagement/relationship properties, and the
#  relationship vocabulary. Named agents are curated implementation data at
#  /organization/{id} and /specialist/{id}, never in this term space.
#
#  Flat Turtle module. Runtime named graph:
#  https://w3id.org/sstim/graph/ecosystem
#
###########################################################################

@prefix sstim:     <https://w3id.org/sstim#> .
@prefix sstim-eco: <https://w3id.org/sstim/ecosystem#> .

@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix prov:  <http://www.w3.org/ns/prov#> .
@prefix iao:   <http://purl.obolibrary.org/obo/IAO_> .
@prefix schema: <https://schema.org/> .
@prefix org:    <http://www.w3.org/ns/org#> .


###########################################################################
# Module metadata
###########################################################################

<https://w3id.org/sstim/ecosystem> a owl:Ontology ;
    # Introduced in the 0.7.0 whole-set release (ADR 0024/0031). Modules carry
    # owl:versionInfo only; the core identifies the citable set (ADR 0020).
    owl:versionInfo "0.16.0" ;
    dct:title "SSTIM Ecosystem Module"@en ;
    dct:description "Reusable SSTIM module for the sensory-stimulation ecosystem: a neutral agent umbrella, qualified relationship and membership records, implementation responsibility, a retractable approved public projection, append-only private operational activities, and controlled relationship, purpose, and outcome vocabularies. Carries no personal data; named agents are curated implementation data."@en ;
    dct:isPartOf <https://w3id.org/sstim> ;
    dct:requires <https://w3id.org/sstim/technique> ;
    dct:creator <https://orcid.org/0000-0002-9699-629X> ;
    dct:publisher <https://github.com/laBioSynCare> ;
    dct:created "2026-07-12"^^xsd:date ;
    dct:issued "2026-08-18"^^xsd:date ;
    dct:modified "2026-08-18"^^xsd:date ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    rdfs:seeAlso <https://github.com/laBioSynCare/laBioSynCare.github.io/blob/main/docs/decisions/0024-stakeholder-ecosystem-modeling.md>,
        <https://github.com/laBioSynCare/laBioSynCare.github.io/blob/main/docs/decisions/0031-qualified-ecosystem-records.md>,
        <https://github.com/laBioSynCare/laBioSynCare.github.io/blob/main/docs/decisions/0032-visible-pending-status-ecosystem-records.md> ;
    skos:historyNote "0.7.0 — ADR 0031 replaces the initial flat agent-level relationship and consent surface with qualified relationship, membership, implementation-responsibility, and engagement records; the approved public graph is current-state while complete operational history is private and append-only. The original ADR 0024 properties remain deprecated for migration only. 2026-07-19 — ADR 0032 adds sstim-eco:publicationStatus as a second, backward-compatible admission basis: a relationship may be admitted to the public graph at any truthful non-approved status (e.g. notified) so the person it describes can review it in context before consenting; the person-consent gate on a claimed publicationStatus of outcomePublicationApproved is unchanged."@en .


###########################################################################
# Classes
###########################################################################

sstim-eco:EcosystemAgent a owl:Class ;
    rdfs:subClassOf prov:Agent ;
    owl:disjointWith sstim:SensoryStimulationImplementation ;
    rdfs:label "Ecosystem agent"@en ;
    skos:definition "A person or organization active in, or relevant to, the field of sensory stimulation, recorded in the SSTIM ecosystem. Instances are additionally typed with schema.org/FOAF person or organization classes. The class is evaluatively neutral: contributor, stakeholder, cited-author, peer-project, and similar roles are assigned to qualified relationship records with sstim-eco:hasRelationshipType, not asserted as global agent types."@en ;
    rdfs:seeAlso <https://github.com/laBioSynCare/laBioSynCare.github.io/blob/main/docs/decisions/0024-stakeholder-ecosystem-modeling.md> ;
    rdfs:isDefinedBy <https://w3id.org/sstim/ecosystem> .

sstim-eco:RelationshipType a owl:Class ;
    rdfs:subClassOf iao:0000030 ;
    rdfs:label "Ecosystem relationship type"@en ;
    skos:definition "A controlled category describing how an ecosystem agent relates to sensory stimulation or to SSTIM (e.g. contributor, stakeholder, cited author). Instances are the dual-typed SKOS concepts of the EcosystemRelationScheme."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/ecosystem> .

sstim-eco:ImplementationResponsibilityType a owl:Class ;
    rdfs:subClassOf sstim-eco:RelationshipType ;
    rdfs:label "Implementation responsibility type"@en ;
    skos:definition "A controlled relationship type identifying how a person or organization is responsible for a sensory-stimulation implementation, such as developer, publisher, maintainer, provider, operator, host, or funder."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/ecosystem> .

sstim-eco:EcosystemPurpose a owl:Class ;
    rdfs:subClassOf iao:0000030 ;
    rdfs:label "Ecosystem record purpose"@en ;
    skos:definition "A controlled purpose for which an ecosystem relationship or engagement activity is recorded, such as public discovery, attribution, outreach, or live publication."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/ecosystem> .

sstim-eco:EngagementOutcome a owl:Class ;
    rdfs:subClassOf iao:0000030 ;
    rdfs:label "Engagement outcome"@en ;
    skos:definition "A controlled minimal outcome of an ecosystem engagement activity. Positive admission outcomes may appear in the public current-state graph; negative and operational outcomes remain private. No outcome publishes correspondence, contact details, or raw consent evidence."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/ecosystem> .

sstim-eco:EcosystemRelationship a owl:Class ;
    rdfs:subClassOf prov:Entity, iao:0000030 ;
    rdfs:label "Ecosystem relationship"@en ;
    skos:definition "A named, qualified record binding exactly one ecosystem agent to one target, relationship type, purpose, source set, curator, and review history so values cannot be cross-associated across several relationships."@en ;
    rdfs:seeAlso <https://github.com/laBioSynCare/laBioSynCare.github.io/blob/main/docs/decisions/0031-qualified-ecosystem-records.md> ;
    rdfs:isDefinedBy <https://w3id.org/sstim/ecosystem> .

sstim-eco:OrganizationMembership a owl:Class ;
    rdfs:subClassOf sstim-eco:EcosystemRelationship, org:Membership ;
    rdfs:label "Organization membership"@en ;
    skos:definition "A sourced, time-qualified relationship in which a person is a member of an organization in an identified ORG role. The member and organization also fill the relationship-agent and relationship-target positions."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/ecosystem> .

sstim-eco:ImplementationResponsibility a owl:Class ;
    rdfs:subClassOf sstim-eco:EcosystemRelationship ;
    rdfs:label "Implementation responsibility"@en ;
    skos:definition "A qualified relationship identifying a person or organization that develops, publishes, maintains, provides, operates, hosts, or funds a specific sstim:SensoryStimulationImplementation."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/ecosystem> .

sstim-eco:EngagementActivity a owl:Class ;
    rdfs:subClassOf prov:Activity ;
    rdfs:label "Ecosystem engagement activity"@en ;
    skos:definition "A named activity recording one lifecycle event for one ecosystem relationship, with a purpose, controlled outcome, timestamp, and responsible agent. The private operational ledger is append-only; only approved positive state is projected publicly."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/ecosystem> .

sstim-eco:NotificationActivity a owl:Class ;
    rdfs:subClassOf sstim-eco:EngagementActivity ;
    rdfs:label "Notification activity"@en ;
    skos:definition "An activity recording that notification about an ecosystem relationship was sent or failed, without publishing its channel, address, or message."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/ecosystem> .

sstim-eco:ResponseActivity a owl:Class ;
    rdfs:subClassOf sstim-eco:EngagementActivity ;
    rdfs:label "Response activity"@en ;
    skos:definition "An activity recording a controlled response outcome for an ecosystem relationship without publishing response text or private evidence. Only acknowledged is public-safe; change, objection, and removal outcomes remain private."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/ecosystem> .

sstim-eco:PublicationDecisionActivity a owl:Class ;
    rdfs:subClassOf sstim-eco:EngagementActivity ;
    rdfs:label "Publication decision activity"@en ;
    skos:definition "An activity recording whether a qualified ecosystem relationship is approved or withheld for publication under its declared purpose. In a public SSTIM ecosystem artifact, the chronologically final activity for every admitted relationship is an approval decision."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/ecosystem> .

sstim-eco:ConsentDecisionActivity a owl:Class ;
    rdfs:subClassOf sstim-eco:EngagementActivity ;
    rdfs:label "Consent decision activity"@en ;
    skos:definition "An activity recording a controlled consent outcome for one relationship and purpose. Raw consent evidence remains private and is not represented by this public summary."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/ecosystem> .

sstim-eco:AmendmentActivity a owl:Class ;
    rdfs:subClassOf sstim-eco:EngagementActivity ;
    rdfs:label "Amendment activity"@en ;
    skos:definition "An operational activity recording that an ecosystem relationship was amended, with the revision chain expressed using PROV. Invalidated values and the detailed amendment event remain in the private audit ledger; the public graph publishes only the approved current replacement."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/ecosystem> .

sstim-eco:WithdrawalActivity a owl:Class ;
    rdfs:subClassOf sstim-eco:EngagementActivity ;
    rdfs:label "Withdrawal activity"@en ;
    skos:definition "An operational activity recording a removal request or consent withdrawal for one qualified ecosystem relationship. The event is retained in the private audit ledger while the withdrawn relationship and identifying public chain are removed from the current public graph."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/ecosystem> .


###########################################################################
# Qualified relationship and engagement properties (ADR 0031)
###########################################################################

sstim-eco:hasEcosystemRelationship a owl:ObjectProperty ;
    owl:inverseOf sstim-eco:relationshipAgent ;
    rdfs:label "has ecosystem relationship"@en ;
    rdfs:domain sstim-eco:EcosystemAgent ;
    rdfs:range sstim-eco:EcosystemRelationship ;
    skos:definition "Links an ecosystem agent to one named qualified relationship record. The inverse relationshipAgent identifies the same agent from the record."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/ecosystem> .

sstim-eco:relationshipAgent a owl:ObjectProperty ;
    rdfs:label "relationship agent"@en ;
    rdfs:domain sstim-eco:EcosystemRelationship ;
    rdfs:range sstim-eco:EcosystemAgent ;
    skos:definition "Identifies the one ecosystem agent described by a qualified ecosystem relationship."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/ecosystem> .

sstim-eco:relationshipTarget a owl:ObjectProperty ;
    rdfs:label "relationship target"@en ;
    rdfs:domain sstim-eco:EcosystemRelationship ;
    skos:definition "Identifies the one resource to which the agent is related in a qualified ecosystem relationship."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/ecosystem> .

sstim-eco:hasRelationshipType a owl:ObjectProperty ;
    rdfs:label "has relationship type"@en ;
    rdfs:domain sstim-eco:EcosystemRelationship ;
    rdfs:range sstim-eco:RelationshipType ;
    skos:definition "Assigns one controlled relationship type to one qualified ecosystem relationship record."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/ecosystem> .

sstim-eco:relationshipPurpose a owl:ObjectProperty ;
    rdfs:label "relationship purpose"@en ;
    rdfs:domain sstim-eco:EcosystemRelationship ;
    rdfs:range sstim-eco:EcosystemPurpose ;
    skos:definition "Identifies the one declared purpose for recording a qualified ecosystem relationship."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/ecosystem> .

sstim-eco:validFrom a owl:DatatypeProperty ;
    rdfs:label "valid from"@en ;
    rdfs:domain sstim-eco:EcosystemRelationship ;
    rdfs:range xsd:date ;
    skos:definition "The date from which a qualified ecosystem relationship is known to apply, when available."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/ecosystem> .

sstim-eco:validUntil a owl:DatatypeProperty ;
    rdfs:label "valid until"@en ;
    rdfs:domain sstim-eco:EcosystemRelationship ;
    rdfs:range xsd:date ;
    skos:definition "The date through which a qualified ecosystem relationship is known to apply, when it has ended."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/ecosystem> .

sstim-eco:reviewedOn a owl:DatatypeProperty ;
    rdfs:label "reviewed on"@en ;
    rdfs:domain sstim-eco:EcosystemRelationship ;
    rdfs:range xsd:date ;
    skos:definition "The date on which the qualified relationship, its public sources, and its publication status were last reviewed."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/ecosystem> .

sstim-eco:publicationStatus a owl:ObjectProperty ;
    rdfs:label "publication status"@en ;
    rdfs:domain sstim-eco:EcosystemRelationship ;
    rdfs:range sstim-eco:EngagementOutcome ;
    skos:definition "The current lifecycle status of a qualified ecosystem relationship — one controlled outcome (e.g. notification sent, consent granted, publication approved) matching the engagementOutcome of the relationship's chronologically most recent engagement activity. Introduced by ADR 0032 as a second, explicit admission basis for the public ecosystem graph: a relationship may be admitted with any truthful status via this property, not only a final publication-approved one, so that the person or organization it describes — and anyone else — can see exactly where the relationship stands, including its context, without waiting for approval to become visible at all. Only a publicationStatus of outcomePublicationApproved for a relationship whose agent is a person still requires that person's own prior consent or self-publication; every other status requires no consent to display, precisely because it does not claim confirmation. A relationship admitted through the legacy path (ending in a PublicationDecisionActivity with no explicit publicationStatus) is treated as approved for backward compatibility."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/ecosystem> .

sstim-eco:hasEngagementActivity a owl:ObjectProperty ;
    owl:inverseOf sstim-eco:engagementFor ;
    rdfs:label "has engagement activity"@en ;
    rdfs:domain sstim-eco:EcosystemRelationship ;
    rdfs:range sstim-eco:EngagementActivity ;
    skos:definition "Links a qualified relationship to one engagement lifecycle activity. Public artifacts admit only positive activities ending in final approval; the complete append-only chain remains private."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/ecosystem> .

sstim-eco:engagementFor a owl:ObjectProperty ;
    rdfs:label "engagement for"@en ;
    rdfs:domain sstim-eco:EngagementActivity ;
    rdfs:range sstim-eco:EcosystemRelationship ;
    skos:definition "Identifies the one qualified ecosystem relationship governed by an engagement activity."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/ecosystem> .

sstim-eco:engagementPurpose a owl:ObjectProperty ;
    rdfs:label "engagement purpose"@en ;
    rdfs:domain sstim-eco:EngagementActivity ;
    rdfs:range sstim-eco:EcosystemPurpose ;
    skos:definition "Identifies the purpose to which a notification, response, decision, amendment, or withdrawal applies."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/ecosystem> .

sstim-eco:engagementOutcome a owl:ObjectProperty ;
    rdfs:label "engagement outcome"@en ;
    rdfs:domain sstim-eco:EngagementActivity ;
    rdfs:range sstim-eco:EngagementOutcome ;
    skos:definition "Assigns one controlled minimal outcome to an engagement activity."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/ecosystem> .


###########################################################################
# Relationship and expertise properties
###########################################################################

sstim-eco:relationshipType a owl:ObjectProperty ;
    owl:deprecated true ;
    dct:isReplacedBy sstim-eco:hasRelationshipType ;
    rdfs:label "relationship type"@en ;
    rdfs:domain sstim-eco:EcosystemAgent ;
    rdfs:range sstim-eco:RelationshipType ;
    skos:definition "Relates an ecosystem agent to one or more controlled relationship types describing how it engages with the field or with SSTIM."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/ecosystem> .

sstim-eco:relatesTo a owl:ObjectProperty ;
    owl:deprecated true ;
    dct:isReplacedBy sstim-eco:relationshipTarget ;
    rdfs:label "relates to"@en ;
    rdfs:domain sstim-eco:EcosystemAgent ;
    skos:definition "Links an ecosystem agent to the specific SSTIM resource it relates to (a technique, the framework, a reference, the community group, the platform), when applicable."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/ecosystem> .

sstim-eco:expertiseArea a owl:ObjectProperty ;
    owl:deprecated true ;
    dct:isReplacedBy sstim-eco:hasEcosystemRelationship ;
    rdfs:label "expertise area"@en ;
    rdfs:domain sstim-eco:EcosystemAgent ;
    rdfs:range skos:Concept ;
    skos:definition "Links an ecosystem agent to SSTIM controlled concepts (modalities, mechanisms, techniques) it works on. A sourced claim about scope, not an assertion of rank or authority."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/ecosystem> .

sstim-eco:hasContributedTo a owl:ObjectProperty ;
    owl:deprecated true ;
    dct:isReplacedBy sstim-eco:hasEcosystemRelationship ;
    rdfs:label "has contributed to"@en ;
    rdfs:domain sstim-eco:EcosystemAgent ;
    skos:definition "An SSTIM area (technique, module, the community group) to which the agent has actually contributed."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/ecosystem> .

sstim-eco:couldContributeTo a owl:ObjectProperty ;
    owl:deprecated true ;
    rdfs:label "could contribute to"@en ;
    rdfs:domain sstim-eco:EcosystemAgent ;
    skos:definition "An SSTIM area to which the agent could plausibly contribute."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/ecosystem> .

sstim-eco:curatedBy a owl:ObjectProperty ;
    owl:deprecated true ;
    dct:isReplacedBy prov:wasAttributedTo ;
    rdfs:label "curated by"@en ;
    rdfs:domain sstim-eco:EcosystemAgent ;
    rdfs:range prov:Agent ;
    skos:definition "The agent (typically BSC Lab) responsible for creating and maintaining this ecosystem record."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/ecosystem> .


###########################################################################
# Engagement / consent lifecycle properties (ADR 0024 §5)
#
# These record OUR process (notification, response, consent), factually and
# separately from claims about the agent. The status datatype properties take
# controlled string values enumerated by sh:in in sstim-shapes.ttl.
###########################################################################

sstim-eco:recordSource a owl:DatatypeProperty ;
    owl:deprecated true ;
    dct:isReplacedBy dct:source ;
    rdfs:label "record source"@en ;
    rdfs:domain sstim-eco:EcosystemAgent ;
    skos:definition "Provenance of the facts in this record: a public URL (Wikipedia, ORCID, ROR, homepage) or a phrase such as 'personal communication'. Required for every ecosystem agent."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/ecosystem> .

sstim-eco:consentStatus a owl:DatatypeProperty ;
    owl:deprecated true ;
    dct:isReplacedBy sstim-eco:ConsentDecisionActivity ;
    rdfs:label "consent status"@en ;
    rdfs:domain sstim-eco:EcosystemAgent ;
    rdfs:range xsd:string ;
    skos:definition "Listing-tier consent state: implicit-public, notified, consent-requested, consent-granted, consent-declined, removal-requested, or withdrawn (ADR 0024)."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/ecosystem> .

sstim-eco:archivalConsent a owl:DatatypeProperty ;
    owl:deprecated true ;
    dct:isReplacedBy sstim-eco:ConsentDecisionActivity ;
    rdfs:label "archival consent"@en ;
    rdfs:domain sstim-eco:EcosystemAgent ;
    rdfs:range xsd:boolean ;
    skos:definition "True only when the agent has given specific, informed consent that the record may enter a permanent, citable archive and cannot then be fully erased (ADR 0024 §6). Absent or false permits only mutable live publication outside the Zenodo-tracked release repository; removal can be honored in the controlled store, but third-party public copies cannot be recalled."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/ecosystem> .

sstim-eco:notificationStatus a owl:DatatypeProperty ;
    owl:deprecated true ;
    dct:isReplacedBy sstim-eco:NotificationActivity ;
    rdfs:label "notification status"@en ;
    rdfs:domain sstim-eco:EcosystemAgent ;
    rdfs:range xsd:string ;
    skos:definition "Whether the agent has been notified of inclusion: not-notified, notified, or failed."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/ecosystem> .

sstim-eco:notifiedOn a owl:DatatypeProperty ;
    owl:deprecated true ;
    dct:isReplacedBy prov:endedAtTime ;
    rdfs:label "notified on"@en ;
    rdfs:domain sstim-eco:EcosystemAgent ;
    rdfs:range xsd:date ;
    skos:definition "The date the agent was notified of inclusion in SSTIM."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/ecosystem> .

sstim-eco:notificationChannel a owl:DatatypeProperty ;
    owl:deprecated true ;
    rdfs:label "notification channel"@en ;
    rdfs:domain sstim-eco:EcosystemAgent ;
    rdfs:range xsd:string ;
    skos:definition "How the notification was sent (e.g. email, public message, institutional contact)."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/ecosystem> .

sstim-eco:responseStatus a owl:DatatypeProperty ;
    owl:deprecated true ;
    dct:isReplacedBy sstim-eco:ResponseActivity ;
    rdfs:label "response status"@en ;
    rdfs:domain sstim-eco:EcosystemAgent ;
    rdfs:range xsd:string ;
    skos:definition "The agent's response: no-response, acknowledged, consented, objected, requested-removal, or requested-changes."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/ecosystem> .

sstim-eco:respondedOn a owl:DatatypeProperty ;
    owl:deprecated true ;
    dct:isReplacedBy prov:endedAtTime ;
    rdfs:label "responded on"@en ;
    rdfs:domain sstim-eco:EcosystemAgent ;
    rdfs:range xsd:date ;
    skos:definition "The date the agent responded to notification."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/ecosystem> .

sstim-eco:responseNote a owl:DatatypeProperty ;
    owl:deprecated true ;
    rdfs:label "response note"@en ;
    rdfs:domain sstim-eco:EcosystemAgent ;
    rdfs:range xsd:string ;
    skos:definition "The substance of the agent's response, recorded verbatim or summarized."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/ecosystem> .

sstim-eco:contributionStatus a owl:DatatypeProperty ;
    owl:deprecated true ;
    dct:isReplacedBy sstim-eco:hasEcosystemRelationship ;
    rdfs:label "contribution status"@en ;
    rdfs:domain sstim-eco:EcosystemAgent ;
    rdfs:range xsd:string ;
    skos:definition "The agent's contribution state relative to SSTIM: none, potential, active, or past."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/ecosystem> .

sstim-eco:addedOn a owl:DatatypeProperty ;
    owl:deprecated true ;
    dct:isReplacedBy dct:created ;
    rdfs:label "added on"@en ;
    rdfs:domain sstim-eco:EcosystemAgent ;
    rdfs:range xsd:date ;
    skos:definition "The date this ecosystem record was created."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/ecosystem> .


###########################################################################
# Relationship-type vocabulary (SKOS)
###########################################################################

sstim-eco:EcosystemRelationScheme a skos:ConceptScheme ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    skos:prefLabel "SSTIM Ecosystem Relationship Vocabulary"@en ;
    dct:description "Controlled types assigned to qualified ecosystem relationship records. A term such as contributor, stakeholder, organization member, or implementation developer describes one sourced agent-target relationship, not the agent globally."@en ;
    skos:hasTopConcept sstim-eco:contributor, sstim-eco:stakeholder,
        sstim-eco:researchCollaborator, sstim-eco:scientificAdvisor,
        sstim-eco:citedAuthor, sstim-eco:toolVendor, sstim-eco:standardsBody,
        sstim-eco:funder, sstim-eco:institutionalHost, sstim-eco:peerProject,
        sstim-eco:referencedSource, sstim-eco:organizationMember,
        sstim-eco:implementationDeveloper, sstim-eco:implementationPublisher,
        sstim-eco:implementationMaintainer, sstim-eco:implementationProvider,
        sstim-eco:implementationOperator .

sstim-eco:contributor a owl:NamedIndividual, sstim-eco:RelationshipType, skos:Concept ;
    skos:inScheme sstim-eco:EcosystemRelationScheme ;
    skos:topConceptOf sstim-eco:EcosystemRelationScheme ;
    skos:prefLabel "Contributor"@en,
                   "Contributore"@it,
                   "Contribuidor"@pt,
                   "Contribuidor"@es ;
    skos:notation "contributor" ;
    skos:definition "An agent that has contributed to the sensory-stimulation field — in knowledge, research, practice, or business."@en .

sstim-eco:stakeholder a owl:NamedIndividual, sstim-eco:RelationshipType, skos:Concept ;
    skos:inScheme sstim-eco:EcosystemRelationScheme ;
    skos:topConceptOf sstim-eco:EcosystemRelationScheme ;
    skos:prefLabel "Stakeholder"@en,
                   "Portatore di interesse"@it,
                   "Parte interessada"@pt,
                   "Parte interesada"@es ;
    skos:notation "stakeholder" ;
    skos:definition "An agent with an active stake or investment in the sensory-stimulation field or in SSTIM."@en .

sstim-eco:researchCollaborator a owl:NamedIndividual, sstim-eco:RelationshipType, skos:Concept ;
    skos:inScheme sstim-eco:EcosystemRelationScheme ;
    skos:topConceptOf sstim-eco:EcosystemRelationScheme ;
    skos:prefLabel "Research collaborator"@en,
                   "Collaboratore di ricerca"@it,
                   "Colaborador de pesquisa"@pt,
                   "Colaborador de investigación"@es ;
    skos:notation "research-collaborator" ;
    skos:definition "An agent collaborating on research relevant to SSTIM."@en .

sstim-eco:scientificAdvisor a owl:NamedIndividual, sstim-eco:RelationshipType, skos:Concept ;
    skos:inScheme sstim-eco:EcosystemRelationScheme ;
    skos:topConceptOf sstim-eco:EcosystemRelationScheme ;
    skos:prefLabel "Scientific advisor"@en,
                   "Consulente scientifico"@it,
                   "Consultor científico"@pt,
                   "Asesor científico"@es ;
    skos:notation "scientific-advisor" ;
    skos:definition "An agent providing scientific guidance to the SSTIM/BSC Lab effort."@en .

sstim-eco:citedAuthor a owl:NamedIndividual, sstim-eco:RelationshipType, skos:Concept ;
    skos:inScheme sstim-eco:EcosystemRelationScheme ;
    skos:topConceptOf sstim-eco:EcosystemRelationScheme ;
    skos:prefLabel "Cited author"@en,
                   "Autore citato"@it,
                   "Autor citado"@pt,
                   "Autor citado"@es ;
    skos:notation "cited-author" ;
    skos:definition "An author whose work is cited by SSTIM's evidence or references. Historical or current; implies no ongoing engagement."@en .

sstim-eco:toolVendor a owl:NamedIndividual, sstim-eco:RelationshipType, skos:Concept ;
    skos:inScheme sstim-eco:EcosystemRelationScheme ;
    skos:topConceptOf sstim-eco:EcosystemRelationScheme ;
    skos:prefLabel "Tool vendor"@en,
                   "Fornitore di strumenti"@it,
                   "Fornecedor de ferramentas"@pt,
                   "Proveedor de herramientas"@es ;
    skos:notation "tool-vendor" ;
    skos:definition "An organization producing tools, devices, or applications for sensory stimulation."@en .

sstim-eco:standardsBody a owl:NamedIndividual, sstim-eco:RelationshipType, skos:Concept ;
    skos:inScheme sstim-eco:EcosystemRelationScheme ;
    skos:topConceptOf sstim-eco:EcosystemRelationScheme ;
    skos:prefLabel "Standards body"@en,
                   "Ente di normazione"@it,
                   "Organismo de normalização"@pt,
                   "Organismo de normalización"@es ;
    skos:notation "standards-body" ;
    skos:definition "An organization that develops standards relevant to sensory stimulation or its interoperability."@en .

sstim-eco:funder a owl:NamedIndividual, sstim-eco:RelationshipType,
        sstim-eco:ImplementationResponsibilityType, skos:Concept ;
    skos:inScheme sstim-eco:EcosystemRelationScheme ;
    skos:topConceptOf sstim-eco:EcosystemRelationScheme ;
    skos:prefLabel "Funder"@en,
                   "Finanziatore"@it,
                   "Financiador"@pt,
                   "Financiador"@es ;
    skos:notation "funder" ;
    skos:definition "An agent that funds work relevant to SSTIM or the field."@en .

sstim-eco:institutionalHost a owl:NamedIndividual, sstim-eco:RelationshipType,
        sstim-eco:ImplementationResponsibilityType, skos:Concept ;
    skos:inScheme sstim-eco:EcosystemRelationScheme ;
    skos:topConceptOf sstim-eco:EcosystemRelationScheme ;
    skos:prefLabel "Institutional host"@en,
                   "Ente ospitante"@it,
                   "Instituição anfitriã"@pt,
                   "Institución anfitriona"@es ;
    skos:notation "institutional-host" ;
    skos:definition "An institution hosting people or projects that work in the field."@en .

sstim-eco:peerProject a owl:NamedIndividual, sstim-eco:RelationshipType, skos:Concept ;
    skos:inScheme sstim-eco:EcosystemRelationScheme ;
    skos:topConceptOf sstim-eco:EcosystemRelationScheme ;
    skos:prefLabel "Peer project"@en,
                   "Progetto affine"@it,
                   "Projeto congênere"@pt,
                   "Proyecto afín"@es ;
    skos:notation "peer-project" ;
    skos:definition "A peer initiative or platform with goals adjacent to SSTIM/BSC Lab."@en .

sstim-eco:referencedSource a owl:NamedIndividual, sstim-eco:RelationshipType, skos:Concept ;
    skos:inScheme sstim-eco:EcosystemRelationScheme ;
    skos:topConceptOf sstim-eco:EcosystemRelationScheme ;
    skos:prefLabel "Referenced source"@en,
                   "Fonte referenziata"@it,
                   "Fonte referenciada"@pt,
                   "Fuente referenciada"@es ;
    skos:notation "referenced-source" ;
    skos:definition "An agent that produces sources referenced by SSTIM, without a closer relationship."@en .

sstim-eco:organizationMember a owl:NamedIndividual, sstim-eco:RelationshipType, skos:Concept ;
    skos:inScheme sstim-eco:EcosystemRelationScheme ;
    skos:topConceptOf sstim-eco:EcosystemRelationScheme ;
    skos:prefLabel "Organization member"@en,
                   "Membro dell'organizzazione"@it,
                   "Membro da organização"@pt,
                   "Miembro de la organización"@es ;
    skos:notation "organization-member" ;
    skos:definition "A person related to an organization through a sourced, time-qualified org:Membership record and an identified ORG role."@en .

sstim-eco:implementationDeveloper a owl:NamedIndividual,
        sstim-eco:RelationshipType, sstim-eco:ImplementationResponsibilityType,
        skos:Concept ;
    skos:inScheme sstim-eco:EcosystemRelationScheme ;
    skos:topConceptOf sstim-eco:EcosystemRelationScheme ;
    skos:prefLabel "Implementation developer"@en,
                   "Sviluppatore dell'implementazione"@it,
                   "Desenvolvedor da implementação"@pt,
                   "Desarrollador de la implementación"@es ;
    skos:notation "implementation-developer" ;
    skos:definition "An agent responsible for developing a specific sensory-stimulation implementation."@en .

sstim-eco:implementationPublisher a owl:NamedIndividual,
        sstim-eco:RelationshipType, sstim-eco:ImplementationResponsibilityType,
        skos:Concept ;
    skos:inScheme sstim-eco:EcosystemRelationScheme ;
    skos:topConceptOf sstim-eco:EcosystemRelationScheme ;
    skos:prefLabel "Implementation publisher"@en,
                   "Editore dell'implementazione"@it,
                   "Publicador da implementação"@pt,
                   "Editor de la implementación"@es ;
    skos:notation "implementation-publisher" ;
    skos:definition "An agent responsible for publishing or distributing a specific sensory-stimulation implementation."@en .

sstim-eco:implementationMaintainer a owl:NamedIndividual,
        sstim-eco:RelationshipType, sstim-eco:ImplementationResponsibilityType,
        skos:Concept ;
    skos:inScheme sstim-eco:EcosystemRelationScheme ;
    skos:topConceptOf sstim-eco:EcosystemRelationScheme ;
    skos:prefLabel "Implementation maintainer"@en,
                   "Manutentore dell'implementazione"@it,
                   "Mantenedor da implementação"@pt,
                   "Mantenedor de la implementación"@es ;
    skos:notation "implementation-maintainer" ;
    skos:definition "An agent responsible for maintaining a specific sensory-stimulation implementation."@en .

sstim-eco:implementationProvider a owl:NamedIndividual,
        sstim-eco:RelationshipType, sstim-eco:ImplementationResponsibilityType,
        skos:Concept ;
    skos:inScheme sstim-eco:EcosystemRelationScheme ;
    skos:topConceptOf sstim-eco:EcosystemRelationScheme ;
    skos:prefLabel "Implementation provider"@en,
                   "Fornitore dell'implementazione"@it,
                   "Fornecedor da implementação"@pt,
                   "Proveedor de la implementación"@es ;
    skos:notation "implementation-provider" ;
    skos:definition "An agent that makes a specific sensory-stimulation implementation available for use without necessarily developing it."@en .

sstim-eco:implementationOperator a owl:NamedIndividual,
        sstim-eco:RelationshipType, sstim-eco:ImplementationResponsibilityType,
        skos:Concept ;
    skos:inScheme sstim-eco:EcosystemRelationScheme ;
    skos:topConceptOf sstim-eco:EcosystemRelationScheme ;
    skos:prefLabel "Implementation operator"@en,
                   "Operatore dell'implementazione"@it,
                   "Operador da implementação"@pt,
                   "Operador de la implementación"@es ;
    skos:notation "implementation-operator" ;
    skos:definition "An agent responsible for operating a specific sensory-stimulation implementation in a declared context."@en .


###########################################################################
# Ecosystem-purpose vocabulary (SKOS)
###########################################################################

sstim-eco:EcosystemPurposeScheme a skos:ConceptScheme ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    skos:prefLabel "SSTIM Ecosystem Purpose Vocabulary"@en ;
    dct:description "Controlled purposes that scope qualified ecosystem relationships and their public engagement activities."@en ;
    skos:hasTopConcept sstim-eco:purposePublicDiscovery,
        sstim-eco:purposePublicAttribution, sstim-eco:purposeOutreach,
        sstim-eco:purposeLivePublication, sstim-eco:purposeArchivalPublication .

sstim-eco:purposePublicDiscovery a owl:NamedIndividual, sstim-eco:EcosystemPurpose, skos:Concept ;
    skos:inScheme sstim-eco:EcosystemPurposeScheme ;
    skos:topConceptOf sstim-eco:EcosystemPurposeScheme ;
    skos:prefLabel "Public discovery"@en,
                   "Reperibilità pubblica"@it,
                   "Descoberta pública"@pt,
                   "Descubrimiento público"@es ;
    skos:notation "public-discovery" ;
    skos:definition "Recording a sourced professional relationship so users can discover relevant people and organizations."@en .

sstim-eco:purposePublicAttribution a owl:NamedIndividual, sstim-eco:EcosystemPurpose, skos:Concept ;
    skos:inScheme sstim-eco:EcosystemPurposeScheme ;
    skos:topConceptOf sstim-eco:EcosystemPurposeScheme ;
    skos:prefLabel "Public attribution"@en,
                   "Attribuzione pubblica"@it,
                   "Atribuição pública"@pt,
                   "Atribución pública"@es ;
    skos:notation "public-attribution" ;
    skos:definition "Recording a sourced relationship to give accurate public credit or responsibility attribution."@en .

sstim-eco:purposeOutreach a owl:NamedIndividual, sstim-eco:EcosystemPurpose, skos:Concept ;
    skos:inScheme sstim-eco:EcosystemPurposeScheme ;
    skos:topConceptOf sstim-eco:EcosystemPurposeScheme ;
    skos:prefLabel "Outreach"@en,
                   "Divulgazione"@it,
                   "Divulgação"@pt,
                   "Divulgación"@es ;
    skos:notation "outreach" ;
    skos:definition "Recording an engagement for transparent ecosystem outreach and follow-up."@en .

sstim-eco:purposeLivePublication a owl:NamedIndividual, sstim-eco:EcosystemPurpose, skos:Concept ;
    skos:inScheme sstim-eco:EcosystemPurposeScheme ;
    skos:topConceptOf sstim-eco:EcosystemPurposeScheme ;
    skos:prefLabel "Live publication"@en,
                   "Pubblicazione dinamica"@it,
                   "Publicação dinâmica"@pt,
                   "Publicación dinámica"@es ;
    skos:notation "live-publication" ;
    skos:definition "Publishing a record in a controlled mutable dataset outside the Zenodo-tracked release repository and its immutable DOI deposits."@en .

sstim-eco:purposeArchivalPublication a owl:NamedIndividual, sstim-eco:EcosystemPurpose, skos:Concept ;
    skos:inScheme sstim-eco:EcosystemPurposeScheme ;
    skos:topConceptOf sstim-eco:EcosystemPurposeScheme ;
    skos:prefLabel "Archival publication"@en,
                   "Pubblicazione archivistica"@it,
                   "Publicação arquivística"@pt,
                   "Publicación archivística"@es ;
    skos:notation "archival-publication" ;
    skos:definition "Eligibility for permanent citable archival publication. The archival pipeline is not implemented by ADR 0031."@en .


###########################################################################
# Engagement-outcome vocabulary (SKOS; public and private-ledger terms)
###########################################################################

sstim-eco:EngagementOutcomeScheme a skos:ConceptScheme ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    skos:prefLabel "SSTIM Engagement Outcome Vocabulary"@en ;
    dct:description "Minimal controlled outcomes for ecosystem engagement activities. Only positive admission outcomes may be projected publicly; negative and operational outcomes, messages, channels, and evidence remain private."@en ;
    skos:hasTopConcept sstim-eco:outcomeNotificationSent,
        sstim-eco:outcomeNotificationFailed, sstim-eco:outcomeAcknowledged,
        sstim-eco:outcomeChangesRequested, sstim-eco:outcomeObjected,
        sstim-eco:outcomeConsentGranted, sstim-eco:outcomeConsentDeclined,
        sstim-eco:outcomePublicationApproved, sstim-eco:outcomePublicationWithheld,
        sstim-eco:outcomeRecordAmended, sstim-eco:outcomeRemovalRequested,
        sstim-eco:outcomeConsentWithdrawn .

sstim-eco:outcomeNotificationSent a owl:NamedIndividual, sstim-eco:EngagementOutcome, skos:Concept ;
    skos:inScheme sstim-eco:EngagementOutcomeScheme ; skos:topConceptOf sstim-eco:EngagementOutcomeScheme ;
    skos:prefLabel "Notification sent"@en,
                   "Notifica inviata"@it,
                   "Notificação enviada"@pt,
                   "Notificación enviada"@es ; skos:notation "notification-sent" ;
    skos:definition "Notification was sent; no channel, address, or message is published."@en .

sstim-eco:outcomeNotificationFailed a owl:NamedIndividual, sstim-eco:EngagementOutcome, skos:Concept ;
    skos:inScheme sstim-eco:EngagementOutcomeScheme ; skos:topConceptOf sstim-eco:EngagementOutcomeScheme ;
    skos:prefLabel "Notification failed"@en,
                   "Notifica non riuscita"@it,
                   "Falha na notificação"@pt,
                   "Notificación fallida"@es ; skos:notation "notification-failed" ;
    skos:definition "A notification attempt failed; operational details remain private."@en .

sstim-eco:outcomeAcknowledged a owl:NamedIndividual, sstim-eco:EngagementOutcome, skos:Concept ;
    skos:inScheme sstim-eco:EngagementOutcomeScheme ; skos:topConceptOf sstim-eco:EngagementOutcomeScheme ;
    skos:prefLabel "Acknowledged"@en,
                   "Riscontro ricevuto"@it,
                   "Reconhecido"@pt,
                   "Acuse recibido"@es ; skos:notation "acknowledged" ;
    skos:definition "The subject acknowledged the engagement without this value implying broader consent."@en .

sstim-eco:outcomeChangesRequested a owl:NamedIndividual, sstim-eco:EngagementOutcome, skos:Concept ;
    skos:inScheme sstim-eco:EngagementOutcomeScheme ; skos:topConceptOf sstim-eco:EngagementOutcomeScheme ;
    skos:prefLabel "Changes requested"@en,
                   "Modifiche richieste"@it,
                   "Alterações solicitadas"@pt,
                   "Cambios solicitados"@es ; skos:notation "changes-requested" ;
    skos:definition "The subject requested changes to the relationship record."@en .

sstim-eco:outcomeObjected a owl:NamedIndividual, sstim-eco:EngagementOutcome, skos:Concept ;
    skos:inScheme sstim-eco:EngagementOutcomeScheme ; skos:topConceptOf sstim-eco:EngagementOutcomeScheme ;
    skos:prefLabel "Objected"@en,
                   "Obiezione sollevata"@it,
                   "Objeção apresentada"@pt,
                   "Objeción presentada"@es ; skos:notation "objected" ;
    skos:definition "The subject objected to the scoped relationship or its publication."@en .

sstim-eco:outcomeConsentGranted a owl:NamedIndividual, sstim-eco:EngagementOutcome, skos:Concept ;
    skos:inScheme sstim-eco:EngagementOutcomeScheme ; skos:topConceptOf sstim-eco:EngagementOutcomeScheme ;
    skos:prefLabel "Consent granted"@en,
                   "Consenso concesso"@it,
                   "Consentimento concedido"@pt,
                   "Consentimiento concedido"@es ; skos:notation "consent-granted" ;
    skos:definition "Consent was granted for the activity's declared relationship and purpose only."@en .

sstim-eco:outcomeConsentDeclined a owl:NamedIndividual, sstim-eco:EngagementOutcome, skos:Concept ;
    skos:inScheme sstim-eco:EngagementOutcomeScheme ; skos:topConceptOf sstim-eco:EngagementOutcomeScheme ;
    skos:prefLabel "Consent declined"@en,
                   "Consenso negato"@it,
                   "Consentimento recusado"@pt,
                   "Consentimiento denegado"@es ; skos:notation "consent-declined" ;
    skos:definition "Consent was declined for the activity's declared relationship and purpose only."@en .

sstim-eco:outcomePublicationApproved a owl:NamedIndividual, sstim-eco:EngagementOutcome, skos:Concept ;
    skos:inScheme sstim-eco:EngagementOutcomeScheme ; skos:topConceptOf sstim-eco:EngagementOutcomeScheme ;
    skos:prefLabel "Publication approved"@en,
                   "Pubblicazione approvata"@it,
                   "Publicação aprovada"@pt,
                   "Publicación aprobada"@es ; skos:notation "publication-approved" ;
    skos:definition "The curated record was approved for the relationship's declared purpose in the mutable live dataset."@en .

sstim-eco:outcomePublicationWithheld a owl:NamedIndividual, sstim-eco:EngagementOutcome, skos:Concept ;
    skos:inScheme sstim-eco:EngagementOutcomeScheme ; skos:topConceptOf sstim-eco:EngagementOutcomeScheme ;
    skos:prefLabel "Publication withheld"@en,
                   "Pubblicazione sospesa"@it,
                   "Publicação retida"@pt,
                   "Publicación retenida"@es ; skos:notation "publication-withheld" ;
    skos:definition "Publication was withheld for the activity's declared purpose."@en .

sstim-eco:outcomeRecordAmended a owl:NamedIndividual, sstim-eco:EngagementOutcome, skos:Concept ;
    skos:inScheme sstim-eco:EngagementOutcomeScheme ; skos:topConceptOf sstim-eco:EngagementOutcomeScheme ;
    skos:prefLabel "Record amended"@en,
                   "Registrazione modificata"@it,
                   "Registro emendado"@pt,
                   "Registro enmendado"@es ; skos:notation "record-amended" ;
    skos:definition "The qualified relationship record was amended through an identified revision."@en .

sstim-eco:outcomeRemovalRequested a owl:NamedIndividual, sstim-eco:EngagementOutcome, skos:Concept ;
    skos:inScheme sstim-eco:EngagementOutcomeScheme ; skos:topConceptOf sstim-eco:EngagementOutcomeScheme ;
    skos:prefLabel "Removal requested"@en,
                   "Rimozione richiesta"@it,
                   "Remoção solicitada"@pt,
                   "Eliminación solicitada"@es ; skos:notation "removal-requested" ;
    skos:definition "Removal of the scoped live relationship record was requested."@en .

sstim-eco:outcomeConsentWithdrawn a owl:NamedIndividual, sstim-eco:EngagementOutcome, skos:Concept ;
    skos:inScheme sstim-eco:EngagementOutcomeScheme ; skos:topConceptOf sstim-eco:EngagementOutcomeScheme ;
    skos:prefLabel "Consent withdrawn"@en,
                   "Consenso revocato"@it,
                   "Consentimento retirado"@pt,
                   "Consentimiento retirado"@es ; skos:notation "consent-withdrawn" ;
    skos:definition "Previously granted consent was withdrawn for the scoped relationship and purpose."@en .

