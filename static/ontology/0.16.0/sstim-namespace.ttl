[] a owl:Axiom ;
    owl:annotatedSource sstim-v:mechMultisensory ;
    owl:annotatedProperty skos:relatedMatch ;
    owl:annotatedTarget wd:Q17166073 ;
    dct:source <http://www.wikidata.org/entity/Q17166073> ;
