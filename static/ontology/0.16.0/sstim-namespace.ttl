    dct:issued "2026-08-18"^^xsd:date ;
    dct:modified "2026-08-18"^^xsd:date ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    skos:historyNote "0.6.0 narrows mappings that had conflated SSTIM's domain with brainwave-entrainment or therapy concepts, removes an unverified Music Ontology association, records the corrected MeSH audit, removes obsolete OBI_0000011, and limits OBI protocol alignment to the actual SSTIM protocol class."@en ;
    skos:historyNote "The 2026-08-08 Wikidata review adds a conservative close match for monaural beats and weakens the binaural-beats technique mapping because Wikidata Q863539 also represents a perceptual phenomenon and music genre."@en .


###########################################################################
# Wikidata alignments — frequency bands
###########################################################################

# All QIDs below were verified against live Wikidata (2026-06). The prior
# QIDs in this section were incorrect (they resolved to unrelated entities
# such as a Van Halen album and a stock exchange) and were replaced.
#
# Re-audited 2026-07-24 (RDF-08/RDF-17, 2026-07-24 audit; reviewer: Renato
# Fabbri). Downgraded exactMatch to closeMatch: each Wikidata item is the
# observed-EEG-oscillation sense of the band (a neurophysiological phenomenon),
# while sstim-v:alpha/delta/theta/beta/gamma are also used, unsplit, as
# stimulus-frequency targets (sstim:targetsFrequencyBand). SSTIM's own
# FrequencyBandScheme currently conflates those two senses (RDF-08); until
# they are split into distinct classes, extensional identity with the
# single-sense Wikidata items cannot be claimed with exactMatch's confidence.
# Revisit once RDF-08's oscillation-band/stimulus-target split lands.

# Moved to the oscillations by ADR 0049 (2026-08-15). Each Wikidata item
# describes itself as a neural oscillation — Q2469782 is "neural oscillation in
# the frequency range of 8-12 Hz" — so the band, a Hz interval, was never its
# counterpart. The history notes keep anyone who resolved the old mapping from
# reaching a dead end.
sstim-v:alpha skos:historyNote "External mapping moved 2026-08-15 (ADR 0049): wd:Q2469782 describes a neural oscillation, not a Hz interval, and now maps to sstim-v:alphaOscillation. This band is reachable from that concept through sstim:hasTypicalFrequencyBand."@en .
sstim-v:delta skos:historyNote "External mapping moved 2026-08-15 (ADR 0049): wd:Q2623205 now maps to sstim-v:deltaOscillation."@en .
sstim-v:theta skos:historyNote "External mapping moved 2026-08-15 (ADR 0049): wd:Q2370623 now maps to sstim-v:thetaOscillation."@en .
sstim-v:beta skos:historyNote "External mapping moved 2026-08-15 (ADR 0049): wd:Q831014 now maps to sstim-v:betaOscillation."@en .
sstim-v:gamma skos:historyNote "External mapping moved 2026-08-15 (ADR 0049): wd:Q2623017 now maps to sstim-v:gammaOscillation."@en .


###########################################################################
# Wikidata alignments — neural oscillations (ADR 0049)
#
# Verified against live Wikidata on 2026-08-15. Four are exactMatch: the items
# describe the same named rhythm SSTIM names, and the numeric bounds they quote
# differ only as delimiting conventions differ, which is not an intension
# difference.
#
# Beta is the exception, and it is why the extension test exists. Q831014 spans
# 12.5-30 Hz, while SSTIM holds the sensorimotor rhythm apart at 12-15 Hz and
# starts beta at 15. Wikidata's beta wave therefore subsumes an entity SSTIM
# keeps separate, so the two are close rather than identical.
###########################################################################

sstim-v:alphaOscillation skos:exactMatch wd:Q2469782 .
sstim-v:deltaOscillation skos:exactMatch wd:Q2623205 .
sstim-v:thetaOscillation skos:exactMatch wd:Q2370623 .
sstim-v:gammaOscillation skos:exactMatch wd:Q2623017 .
sstim-v:betaOscillation  skos:closeMatch wd:Q831014 .

# A BSC binaural voice is a parameter bundle that can realize binaural beats;
# it is not identical to the perceptual phenomenon or musical genre represented
# by Wikidata Q863539.
sstim-v:voiceBinaural skos:relatedMatch wd:Q863539 .

# isochronic tones: https://www.wikidata.org/wiki/Q98000061
sstim-v:voiceSymmetry skos:relatedMatch wd:Q98000061 .

# Technique vocabulary alignments. Q863539 and Q6898437 were re-verified against
# live Wikidata on 2026-08-08. Q6898437 is a thin item, so closeMatch is the
# strongest defensible assertion. Q863539 also represents a perceptual phenomenon
# and music genre, so the SSTIM stimulation technique is only related to it.
# Other techniques (RAS, ASSR, vibroacoustic, ultrasound neuromodulation, etc.)
# are pending Wikidata alignment — tracked in TODO.md.
sstim-v:techIsochronicTones skos:closeMatch wd:Q98000061 .
sstim-v:techMonauralBeats skos:closeMatch wd:Q6898437 .
sstim-v:techBinauralBeats skos:relatedMatch wd:Q863539 .

# Multisensory integration: verified Wikidata concept Q17166073. SSTIM's term
# is a proposed-mechanism category, so relatedMatch is intentionally weaker
# than exactMatch.
sstim-v:mechMultisensory skos:relatedMatch wd:Q17166073 .

# Note: Wikidata items for Martigli oscillation, Sonic Symmetry permutation
# technique, and the SSTIM ontology itself are pending — Wikidata contribution
# work item tracked in TODO.md.


###########################################################################
# Mapping provenance (KR-09)
#
# The rationale for every external mapping used to live only in the Turtle
# comments above, which no consumer can read. These annotated axioms carry the
# same facts as data: which source item was checked, when it was last verified,
# who reviewed it where a review is on record, and why the assertion is
# closeMatch or relatedMatch rather than exactMatch.
#
# The plain mapping triples above are untouched, so nothing that already
# consumes them changes. An annotation is about an assertion, not a second
# assertion.
#
# `dct:date` is the date the target item was last verified against live
# Wikidata, not a source revision id: Wikidata revisions were not recorded at
# verification time, and inventing them would be worse than naming the date
# that was. Re-verify before upgrading any of these to exactMatch — the
# disposition for KR-09 requires an extension/intension test, not label
# similarity.
###########################################################################

[] a owl:Axiom ;
    owl:annotatedSource sstim-v:alphaOscillation ;
    owl:annotatedProperty skos:exactMatch ;
    owl:annotatedTarget wd:Q2469782 ;
    dct:source <http://www.wikidata.org/entity/Q2469782> ;
    dct:date "2026-08-15"^^xsd:date ;
    prov:wasAttributedTo <https://orcid.org/0000-0002-9699-629X> ;
    skos:editorialNote "Upgraded from closeMatch on the band to exactMatch on the rhythm (ADR 0049). The item describes a neural oscillation, which is what this concept now names; the earlier closeMatch was forced by the subject being a Hz interval. Quoted numeric bounds differ only as delimiting conventions differ."@en .

[] a owl:Axiom ;
    owl:annotatedSource sstim-v:deltaOscillation ;
    owl:annotatedProperty skos:exactMatch ;
    owl:annotatedTarget wd:Q2623205 ;
    dct:source <http://www.wikidata.org/entity/Q2623205> ;
    dct:date "2026-08-15"^^xsd:date ;
    prov:wasAttributedTo <https://orcid.org/0000-0002-9699-629X> ;
    skos:editorialNote "Upgraded from closeMatch on the band to exactMatch on the rhythm (ADR 0049). The item describes a neural oscillation, which is what this concept now names; the earlier closeMatch was forced by the subject being a Hz interval. Quoted numeric bounds differ only as delimiting conventions differ."@en .

[] a owl:Axiom ;
    owl:annotatedSource sstim-v:thetaOscillation ;
    owl:annotatedProperty skos:exactMatch ;
    owl:annotatedTarget wd:Q2370623 ;
    dct:source <http://www.wikidata.org/entity/Q2370623> ;
    dct:date "2026-08-15"^^xsd:date ;
    prov:wasAttributedTo <https://orcid.org/0000-0002-9699-629X> ;
    skos:editorialNote "Upgraded from closeMatch on the band to exactMatch on the rhythm (ADR 0049). The item describes a neural oscillation, which is what this concept now names; the earlier closeMatch was forced by the subject being a Hz interval. Quoted numeric bounds differ only as delimiting conventions differ."@en .

[] a owl:Axiom ;
    owl:annotatedSource sstim-v:betaOscillation ;
    owl:annotatedProperty skos:closeMatch ;
    owl:annotatedTarget wd:Q831014 ;
    dct:source <http://www.wikidata.org/entity/Q831014> ;
    dct:date "2026-08-15"^^xsd:date ;
    prov:wasAttributedTo <https://orcid.org/0000-0002-9699-629X> ;
    skos:editorialNote "Q831014 spans 12.5-30 Hz while SSTIM holds the sensorimotor rhythm apart at 12-15 Hz and begins beta at 15, so the Wikidata item subsumes an entity SSTIM keeps separate. Close rather than identical, by extension rather than by label."@en .

[] a owl:Axiom ;
    owl:annotatedSource sstim-v:gammaOscillation ;
    owl:annotatedProperty skos:exactMatch ;
    owl:annotatedTarget wd:Q2623017 ;
    dct:source <http://www.wikidata.org/entity/Q2623017> ;
    dct:date "2026-08-15"^^xsd:date ;
    prov:wasAttributedTo <https://orcid.org/0000-0002-9699-629X> ;
    skos:editorialNote "Upgraded from closeMatch on the band to exactMatch on the rhythm (ADR 0049). The item describes a neural oscillation, which is what this concept now names; the earlier closeMatch was forced by the subject being a Hz interval. Quoted numeric bounds differ only as delimiting conventions differ."@en .

[] a owl:Axiom ;
    owl:annotatedSource sstim-v:voiceBinaural ;
    owl:annotatedProperty skos:relatedMatch ;
    owl:annotatedTarget wd:Q863539 ;
    dct:source <http://www.wikidata.org/entity/Q863539> ;
    dct:date "2026-08-08"^^xsd:date ;
    prov:wasAttributedTo <https://orcid.org/0000-0002-9699-629X> ;
    skos:editorialNote "A BSC binaural voice is a parameter bundle that can realize binaural beats. It is not identical to the perceptual phenomenon or the music genre the Wikidata item also represents."@en .

[] a owl:Axiom ;
    owl:annotatedSource sstim-v:voiceSymmetry ;
    owl:annotatedProperty skos:relatedMatch ;
    owl:annotatedTarget wd:Q98000061 ;
