###########################################################################
# Controlled vocabulary concepts
###########################################################################

# ── ADR 0034: neutral medium parents and applied-energy media ────────────
# Physical categories are not a disjoint flat list. Electric and magnetic
# fields and optical radiation are all electromagnetic phenomena, but the
# operational delivery distinctions stay useful: TMS applies a magnetic field
# and induces an electric field in tissue, while tES applies current through
# electrodes. Concepts are related by broader/narrower and are NOT declared
# disjoint. mediumElectromagneticField is retained for compatibility and
# generic exposure records; it is not the only value for electromagnetic
# techniques.

sstim-ex:mediumAcousticEnergy a owl:NamedIndividual, sstim-ex:PhysicalDeliveryMedium, skos:Concept ;
    skos:inScheme sstim-ex:DeliveryMediumScheme ;
    skos:topConceptOf sstim-ex:DeliveryMediumScheme ;
    skos:narrower sstim-ex:mediumAirConductedSound, sstim-ex:mediumContactAcousticVibration,
        sstim-ex:mediumFocusedUltrasound ;
    skos:prefLabel "acoustic energy"@en,
                   "energia acustica"@it,
                   "energia acústica"@pt,
                   "energía acústica"@es ;
    skos:notation "acoustic-energy" ;
    skos:definition "Mechanical wave energy applied as a stimulus, whether or not it is audible."@en .

sstim-ex:mediumFocusedUltrasound a owl:NamedIndividual, sstim-ex:PhysicalDeliveryMedium, skos:Concept ;
    skos:inScheme sstim-ex:DeliveryMediumScheme ;
    skos:broader sstim-ex:mediumAcousticEnergy ;
    skos:prefLabel "focused ultrasound"@en,
                   "ultrasuoni focalizzati"@it,
                   "ultrassom focalizado"@pt,
                   "ultrasonido focalizado"@es ;
    skos:notation "focused-ultrasound" ;
    skos:definition "Acoustic energy focused on a spatial target, applied above the audible range as the intended causal medium."@en ;
    skos:scopeNote "An audible or somatosensory concomitant may still be present and is recorded as a separate channel with a concomitant role, not by reclassifying this medium."@en .

sstim-ex:mediumMechanicalForce a owl:NamedIndividual, sstim-ex:PhysicalDeliveryMedium, skos:Concept ;
    skos:inScheme sstim-ex:DeliveryMediumScheme ;
    skos:topConceptOf sstim-ex:DeliveryMediumScheme ;
    skos:narrower sstim-ex:mediumMechanicalVibration ;
    skos:prefLabel "mechanical force"@en,
                   "forza meccanica"@it,
                   "força mecânica"@pt,
                   "fuerza mecánica"@es ;
    skos:notation "mechanical-force" ;
    skos:definition "Applied mechanical force, displacement, or motion delivered to the body or a contacting surface."@en .

sstim-ex:mediumElectromagneticRadiation a owl:NamedIndividual, sstim-ex:PhysicalDeliveryMedium, skos:Concept ;
    skos:inScheme sstim-ex:DeliveryMediumScheme ;
    skos:topConceptOf sstim-ex:DeliveryMediumScheme ;
    skos:narrower sstim-ex:mediumVisualLight, sstim-ex:mediumInfraredRadiation,
        sstim-ex:mediumUltravioletRadiation ;
    skos:prefLabel "electromagnetic radiation"@en,
                   "radiazione elettromagnetica"@it,
                   "radiação eletromagnética"@pt,
                   "radiación electromagnética"@es ;
    skos:notation "electromagnetic-radiation" ;
    skos:definition "Radiated electromagnetic energy applied as a stimulus, across the optical range and adjacent bands."@en .

sstim-ex:mediumThermalEnergy a owl:NamedIndividual, sstim-ex:PhysicalDeliveryMedium, skos:Concept ;
    skos:inScheme sstim-ex:DeliveryMediumScheme ;
    skos:topConceptOf sstim-ex:DeliveryMediumScheme ;
    skos:narrower sstim-ex:mediumThermalContact ;
    skos:prefLabel "thermal energy"@en,
                   "energia termica"@it,
                   "energia térmica"@pt,
                   "energía térmica"@es ;
    skos:notation "thermal-energy" ;
    skos:definition "Applied heating or cooling delivered as a stimulus by any transfer path."@en .

sstim-ex:mediumChemicalAgent a owl:NamedIndividual, sstim-ex:PhysicalDeliveryMedium, skos:Concept ;
    skos:inScheme sstim-ex:DeliveryMediumScheme ;
    skos:topConceptOf sstim-ex:DeliveryMediumScheme ;
    skos:narrower sstim-ex:mediumPharmacologicalAgent, sstim-ex:mediumOlfactoryChemicalExposure,
        sstim-ex:mediumGustatoryChemicalExposure ;
    skos:prefLabel "chemical agent"@en,
                   "agente chimico"@it,
                   "agente químico"@pt,
                   "agente químico"@es ;
    skos:notation "chemical-agent" ;
    skos:definition "A chemical substance applied as the controlled input of a stimulation method."@en ;
    skos:scopeNote "A neutral delivery category. Unlike the effect-oriented MeSH sense of chemical stimulation, it asserts no increase in any physiological or metabolic parameter, and no response at all; a chemical medium is not by itself neuromodulation, since olfactory and gustatory inputs are chemical and sensory."@en .

sstim-ex:mediumPharmacologicalAgent a owl:NamedIndividual, sstim-ex:PhysicalDeliveryMedium, skos:Concept ;
    skos:inScheme sstim-ex:DeliveryMediumScheme ;
    skos:broader sstim-ex:mediumChemicalAgent ;
    skos:prefLabel "pharmacological agent"@en,
                   "agente farmacologico"@it,
                   "agente farmacológico"@pt,
                   "agente farmacológico"@es ;
    skos:notation "pharmacological-agent" ;
    skos:definition "A pharmacological substance delivered as the controlled input of a stimulation method."@en ;
    skos:scopeNote "Ordinary systemic neuroactive pharmacotherapy is outside the neuromodulation technique catalog; a bounded method qualifies only with an explicit neuromodulatory objective and an identified neural target."@en .

sstim-ex:mediumAppliedElectricCurrent a owl:NamedIndividual, sstim-ex:PhysicalDeliveryMedium, skos:Concept ;
    skos:inScheme sstim-ex:DeliveryMediumScheme ;
    skos:topConceptOf sstim-ex:DeliveryMediumScheme ;
    skos:related sstim-ex:mediumAppliedElectricField ;
    skos:prefLabel "applied electric current"@en,
                   "corrente elettrica applicata"@it,
                   "corrente elétrica aplicada"@pt,
                   "corriente eléctrica aplicada"@es ;
    skos:notation "applied-electric-current" ;
    skos:definition "Electric current delivered through electrodes in contact with tissue or the body surface."@en ;
    skos:scopeNote "Applied current is not by itself brain stimulation: peripheral nerve, muscle, and cardiac applications use the same medium and are separated by the route, approach, and target facets."@en .

sstim-ex:mediumAppliedElectricField a owl:NamedIndividual, sstim-ex:PhysicalDeliveryMedium, skos:Concept ;
    skos:inScheme sstim-ex:DeliveryMediumScheme ;
    skos:topConceptOf sstim-ex:DeliveryMediumScheme ;
    skos:related sstim-ex:mediumAppliedElectricCurrent ;
    skos:prefLabel "applied electric field"@en,
                   "campo elettrico applicato"@it,
                   "campo elétrico aplicado"@pt,
                   "campo eléctrico aplicado"@es ;
    skos:notation "applied-electric-field" ;
    skos:definition "An electric field present in tissue, whether applied directly or induced by a changing magnetic field."@en ;
    skos:scopeNote "The field induced in tissue by TMS is an established physical transformation, so it is represented here as a secondary tissue-field interaction in the exposure or device description — not as a proposed mechanism. How that field produces a neural response remains a mechanism and evidence question."@en .

sstim-ex:mediumAppliedMagneticField a owl:NamedIndividual, sstim-ex:PhysicalDeliveryMedium, skos:Concept ;
    skos:inScheme sstim-ex:DeliveryMediumScheme ;
    skos:topConceptOf sstim-ex:DeliveryMediumScheme ;
    skos:prefLabel "applied magnetic field"@en,
                   "campo magnetico applicato"@it,
                   "campo magnético aplicado"@pt,
                   "campo magnético aplicado"@es ;
    skos:notation "applied-magnetic-field" ;
    skos:definition "A magnetic field applied by a coil or magnet as the primary delivered medium."@en .

sstim-ex:mediumAirConductedSound a owl:NamedIndividual, sstim-ex:PhysicalDeliveryMedium, skos:Concept ;
    skos:inScheme sstim-ex:DeliveryMediumScheme ;
    skos:broader sstim-ex:mediumAcousticEnergy ;
    skos:prefLabel "air-conducted sound"@en,
                   "suono per via aerea"@it,
                   "som conduzido pelo ar"@pt,
                   "sonido conducido por aire"@es ;
    skos:notation "air-conducted-sound" ;
    skos:definition "Sound delivered through air before reaching the ear or body."@en .

sstim-ex:mediumContactAcousticVibration a owl:NamedIndividual, sstim-ex:PhysicalDeliveryMedium, skos:Concept ;
    skos:inScheme sstim-ex:DeliveryMediumScheme ;
    skos:broader sstim-ex:mediumAcousticEnergy ;
    skos:prefLabel "contact acoustic vibration"@en,
                   "vibrazione acustica per contatto"@it,
                   "vibração acústica por contato"@pt,
                   "vibración acústica por contacto"@es ;
    skos:notation "contact-acoustic-vibration" ;
    skos:definition "Acoustic energy delivered through contact with a vibrating object or surface."@en .

sstim-ex:mediumMechanicalVibration a owl:NamedIndividual, sstim-ex:PhysicalDeliveryMedium, skos:Concept ;
    skos:inScheme sstim-ex:DeliveryMediumScheme ;
    skos:broader sstim-ex:mediumMechanicalForce ;
    skos:prefLabel "mechanical vibration"@en,
                   "vibrazione meccanica"@it,
                   "vibração mecânica"@pt,
                   "vibración mecánica"@es ;
    skos:notation "mechanical-vibration" ;
    skos:definition "Mechanical motion delivered by an actuator, transducer, surface, or object."@en .

sstim-ex:mediumVisualLight a owl:NamedIndividual, sstim-ex:PhysicalDeliveryMedium, skos:Concept ;
    skos:inScheme sstim-ex:DeliveryMediumScheme ;
    skos:broader sstim-ex:mediumElectromagneticRadiation ;
    skos:prefLabel "visual light"@en,
                   "luce visibile"@it,
                   "luz visível"@pt,
                   "luz visible"@es ;
    skos:notation "visual-light" ;
    skos:definition "Visible light delivered by a display, lamp, projector, or environment."@en .

sstim-ex:mediumElectromagneticField a owl:NamedIndividual, sstim-ex:PhysicalDeliveryMedium, skos:Concept ;
    skos:inScheme sstim-ex:DeliveryMediumScheme ;
    skos:topConceptOf sstim-ex:DeliveryMediumScheme ;
    skos:prefLabel "electromagnetic field"@en,
                   "campo elettromagnetico"@it,
                   "campo eletromagnético"@pt,
                   "campo electromagnético"@es ;
    skos:notation "electromagnetic-field" ;
    skos:definition "Electromagnetic exposure modeled as a physical medium without asserting stimulation efficacy."@en .

sstim-ex:mediumRespiratoryCue a owl:NamedIndividual, sstim-ex:PhysicalDeliveryMedium, skos:Concept ;
    skos:inScheme sstim-ex:DeliveryMediumScheme ;
    skos:topConceptOf sstim-ex:DeliveryMediumScheme ;
    skos:prefLabel "respiratory cue"@en,
                   "segnale respiratorio"@it,
                   "sinal respiratório"@pt,
                   "señal respiratoria"@es ;
    skos:notation "respiratory-cue" ;
    skos:definition "A visual, auditory, haptic, or other cue used to guide breathing behavior."@en .

sstim-ex:mediumStereoscopicVisualPresentation a owl:NamedIndividual, sstim-ex:PhysicalDeliveryMedium, skos:Concept ;
    skos:inScheme sstim-ex:DeliveryMediumScheme ;
    skos:topConceptOf sstim-ex:DeliveryMediumScheme ;
    skos:prefLabel "stereoscopic visual presentation"@en,
                   "presentazione visiva stereoscopica"@it,
                   "apresentação visual estereoscópica"@pt,
                   "presentación visual estereoscópica"@es ;
    skos:notation "stereoscopic-visual-presentation" ;
    skos:definition "Visual presentation arranged to create binocular depth perception."@en .

sstim-ex:mediumOlfactoryChemicalExposure a owl:NamedIndividual, sstim-ex:PhysicalDeliveryMedium, skos:Concept ;
    skos:inScheme sstim-ex:DeliveryMediumScheme ;
    skos:broader sstim-ex:mediumChemicalAgent ;
    skos:prefLabel "olfactory chemical exposure"@en,
                   "esposizione chimica olfattiva"@it,
                   "exposição química olfativa"@pt,
                   "exposición química olfativa"@es ;
    skos:notation "olfactory-chemical-exposure" ;
    skos:definition "Chemical exposure intended or likely to be perceived through smell."@en .

sstim-ex:mediumGustatoryChemicalExposure a owl:NamedIndividual, sstim-ex:PhysicalDeliveryMedium, skos:Concept ;
    skos:inScheme sstim-ex:DeliveryMediumScheme ;
    skos:broader sstim-ex:mediumChemicalAgent ;
    skos:prefLabel "gustatory chemical exposure"@en,
                   "esposizione chimica gustativa"@it,
                   "exposição química gustativa"@pt,
                   "exposición química gustativa"@es ;
    skos:notation "gustatory-chemical-exposure" ;
    skos:definition "Chemical exposure intended or likely to be perceived through taste."@en .

sstim-ex:mediumLiquidGelImmersion a owl:NamedIndividual, sstim-ex:PhysicalDeliveryMedium, skos:Concept ;
    skos:inScheme sstim-ex:DeliveryMediumScheme ;
    skos:topConceptOf sstim-ex:DeliveryMediumScheme ;
    skos:prefLabel "liquid/gel immersion"@en,
                   "immersione in liquido/gel"@it,
                   "imersão em líquido/gel"@pt,
                   "inmersión en líquido/gel"@es ;
    skos:notation "liquid-gel-immersion" ;
    skos:definition "Liquid or gel contact used as an immersive tactile, thermal, or pressure medium."@en .

sstim-ex:mediumTextileClothingContact a owl:NamedIndividual, sstim-ex:PhysicalDeliveryMedium, skos:Concept ;
    skos:inScheme sstim-ex:DeliveryMediumScheme ;
    skos:topConceptOf sstim-ex:DeliveryMediumScheme ;
