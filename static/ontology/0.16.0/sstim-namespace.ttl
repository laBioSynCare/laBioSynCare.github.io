[] a owl:Axiom ;
    owl:annotatedSource sstim-v:techBinauralBeats ;
    owl:annotatedProperty skos:relatedMatch ;
    owl:annotatedTarget wd:Q863539 ;
    dct:source <http://www.wikidata.org/entity/Q863539> ;
