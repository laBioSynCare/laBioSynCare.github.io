###########################################################################
#
#  SSTIM Core Profile entrypoint
#
#  Version: 0.15.0-dev
#  Date:    2026-08-04
#  License: CC BY 4.0 <https://creativecommons.org/licenses/by/4.0/>
#
#  This import ontology is a consumer entrypoint, not a term-owning module.
#  SHACL shapes are selected separately and are never silently imported.
#
###########################################################################

@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix prof: <http://www.w3.org/ns/dx/prof/> .
@prefix role: <http://www.w3.org/ns/dx/prof/role/> .

<https://w3id.org/sstim/profile/core> a owl:Ontology, prof:Profile ;
    owl:versionInfo "0.15.0-dev" ;
    prof:hasToken "core" ;
    prof:isProfileOf <https://w3id.org/sstim> ;
    prof:hasResource
        <https://w3id.org/sstim/profile/core#entrypoint>,
        <https://w3id.org/sstim/profile/core#constraints>,
        <https://w3id.org/sstim/profile/core#manifest> ;
    dct:title "SSTIM Core Profile"@en ;
    dct:description "The smallest SSTIM consumer contract: the stimulation process kernel and engine-independent stimulus descriptions, including regime, minimal channels, duration, and optional targets."@en ;
    dct:isPartOf <https://w3id.org/sstim> ;
    dct:requires
        <https://w3id.org/sstim>,
        <https://w3id.org/sstim/stimulus> ;
    owl:imports
        <https://w3id.org/sstim/kernel>,
        <https://w3id.org/sstim/stimulus> ;
    dct:creator <https://orcid.org/0000-0002-9699-629X> ;
    dct:publisher <https://github.com/laBioSynCare> ;
    dct:created "2026-08-01"^^xsd:date ;
    dct:issued "2026-08-13"^^xsd:date ;
    dct:modified "2026-08-13"^^xsd:date ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    rdfs:seeAlso
        <https://w3id.org/sstim/manifest>,
        <https://github.com/laBioSynCare/laBioSynCare.github.io/blob/main/docs/decisions/0043-sstim-core-profile-and-module-boundaries.md>,
        <https://github.com/laBioSynCare/laBioSynCare.github.io/blob/main/docs/decisions/0044-stimulus-channel-core-ownership.md> .

<https://w3id.org/sstim/profile/core#entrypoint> a prof:ResourceDescriptor ;
    prof:hasRole role:specification ;
    prof:hasArtifact <https://w3id.org/sstim/profile/core> ;
    dct:format "text/turtle" .

<https://w3id.org/sstim/profile/core#constraints> a prof:ResourceDescriptor ;
    prof:hasRole role:constraints ;
    prof:hasArtifact <https://w3id.org/sstim/core-shapes> ;
    dct:conformsTo <http://www.w3.org/ns/shacl#> ;
    dct:format "text/turtle" .

<https://w3id.org/sstim/profile/core#manifest> a prof:ResourceDescriptor ;
    prof:hasRole role:schema ;
    prof:hasArtifact <https://w3id.org/sstim/manifest> ;
    dct:format "application/json" .
