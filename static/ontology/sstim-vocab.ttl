###########################################################################
# Part 12 — Evidence Basis and Review Provenance Schemes (ADR 0027)
#
# Controlled values for the orthogonal evidence-basis axes and the review
# axes. Pattern-2 dual typing (ADR 0002). English-only labels at
# introduction; translations follow the normal review process.
###########################################################################

sstim-v:ModalityApplicabilityScheme a skos:ConceptScheme ;
    skos:definition "Controlled statements of how sensory modality applies to an evidence source: mixed, unknown/not reported, or not applicable (ADR 0027)."@en ;
    skos:prefLabel "SSTIM Evidence Modality Applicability Vocabulary"@en ;
    skos:hasTopConcept sstim-v:applicabilityMixedModalities,
                       sstim-v:applicabilityUnknownModality,
                       sstim-v:applicabilityNotApplicable .

sstim-v:applicabilityMixedModalities a owl:NamedIndividual, sstim:ModalityApplicability, skos:Concept ;
    skos:inScheme sstim-v:ModalityApplicabilityScheme ;
    skos:prefLabel "Mixed modalities"@en ;
    skos:notation "mixed-modalities" ;
    skos:definition "The source spans several sensory modalities; every canonical modality it actually supports is still listed explicitly."@en .

sstim-v:applicabilityUnknownModality a owl:NamedIndividual, sstim:ModalityApplicability, skos:Concept ;
    skos:inScheme sstim-v:ModalityApplicabilityScheme ;
    skos:prefLabel "Unknown / not reported"@en ;
    skos:notation "unknown-modality" ;
    skos:definition "The source does not report, or the extraction did not establish, the sensory modality."@en .

sstim-v:applicabilityNotApplicable a owl:NamedIndividual, sstim:ModalityApplicability, skos:Concept ;
    skos:inScheme sstim-v:ModalityApplicabilityScheme ;
    skos:prefLabel "Not applicable"@en ;
    skos:notation "not-applicable-modality" ;
    skos:definition "Sensory modality does not apply to this source (for example a paced-breathing intervention with no sensory delivery claim)."@en .


sstim-v:StudyDesignScheme a skos:ConceptScheme ;
    skos:definition "Controlled designs of the underlying studies contributing to an evidence source (ADR 0027)."@en ;
    skos:prefLabel "SSTIM Study Design Vocabulary"@en ;
    skos:hasTopConcept sstim-v:designRandomizedControlledTrial, sstim-v:designControlledTrial,
                       sstim-v:designObservational, sstim-v:designCaseReport,
                       sstim-v:designPreclinicalExperiment, sstim-v:designMixedDesigns,
                       sstim-v:designUnknownDesign .

sstim-v:designRandomizedControlledTrial a owl:NamedIndividual, sstim:StudyDesign, skos:Concept ;
    skos:inScheme sstim-v:StudyDesignScheme ;
    skos:prefLabel "Randomized controlled trial"@en ;
    skos:notation "rct" ;
    skos:definition "Randomized allocation to intervention and control conditions."@en .

sstim-v:designControlledTrial a owl:NamedIndividual, sstim:StudyDesign, skos:Concept ;
    skos:inScheme sstim-v:StudyDesignScheme ;
    skos:prefLabel "Controlled trial (non-randomized)"@en ;
    skos:notation "controlled-trial" ;
    skos:definition "Controlled comparison without randomized allocation."@en .

sstim-v:designObservational a owl:NamedIndividual, sstim:StudyDesign, skos:Concept ;
    skos:inScheme sstim-v:StudyDesignScheme ;
    skos:prefLabel "Observational"@en ;
    skos:notation "observational" ;
    skos:definition "Observational design without experimenter-controlled allocation."@en .

sstim-v:designCaseReport a owl:NamedIndividual, sstim:StudyDesign, skos:Concept ;
    skos:inScheme sstim-v:StudyDesignScheme ;
    skos:prefLabel "Case report / case series"@en ;
    skos:notation "case-report" ;
    skos:definition "Individual case descriptions without systematic comparison."@en .

sstim-v:designPreclinicalExperiment a owl:NamedIndividual, sstim:StudyDesign, skos:Concept ;
    skos:inScheme sstim-v:StudyDesignScheme ;
    skos:prefLabel "Preclinical experiment"@en ;
    skos:notation "preclinical-experiment" ;
    skos:definition "Controlled experiment in a preclinical model rather than human participants."@en .

sstim-v:designMixedDesigns a owl:NamedIndividual, sstim:StudyDesign, skos:Concept ;
    skos:inScheme sstim-v:StudyDesignScheme ;
    skos:prefLabel "Mixed designs"@en ;
    skos:notation "mixed-designs" ;
    skos:definition "The source aggregates studies of several designs (typical of reviews)."@en .

sstim-v:designUnknownDesign a owl:NamedIndividual, sstim:StudyDesign, skos:Concept ;
    skos:inScheme sstim-v:StudyDesignScheme ;
    skos:prefLabel "Unknown design"@en ;
    skos:notation "unknown-design" ;
    skos:definition "The underlying design was not reported or has not been extracted."@en .


sstim-v:StudyModelScheme a skos:ConceptScheme ;
    skos:definition "Controlled models or stages in which evidence was produced: human, preclinical animal, in vitro, computational (ADR 0027)."@en ;
    skos:prefLabel "SSTIM Study Model Vocabulary"@en ;
    skos:hasTopConcept sstim-v:modelHuman, sstim-v:modelPreclinicalAnimal,
                       sstim-v:modelInVitro, sstim-v:modelComputational,
                       sstim-v:modelMixedModels, sstim-v:modelUnknownModel .

sstim-v:modelHuman a owl:NamedIndividual, sstim:StudyModel, skos:Concept ;
    skos:inScheme sstim-v:StudyModelScheme ;
    skos:prefLabel "Human participants"@en ;
    skos:notation "human" ;
    skos:definition "Findings produced with human participants."@en .

sstim-v:modelPreclinicalAnimal a owl:NamedIndividual, sstim:StudyModel, skos:Concept ;
    skos:inScheme sstim-v:StudyModelScheme ;
    skos:prefLabel "Preclinical animal model"@en ;
    skos:notation "preclinical-animal" ;
    skos:definition "Findings produced in a non-human animal model. Replaces the modality-tag misuse of PRECLINICAL as a modality."@en .

sstim-v:modelInVitro a owl:NamedIndividual, sstim:StudyModel, skos:Concept ;
    skos:inScheme sstim-v:StudyModelScheme ;
    skos:prefLabel "In vitro"@en ;
    skos:notation "in-vitro" ;
    skos:definition "Findings produced in vitro."@en .

sstim-v:modelComputational a owl:NamedIndividual, sstim:StudyModel, skos:Concept ;
    skos:inScheme sstim-v:StudyModelScheme ;
    skos:prefLabel "Computational model"@en ;
    skos:notation "computational" ;
    skos:definition "Findings produced by simulation or computational modeling."@en .

sstim-v:modelMixedModels a owl:NamedIndividual, sstim:StudyModel, skos:Concept ;
    skos:inScheme sstim-v:StudyModelScheme ;
    skos:prefLabel "Mixed models"@en ;
    skos:notation "mixed-models" ;
    skos:definition "The source aggregates findings across several models or stages."@en .

sstim-v:modelUnknownModel a owl:NamedIndividual, sstim:StudyModel, skos:Concept ;
    skos:inScheme sstim-v:StudyModelScheme ;
    skos:prefLabel "Unknown model"@en ;
    skos:notation "unknown-model" ;
    skos:definition "The model or stage was not reported or has not been extracted."@en .


sstim-v:EvidenceSynthesisTypeScheme a skos:ConceptScheme ;
    skos:definition "Controlled synthesis levels of an evidence source, from primary study to meta-analysis (ADR 0027)."@en ;
    skos:prefLabel "SSTIM Evidence Synthesis Type Vocabulary"@en ;
    skos:hasTopConcept sstim-v:synthesisPrimaryStudy, sstim-v:synthesisNarrativeReview,
                       sstim-v:synthesisSystematicReview, sstim-v:synthesisMetaAnalysis,
                       sstim-v:synthesisLiteratureReview, sstim-v:synthesisTutorial .

sstim-v:synthesisPrimaryStudy a owl:NamedIndividual, sstim:EvidenceSynthesisType, skos:Concept ;
    skos:inScheme sstim-v:EvidenceSynthesisTypeScheme ;
    skos:prefLabel "Primary study"@en ;
    skos:notation "primary-study" ;
    skos:definition "An original empirical study, not a synthesis of other studies."@en .

sstim-v:synthesisNarrativeReview a owl:NamedIndividual, sstim:EvidenceSynthesisType, skos:Concept ;
    skos:inScheme sstim-v:EvidenceSynthesisTypeScheme ;
    skos:prefLabel "Narrative review"@en ;
    skos:notation "narrative-review" ;
    skos:definition "A review without a systematic search and selection protocol."@en .

sstim-v:synthesisSystematicReview a owl:NamedIndividual, sstim:EvidenceSynthesisType, skos:Concept ;
    skos:inScheme sstim-v:EvidenceSynthesisTypeScheme ;
    skos:prefLabel "Systematic review"@en ;
    skos:notation "systematic-review" ;
    skos:definition "A review with a documented systematic search, selection, and appraisal protocol. Matches the narrower meaning the legacy REVIEW tag claimed."@en .

sstim-v:synthesisMetaAnalysis a owl:NamedIndividual, sstim:EvidenceSynthesisType, skos:Concept ;
    skos:inScheme sstim-v:EvidenceSynthesisTypeScheme ;
    skos:prefLabel "Meta-analysis"@en ;
    skos:notation "meta-analysis" ;
    skos:definition "A quantitative synthesis of results across studies."@en .

sstim-v:synthesisLiteratureReview a owl:NamedIndividual, sstim:EvidenceSynthesisType, skos:Concept ;
    skos:inScheme sstim-v:EvidenceSynthesisTypeScheme ;
    skos:prefLabel "Literature review"@en ;
    skos:notation "literature-review" ;
    skos:definition "A survey of the literature without a documented systematic protocol or quantitative synthesis."@en .

sstim-v:synthesisTutorial a owl:NamedIndividual, sstim:EvidenceSynthesisType, skos:Concept ;
    skos:inScheme sstim-v:EvidenceSynthesisTypeScheme ;
    skos:prefLabel "Tutorial"@en ;
    skos:notation "tutorial" ;
    skos:definition "An instructional source synthesizing established methods and findings."@en .


sstim-v:EvidencePropositionFormScheme a skos:ConceptScheme ;
    skos:definition "Controlled logical forms of an assessment proposition; universal absence is named so validation can reject it (ADR 0027)."@en ;
    skos:prefLabel "SSTIM Evidence Proposition Form Vocabulary"@en ;
    skos:hasTopConcept sstim-v:formBoundedRelation, sstim-v:formBoundedNullResult,
                       sstim-v:formScopedSearchFinding, sstim-v:formUniversalAbsence .

sstim-v:formBoundedRelation a owl:NamedIndividual, sstim:EvidencePropositionForm, skos:Concept ;
    skos:inScheme sstim-v:EvidencePropositionFormScheme ;
    skos:prefLabel "Bounded relation"@en ;
    skos:notation "bounded-relation" ;
    skos:definition "The proposition asserts a relation, difference, or response within an explicit scope."@en .

sstim-v:formBoundedNullResult a owl:NamedIndividual, sstim:EvidencePropositionForm, skos:Concept ;
    skos:inScheme sstim-v:EvidencePropositionFormScheme ;
    skos:prefLabel "Bounded null result"@en ;
    skos:notation "bounded-null-result" ;
    skos:definition "The proposition asserts the absence of an effect within an explicit scope, backed by evidence that tested it."@en .

sstim-v:formScopedSearchFinding a owl:NamedIndividual, sstim:EvidencePropositionForm, skos:Concept ;
    skos:inScheme sstim-v:EvidencePropositionFormScheme ;
    skos:prefLabel "Scoped search finding"@en ;
    skos:notation "scoped-search-finding" ;
    skos:definition "The proposition states that no eligible evidence was found within a documented search scope as of a date. Requires an evidence search record basis."@en .

sstim-v:formUniversalAbsence a owl:NamedIndividual, sstim:EvidencePropositionForm, skos:Concept ;
    skos:inScheme sstim-v:EvidencePropositionFormScheme ;
    skos:prefLabel "Universal absence"@en ;
    skos:notation "universal-absence" ;
    skos:definition "The proposition asserts that no evidence or mechanism exists at all. Never conformant: a finite search cannot support it. Present in the vocabulary so validation can name and reject it."@en .


sstim-v:ScopeMarkerScheme a skos:ConceptScheme ;
    skos:definition "Controlled markers stating that a proposition scope axis is unknown, not reported, or not applicable (ADR 0027)."@en ;
    skos:prefLabel "SSTIM Scope Marker Vocabulary"@en ;
    skos:hasTopConcept sstim-v:scopeUnknown, sstim-v:scopeNotReported, sstim-v:scopeNotApplicable .

sstim-v:scopeUnknown a owl:NamedIndividual, sstim:ScopeMarker, skos:Concept ;
    skos:inScheme sstim-v:ScopeMarkerScheme ;
    skos:prefLabel "Unknown"@en ;
    skos:notation "scope-unknown" ;
    skos:definition "The value of this scope axis is unknown."@en .

sstim-v:scopeNotReported a owl:NamedIndividual, sstim:ScopeMarker, skos:Concept ;
    skos:inScheme sstim-v:ScopeMarkerScheme ;
    skos:prefLabel "Not reported"@en ;
    skos:notation "scope-not-reported" ;
    skos:definition "The sources did not report a value for this scope axis."@en .

sstim-v:scopeNotApplicable a owl:NamedIndividual, sstim:ScopeMarker, skos:Concept ;
    skos:inScheme sstim-v:ScopeMarkerScheme ;
    skos:prefLabel "Not applicable"@en ;
    skos:notation "scope-not-applicable" ;
    skos:definition "This scope axis does not apply to the proposition."@en .


sstim-v:ReviewerRelationshipScheme a skos:ConceptScheme ;
    skos:definition "Controlled relationships of a review agent to the assessed work (ADR 0027)."@en ;
    skos:prefLabel "SSTIM Reviewer Relationship Vocabulary"@en ;
    skos:hasTopConcept sstim-v:reviewerSelf, sstim-v:reviewerSameOrganization,
                       sstim-v:reviewerExternal, sstim-v:reviewerUnknownRelationship .

sstim-v:reviewerSelf a owl:NamedIndividual, sstim:ReviewerRelationship, skos:Concept ;
    skos:inScheme sstim-v:ReviewerRelationshipScheme ;
    skos:prefLabel "Self"@en ;
    skos:notation "self" ;
    skos:definition "The reviewer is the author of the assessed work."@en .

sstim-v:reviewerSameOrganization a owl:NamedIndividual, sstim:ReviewerRelationship, skos:Concept ;
    skos:inScheme sstim-v:ReviewerRelationshipScheme ;
    skos:prefLabel "Same organization"@en ;
    skos:notation "same-organization" ;
    skos:definition "The reviewer belongs to the same organization as the assessed work's authors."@en .

sstim-v:reviewerExternal a owl:NamedIndividual, sstim:ReviewerRelationship, skos:Concept ;
    skos:inScheme sstim-v:ReviewerRelationshipScheme ;
    skos:prefLabel "External"@en ;
    skos:notation "external" ;
    skos:definition "The reviewer is external to the authoring organization. Never implies independence by itself."@en .

sstim-v:reviewerUnknownRelationship a owl:NamedIndividual, sstim:ReviewerRelationship, skos:Concept ;
    skos:inScheme sstim-v:ReviewerRelationshipScheme ;
    skos:prefLabel "Unknown relationship"@en ;
    skos:notation "unknown-relationship" ;
    skos:definition "The reviewer's relationship to the assessed work is not established."@en .


sstim-v:IndependenceDeterminationScheme a skos:ConceptScheme ;
    skos:definition "Controlled policy-based reviewer-independence determinations (ADR 0027)."@en ;
    skos:prefLabel "SSTIM Independence Determination Vocabulary"@en ;
    skos:hasTopConcept sstim-v:independenceIndependent, sstim-v:independenceNotIndependent,
                       sstim-v:independenceUndetermined .

sstim-v:independenceIndependent a owl:NamedIndividual, sstim:IndependenceDetermination, skos:Concept ;
    skos:inScheme sstim-v:IndependenceDeterminationScheme ;
    skos:prefLabel "Independent"@en ;
    skos:notation "independent" ;
    skos:definition "Determined independent under a named policy, with recorded conflict disclosure."@en .

sstim-v:independenceNotIndependent a owl:NamedIndividual, sstim:IndependenceDetermination, skos:Concept ;
    skos:inScheme sstim-v:IndependenceDeterminationScheme ;
    skos:prefLabel "Not independent"@en ;
    skos:notation "not-independent" ;
    skos:definition "Determined not independent under a named policy, with recorded conflict disclosure."@en .

sstim-v:independenceUndetermined a owl:NamedIndividual, sstim:IndependenceDetermination, skos:Concept ;
    skos:inScheme sstim-v:IndependenceDeterminationScheme ;
    skos:prefLabel "Undetermined"@en ;
    skos:notation "undetermined" ;
    skos:definition "No independence determination has been made."@en .


sstim-v:ReviewDecisionScheme a skos:ConceptScheme ;
    skos:definition "Controlled outcomes of an evidence review decision (ADR 0027)."@en ;
    skos:prefLabel "SSTIM Review Decision Vocabulary"@en ;
    skos:hasTopConcept sstim-v:reviewConfirm, sstim-v:reviewRequestRevision, sstim-v:reviewReject .

sstim-v:reviewConfirm a owl:NamedIndividual, sstim:ReviewDecisionValue, skos:Concept ;
    skos:inScheme sstim-v:ReviewDecisionScheme ;
    skos:prefLabel "Confirm"@en ;
    skos:notation "confirm" ;
    skos:definition "The review confirms the assessment revision under the named rubric."@en .

sstim-v:reviewRequestRevision a owl:NamedIndividual, sstim:ReviewDecisionValue, skos:Concept ;
    skos:inScheme sstim-v:ReviewDecisionScheme ;
    skos:prefLabel "Request revision"@en ;
    skos:notation "request-revision" ;
    skos:definition "The review requests a new assessment revision."@en .

sstim-v:reviewReject a owl:NamedIndividual, sstim:ReviewDecisionValue, skos:Concept ;
    skos:inScheme sstim-v:ReviewDecisionScheme ;
    skos:prefLabel "Reject"@en ;
    skos:notation "reject" ;
    skos:definition "The review rejects the assessment revision under the named rubric."@en .


sstim-v:ConflictDisclosureScheme a skos:ConceptScheme ;
    skos:definition "Controlled conflict-of-interest disclosure records for reviews (ADR 0027)."@en ;
    skos:prefLabel "SSTIM Conflict Disclosure Vocabulary"@en ;
    skos:hasTopConcept sstim-v:noConflictDeclared .

sstim-v:noConflictDeclared a owl:NamedIndividual, sstim:ConflictDisclosure, skos:Concept ;
    skos:inScheme sstim-v:ConflictDisclosureScheme ;
    skos:prefLabel "No conflict declared"@en ;
    skos:notation "no-conflict-declared" ;
    skos:definition "The explicit declaration that the reviewer declared no conflict of interest. Case-specific disclosures are separate ConflictDisclosure records."@en .


# Materialized inverses for the Part 12 schemes (raw-RDF clients do not run inference).
sstim-v:applicabilityMixedModalities skos:topConceptOf sstim-v:ModalityApplicabilityScheme .
sstim-v:applicabilityUnknownModality skos:topConceptOf sstim-v:ModalityApplicabilityScheme .
sstim-v:applicabilityNotApplicable skos:topConceptOf sstim-v:ModalityApplicabilityScheme .
sstim-v:designRandomizedControlledTrial skos:topConceptOf sstim-v:StudyDesignScheme .
sstim-v:designControlledTrial skos:topConceptOf sstim-v:StudyDesignScheme .
sstim-v:designObservational skos:topConceptOf sstim-v:StudyDesignScheme .
sstim-v:designCaseReport skos:topConceptOf sstim-v:StudyDesignScheme .
sstim-v:designPreclinicalExperiment skos:topConceptOf sstim-v:StudyDesignScheme .
sstim-v:designMixedDesigns skos:topConceptOf sstim-v:StudyDesignScheme .
sstim-v:designUnknownDesign skos:topConceptOf sstim-v:StudyDesignScheme .
sstim-v:modelHuman skos:topConceptOf sstim-v:StudyModelScheme .
sstim-v:modelPreclinicalAnimal skos:topConceptOf sstim-v:StudyModelScheme .
sstim-v:modelInVitro skos:topConceptOf sstim-v:StudyModelScheme .
sstim-v:modelComputational skos:topConceptOf sstim-v:StudyModelScheme .
sstim-v:modelMixedModels skos:topConceptOf sstim-v:StudyModelScheme .
sstim-v:modelUnknownModel skos:topConceptOf sstim-v:StudyModelScheme .
sstim-v:synthesisPrimaryStudy skos:topConceptOf sstim-v:EvidenceSynthesisTypeScheme .
sstim-v:synthesisNarrativeReview skos:topConceptOf sstim-v:EvidenceSynthesisTypeScheme .
sstim-v:synthesisSystematicReview skos:topConceptOf sstim-v:EvidenceSynthesisTypeScheme .
sstim-v:synthesisMetaAnalysis skos:topConceptOf sstim-v:EvidenceSynthesisTypeScheme .
sstim-v:synthesisLiteratureReview skos:topConceptOf sstim-v:EvidenceSynthesisTypeScheme .
sstim-v:synthesisTutorial skos:topConceptOf sstim-v:EvidenceSynthesisTypeScheme .
sstim-v:formBoundedRelation skos:topConceptOf sstim-v:EvidencePropositionFormScheme .
sstim-v:formBoundedNullResult skos:topConceptOf sstim-v:EvidencePropositionFormScheme .
sstim-v:formScopedSearchFinding skos:topConceptOf sstim-v:EvidencePropositionFormScheme .
sstim-v:formUniversalAbsence skos:topConceptOf sstim-v:EvidencePropositionFormScheme .
sstim-v:scopeUnknown skos:topConceptOf sstim-v:ScopeMarkerScheme .
sstim-v:scopeNotReported skos:topConceptOf sstim-v:ScopeMarkerScheme .
sstim-v:scopeNotApplicable skos:topConceptOf sstim-v:ScopeMarkerScheme .
sstim-v:reviewerSelf skos:topConceptOf sstim-v:ReviewerRelationshipScheme .
sstim-v:reviewerSameOrganization skos:topConceptOf sstim-v:ReviewerRelationshipScheme .
sstim-v:reviewerExternal skos:topConceptOf sstim-v:ReviewerRelationshipScheme .
sstim-v:reviewerUnknownRelationship skos:topConceptOf sstim-v:ReviewerRelationshipScheme .
sstim-v:independenceIndependent skos:topConceptOf sstim-v:IndependenceDeterminationScheme .
sstim-v:independenceNotIndependent skos:topConceptOf sstim-v:IndependenceDeterminationScheme .
sstim-v:independenceUndetermined skos:topConceptOf sstim-v:IndependenceDeterminationScheme .
sstim-v:reviewConfirm skos:topConceptOf sstim-v:ReviewDecisionScheme .
sstim-v:reviewRequestRevision skos:topConceptOf sstim-v:ReviewDecisionScheme .
sstim-v:reviewReject skos:topConceptOf sstim-v:ReviewDecisionScheme .
sstim-v:noConflictDeclared skos:topConceptOf sstim-v:ConflictDisclosureScheme .


###########################################################################
# End of sstim-vocab.ttl
###########################################################################


###########################################################################
# Part 12 — Stimulation Facet Schemes (ADR 0034)
#
# Route, approach, target site, neural system, and neural phenomenon answer
# different questions and are therefore five schemes, not one "level" axis.
# "Transcranial", "implanted", "acoustic", "chemical", "oscillatory",
# "autonomic", and "cognitive" are not values on a common scale.
###########################################################################

sstim-v:NeuralAccessRouteScheme a skos:ConceptScheme ;
    skos:prefLabel "SSTIM Neural Access Route Vocabulary"@en ,
                   "Vocabolario delle Vie di Accesso Neurale SSTIM"@it ,
                   "Vocabulário de Vias de Acesso Neural SSTIM"@pt ,
                   "Vocabulario de Vías de Acceso Neural SSTIM"@es ;
    skos:definition "Causal-route categories for how a stimulation process is intended to engage a neural target. Contains routes only — not media, approaches, targets, or outcomes."@en ;
    skos:scopeNote "'Receptor' here means a canonical sensory receptor, never a molecular drug receptor. Mixed access is several values; an unresolved route is an epistemic status recorded elsewhere, not a pseudo-route."@en ;
    skos:hasTopConcept sstim-v:routeCanonicalSensoryTransductionAfferent,
        sstim-v:routeBypassesCanonicalSensoryTransduction .

sstim-v:routeCanonicalSensoryTransductionAfferent a owl:NamedIndividual, sstim:CanonicalSensoryTransductionAccessRoute, skos:Concept ;
    skos:inScheme sstim-v:NeuralAccessRouteScheme ;
    skos:topConceptOf sstim-v:NeuralAccessRouteScheme ;
    skos:prefLabel "canonical sensory transduction and afferent access"@en,
                   "accesso per trasduzione sensoriale canonica e via afferente"@it,
                   "acesso por transdução sensorial canónica e via aferente"@pt,
                   "acceso por transducción sensorial canónica y vía aferente"@es ;
    skos:notation "route-canonical-sensory-transduction-afferent" ;
    skos:definition "Engagement of a neural target through canonical sensory receptor transduction and afferent processing."@en ;
    skos:scopeNote "Within the neuromodulation population this is not a redundant value: it is the fact that distinguishes the sensory-route overlap from approaches that bypass canonical sensory transduction. Conscious perception is not required."@en .

sstim-v:routeBypassesCanonicalSensoryTransduction a owl:NamedIndividual, sstim:SensoryTransductionBypassingAccessRoute, skos:Concept ;
    skos:inScheme sstim-v:NeuralAccessRouteScheme ;
    skos:topConceptOf sstim-v:NeuralAccessRouteScheme ;
    skos:narrower sstim-v:routePhysicalNeuralInteraction, sstim-v:routeBiochemicalPharmacologicalNeuralInteraction, sstim-v:routeIndirectNonSensoryPhysiologicalMediation ;
    skos:prefLabel "bypasses canonical sensory transduction"@en,
                   "elude la trasduzione sensoriale canonica"@it,
                   "contorna a transdução sensorial canónica"@pt,
                   "elude la transducción sensorial canónica"@es ;
    skos:notation "route-bypasses-canonical-sensory-transduction" ;
    skos:definition "Engagement of a neural target without canonical sensory receptor transduction."@en ;
    skos:scopeNote "Asserting this route positively identifies such a route; it does not prove the technique is non-sensory, because a hybrid may also declare an intended sensory route."@en .

sstim-v:routePhysicalNeuralInteraction a owl:NamedIndividual, sstim:SensoryTransductionBypassingAccessRoute, skos:Concept ;
    skos:inScheme sstim-v:NeuralAccessRouteScheme ;
    skos:broader sstim-v:routeBypassesCanonicalSensoryTransduction ;
    skos:prefLabel "physical neural interaction"@en,
                   "interazione neurale fisica"@it,
                   "interação neural física"@pt,
                   "interacción neural física"@es ;
    skos:notation "route-physical-neural-interaction" ;
    skos:definition "Direct physical interaction with neural tissue by an applied electric current or field, magnetic field, acoustic energy, or comparable physical means."@en ;
    skos:scopeNote "Both an intended cortical tACS interaction and a competing peripheral-nerve explanation use this broad route; they are separated by the intended target site versus the evaluated outcome target site, not by inventing two routes."@en .

sstim-v:routeBiochemicalPharmacologicalNeuralInteraction a owl:NamedIndividual, sstim:SensoryTransductionBypassingAccessRoute, skos:Concept ;
    skos:inScheme sstim-v:NeuralAccessRouteScheme ;
    skos:broader sstim-v:routeBypassesCanonicalSensoryTransduction ;
    skos:prefLabel "biochemical or pharmacological neural interaction"@en,
                   "interazione neurale biochimica o farmacologica"@it,
                   "interação neural bioquímica ou farmacológica"@pt,
                   "interacción neural bioquímica o farmacológica"@es ;
    skos:notation "route-biochemical-pharmacological-neural-interaction" ;
    skos:definition "Engagement of a neural target by a chemical or pharmacological agent acting on neural tissue."@en .

sstim-v:routeIndirectNonSensoryPhysiologicalMediation a owl:NamedIndividual, sstim:SensoryTransductionBypassingAccessRoute, skos:Concept ;
    skos:inScheme sstim-v:NeuralAccessRouteScheme ;
    skos:broader sstim-v:routeBypassesCanonicalSensoryTransduction ;
    skos:prefLabel "indirect non-sensory physiological mediation"@en,
                   "mediazione fisiologica indiretta non sensoriale"@it,
                   "mediação fisiológica indireta não sensorial"@pt,
                   "mediación fisiológica indirecta no sensorial"@es ;
    skos:notation "route-indirect-non-sensory-physiological-mediation" ;
    skos:definition "Engagement of a neural target through an intermediate physiological process that is not canonical sensory transduction, such as a vascular, endocrine, or muscular pathway."@en .

sstim-v:StimulationDeliveryApproachScheme a skos:ConceptScheme ;
    skos:prefLabel "SSTIM Stimulation Delivery Approach Vocabulary"@en ,
                   "Vocabolario degli Approcci di Somministrazione della Stimolazione SSTIM"@it ,
                   "Vocabulário de Abordagens de Administração da Estimulação SSTIM"@pt ,
                   "Vocabulario de Enfoques de Administración de la Estimulación SSTIM"@es ;
    skos:definition "Coarse, non-exclusive operational tags summarizing administration, invasiveness, and interface placement for cross-technique navigation."@en ;
    skos:scopeNote "Deliberately non-exclusive and deliberately coarse: a method may be external, transcutaneous, and transcranial at once. Detailed device, body placement, administration, and dose remain in the exposure profile, and no approach tag is inferred from another facet."@en ;
    skos:hasTopConcept sstim-v:approachExternal, sstim-v:approachEnvironmentalReceptorFacing, sstim-v:approachTranscutaneous, sstim-v:approachTranscranial, sstim-v:approachPercutaneous, sstim-v:approachImplanted, sstim-v:approachIntracranial, sstim-v:approachEpidural, sstim-v:approachTargetedLocalInfusion, sstim-v:approachIntrathecal, sstim-v:approachSystemic .

sstim-v:approachExternal a owl:NamedIndividual, sstim:StimulationDeliveryApproach, skos:Concept ;
    skos:inScheme sstim-v:StimulationDeliveryApproachScheme ;
    skos:topConceptOf sstim-v:StimulationDeliveryApproachScheme ;
    skos:prefLabel "external"@en,
                   "esterno"@it,
                   "externo"@pt,
                   "externo"@es ;
    skos:notation "approach-external" ;
    skos:definition "Applied from outside the body without breaching the skin."@en .

sstim-v:approachEnvironmentalReceptorFacing a owl:NamedIndividual, sstim:StimulationDeliveryApproach, skos:Concept ;
    skos:inScheme sstim-v:StimulationDeliveryApproachScheme ;
    skos:topConceptOf sstim-v:StimulationDeliveryApproachScheme ;
    skos:prefLabel "environmental / receptor-facing"@en,
                   "ambientale / rivolto ai recettori"@it,
                   "ambiental / voltado para recetores"@pt,
                   "ambiental / orientado a receptores"@es ;
    skos:notation "approach-environmental-receptor-facing" ;
    skos:definition "Presented in the surrounding environment toward sensory receptors, without a body-mounted interface."@en .

sstim-v:approachTranscutaneous a owl:NamedIndividual, sstim:StimulationDeliveryApproach, skos:Concept ;
    skos:inScheme sstim-v:StimulationDeliveryApproachScheme ;
    skos:topConceptOf sstim-v:StimulationDeliveryApproachScheme ;
    skos:prefLabel "transcutaneous"@en,
                   "transcutaneo"@it,
                   "transcutâneo"@pt,
                   "transcutáneo"@es ;
    skos:notation "approach-transcutaneous" ;
    skos:definition "Delivered across intact skin."@en .

sstim-v:approachTranscranial a owl:NamedIndividual, sstim:StimulationDeliveryApproach, skos:Concept ;
    skos:inScheme sstim-v:StimulationDeliveryApproachScheme ;
    skos:topConceptOf sstim-v:StimulationDeliveryApproachScheme ;
    skos:prefLabel "transcranial"@en,
                   "transcranico"@it,
                   "transcraniano"@pt,
                   "transcraneal"@es ;
    skos:notation "approach-transcranial" ;
    skos:definition "Delivered across the skull toward an intracranial target."@en .

sstim-v:approachPercutaneous a owl:NamedIndividual, sstim:StimulationDeliveryApproach, skos:Concept ;
    skos:inScheme sstim-v:StimulationDeliveryApproachScheme ;
    skos:topConceptOf sstim-v:StimulationDeliveryApproachScheme ;
    skos:prefLabel "percutaneous"@en,
                   "percutaneo"@it,
                   "percutâneo"@pt,
                   "percutáneo"@es ;
    skos:notation "approach-percutaneous" ;
    skos:definition "Delivered through a needle or comparable skin puncture without a permanent implant."@en .

sstim-v:approachImplanted a owl:NamedIndividual, sstim:StimulationDeliveryApproach, skos:Concept ;
    skos:inScheme sstim-v:StimulationDeliveryApproachScheme ;
    skos:topConceptOf sstim-v:StimulationDeliveryApproachScheme ;
    skos:prefLabel "implanted"@en,
                   "impiantato"@it,
                   "implantado"@pt,
                   "implantado"@es ;
    skos:notation "approach-implanted" ;
    skos:definition "Delivered by a surgically placed device remaining in the body."@en .

sstim-v:approachIntracranial a owl:NamedIndividual, sstim:StimulationDeliveryApproach, skos:Concept ;
    skos:inScheme sstim-v:StimulationDeliveryApproachScheme ;
    skos:topConceptOf sstim-v:StimulationDeliveryApproachScheme ;
    skos:prefLabel "intracranial"@en,
                   "intracranico"@it,
                   "intracraniano"@pt,
                   "intracraneal"@es ;
    skos:notation "approach-intracranial" ;
    skos:definition "Delivered from within the cranial cavity."@en .

sstim-v:approachEpidural a owl:NamedIndividual, sstim:StimulationDeliveryApproach, skos:Concept ;
    skos:inScheme sstim-v:StimulationDeliveryApproachScheme ;
    skos:topConceptOf sstim-v:StimulationDeliveryApproachScheme ;
    skos:prefLabel "epidural"@en,
                   "epidurale"@it,
                   "epidural"@pt,
                   "epidural"@es ;
    skos:notation "approach-epidural" ;
    skos:definition "Delivered into the epidural space."@en .

sstim-v:approachTargetedLocalInfusion a owl:NamedIndividual, sstim:StimulationDeliveryApproach, skos:Concept ;
    skos:inScheme sstim-v:StimulationDeliveryApproachScheme ;
    skos:topConceptOf sstim-v:StimulationDeliveryApproachScheme ;
    skos:prefLabel "targeted local infusion"@en,
                   "infusione locale mirata"@it,
                   "infusão local dirigida"@pt,
                   "infusión local dirigida"@es ;
    skos:notation "approach-targeted-local-infusion" ;
    skos:definition "An agent infused at or near an identified target rather than distributed systemically."@en .

sstim-v:approachIntrathecal a owl:NamedIndividual, sstim:StimulationDeliveryApproach, skos:Concept ;
    skos:inScheme sstim-v:StimulationDeliveryApproachScheme ;
    skos:topConceptOf sstim-v:StimulationDeliveryApproachScheme ;
    skos:prefLabel "intrathecal"@en,
                   "intratecale"@it,
                   "intratecal"@pt,
                   "intratecal"@es ;
    skos:notation "approach-intrathecal" ;
    skos:definition "Delivered into the intrathecal space."@en .

sstim-v:approachSystemic a owl:NamedIndividual, sstim:StimulationDeliveryApproach, skos:Concept ;
    skos:inScheme sstim-v:StimulationDeliveryApproachScheme ;
    skos:topConceptOf sstim-v:StimulationDeliveryApproachScheme ;
    skos:prefLabel "systemic"@en,
                   "sistemico"@it,
                   "sistémico"@pt,
                   "sistémico"@es ;
    skos:notation "approach-systemic" ;
    skos:definition "Distributed through the body as a whole rather than applied at an identified site."@en .

# Invasiveness rollup (ADR 0035, from the 2026-07-22 Theo Marins interview, who
# noted that neuromodulation divides first into invasive and non-invasive
# techniques). Expressed as SKOS collections that GROUP the delivery-approach
# values, not as a new primitive axis or a subsumption layer: ADR 0034
# deliberately kept delivery approach coarse and non-exclusive, and invasive vs.
# non-invasive is a rollup of it, not an independent facet. Collections leave the
# scheme's top-concept structure untouched and add no OWL entailment. Systemic
# distribution is deliberately in none of them: it is a route of distribution,
# orthogonal to depth of tissue penetration.
sstim-v:NonInvasiveApproachCollection a skos:Collection ;
    rdfs:label "Non-invasive delivery approaches"@en ;
    skos:definition "The rollup of delivery approaches that do not breach the skin or body: external, environmental / receptor-facing, transcutaneous, and transcranial."@en ;
    rdfs:seeAlso <https://github.com/laBioSynCare/laBioSynCare.github.io/blob/main/docs/decisions/0035-participant-engagement-mode-and-endogenous-self-regulation.md> ;
    skos:member sstim-v:approachExternal, sstim-v:approachEnvironmentalReceptorFacing,
        sstim-v:approachTranscutaneous, sstim-v:approachTranscranial .

sstim-v:MinimallyInvasiveApproachCollection a skos:Collection ;
    rdfs:label "Minimally-invasive delivery approaches"@en ;
    skos:definition "The rollup of delivery approaches that cross the skin by needle puncture without leaving a permanent implant: percutaneous."@en ;
    rdfs:seeAlso <https://github.com/laBioSynCare/laBioSynCare.github.io/blob/main/docs/decisions/0035-participant-engagement-mode-and-endogenous-self-regulation.md> ;
    skos:member sstim-v:approachPercutaneous .

sstim-v:InvasiveApproachCollection a skos:Collection ;
    rdfs:label "Invasive delivery approaches"@en ;
    skos:definition "The rollup of delivery approaches that place a device or agent inside the body: implanted, intracranial, epidural, targeted local infusion, and intrathecal."@en ;
    rdfs:seeAlso <https://github.com/laBioSynCare/laBioSynCare.github.io/blob/main/docs/decisions/0035-participant-engagement-mode-and-endogenous-self-regulation.md> ;
    skos:member sstim-v:approachImplanted, sstim-v:approachIntracranial, sstim-v:approachEpidural,
        sstim-v:approachTargetedLocalInfusion, sstim-v:approachIntrathecal .

sstim-v:NeuralTargetSiteScheme a skos:ConceptScheme ;
    skos:prefLabel "SSTIM Neural Target Site Vocabulary"@en ,
                   "Vocabolario dei Siti Bersaglio Neurali SSTIM"@it ,
                   "Vocabulário de Locais-Alvo Neurais SSTIM"@pt ,
                   "Vocabulario de Sitios Diana Neurales SSTIM"@es ;
    skos:definition "Controlled information categories for broad anatomical targets of stimulation. These classify a target; they are not the anatomical entities themselves."@en ;
    skos:scopeNote "A category may have more than one broader concept; no forced single-parent tree is required. External anatomy alignment is a separate, evidence-checked pass."@en ;
    skos:hasTopConcept sstim-v:targetCentralNervousSystem,
        sstim-v:targetPeripheralNervousSystem, sstim-v:targetCranialNerve .

sstim-v:targetCentralNervousSystem a owl:NamedIndividual, sstim:NeuralTargetSite, skos:Concept ;
    skos:inScheme sstim-v:NeuralTargetSiteScheme ;
    skos:topConceptOf sstim-v:NeuralTargetSiteScheme ;
    skos:narrower sstim-v:targetBrain, sstim-v:targetSpinalCord ;
    skos:prefLabel "central nervous system"@en,
                   "sistema nervoso centrale"@it,
                   "sistema nervoso central"@pt,
                   "sistema nervioso central"@es ;
    skos:notation "target-central-nervous-system" ;
    skos:definition "The brain and spinal cord as a broad stimulation target."@en .

sstim-v:targetBrain a owl:NamedIndividual, sstim:NeuralTargetSite, skos:Concept ;
    skos:inScheme sstim-v:NeuralTargetSiteScheme ;
    skos:broader sstim-v:targetCentralNervousSystem ;
    skos:narrower sstim-v:targetCortex, sstim-v:targetDeepBrainStructure ;
    skos:prefLabel "brain"@en,
                   "encefalo"@it,
                   "encéfalo"@pt,
                   "encéfalo"@es ;
    skos:notation "target-brain" ;
    skos:definition "The brain as a broad stimulation target."@en .

sstim-v:targetCortex a owl:NamedIndividual, sstim:NeuralTargetSite, skos:Concept ;
    skos:inScheme sstim-v:NeuralTargetSiteScheme ;
    skos:broader sstim-v:targetBrain ;
    skos:prefLabel "cortex"@en,
                   "corteccia"@it,
                   "córtex"@pt,
                   "corteza"@es ;
    skos:notation "target-cortex" ;
    skos:definition "Cortical tissue as a stimulation target."@en .

sstim-v:targetDeepBrainStructure a owl:NamedIndividual, sstim:NeuralTargetSite, skos:Concept ;
    skos:inScheme sstim-v:NeuralTargetSiteScheme ;
    skos:broader sstim-v:targetBrain ;
    skos:prefLabel "deep brain structure"@en,
                   "struttura cerebrale profonda"@it,
                   "estrutura cerebral profunda"@pt,
                   "estructura cerebral profunda"@es ;
    skos:notation "target-deep-brain-structure" ;
    skos:definition "A subcortical or deep brain structure as a stimulation target."@en .

sstim-v:targetSpinalCord a owl:NamedIndividual, sstim:NeuralTargetSite, skos:Concept ;
    skos:inScheme sstim-v:NeuralTargetSiteScheme ;
    skos:broader sstim-v:targetCentralNervousSystem ;
    skos:prefLabel "spinal cord"@en,
                   "midollo spinale"@it,
                   "medula espinal"@pt,
                   "médula espinal"@es ;
    skos:notation "target-spinal-cord" ;
    skos:definition "The spinal cord as a stimulation target."@en .

sstim-v:targetPeripheralNervousSystem a owl:NamedIndividual, sstim:NeuralTargetSite, skos:Concept ;
    skos:inScheme sstim-v:NeuralTargetSiteScheme ;
    skos:topConceptOf sstim-v:NeuralTargetSiteScheme ;
    skos:narrower sstim-v:targetPeripheralNerve ;
    skos:prefLabel "peripheral nervous system"@en,
                   "sistema nervoso periferico"@it,
                   "sistema nervoso periférico"@pt,
                   "sistema nervioso periférico"@es ;
    skos:notation "target-peripheral-nervous-system" ;
    skos:definition "Neural tissue outside the brain and spinal cord as a broad stimulation target."@en .

sstim-v:targetPeripheralNerve a owl:NamedIndividual, sstim:NeuralTargetSite, skos:Concept ;
    skos:inScheme sstim-v:NeuralTargetSiteScheme ;
    skos:broader sstim-v:targetPeripheralNervousSystem ;
    skos:prefLabel "peripheral nerve"@en,
                   "nervo periferico"@it,
                   "nervo periférico"@pt,
                   "nervio periférico"@es ;
    skos:notation "target-peripheral-nerve" ;
    skos:definition "A peripheral nerve as a stimulation target."@en .

sstim-v:targetCranialNerve a owl:NamedIndividual, sstim:NeuralTargetSite, skos:Concept ;
    skos:inScheme sstim-v:NeuralTargetSiteScheme ;
    skos:topConceptOf sstim-v:NeuralTargetSiteScheme ;
    skos:prefLabel "cranial nerve"@en,
                   "nervo cranico"@it,
                   "nervo craniano"@pt,
                   "nervio craneal"@es ;
    skos:notation "target-cranial-nerve" ;
    skos:definition "A cranial nerve as a stimulation target."@en ;
    skos:scopeNote "Kept as a separate seed category rather than a blanket child of the peripheral nervous system, because cranial-nerve anatomy is not uniformly peripheral."@en .

sstim-v:NeuralSystemScheme a skos:ConceptScheme ;
    skos:prefLabel "SSTIM Neural System Vocabulary"@en ,
                   "Vocabolario dei Sistemi Neurali SSTIM"@it ,
                   "Vocabulário de Sistemas Neurais SSTIM"@pt ,
                   "Vocabulario de Sistemas Neurales SSTIM"@es ;
    skos:definition "Distributed organizational neural systems used as a target axis, aligned to but not identified with the sensory modality vocabulary."@en ;
    skos:scopeNote "This is the axis for neuromodulation OF a sensory system. It says nothing about the entry route: a cochlear or retinal neural interface targets a sensory system without using the canonical receptor route."@en ;
    skos:hasTopConcept sstim-v:systemSensory, sstim-v:systemMotor, sstim-v:systemAutonomic .

sstim-v:systemSensory a owl:NamedIndividual, sstim:NeuralSystem, skos:Concept ;
    skos:inScheme sstim-v:NeuralSystemScheme ;
    skos:topConceptOf sstim-v:NeuralSystemScheme ;
    skos:narrower sstim-v:systemAuditory, sstim-v:systemVisual, sstim-v:systemSomatosensory, sstim-v:systemOlfactory, sstim-v:systemGustatory, sstim-v:systemVestibular, sstim-v:systemProprioceptive, sstim-v:systemInteroceptive ;
    skos:prefLabel "sensory system"@en,
                   "sistema sensoriale"@it,
                   "sistema sensorial"@pt,
                   "sistema sensorial"@es ;
    skos:notation "system-sensory" ;
    skos:definition "The sensory nervous system as a distributed target."@en .

sstim-v:systemMotor a owl:NamedIndividual, sstim:NeuralSystem, skos:Concept ;
    skos:inScheme sstim-v:NeuralSystemScheme ;
    skos:topConceptOf sstim-v:NeuralSystemScheme ;
    skos:prefLabel "motor system"@en,
                   "sistema motorio"@it,
                   "sistema motor"@pt,
                   "sistema motor"@es ;
    skos:notation "system-motor" ;
    skos:definition "The motor nervous system as a distributed target."@en .

sstim-v:systemAutonomic a owl:NamedIndividual, sstim:NeuralSystem, skos:Concept ;
    skos:inScheme sstim-v:NeuralSystemScheme ;
    skos:topConceptOf sstim-v:NeuralSystemScheme ;
    skos:prefLabel "autonomic system"@en,
                   "sistema autonomo"@it,
                   "sistema autónomo"@pt,
                   "sistema autónomo"@es ;
    skos:notation "system-autonomic" ;
    skos:definition "The autonomic nervous system as a distributed target."@en .

sstim-v:systemAuditory a owl:NamedIndividual, sstim:NeuralSystem, skos:Concept ;
    skos:inScheme sstim-v:NeuralSystemScheme ;
    skos:broader sstim-v:systemSensory ;
    skos:prefLabel "auditory system"@en,
                   "sistema uditivo"@it,
                   "sistema auditivo"@pt,
                   "sistema auditivo"@es ;
    skos:notation "system-auditory" ;
    skos:definition "The auditory neural system as a distributed target."@en .

sstim-v:systemVisual a owl:NamedIndividual, sstim:NeuralSystem, skos:Concept ;
    skos:inScheme sstim-v:NeuralSystemScheme ;
    skos:broader sstim-v:systemSensory ;
    skos:prefLabel "visual system"@en,
                   "sistema visivo"@it,
                   "sistema visual"@pt,
                   "sistema visual"@es ;
    skos:notation "system-visual" ;
    skos:definition "The visual neural system as a distributed target."@en .

sstim-v:systemSomatosensory a owl:NamedIndividual, sstim:NeuralSystem, skos:Concept ;
    skos:inScheme sstim-v:NeuralSystemScheme ;
    skos:broader sstim-v:systemSensory ;
    skos:prefLabel "somatosensory system"@en,
                   "sistema somatosensoriale"@it,
                   "sistema somatossensorial"@pt,
                   "sistema somatosensorial"@es ;
    skos:notation "system-somatosensory" ;
    skos:definition "The somatosensory neural system as a distributed target."@en .

sstim-v:systemOlfactory a owl:NamedIndividual, sstim:NeuralSystem, skos:Concept ;
    skos:inScheme sstim-v:NeuralSystemScheme ;
    skos:broader sstim-v:systemSensory ;
    skos:prefLabel "olfactory system"@en,
                   "sistema olfattivo"@it,
                   "sistema olfativo"@pt,
                   "sistema olfativo"@es ;
    skos:notation "system-olfactory" ;
    skos:definition "The olfactory neural system as a distributed target."@en .

sstim-v:systemGustatory a owl:NamedIndividual, sstim:NeuralSystem, skos:Concept ;
    skos:inScheme sstim-v:NeuralSystemScheme ;
    skos:broader sstim-v:systemSensory ;
    skos:prefLabel "gustatory system"@en,
                   "sistema gustativo"@it,
                   "sistema gustativo"@pt,
                   "sistema gustativo"@es ;
    skos:notation "system-gustatory" ;
    skos:definition "The gustatory neural system as a distributed target."@en .

sstim-v:systemVestibular a owl:NamedIndividual, sstim:NeuralSystem, skos:Concept ;
    skos:inScheme sstim-v:NeuralSystemScheme ;
    skos:broader sstim-v:systemSensory ;
    skos:prefLabel "vestibular system"@en,
                   "sistema vestibolare"@it,
                   "sistema vestibular"@pt,
                   "sistema vestibular"@es ;
    skos:notation "system-vestibular" ;
    skos:definition "The vestibular neural system as a distributed target."@en .

sstim-v:systemProprioceptive a owl:NamedIndividual, sstim:NeuralSystem, skos:Concept ;
    skos:inScheme sstim-v:NeuralSystemScheme ;
    skos:broader sstim-v:systemSensory ;
    skos:prefLabel "proprioceptive system"@en,
                   "sistema propriocettivo"@it,
                   "sistema propriocetivo"@pt,
                   "sistema propioceptivo"@es ;
    skos:notation "system-proprioceptive" ;
    skos:definition "The proprioceptive neural system as a distributed target."@en .

sstim-v:systemInteroceptive a owl:NamedIndividual, sstim:NeuralSystem, skos:Concept ;
    skos:inScheme sstim-v:NeuralSystemScheme ;
    skos:broader sstim-v:systemSensory ;
    skos:prefLabel "interoceptive system"@en,
                   "sistema interocettivo"@it,
                   "sistema interocetivo"@pt,
                   "sistema interoceptivo"@es ;
    skos:notation "system-interoceptive" ;
    skos:definition "The interoceptive neural system as a distributed target."@en .

sstim-v:NeuralPhenomenonScheme a skos:ConceptScheme ;
    skos:prefLabel "SSTIM Neural Phenomenon Vocabulary"@en ,
                   "Vocabolario dei Fenomeni Neurali SSTIM"@it ,
                   "Vocabulário de Fenómenos Neurais SSTIM"@pt ,
                   "Vocabulario de Fenómenos Neurales SSTIM"@es ;
    skos:definition "Coherent functional neural phenomena, reused across the proposed-mechanism, intended-target, and observed-outcome roles by three separate properties."@en ;
    skos:scopeNote "This scheme replaces any single target-level axis. A route, a dynamic, a system, and an outcome domain are not values on one scale, and an autonomic outcome can also be neural. Perceptual, cognitive, motor, physiological, and behavioural outcome domains are modelled separately and non-exclusively; a controlled vocabulary must not force false partitions to simplify a query."@en ;
    skos:hasTopConcept sstim-v:phenomenonExcitabilityOrFiring, sstim-v:phenomenonOscillatoryDynamics, sstim-v:phenomenonTemporalCoordination, sstim-v:phenomenonSynapticTransmission, sstim-v:phenomenonNeurochemicalSignaling, sstim-v:phenomenonConnectivityOrPlasticity, sstim-v:phenomenonAutonomicNeuralRegulation, sstim-v:phenomenonEvokedResponse, sstim-v:phenomenonReflexResponse .

sstim-v:phenomenonExcitabilityOrFiring a owl:NamedIndividual, sstim:NeuralPhenomenon, skos:Concept ;
    skos:inScheme sstim-v:NeuralPhenomenonScheme ;
    skos:topConceptOf sstim-v:NeuralPhenomenonScheme ;
    skos:prefLabel "excitability or firing"@en,
                   "eccitabilità o scarica"@it,
                   "excitabilidade ou disparo"@pt,
                   "excitabilidad o descarga"@es ;
    skos:notation "phenomenon-excitability-or-firing" ;
    skos:definition "Change in neuronal excitability or firing."@en .

sstim-v:phenomenonOscillatoryDynamics a owl:NamedIndividual, sstim:NeuralPhenomenon, skos:Concept ;
    skos:inScheme sstim-v:NeuralPhenomenonScheme ;
    skos:topConceptOf sstim-v:NeuralPhenomenonScheme ;
    skos:prefLabel "oscillatory dynamics"@en,
                   "dinamiche oscillatorie"@it,
                   "dinâmicas oscilatórias"@pt,
                   "dinámicas oscilatorias"@es ;
    skos:notation "phenomenon-oscillatory-dynamics" ;
    skos:definition "Change in the amplitude, frequency, or phase of neural oscillations."@en .

sstim-v:phenomenonTemporalCoordination a owl:NamedIndividual, sstim:NeuralPhenomenon, skos:Concept ;
    skos:inScheme sstim-v:NeuralPhenomenonScheme ;
    skos:topConceptOf sstim-v:NeuralPhenomenonScheme ;
    skos:prefLabel "temporal coordination"@en,
                   "coordinazione temporale"@it,
                   "coordenação temporal"@pt,
                   "coordinación temporal"@es ;
    skos:notation "phenomenon-temporal-coordination" ;
    skos:definition "Change in the temporal alignment or coordination of neural activity."@en .

sstim-v:phenomenonSynapticTransmission a owl:NamedIndividual, sstim:NeuralPhenomenon, skos:Concept ;
    skos:inScheme sstim-v:NeuralPhenomenonScheme ;
    skos:topConceptOf sstim-v:NeuralPhenomenonScheme ;
    skos:prefLabel "synaptic transmission"@en,
                   "trasmissione sinaptica"@it,
                   "transmissão sináptica"@pt,
                   "transmisión sináptica"@es ;
    skos:notation "phenomenon-synaptic-transmission" ;
    skos:definition "Change in synaptic transmission."@en .

sstim-v:phenomenonNeurochemicalSignaling a owl:NamedIndividual, sstim:NeuralPhenomenon, skos:Concept ;
    skos:inScheme sstim-v:NeuralPhenomenonScheme ;
    skos:topConceptOf sstim-v:NeuralPhenomenonScheme ;
    skos:prefLabel "neurochemical signaling"@en,
                   "segnalazione neurochimica"@it,
                   "sinalização neuroquímica"@pt,
                   "señalización neuroquímica"@es ;
    skos:notation "phenomenon-neurochemical-signaling" ;
    skos:definition "Change in neurochemical or neurotransmitter signaling."@en .

sstim-v:phenomenonConnectivityOrPlasticity a owl:NamedIndividual, sstim:NeuralPhenomenon, skos:Concept ;
    skos:inScheme sstim-v:NeuralPhenomenonScheme ;
    skos:topConceptOf sstim-v:NeuralPhenomenonScheme ;
    skos:prefLabel "connectivity or plasticity"@en,
                   "connettività o plasticità"@it,
                   "conetividade ou plasticidade"@pt,
                   "conectividad o plasticidad"@es ;
    skos:notation "phenomenon-connectivity-or-plasticity" ;
    skos:definition "Change in functional connectivity or in plasticity."@en .

sstim-v:phenomenonAutonomicNeuralRegulation a owl:NamedIndividual, sstim:NeuralPhenomenon, skos:Concept ;
    skos:inScheme sstim-v:NeuralPhenomenonScheme ;
    skos:topConceptOf sstim-v:NeuralPhenomenonScheme ;
    skos:prefLabel "autonomic neural regulation"@en,
                   "regolazione neurale autonoma"@it,
                   "regulação neural autónoma"@pt,
                   "regulación neural autónoma"@es ;
    skos:notation "phenomenon-autonomic-neural-regulation" ;
    skos:definition "Change in autonomic neural regulation."@en .

sstim-v:temporalContinuousTonic a owl:NamedIndividual, sstim:StimulusTemporalStructure, skos:Concept ;
    skos:inScheme sstim-v:StimulusTemporalStructureScheme ;
    skos:topConceptOf sstim-v:StimulusTemporalStructureScheme ;
    skos:prefLabel "Continuous / Tonic"@en, "Continuo/Tonico"@it, "Contínuo/Tónico"@pt, "Continuo/Tónico"@es ;
    skos:notation "temporal-continuous-tonic" ;
    skos:definition "Applied continuously at a sustained level rather than as discrete events, such as a constant direct current."@en .

sstim-v:temporalSingleEvent a owl:NamedIndividual, sstim:StimulusTemporalStructure, skos:Concept ;
    skos:inScheme sstim-v:StimulusTemporalStructureScheme ;
    skos:topConceptOf sstim-v:StimulusTemporalStructureScheme ;
    skos:prefLabel "Single Event"@en, "Evento Singolo"@it, "Evento Único"@pt, "Evento Único"@es ;
    skos:notation "temporal-single-event" ;
    skos:definition "A single discrete application, such as one pulse."@en .

sstim-v:temporalPulseTrainOrBurst a owl:NamedIndividual, sstim:StimulusTemporalStructure, skos:Concept ;
    skos:inScheme sstim-v:StimulusTemporalStructureScheme ;
    skos:topConceptOf sstim-v:StimulusTemporalStructureScheme ;
    skos:prefLabel "Pulse Train / Burst"@en, "Treno di Impulsi/Raffica"@it, "Trem de Impulsos/Rajada"@pt, "Tren de Pulsos/Ráfaga"@es ;
    skos:notation "temporal-pulse-train-or-burst" ;
    skos:definition "Discrete pulses delivered in trains or bursts."@en ;
    skos:scopeNote "Combinable with a carrier periodicity value: a pulse train may itself be periodic or irregular."@en .

sstim-v:temporalIntermittentScheduled a owl:NamedIndividual, sstim:StimulusTemporalStructure, skos:Concept ;
    skos:inScheme sstim-v:StimulusTemporalStructureScheme ;
    skos:topConceptOf sstim-v:StimulusTemporalStructureScheme ;
    skos:prefLabel "Intermittent / Scheduled"@en, "Intermittente/Programmato"@it, "Intermitente/Programado"@pt, "Intermitente/Programado"@es ;
    skos:notation "temporal-intermittent-scheduled" ;
    skos:definition "Applied in separated episodes on a schedule rather than continuously."@en .

sstim-v:temporalBolus a owl:NamedIndividual, sstim:StimulusTemporalStructure, skos:Concept ;
    skos:inScheme sstim-v:StimulusTemporalStructureScheme ;
    skos:topConceptOf sstim-v:StimulusTemporalStructureScheme ;
    skos:prefLabel "Bolus"@en, "Bolo"@it, "Bólus"@pt, "Bolo"@es ;
    skos:notation "temporal-bolus" ;
    skos:definition "An agent administered as a single discrete dose."@en .

sstim-v:temporalContinuousInfusion a owl:NamedIndividual, sstim:StimulusTemporalStructure, skos:Concept ;
    skos:inScheme sstim-v:StimulusTemporalStructureScheme ;
    skos:topConceptOf sstim-v:StimulusTemporalStructureScheme ;
    skos:prefLabel "Continuous Infusion"@en, "Infusione Continua"@it, "Infusão Contínua"@pt, "Infusión Continua"@es ;
    skos:notation "temporal-continuous-infusion" ;
    skos:definition "An agent administered continuously over time."@en .

sstim-v:phenomenonEvokedResponse a owl:NamedIndividual, sstim:NeuralPhenomenon, skos:Concept ;
    skos:inScheme sstim-v:NeuralPhenomenonScheme ;
    skos:topConceptOf sstim-v:NeuralPhenomenonScheme ;
    skos:narrower sstim-v:phenomenonFrequencyFollowingResponse, sstim-v:phenomenonAuditorySteadyStateResponse, sstim-v:phenomenonVisualSteadyStateResponse, sstim-v:phenomenonSomatosensorySteadyStateResponse ;
    skos:prefLabel "evoked or driven response"@en,
                   "risposta evocata o indotta"@it,
                   "resposta evocada ou induzida"@pt,
                   "respuesta evocada o inducida"@es ;
    skos:notation "phenomenon-evoked-response" ;
    skos:definition "A neural response evoked or driven by an applied stimulus."@en ;
    skos:scopeNote "These are response forms, not causal mechanisms. They replace the mechanism-scheme entries deprecated in 0.9.0: a measurable evoked response describes what happens, while how it arises remains a separate mechanism and evidence question."@en .

sstim-v:phenomenonFrequencyFollowingResponse a owl:NamedIndividual, sstim:NeuralPhenomenon, skos:Concept ;
    skos:inScheme sstim-v:NeuralPhenomenonScheme ;
    skos:broader sstim-v:phenomenonEvokedResponse ;
    skos:prefLabel "frequency-following response"@en,
                   "risposta di inseguimento della frequenza"@it,
                   "resposta de seguimento de frequência"@pt,
                   "respuesta de seguimiento de frecuencia"@es ;
    skos:notation "phenomenon-frequency-following-response" ;
    skos:definition "A neural response that follows the periodicity of an applied stimulus."@en .

sstim-v:phenomenonAuditorySteadyStateResponse a owl:NamedIndividual, sstim:NeuralPhenomenon, skos:Concept ;
    skos:inScheme sstim-v:NeuralPhenomenonScheme ;
    skos:broader sstim-v:phenomenonEvokedResponse ;
    skos:prefLabel "auditory steady-state response"@en,
                   "risposta uditiva di stato stazionario"@it,
                   "resposta auditiva de estado estacionário"@pt,
                   "respuesta auditiva de estado estacionario"@es ;
    skos:notation "phenomenon-auditory-steady-state-response" ;
    skos:definition "A steady-state neural response frequency-tagged to a periodic auditory stimulus."@en .

sstim-v:phenomenonVisualSteadyStateResponse a owl:NamedIndividual, sstim:NeuralPhenomenon, skos:Concept ;
    skos:inScheme sstim-v:NeuralPhenomenonScheme ;
    skos:broader sstim-v:phenomenonEvokedResponse ;
    skos:prefLabel "visual steady-state response"@en,
                   "risposta visiva di stato stazionario"@it,
                   "resposta visual de estado estacionário"@pt,
                   "respuesta visual de estado estacionario"@es ;
    skos:notation "phenomenon-visual-steady-state-response" ;
    skos:definition "A steady-state neural response frequency-tagged to a periodic visual stimulus."@en .

sstim-v:phenomenonSomatosensorySteadyStateResponse a owl:NamedIndividual, sstim:NeuralPhenomenon, skos:Concept ;
    skos:inScheme sstim-v:NeuralPhenomenonScheme ;
    skos:broader sstim-v:phenomenonEvokedResponse ;
    skos:prefLabel "somatosensory steady-state response"@en,
                   "risposta somatosensoriale di stato stazionario"@it,
                   "resposta somatossensorial de estado estacionário"@pt,
                   "respuesta somatosensorial de estado estacionario"@es ;
    skos:notation "phenomenon-somatosensory-steady-state-response" ;
    skos:definition "A steady-state neural response frequency-tagged to a periodic somatosensory stimulus."@en .

sstim-v:phenomenonReflexResponse a owl:NamedIndividual, sstim:NeuralPhenomenon, skos:Concept ;
    skos:inScheme sstim-v:NeuralPhenomenonScheme ;
    skos:topConceptOf sstim-v:NeuralPhenomenonScheme ;
    skos:narrower sstim-v:phenomenonAcousticStartleReflex ;
    skos:prefLabel "reflex response"@en,
                   "risposta riflessa"@it,
                   "resposta reflexa"@pt,
                   "respuesta refleja"@es ;
    skos:notation "phenomenon-reflex-response" ;
    skos:definition "A reflex response elicited by an applied stimulus."@en .

sstim-v:phenomenonAcousticStartleReflex a owl:NamedIndividual, sstim:NeuralPhenomenon, skos:Concept ;
    skos:inScheme sstim-v:NeuralPhenomenonScheme ;
    skos:broader sstim-v:phenomenonReflexResponse ;
    skos:prefLabel "acoustic startle reflex"@en,
                   "riflesso di trasalimento acustico"@it,
                   "reflexo de sobressalto acústico"@pt,
                   "reflejo de sobresalto acústico"@es ;
    skos:notation "phenomenon-acoustic-startle-reflex" ;
    skos:definition "The startle reflex elicited by a sudden intense acoustic stimulus."@en .

# ADR 0036: names "neuromodulation-as-effect" WITHOUT minting a class. A SKOS
# collection grouping the state-change neural phenomena — the outcomes that
# constitute an ongoing or lasting modulation of neural state — and deliberately
# EXCLUDING the evoked/driven and reflex responses, which are the nervous system
# following a stimulus rather than a modulation of its state. The effect sense
# stays a facet over sstim:outcomeNeuralPhenomenon; this collection is the
# queryable, legible handle (ADR 0036 Q2).
sstim-v:NeuromodulatoryEffectCollection a skos:Collection ;
    rdfs:label "Neuromodulatory effect (neural phenomena)"@en ;
    skos:definition "The state-change neural phenomena that constitute a neuromodulatory effect when asserted in the outcome role (sstim:outcomeNeuralPhenomenon): changes in excitability or firing, oscillatory dynamics, temporal coordination, synaptic transmission, neurochemical signaling, connectivity or plasticity, and autonomic neural regulation. Evoked or driven responses and reflex responses are excluded: they are the nervous system following a stimulus, not a modulation of its state (ADR 0036)."@en ;
    rdfs:seeAlso <https://github.com/laBioSynCare/laBioSynCare.github.io/blob/main/docs/decisions/0036-neurostimulation-neuromodulation-senses-and-self-directed-split.md> ;
    skos:member sstim-v:phenomenonExcitabilityOrFiring, sstim-v:phenomenonOscillatoryDynamics,
        sstim-v:phenomenonTemporalCoordination, sstim-v:phenomenonSynapticTransmission,
        sstim-v:phenomenonNeurochemicalSignaling, sstim-v:phenomenonConnectivityOrPlasticity,
        sstim-v:phenomenonAutonomicNeuralRegulation .


###########################################################################
# Part 12b — Participant Engagement Mode Facet (ADR 0035)
#
# The sixth facet, orthogonal to the five ADR 0034 axes. It answers a question
# none of them does: how much active participation does the method demand of the
# individual? Raised in the 2026-07-22 Theo Marins interview, from the
# observation that neurofeedback, biofeedback, meditation, and breathwork are set
# apart from receptive stimulation by requiring the individual's own engagement.
###########################################################################

sstim-v:ParticipantEngagementModeScheme a skos:ConceptScheme ;
    skos:prefLabel "SSTIM Participant Engagement Mode Vocabulary"@en ,
                   "Vocabolario delle Modalità di Coinvolgimento del Partecipante SSTIM"@it ,
                   "Vocabulário de Modos de Envolvimento do Participante SSTIM"@pt ,
                   "Vocabulario de Modos de Participación del Participante SSTIM"@es ;
    skos:definition "The degree and kind of active participation a method requires of the individual, from passive reception through cue-following to active self-regulation."@en ;
    skos:scopeNote "A single coarse ordinal-ish axis, deliberately orthogonal to route, approach, target site, system, and phenomenon (ADR 0034). Engagement mode is a property of the method, not a claim about efficacy, and does not by itself decide whether a method is neuromodulation (ADR 0035)."@en ;
    rdfs:seeAlso <https://github.com/laBioSynCare/laBioSynCare.github.io/blob/main/docs/decisions/0035-participant-engagement-mode-and-endogenous-self-regulation.md> ;
    skos:hasTopConcept sstim-v:engagementPassiveReceptive, sstim-v:engagementGuidedFollowing,
        sstim-v:engagementActiveSelfRegulatory .

sstim-v:engagementPassiveReceptive a owl:NamedIndividual, sstim:ParticipantEngagementMode, skos:Concept ;
    skos:inScheme sstim-v:ParticipantEngagementModeScheme ;
    skos:topConceptOf sstim-v:ParticipantEngagementModeScheme ;
    skos:prefLabel "Passive / Receptive"@en, "Passivo / Ricettivo"@it,
                   "Passivo / Recetivo"@pt, "Pasivo / Receptivo"@es ;
    skos:notation "engagement-passive-receptive" ;
    skos:definition "The method delivers to a receptive individual who is not required to act on their own state — for example binaural beats played to a resting listener, photic driving, or an anaesthetised recipient of ECT. A closed-loop automated system (such as sleep-phase-locked auditory stimulation) is still passive when the individual does not self-regulate."@en .

sstim-v:engagementGuidedFollowing a owl:NamedIndividual, sstim:ParticipantEngagementMode, skos:Concept ;
    skos:inScheme sstim-v:ParticipantEngagementModeScheme ;
    skos:topConceptOf sstim-v:ParticipantEngagementModeScheme ;
    skos:prefLabel "Guided / Cue-Following"@en, "Guidato / A Seguito di Segnale"@it,
                   "Guiado / A Seguir Sinal"@pt, "Guiado / Siguiendo Señal"@es ;
    skos:notation "engagement-guided-following" ;
    skos:definition "The individual actively follows an external pacing cue but does not regulate from their own internal feedback — for example following BSC's Martigli paced-breathing guidance or a movement cue. Between passive reception and self-regulation."@en .

sstim-v:engagementActiveSelfRegulatory a owl:NamedIndividual, sstim:ParticipantEngagementMode, skos:Concept ;
    skos:inScheme sstim-v:ParticipantEngagementModeScheme ;
    skos:topConceptOf sstim-v:ParticipantEngagementModeScheme ;
    skos:prefLabel "Active / Self-Regulatory"@en, "Attivo / Autoregolatorio"@it,
                   "Ativo / Autorregulatório"@pt, "Activo / Autorregulatorio"@es ;
    skos:notation "engagement-active-self-regulatory" ;
    skos:definition "The method's mechanism requires the individual to actively regulate their own state, typically toward a goal they perceive — for example meditation, volitional breathwork, neurofeedback, and biofeedback. The modulation is produced endogenously by the individual, which is the crux discussed in ADR 0035."@en .

# ── ADR 0034: non-sensory neuromodulation contrast set ──────────────────
# Catalogued so the ontology can DESCRIBE these boundary methods, and so the
# neural-access-route axis is exercised across three distinct routes rather
# than left single-valued. None is referenced by any BSC preset, framework,
# protocol, or implementation, and none is linked by definesTechnique or
# incorporatesTechnique: inclusion asserts neither BSC Lab capability, nor
# efficacy, nor safety. Characteristic delivery media are asserted in the
# sstim-technique-exposure.ttl bridge, which depends on both concerns.

sstim-v:techRepetitiveTMS a owl:NamedIndividual, sstim:NeuromodulationTechnique, sstim:NeurostimulationTechnique, skos:Concept ;
    skos:inScheme sstim-v:TechniqueScheme ;
    skos:prefLabel "Repetitive Transcranial Magnetic Stimulation"@en,
                   "Stimolazione Magnetica Transcranica Ripetitiva"@it,
                   "Estimulação Magnética Transcraniana Repetitiva"@pt,
                   "Estimulación Magnética Transcraneal Repetitiva"@es ;
    skos:notation "repetitive-tms" ;
    skos:definition "Repeated magnetic pulses applied by a coil over the scalp, inducing an electric field in underlying tissue, with the objective of altering cortical activity or excitability."@en ;
    skos:scopeNote "Typed as neuromodulation because the modulation objective is definitional for the repetitive protocol. A single-pulse probe used only to elicit and measure a response is stimulation without being neuromodulation, since measuring is not modulating. The induced electric field is an established physical transformation and belongs in the exposure or device description, not in a proposed mechanism; how that field produces a neural response remains an evidence question."@en ;
    sstim:hasStimulusTemporalStructure sstim-v:temporalPulseTrainOrBurst ;
    sstim:neuralAccessRoute sstim-v:routePhysicalNeuralInteraction ;
    sstim:stimulationDeliveryApproach sstim-v:approachExternal, sstim-v:approachTranscranial ;
    sstim:intendedNeuralTargetSite sstim-v:targetBrain, sstim-v:targetCortex ;
    sstim:intendedNeuralPhenomenon sstim-v:phenomenonExcitabilityOrFiring ;
    skos:editorialNote "Catalogued for domain completeness. Not deliverable by BSC Lab and not consumer-platform feasible."@en .

sstim-v:techTDCS a owl:NamedIndividual, sstim:NeuromodulationTechnique, sstim:NeurostimulationTechnique, skos:Concept ;
    skos:inScheme sstim-v:TechniqueScheme ;
    skos:prefLabel "Transcranial Direct Current Stimulation"@en,
                   "Stimolazione Transcranica a Corrente Continua"@it,
                   "Estimulação Transcraniana por Corrente Contínua"@pt,
                   "Estimulación Transcraneal por Corriente Continua"@es ;
    skos:notation "tdcs" ;
    skos:definition "A weak constant electric current applied through scalp electrodes with the objective of altering cortical excitability."@en ;
    skos:scopeNote "Applied electric current is not by itself brain stimulation — peripheral, muscular, and cardiac applications share the medium and are separated here by route, approach, and target."@en ;
    sstim:hasStimulusTemporalStructure sstim-v:temporalContinuousTonic ;
    sstim:neuralAccessRoute sstim-v:routePhysicalNeuralInteraction ;
    sstim:stimulationDeliveryApproach sstim-v:approachExternal, sstim-v:approachTranscutaneous, sstim-v:approachTranscranial ;
    sstim:intendedNeuralTargetSite sstim-v:targetBrain, sstim-v:targetCortex ;
    sstim:intendedNeuralPhenomenon sstim-v:phenomenonExcitabilityOrFiring ;
    skos:editorialNote "Catalogued for domain completeness. Not deliverable by BSC Lab."@en .

sstim-v:techTACS a owl:NamedIndividual, sstim:NeuromodulationTechnique, sstim:NeurostimulationTechnique, skos:Concept ;
    skos:inScheme sstim-v:TechniqueScheme ;
    skos:prefLabel "Transcranial Alternating Current Stimulation"@en,
                   "Stimolazione Transcranica a Corrente Alternata"@it,
                   "Estimulação Transcraniana por Corrente Alternada"@pt,
                   "Estimulación Transcraneal por Corriente Alterna"@es ;
    skos:notation "tacs" ;
    skos:definition "An oscillating electric current applied through scalp electrodes with the objective of altering the amplitude, frequency, or phase of cortical oscillations."@en ;
    skos:scopeNote "The direct non-sensory analogue of sensory entrainment: periodic, and targeting oscillatory dynamics. Its intended route is a physical cortical interaction, but reported effects can also arise through transcutaneous peripheral-nerve stimulation. That competing account is an evidence question, recorded on an outcome concept via sstim:outcomeNeuralTargetSite, and it never rewrites this declared intended route."@en ;
    sstim:hasStimulusTemporalStructure sstim-v:temporalPeriodic ;
    sstim:neuralAccessRoute sstim-v:routePhysicalNeuralInteraction ;
    sstim:stimulationDeliveryApproach sstim-v:approachExternal, sstim-v:approachTranscutaneous, sstim-v:approachTranscranial ;
    sstim:intendedNeuralTargetSite sstim-v:targetBrain, sstim-v:targetCortex ;
    sstim:intendedNeuralPhenomenon sstim-v:phenomenonOscillatoryDynamics ;
    skos:editorialNote "Catalogued for domain completeness. Not deliverable by BSC Lab."@en .

sstim-v:techDBS a owl:NamedIndividual, sstim:NeuromodulationTechnique, sstim:NeurostimulationTechnique, skos:Concept ;
    skos:inScheme sstim-v:TechniqueScheme ;
    skos:prefLabel "Deep Brain Stimulation"@en,
                   "Stimolazione Cerebrale Profonda"@it,
                   "Estimulação Cerebral Profunda"@pt,
                   "Estimulación Cerebral Profunda"@es ;
    skos:notation "dbs" ;
    skos:definition "Electrical stimulation delivered by surgically implanted intracranial electrodes to a deep brain structure with the objective of altering its activity."@en ;
    skos:scopeNote "A clinical neurosurgical method, catalogued so the ontology can describe the implanted-electrode route. It is emphatically outside any consumer or wellness context."@en ;
    sstim:hasStimulusTemporalStructure sstim-v:temporalPulseTrainOrBurst ;
    sstim:neuralAccessRoute sstim-v:routePhysicalNeuralInteraction ;
    sstim:stimulationDeliveryApproach sstim-v:approachImplanted, sstim-v:approachIntracranial ;
    sstim:intendedNeuralTargetSite sstim-v:targetDeepBrainStructure ;
    sstim:intendedNeuralPhenomenon sstim-v:phenomenonExcitabilityOrFiring ;
    skos:editorialNote "Catalogued for domain completeness. Not deliverable by BSC Lab and outside its scope entirely."@en .

sstim-v:techVagusNerveStimulation a owl:NamedIndividual, sstim:NeuromodulationTechnique, sstim:NeurostimulationTechnique, skos:Concept ;
    skos:inScheme sstim-v:TechniqueScheme ;
    skos:prefLabel "Vagus Nerve Stimulation"@en,
                   "Stimolazione del Nervo Vago"@it,
                   "Estimulação do Nervo Vago"@pt,
                   "Estimulación del Nervio Vago"@es ;
    skos:notation "vagus-nerve-stimulation" ;
    skos:definition "Electrical stimulation of the vagus nerve, by an implanted device or through the skin at an accessible branch, with the objective of altering autonomic neural regulation."@en ;
    skos:scopeNote "Shows why route, approach, and target must stay independent: implanted and transcutaneous variants share a target and a route while differing in approach. Targeting a cranial nerve and the autonomic system says nothing about entering through a sensory system."@en ;
    sstim:hasStimulusTemporalStructure sstim-v:temporalPulseTrainOrBurst ;
    sstim:neuralAccessRoute sstim-v:routePhysicalNeuralInteraction ;
    sstim:stimulationDeliveryApproach sstim-v:approachImplanted, sstim-v:approachExternal, sstim-v:approachTranscutaneous ;
    sstim:intendedNeuralTargetSite sstim-v:targetCranialNerve ;
    sstim:intendedNeuralSystem sstim-v:systemAutonomic ;
    sstim:intendedNeuralPhenomenon sstim-v:phenomenonAutonomicNeuralRegulation ;
    skos:editorialNote "Catalogued for domain completeness. Not deliverable by BSC Lab."@en .

sstim-v:techIntrathecalNeuromodulatoryAgentDelivery a owl:NamedIndividual, sstim:NeuromodulationTechnique, skos:Concept ;
    skos:inScheme sstim-v:TechniqueScheme ;
    skos:prefLabel "Targeted Intrathecal Neuromodulatory Agent Delivery"@en,
                   "Somministrazione Intratecale Mirata di Agente Neuromodulatore"@it,
                   "Administração Intratecal Dirigida de Agente Neuromodulador"@pt,
                   "Administración Intratecal Dirigida de Agente Neuromodulador"@es ;
    skos:notation "intrathecal-neuromodulatory-agent-delivery" ;
    skos:definition "Infusion of a neuromodulatory agent into the intrathecal space, targeted at an identified central nervous system site with the objective of altering its activity or function."@en ;
    skos:scopeNote "The populated chemical example, included because an empty route category would not demonstrate that the model works. It qualifies as neuromodulation only because the neuromodulatory objective and the identified neural target are definitional; ordinary systemic neuroactive pharmacotherapy does not qualify, since drug administration alone is insufficient."@en ;
    sstim:hasStimulusTemporalStructure sstim-v:temporalContinuousInfusion ;
    sstim:neuralAccessRoute sstim-v:routeBiochemicalPharmacologicalNeuralInteraction ;
    sstim:stimulationDeliveryApproach sstim-v:approachTargetedLocalInfusion, sstim-v:approachIntrathecal ;
    sstim:intendedNeuralTargetSite sstim-v:targetCentralNervousSystem, sstim-v:targetSpinalCord ;
    sstim:intendedNeuralPhenomenon sstim-v:phenomenonNeurochemicalSignaling ;
    skos:editorialNote "Catalogued for domain completeness. A clinical method, not deliverable by BSC Lab."@en .

# ADR 0035: electroconvulsive therapy, added at the suggestion of Theo Marins
# (2026-07-22). It completes the contrast set's coverage of the established
# convulsive branch of brain-stimulation therapies and, as the recipient is
# anaesthetised, exercises the passive extreme of the new engagement axis.
sstim-v:techElectroconvulsiveTherapy a owl:NamedIndividual, sstim:NeuromodulationTechnique, sstim:NeurostimulationTechnique, skos:Concept ;
    skos:inScheme sstim-v:TechniqueScheme ;
    skos:prefLabel "Electroconvulsive Therapy"@en,
                   "Terapia Elettroconvulsivante"@it,
                   "Eletroconvulsoterapia"@pt,
                   "Terapia Electroconvulsiva"@es ;
    skos:notation "electroconvulsive-therapy" ;
    skos:definition "Brief electrical stimulation applied through scalp electrodes to deliberately induce a generalized seizure under anaesthesia, with the objective of altering brain activity."@en ;
    skos:scopeNote "A clinical psychiatric neuromodulation method, catalogued only so the ontology can describe the convulsive branch of established brain-stimulation therapy. Emphatically outside any consumer or wellness context and not deliverable by BSC Lab. The induced seizure is the deliberate mechanism, which separates it from stimulation applied merely to probe a response; efficacy and safety remain evidence questions this catalogue does not answer."@en ;
    sstim:hasStimulusTemporalStructure sstim-v:temporalPulseTrainOrBurst ;
    sstim:neuralAccessRoute sstim-v:routePhysicalNeuralInteraction ;
    sstim:stimulationDeliveryApproach sstim-v:approachExternal, sstim-v:approachTranscutaneous, sstim-v:approachTranscranial ;
    sstim:intendedNeuralTargetSite sstim-v:targetBrain ;
    sstim:intendedNeuralPhenomenon sstim-v:phenomenonExcitabilityOrFiring ;
    sstim:participantEngagementMode sstim-v:engagementPassiveReceptive ;
    skos:editorialNote "Catalogued for domain completeness at the suggestion of Theo Marins (2026-07-22 interview, ADR 0035). Not deliverable by BSC Lab and outside its scope entirely."@en .


# ── ADR 0035: closed-loop self-regulation techniques ────────────────────
# Neurofeedback and biofeedback. Theo Marins (2026-07-22) places both closer to
# neuromodulation than to neurostimulation. They are typed at the NEUTRAL
# sstim:StimulationTechnique layer, not as sstim:NeuromodulationTechnique or
# sstim:SensoryStimulationTechnique: the feedback signal enters through canonical
# sensory transduction, yet the modulation is produced by the individual's own
# endogenous self-regulation, which the current sstim:Neuromodulation definition
# excludes. Neutral typing records the method without prejudging that scope
# question, which ADR 0035 keeps open rather than reopening ADR 0034's frozen
# 0.9.0 decision. They exercise the active extreme of the engagement axis.

sstim-v:techNeurofeedback a owl:NamedIndividual, sstim:NeuromodulationTechnique, skos:Concept ;
    skos:inScheme sstim-v:TechniqueScheme ;
    skos:prefLabel "Neurofeedback"@en,
                   "Neurofeedback"@it,
                   "Neurofeedback"@pt,
                   "Neurofeedback"@es ;
    skos:notation "neurofeedback" ;
    skos:definition "A closed-loop practice in which a measured brain signal (typically EEG) is rendered back to the individual as sensory feedback so that they can learn to self-regulate that neural activity."@en ;
    skos:scopeNote "Self-directed neuromodulation (ADR 0036): a neuromodulation technique whose agency is the individual's own regulation, marked by the active-self-regulatory engagement mode. The feedback enters through canonical sensory transduction (its declared route) and is presented externally; the neural change itself is the intended effect, recorded on the outcome facet, not asserted as achieved here. Theo Marins (2026-07-22) placed neurofeedback closer to neuromodulation than to neurostimulation, which ADR 0036 adopts."@en ;
    sstim:hasStimulusTemporalStructure sstim-v:temporalAdaptive ;
    sstim:neuralAccessRoute sstim-v:routeCanonicalSensoryTransductionAfferent ;
    sstim:stimulationDeliveryApproach sstim-v:approachExternal ;
    sstim:intendedNeuralTargetSite sstim-v:targetBrain, sstim-v:targetCortex ;
    sstim:participantEngagementMode sstim-v:engagementActiveSelfRegulatory ;
    skos:related sstim-v:techSonification, sstim-v:techClosedLoopAuditory ;
    skos:editorialNote "Added from the 2026-07-22 Theo Marins interview; typed as self-directed neuromodulation by ADR 0036."@en .

sstim-v:techBiofeedback a owl:NamedIndividual, sstim:NeuromodulationTechnique, skos:Concept ;
    skos:inScheme sstim-v:TechniqueScheme ;
    skos:prefLabel "Biofeedback"@en,
                   "Biofeedback"@it,
                   "Biofeedback"@pt,
                   "Biofeedback"@es ;
    skos:notation "biofeedback" ;
    skos:definition "A closed-loop practice in which a measured physiological signal (heart rate, heart-rate variability, respiration, muscle tension, or skin conductance) is rendered back to the individual as sensory feedback so that they can learn to self-regulate that function."@en ;
    skos:scopeNote "Self-directed neuromodulation (ADR 0036), marked by the active-self-regulatory engagement mode. Its neuromodulation status is clearest for autonomically mediated forms — heart-rate-variability biofeedback trains vagal and baroreflex regulation; peripheral forms such as EMG muscle biofeedback sit closer to motor self-regulation than to neural modulation, so the neural target is recorded broadly. Auditory biofeedback is the sonification case (sstim-v:techSonification); HRV/paced-breathing biofeedback connects to BSC's Martigli breathing component. Theo Marins (2026-07-22) placed biofeedback closer to neuromodulation than to neurostimulation, which ADR 0036 adopts."@en ;
    skos:editorialNote "Deliberately kept as one neutral technique rather than split into narrower neural-only and peripheral-only variants (ADR 0037, RDF-05 of the 2026-07-24 audit): the neural-modulation objective is not equally definitional across its autonomic, muscular, and electrodermal forms, so a narrower neuromodulation-only subtype would misrepresent the peripheral cases. sstim:techNeurofeedback already exists as the separate, narrower technique for which the neural-modulation objective is definitional."@en ;
    sstim:hasStimulusTemporalStructure sstim-v:temporalAdaptive ;
    sstim:neuralAccessRoute sstim-v:routeCanonicalSensoryTransductionAfferent ;
    sstim:stimulationDeliveryApproach sstim-v:approachExternal ;
    sstim:intendedNeuralTargetSite sstim-v:targetPeripheralNervousSystem ;
    sstim:intendedNeuralSystem sstim-v:systemAutonomic ;
    sstim:participantEngagementMode sstim-v:engagementActiveSelfRegulatory ;
    skos:related sstim-v:techSonification ;
    skos:editorialNote "Added from the 2026-07-22 Theo Marins interview; typed as self-directed neuromodulation by ADR 0036."@en .
