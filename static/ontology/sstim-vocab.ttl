###########################################################################
#
#  SSTIM Vocabulary  —  sstim-vocab.ttl
#
#  Namespace:  https://w3id.org/sstim/vocab#
#  Version:    0.3.0
#  Date:       2026-06-17
#  Author:     Renato Fabbri <renato@junto.space>
#  License:    CC BY 4.0
#
#  SKOS concept schemes for the Sensory Stimulation controlled vocabulary.
#  All individuals are dual-typed as both skos:Concept and instances of
#  the relevant OWL class from sstim-core.ttl (Pattern 2 dual-typing).
#  See ontology/README.md for the design rationale.
#
#  Protected file — do not modify without explicit maintainer instruction.
#
###########################################################################

@prefix sstim:    <https://w3id.org/sstim#> .
@prefix sstim-v:  <https://w3id.org/sstim/vocab#> .

@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:   <http://purl.org/dc/terms/> .


###########################################################################
# Part 1 — Frequency Band Scheme
###########################################################################

sstim-v:FrequencyBandScheme a skos:ConceptScheme ;
    skos:prefLabel "SSTIM Frequency Band Vocabulary"@en,
                   "Vocabolario Bande di Frequenza SSTIM"@it,
                   "Vocabulário de Bandas de Frequência SSTIM"@pt,
                   "Vocabulario de Bandas de Frecuencia SSTIM"@es ;
    dct:description "Controlled vocabulary of neural oscillation frequency bands used in BSC protocol design. BSC operational taxonomy — not a medical diagnostic taxonomy."@en ;
    skos:hasTopConcept sstim-v:allFrequencyBands .


sstim-v:allFrequencyBands a owl:NamedIndividual, sstim:FrequencyBandGroup, skos:Concept ;
    skos:inScheme sstim-v:FrequencyBandScheme ;
    skos:topConceptOf sstim-v:FrequencyBandScheme ;
    skos:prefLabel "All Frequency Bands"@en, "Tutte le Bande di Frequenza"@it,
                   "Todas as Bandas de Frequência"@pt, "Todas las Bandas de Frecuencia"@es ;
    skos:narrower sstim-v:delta, sstim-v:theta, sstim-v:alpha,
                  sstim-v:smr, sstim-v:beta, sstim-v:gamma ;
    skos:notation "all" ;
    skos:definition "Top concept of the frequency band scheme: the set of all EEG-derived neural oscillation bands and sub-bands used in BSC protocol design. A grouping root, not a stimulation target in itself."@en .

# --- Primary bands ---

sstim-v:delta a owl:NamedIndividual, sstim:FrequencyBand, skos:Concept ;
    skos:inScheme sstim-v:FrequencyBandScheme ;
    skos:prefLabel "Delta"@en, "Delta"@it, "Delta"@pt, "Delta"@es ;
    skos:notation "delta" ;
    skos:broader sstim-v:allFrequencyBands ;
    skos:narrower sstim-v:lowDelta, sstim-v:highDelta ;
    skos:scopeNote "0.5–4 Hz. Deep sleep, heavy down-regulation."@en ;
    sstim:hzMin "0.5"^^xsd:decimal ;
    sstim:hzMax "4"^^xsd:decimal .

sstim-v:theta a owl:NamedIndividual, sstim:FrequencyBand, skos:Concept ;
    skos:inScheme sstim-v:FrequencyBandScheme ;
    skos:prefLabel "Theta"@en, "Theta"@it, "Theta"@pt, "Theta"@es ;
    skos:notation "theta" ;
    skos:broader sstim-v:allFrequencyBands ;
    skos:narrower sstim-v:lowTheta, sstim-v:highTheta ;
    skos:scopeNote "4–8 Hz. Meditation, creativity, memory, sleep onset, chronic pain support."@en ;
    sstim:hzMin "4"^^xsd:decimal ;
    sstim:hzMax "8"^^xsd:decimal .

sstim-v:alpha a owl:NamedIndividual, sstim:FrequencyBand, skos:Concept ;
    skos:inScheme sstim-v:FrequencyBandScheme ;
    skos:prefLabel "Alpha"@en, "Alfa"@it, "Alfa"@pt, "Alfa"@es ;
    skos:notation "alpha" ;
    skos:broader sstim-v:allFrequencyBands ;
    skos:narrower sstim-v:lowAlpha, sstim-v:highAlpha, sstim-v:alpha10 ;
    skos:scopeNote "8–13 Hz. Relaxation, stress reduction, calm alertness."@en ;
    sstim:hzMin "8"^^xsd:decimal ;
    sstim:hzMax "13"^^xsd:decimal .

sstim-v:smr a owl:NamedIndividual, sstim:FrequencyBand, skos:Concept ;
    skos:inScheme sstim-v:FrequencyBandScheme ;
    skos:prefLabel "SMR"@en, "SMR"@it, "SMR"@pt, "SMR"@es ;
    skos:notation "smr" ;
    skos:broader sstim-v:allFrequencyBands ;
    skos:scopeNote "12–15 Hz. Sensorimotor rhythm. Focused calm, sustained attention."@en ;
    sstim:hzMin "12"^^xsd:decimal ;
    sstim:hzMax "15"^^xsd:decimal .

sstim-v:beta a owl:NamedIndividual, sstim:FrequencyBand, skos:Concept ;
    skos:inScheme sstim-v:FrequencyBandScheme ;
    skos:prefLabel "Beta"@en, "Beta"@it, "Beta"@pt, "Beta"@es ;
    skos:notation "beta" ;
    skos:broader sstim-v:allFrequencyBands ;
    skos:narrower sstim-v:lowBeta, sstim-v:midBeta, sstim-v:highBeta ;
    skos:scopeNote "15–30 Hz. Active cognition, alertness."@en ;
    sstim:hzMin "15"^^xsd:decimal ;
    sstim:hzMax "30"^^xsd:decimal .

sstim-v:gamma a owl:NamedIndividual, sstim:FrequencyBand, skos:Concept ;
    skos:inScheme sstim-v:FrequencyBandScheme ;
    skos:prefLabel "Gamma"@en, "Gamma"@it, "Gamma"@pt, "Gamma"@es ;
    skos:notation "gamma" ;
    skos:broader sstim-v:allFrequencyBands ;
    skos:narrower sstim-v:gamma40 ;
    skos:scopeNote "30–42 Hz. Higher-frequency cognitive activation."@en ;
    sstim:hzMin "30"^^xsd:decimal ;
    sstim:hzMax "42"^^xsd:decimal .

# --- Delta sub-bands ---

sstim-v:lowDelta a owl:NamedIndividual, sstim:FrequencyBand, skos:Concept ;
    skos:inScheme sstim-v:FrequencyBandScheme ;
    skos:prefLabel "Low Delta"@en, "Delta Basso"@it, "Delta Baixo"@pt, "Delta Bajo"@es ;
    skos:notation "low-delta" ;
    skos:broader sstim-v:delta ;
    skos:scopeNote "0.5–2 Hz. Lower portion of the delta band."@en ;
    sstim:hzMin "0.5"^^xsd:decimal ;
    sstim:hzMax "2"^^xsd:decimal .

sstim-v:highDelta a owl:NamedIndividual, sstim:FrequencyBand, skos:Concept ;
    skos:inScheme sstim-v:FrequencyBandScheme ;
    skos:prefLabel "High Delta"@en, "Delta Alto"@it, "Delta Alto"@pt, "Delta Alto"@es ;
    skos:notation "high-delta" ;
    skos:broader sstim-v:delta ;
    skos:scopeNote "2–4 Hz. Upper portion of the delta band."@en ;
    sstim:hzMin "2"^^xsd:decimal ;
    sstim:hzMax "4"^^xsd:decimal .

# --- Theta sub-bands ---

sstim-v:lowTheta a owl:NamedIndividual, sstim:FrequencyBand, skos:Concept ;
    skos:inScheme sstim-v:FrequencyBandScheme ;
    skos:prefLabel "Low Theta"@en, "Theta Basso"@it, "Theta Baixo"@pt, "Theta Bajo"@es ;
    skos:notation "low-theta" ;
    skos:broader sstim-v:theta ;
    skos:scopeNote "4–6 Hz. Lower portion of the theta band."@en ;
    sstim:hzMin "4"^^xsd:decimal ;
    sstim:hzMax "6"^^xsd:decimal .

sstim-v:highTheta a owl:NamedIndividual, sstim:FrequencyBand, skos:Concept ;
    skos:inScheme sstim-v:FrequencyBandScheme ;
    skos:prefLabel "High Theta"@en, "Theta Alto"@it, "Theta Alto"@pt, "Theta Alto"@es ;
    skos:notation "high-theta" ;
    skos:broader sstim-v:theta ;
    skos:scopeNote "6–8 Hz. Upper portion of the theta band."@en ;
    sstim:hzMin "6"^^xsd:decimal ;
    sstim:hzMax "8"^^xsd:decimal .

# --- Alpha sub-bands ---

sstim-v:lowAlpha a owl:NamedIndividual, sstim:FrequencyBand, skos:Concept ;
    skos:inScheme sstim-v:FrequencyBandScheme ;
    skos:prefLabel "Low Alpha"@en, "Alfa Basso"@it, "Alfa Baixo"@pt, "Alfa Bajo"@es ;
    skos:notation "low-alpha" ;
    skos:broader sstim-v:alpha ;
    skos:scopeNote "8–10 Hz. Lower portion of the alpha band."@en ;
    sstim:hzMin "8"^^xsd:decimal ;
    sstim:hzMax "10"^^xsd:decimal .

sstim-v:highAlpha a owl:NamedIndividual, sstim:FrequencyBand, skos:Concept ;
    skos:inScheme sstim-v:FrequencyBandScheme ;
    skos:prefLabel "High Alpha"@en, "Alfa Alto"@it, "Alfa Alto"@pt, "Alfa Alto"@es ;
    skos:notation "high-alpha" ;
    skos:broader sstim-v:alpha ;
    skos:scopeNote "10–13 Hz. Upper portion of the alpha band."@en ;
    sstim:hzMin "10"^^xsd:decimal ;
    sstim:hzMax "13"^^xsd:decimal .

sstim-v:alpha10 a owl:NamedIndividual, sstim:FrequencyBand, skos:Concept ;
    skos:inScheme sstim-v:FrequencyBandScheme ;
    skos:prefLabel "Alpha 10 Hz"@en, "Alfa 10 Hz"@it, "Alfa 10 Hz"@pt, "Alfa 10 Hz"@es ;
    skos:notation "alpha-10" ;
    skos:broader sstim-v:alpha ;
    skos:related sstim-v:lowAlpha, sstim-v:highAlpha ;
    skos:scopeNote "The canonical 10 Hz calming and meditation target (Berger's classic alpha peak / typical individual alpha frequency). Distinguished from broad alpha because multiple protocols specifically target this frequency. 10 Hz sits exactly on the shared boundary of the two alpha sub-bands — the inclusive upper bound of low-alpha (8–10 Hz) and the inclusive lower bound of high-alpha (10–13 Hz) — so it is associatively related (skos:related) to both, not filed under either. skos:related is used rather than a cross-scheme mapping property such as skos:broadMatch because all three concepts are in this same scheme."@en ;
    sstim:hzMin "10"^^xsd:decimal ;
    sstim:hzMax "10"^^xsd:decimal .

# --- Beta sub-bands ---

sstim-v:lowBeta a owl:NamedIndividual, sstim:FrequencyBand, skos:Concept ;
    skos:inScheme sstim-v:FrequencyBandScheme ;
    skos:prefLabel "Low Beta"@en, "Beta Basso"@it, "Beta Baixo"@pt, "Beta Bajo"@es ;
    skos:notation "low-beta" ;
    skos:broader sstim-v:beta ;
    skos:scopeNote "15–20 Hz. Lower portion of the beta band."@en ;
    sstim:hzMin "15"^^xsd:decimal ;
    sstim:hzMax "20"^^xsd:decimal .

sstim-v:midBeta a owl:NamedIndividual, sstim:FrequencyBand, skos:Concept ;
    skos:inScheme sstim-v:FrequencyBandScheme ;
    skos:prefLabel "Mid Beta"@en, "Beta Medio"@it, "Beta Médio"@pt, "Beta Medio"@es ;
    skos:notation "mid-beta" ;
    skos:broader sstim-v:beta ;
    skos:scopeNote "20–25 Hz. Middle portion of the beta band."@en ;
    sstim:hzMin "20"^^xsd:decimal ;
    sstim:hzMax "25"^^xsd:decimal .

sstim-v:highBeta a owl:NamedIndividual, sstim:FrequencyBand, skos:Concept ;
    skos:inScheme sstim-v:FrequencyBandScheme ;
    skos:prefLabel "High Beta"@en, "Beta Alto"@it, "Beta Alto"@pt, "Beta Alto"@es ;
    skos:notation "high-beta" ;
    skos:broader sstim-v:beta ;
    skos:scopeNote "25–30 Hz. Upper portion of the beta band."@en ;
    sstim:hzMin "25"^^xsd:decimal ;
    sstim:hzMax "30"^^xsd:decimal .

# --- Gamma sub-band ---

sstim-v:gamma40 a owl:NamedIndividual, sstim:FrequencyBand, skos:Concept ;
    skos:inScheme sstim-v:FrequencyBandScheme ;
    skos:prefLabel "Gamma 40 Hz"@en, "Gamma 40 Hz"@it, "Gamma 40 Hz"@pt, "Gamma 40 Hz"@es ;
    skos:notation "gamma-40" ;
    skos:broader sstim-v:gamma ;
    skos:scopeNote "The specific 40 Hz target associated with the GENUS/Iaccarino neuroimmune research lineage (emerging, preclinical and early human multisensory). Distinct from general gamma: evidence base, modality cautions, and claim language are different. Do not generalize all gamma designs as neuroprotection-oriented."@en ;
    sstim:hzMin "40"^^xsd:decimal ;
    sstim:hzMax "40"^^xsd:decimal .


###########################################################################
# Part 2 — Preset Group Scheme
###########################################################################

sstim-v:PresetGroupScheme a skos:ConceptScheme ;
    skos:prefLabel "BSC Preset Group Vocabulary"@en ;
    skos:hasTopConcept sstim-v:groupHeal, sstim-v:groupSupport,
                       sstim-v:groupPerform, sstim-v:groupIndulge,
                       sstim-v:groupTranscend .

sstim-v:groupHeal a owl:NamedIndividual, sstim:PresetGroup, skos:Concept ;
    skos:inScheme sstim-v:PresetGroupScheme ;
    skos:prefLabel "Heal"@en, "Heal"@it, "Heal"@pt, "Heal"@es ;
    skos:notation "Heal" ;
    skos:definition "Wellness goals with comparatively stronger evidence and conservative design. Guided breathing often appropriate. Warm, lower-complexity character."@en .

sstim-v:groupSupport a owl:NamedIndividual, sstim:PresetGroup, skos:Concept ;
    skos:inScheme sstim-v:PresetGroupScheme ;
    skos:prefLabel "Support"@en, "Support"@it, "Support"@pt, "Support"@es ;
    skos:notation "Support" ;
    skos:definition "Meaningful user needs where evidence is promising but limited, mixed, indirect, or modality-mismatched. Explicit limitation statements required in techDesc."@en .

sstim-v:groupPerform a owl:NamedIndividual, sstim:PresetGroup, skos:Concept ;
    skos:inScheme sstim-v:PresetGroupScheme ;
    skos:prefLabel "Perform"@en, "Perform"@it, "Perform"@pt, "Perform"@es ;
    skos:notation "Perform" ;
    skos:definition "Cognitive performance, focus, work, creativity. Background (minimal, no breathing) and Active (engaging, breathing may apply) sub-types."@en .

sstim-v:groupIndulge a owl:NamedIndividual, sstim:PresetGroup, skos:Concept ;
    skos:inScheme sstim-v:PresetGroupScheme ;
    skos:prefLabel "Indulge"@en, "Indulge"@it, "Indulge"@pt, "Indulge"@es ;
    skos:notation "Indulge" ;
    skos:definition "Experiential, playful, intense, or recreational sonic worlds. High personality, diverse design, bloom intentional. No medical implication."@en .

sstim-v:groupTranscend a owl:NamedIndividual, sstim:PresetGroup, skos:Concept ;
    skos:inScheme sstim-v:PresetGroupScheme ;
    skos:prefLabel "Transcend"@en, "Transcend"@it, "Transcend"@pt, "Transcend"@es ;
    skos:notation "Transcend" ;
    skos:definition "Meditation, contemplative, altered-state, and perceptual exploration. May progressively reduce grounding. Claims remain conservative."@en .


###########################################################################
# Part 3 — Evidence Tier Scheme
###########################################################################

sstim-v:EvidenceTierScheme a skos:ConceptScheme ;
    skos:prefLabel "SSTIM Evidence Tier Vocabulary"@en ;
    skos:hasTopConcept sstim-v:tierSpeculative, sstim-v:tierAnecdotal,
                       sstim-v:tierPreliminary, sstim-v:tierModerate,
                       sstim-v:tierStrong, sstim-v:tierEstablished .

sstim-v:tierSpeculative a owl:NamedIndividual, sstim:EvidenceTierValue, skos:Concept ;
    skos:inScheme sstim-v:EvidenceTierScheme ;
    skos:prefLabel "Speculative"@en, "Speculativo"@it, "Especulativo"@pt, "Especulativo"@es ;
    skos:notation "speculative" ;
    sstim:tierRank 1 ;
    skos:definition "Tier 1. Theoretical basis only; no controlled human studies."@en .

sstim-v:tierAnecdotal a owl:NamedIndividual, sstim:EvidenceTierValue, skos:Concept ;
    skos:inScheme sstim-v:EvidenceTierScheme ;
    skos:prefLabel "Anecdotal"@en, "Aneddotico"@it, "Anedótico"@pt, "Anecdótico"@es ;
    skos:notation "anecdotal" ;
    sstim:tierRank 2 ;
    skos:definition "Tier 2. Anecdotal reports and case series. No systematic data."@en .

sstim-v:tierPreliminary a owl:NamedIndividual, sstim:EvidenceTierValue, skos:Concept ;
    skos:inScheme sstim-v:EvidenceTierScheme ;
    skos:prefLabel "Preliminary"@en, "Preliminare"@it, "Preliminar"@pt, "Preliminar"@es ;
    skos:notation "preliminary" ;
    sstim:tierRank 3 ;
    skos:definition "Tier 3. Small controlled studies with directionally consistent results but limited replication."@en .

sstim-v:tierModerate a owl:NamedIndividual, sstim:EvidenceTierValue, skos:Concept ;
    skos:inScheme sstim-v:EvidenceTierScheme ;
    skos:prefLabel "Moderate"@en, "Moderato"@it, "Moderado"@pt, "Moderado"@es ;
    skos:notation "moderate" ;
    sstim:tierRank 4 ;
    skos:definition "Tier 4. Multiple studies with generally consistent results; some methodological limitations."@en .

sstim-v:tierStrong a owl:NamedIndividual, sstim:EvidenceTierValue, skos:Concept ;
    skos:inScheme sstim-v:EvidenceTierScheme ;
    skos:prefLabel "Strong"@en, "Forte"@it, "Forte"@pt, "Fuerte"@es ;
    skos:notation "strong" ;
    sstim:tierRank 5 ;
    skos:definition "Tier 5. Multiple high-quality RCTs or meta-analyses with consistent results and adequate samples."@en .

sstim-v:tierEstablished a owl:NamedIndividual, sstim:EvidenceTierValue, skos:Concept ;
    skos:inScheme sstim-v:EvidenceTierScheme ;
    skos:prefLabel "Established"@en, "Consolidato"@it, "Estabelecido"@pt, "Establecido"@es ;
    skos:notation "established" ;
    sstim:tierRank 6 ;
    skos:definition "Tier 6. Systematic reviews/meta-analyses with high GRADE confidence; replicated across populations and laboratories."@en .


###########################################################################
# Part 4 — Evidence Modality Tag Scheme
###########################################################################

sstim-v:EvidenceModalityScheme a skos:ConceptScheme ;
    skos:prefLabel "SSTIM Evidence Modality Tag Vocabulary"@en ;
    skos:hasTopConcept sstim-v:modalityAUD, sstim-v:modalityAV, sstim-v:modalityBREATH,
        sstim-v:modalityGENERAL, sstim-v:modalityPRECLINICAL, sstim-v:modalityREVIEW,
        sstim-v:modalityVIS, sstim-v:modalityTACTILE, sstim-v:modalityMULTISENSORY .

sstim-v:modalityAUD a owl:NamedIndividual, sstim:EvidenceModalityTag, skos:Concept ;
    skos:inScheme sstim-v:EvidenceModalityScheme ;
    skos:prefLabel "Auditory"@en, "Uditivo"@it, "Auditivo"@pt, "Auditivo"@es ;
    skos:notation "AUD" ;
    skos:definition "Evidence from auditory-only stimulation. Applies directly to BSC presets."@en .

sstim-v:modalityAV a owl:NamedIndividual, sstim:EvidenceModalityTag, skos:Concept ;
    skos:inScheme sstim-v:EvidenceModalityScheme ;
    skos:prefLabel "Audiovisual"@en, "Audiovisivo"@it, "Audiovisual"@pt, "Audiovisual"@es ;
    skos:notation "AV" ;
    skos:definition "Evidence from combined audiovisual stimulation. Applies to BSC with one tier discount for auditory-only claims."@en .

sstim-v:modalityBREATH a owl:NamedIndividual, sstim:EvidenceModalityTag, skos:Concept ;
    skos:inScheme sstim-v:EvidenceModalityScheme ;
    skos:prefLabel "Breathing"@en, "Respirazione"@it, "Respiração"@pt, "Respiración"@es ;
    skos:notation "BREATH" ;
    skos:definition "Evidence from paced breathing / HRV biofeedback. Applies directly to Martigli breathing guidance component."@en .

sstim-v:modalityGENERAL a owl:NamedIndividual, sstim:EvidenceModalityTag, skos:Concept ;
    skos:inScheme sstim-v:EvidenceModalityScheme ;
    skos:prefLabel "General / Mixed"@en, "Generale / Misto"@it, "Geral / Misto"@pt, "General / Mixto"@es ;
    skos:notation "GENERAL" ;
    skos:definition "Evidence from mixed or unspecified modalities. Must state indirectness in techDesc."@en .

sstim-v:modalityPRECLINICAL a owl:NamedIndividual, sstim:EvidenceModalityTag, skos:Concept ;
    skos:inScheme sstim-v:EvidenceModalityScheme ;
    skos:prefLabel "Preclinical"@en, "Preclinico"@it, "Pré-clínico"@pt, "Preclínico"@es ;
    skos:notation "PRECLINICAL" ;
    skos:definition "Evidence from animal or in-vitro studies. Maximum tier contribution: Tier 3 for human wellness claims."@en .

sstim-v:modalityREVIEW a owl:NamedIndividual, sstim:EvidenceModalityTag, skos:Concept ;
    skos:inScheme sstim-v:EvidenceModalityScheme ;
    skos:prefLabel "Review"@en, "Revisione"@it, "Revisão"@pt, "Revisión"@es ;
    skos:notation "REVIEW" ;
    skos:definition "Systematic review or meta-analysis. Tag used alongside AUD/AV/BREATH/GENERAL to note the evidence synthesis level."@en .

# Visual / tactile / multisensory tags (ADR 0015 follow-up, P5.6). Evidence must
# match modality: a claim tagged VIS does not transfer to an auditory-only preset
# without a tier discount, and multisensory (e.g. GENUS) results do not transfer
# directly to any single modality.
sstim-v:modalityVIS a owl:NamedIndividual, sstim:EvidenceModalityTag, skos:Concept ;
    skos:inScheme sstim-v:EvidenceModalityScheme ;
    skos:prefLabel "Visual"@en, "Visivo"@it, "Visual"@pt, "Visual"@es ;
    skos:notation "VIS" ;
    skos:definition "Evidence from visual-only stimulation (e.g. photic/flicker driving, SSVEP). Applies directly to visual techniques; one tier discount for auditory-only claims."@en .

sstim-v:modalityTACTILE a owl:NamedIndividual, sstim:EvidenceModalityTag, skos:Concept ;
    skos:inScheme sstim-v:EvidenceModalityScheme ;
    skos:prefLabel "Tactile"@en, "Tattile"@it, "Tátil"@pt, "Táctil"@es ;
    skos:notation "TACTILE" ;
    skos:definition "Evidence from tactile / vibrotactile stimulation (e.g. vibrotactile pulse, SSSEP, vibroacoustic). Applies directly to tactile techniques; one tier discount for auditory-only claims."@en .

sstim-v:modalityMULTISENSORY a owl:NamedIndividual, sstim:EvidenceModalityTag, skos:Concept ;
    skos:inScheme sstim-v:EvidenceModalityScheme ;
    skos:prefLabel "Multisensory"@en, "Multisensoriale"@it, "Multissensorial"@pt, "Multisensorial"@es ;
    skos:notation "MULTISENSORY" ;
    skos:definition "Evidence from combined multisensory stimulation (e.g. GENUS audiovisual, audio-tactile). Modality-specific results do not transfer directly to any single channel; apply a tier discount for single-modality claims."@en .


###########################################################################
# Part 6b — Public Claim Level Scheme (ADR 0018)
#
# The C0–C5 risk ladder: how much a public-facing surface may assert, gated by
# evidence. requiresEvidenceTierRank is the minimum sstim:tierRank of supporting
# evidence; the PresetShape legality constraint enforces it. The mapping is a
# PROVISIONAL risk-reduction default — reconcile with the BioSynCare Reference
# publicClaimLevel/clinicalScope enum and a qualified EU MDR adviser before launch.
###########################################################################

sstim-v:PublicClaimLevelScheme a skos:ConceptScheme ;
    skos:prefLabel "SSTIM Public Claim Level Vocabulary"@en ;
    skos:hasTopConcept sstim-v:claimC0Descriptive, sstim-v:claimC1Experiential,
        sstim-v:claimC2Wellness, sstim-v:claimC3StructureFunction,
        sstim-v:claimC4Medical, sstim-v:claimC5Quantified .

sstim-v:claimC0Descriptive a owl:NamedIndividual, sstim:PublicClaimLevel, skos:Concept ;
    skos:inScheme sstim-v:PublicClaimLevelScheme ;
    skos:prefLabel "C0 — Descriptive"@en, "C0 — Descrittivo"@it, "C0 — Descritivo"@pt, "C0 — Descriptivo"@es ;
    skos:notation "C0" ;
    skos:definition "A mechanical fact about what the product does (e.g. \"plays binaural beats and isochronic tones; guides paced breathing\"). Permitted on every surface."@en ;
    sstim:claimLevelRank 0 ;
    sstim:requiresEvidenceTierRank 0 .

sstim-v:claimC1Experiential a owl:NamedIndividual, sstim:PublicClaimLevel, skos:Concept ;
    skos:inScheme sstim-v:PublicClaimLevelScheme ;
    skos:prefLabel "C1 — Experiential (hedged)"@en, "C1 — Esperienziale (mitigato)"@it, "C1 — Experiencial (moderado)"@pt, "C1 — Experiencial (moderado)"@es ;
    skos:notation "C1" ;
    skos:definition "A subjective, non-universal experience report (e.g. \"many people find sessions relaxing\"). Hedged and non-universal; permitted on every surface."@en ;
    sstim:claimLevelRank 1 ;
    sstim:requiresEvidenceTierRank 0 .

sstim-v:claimC2Wellness a owl:NamedIndividual, sstim:PublicClaimLevel, skos:Concept ;
    skos:inScheme sstim-v:PublicClaimLevelScheme ;
    skos:prefLabel "C2 — Wellness/function (general)"@en, "C2 — Benessere/funzione (generale)"@it, "C2 — Bem-estar/função (geral)"@pt, "C2 — Bienestar/función (general)"@es ;
    skos:notation "C2" ;
    skos:definition "A general wellness/function statement with no disease language (e.g. \"supports relaxation and focus\"). Permitted publicly; watch for drift toward C3."@en ;
    sstim:claimLevelRank 2 ;
    sstim:requiresEvidenceTierRank 0 .

sstim-v:claimC3StructureFunction a owl:NamedIndividual, sstim:PublicClaimLevel, skos:Concept ;
    skos:inScheme sstim-v:PublicClaimLevelScheme ;
    skos:prefLabel "C3 — Structure/function"@en, "C3 — Struttura/funzione"@it, "C3 — Estrutura/função"@pt, "C3 — Estructura/función"@es ;
    skos:notation "C3" ;
    skos:definition "A claim that affects a body function (e.g. \"improves sleep\", \"reduces stress\"). Borderline on both the medical-device and misleading-advertising vectors; assertable publicly only with at least moderate evidence."@en ;
    sstim:claimLevelRank 3 ;
    sstim:requiresEvidenceTierRank 4 .

sstim-v:claimC4Medical a owl:NamedIndividual, sstim:PublicClaimLevel, skos:Concept ;
    skos:inScheme sstim-v:PublicClaimLevelScheme ;
    skos:prefLabel "C4 — Medical/condition"@en, "C4 — Medico/condizione"@it, "C4 — Médico/condição"@pt, "C4 — Médico/afección"@es ;
    skos:notation "C4" ;
    skos:definition "A named-condition or symptom claim (e.g. relieves anxiety, depression, migraine, pain, suicidal ideation). Medical-device intended-purpose language; NOT publicly assertable. The underlying observation belongs in evidence-quarantine (a low-tier EvidenceClaim) and may motivate a study, never a public claim."@en ;
    skos:editorialNote "requiresEvidenceTierRank is the sentinel 7 (above the maximum tier 6): no evidence tier makes a condition claim publicly assertable. Public/in-app/partner surfaces force this level off; it survives only as an internal, labeled hypothesis."@en ;
    sstim:claimLevelRank 4 ;
    sstim:requiresEvidenceTierRank 7 .

sstim-v:claimC5Quantified a owl:NamedIndividual, sstim:PublicClaimLevel, skos:Concept ;
    skos:inScheme sstim-v:PublicClaimLevelScheme ;
    skos:prefLabel "C5 — Quantified/superiority"@en, "C5 — Quantificato/superiorità"@it, "C5 — Quantificado/superioridade"@pt, "C5 — Cuantificado/superioridad"@es ;
    skos:notation "C5" ;
    skos:definition "A magnitude or comparative-superiority claim (e.g. \"20% IQ boost\", \"resolves X in 3 sessions\"). Requires strong (RCT-grade) evidence; absent that, not publicly assertable."@en ;
    sstim:claimLevelRank 5 ;
    sstim:requiresEvidenceTierRank 5 .


###########################################################################
# Part 4b — Evidence dimension vocabularies (P3 item 1):
# claim direction, effect direction, review status
###########################################################################

sstim-v:ClaimDirectionScheme a skos:ConceptScheme ;
    skos:prefLabel "SSTIM Evidence Claim Direction Vocabulary"@en ;
    skos:hasTopConcept sstim-v:claimSupports, sstim-v:claimMixed,
        sstim-v:claimInconclusive, sstim-v:claimRefutes .

sstim-v:claimSupports a owl:NamedIndividual, sstim:ClaimDirection, skos:Concept ;
    skos:inScheme sstim-v:ClaimDirectionScheme ;
    skos:prefLabel "Supports"@en ;
    skos:notation "supports" ;
    skos:definition "The body of cited evidence, on balance, supports the asserted relation."@en .

sstim-v:claimMixed a owl:NamedIndividual, sstim:ClaimDirection, skos:Concept ;
    skos:inScheme sstim-v:ClaimDirectionScheme ;
    skos:prefLabel "Mixed"@en ;
    skos:notation "mixed" ;
    skos:definition "The cited evidence is mixed: some studies support the relation and others do not."@en .

sstim-v:claimInconclusive a owl:NamedIndividual, sstim:ClaimDirection, skos:Concept ;
    skos:inScheme sstim-v:ClaimDirectionScheme ;
    skos:prefLabel "Inconclusive"@en ;
    skos:notation "inconclusive" ;
    skos:definition "The cited evidence is insufficient to determine whether the relation holds."@en .

sstim-v:claimRefutes a owl:NamedIndividual, sstim:ClaimDirection, skos:Concept ;
    skos:inScheme sstim-v:ClaimDirectionScheme ;
    skos:prefLabel "Refutes"@en ;
    skos:notation "refutes" ;
    skos:definition "The body of cited evidence, on balance, does not support (or refutes) the asserted relation."@en .


sstim-v:EffectDirectionScheme a skos:ConceptScheme ;
    skos:prefLabel "SSTIM Effect Direction Vocabulary"@en ;
    skos:hasTopConcept sstim-v:effectIncrease, sstim-v:effectDecrease, sstim-v:effectNoChange .

sstim-v:effectIncrease a owl:NamedIndividual, sstim:EffectDirection, skos:Concept ;
    skos:inScheme sstim-v:EffectDirectionScheme ;
    skos:prefLabel "Increase"@en ;
    skos:notation "increase" ;
    skos:definition "The measured outcome increased relative to the comparator."@en .

sstim-v:effectDecrease a owl:NamedIndividual, sstim:EffectDirection, skos:Concept ;
    skos:inScheme sstim-v:EffectDirectionScheme ;
    skos:prefLabel "Decrease"@en ;
    skos:notation "decrease" ;
    skos:definition "The measured outcome decreased relative to the comparator."@en .

sstim-v:effectNoChange a owl:NamedIndividual, sstim:EffectDirection, skos:Concept ;
    skos:inScheme sstim-v:EffectDirectionScheme ;
    skos:prefLabel "No Change"@en ;
    skos:notation "no-change" ;
    skos:definition "No measurable change in the outcome relative to the comparator."@en .


sstim-v:ReviewStatusScheme a skos:ConceptScheme ;
    skos:prefLabel "SSTIM Evidence Review Status Vocabulary"@en ;
    skos:hasTopConcept sstim-v:reviewProvisional, sstim-v:reviewReviewed, sstim-v:reviewNeedsUpdate .

sstim-v:reviewProvisional a owl:NamedIndividual, sstim:ReviewStatus, skos:Concept ;
    skos:inScheme sstim-v:ReviewStatusScheme ;
    skos:prefLabel "Provisional"@en ;
    skos:notation "provisional" ;
    skos:definition "Tier assigned provisionally; not yet independently reviewed."@en .

sstim-v:reviewReviewed a owl:NamedIndividual, sstim:ReviewStatus, skos:Concept ;
    skos:inScheme sstim-v:ReviewStatusScheme ;
    skos:prefLabel "Reviewed"@en ;
    skos:notation "reviewed" ;
    skos:definition "Tier assignment has been independently reviewed."@en .

sstim-v:reviewNeedsUpdate a owl:NamedIndividual, sstim:ReviewStatus, skos:Concept ;
    skos:inScheme sstim-v:ReviewStatusScheme ;
    skos:prefLabel "Needs Update"@en ;
    skos:notation "needs-update" ;
    skos:definition "Tier assignment is out of date and should be re-reviewed against current literature."@en .


###########################################################################
# Part 5 — Voice Type Scheme
###########################################################################

sstim-v:VoiceTypeScheme a skos:ConceptScheme ;
    skos:prefLabel "BSC Voice Type Vocabulary"@en ;
    skos:hasTopConcept sstim-v:voiceBinaural, sstim-v:voiceMartigli,
        sstim-v:voiceMartigliBinaural, sstim-v:voiceSymmetry .

sstim-v:voiceBinaural a owl:NamedIndividual, sstim:VoiceType, skos:Concept ;
    skos:inScheme sstim-v:VoiceTypeScheme ;
    skos:prefLabel "Binaural"@en, "Binaurale"@it, "Binaural"@pt, "Binaural"@es ;
    skos:notation "Binaural" ;
    skos:definition "Two dichotic sine tones producing a binaural beat at |fr - fl| Hz."@en .

sstim-v:voiceMartigli a owl:NamedIndividual, sstim:VoiceType, skos:Concept ;
    skos:inScheme sstim-v:VoiceTypeScheme ;
    skos:prefLabel "Martigli"@en, "Martigli"@it, "Martigli"@pt, "Martigli"@es ;
    skos:notation "Martigli" ;
    skos:definition "Single tone with sinusoidal frequency oscillation following a decelerating breathing arc."@en .

sstim-v:voiceMartigliBinaural a owl:NamedIndividual, sstim:VoiceType, skos:Concept ;
    skos:inScheme sstim-v:VoiceTypeScheme ;
    skos:prefLabel "Martigli-Binaural"@en, "Martigli-Binaurale"@it, "Martigli-Binaural"@pt, "Martigli-Binaural"@es ;
    skos:notation "Martigli-Binaural" ;
    skos:definition "Binaural beat combined with Martigli oscillation. Constant beat frequency despite sweeping carriers."@en .

sstim-v:voiceSymmetry a owl:NamedIndividual, sstim:VoiceType, skos:Concept ;
    skos:inScheme sstim-v:VoiceTypeScheme ;
    skos:prefLabel "Symmetry"@en, "Simmetria"@it, "Simetria"@pt, "Simetría"@es ;
    skos:notation "Symmetry" ;
    skos:definition "Log-distributed pitch sequence with algebraic group permutation at each cycle. Includes isochronic special case (noctaves=0)."@en .


###########################################################################
# Part 6 — Sensory Modality Scheme
###########################################################################

sstim-v:SensoryModalityScheme a skos:ConceptScheme ;
    skos:prefLabel "SSTIM Sensory Modality Vocabulary"@en ;
    skos:hasTopConcept sstim-v:modalityAuditory, sstim-v:modalityVisual,
        sstim-v:modalitySomatosensory, sstim-v:modalityInteroceptive,
        sstim-v:modalityVestibular, sstim-v:modalityOlfactory .

sstim-v:modalityAuditory a owl:NamedIndividual, sstim:SensoryModality, skos:Concept ;
    skos:inScheme sstim-v:SensoryModalityScheme ;
    skos:prefLabel "Auditory"@en, "Uditivo"@it, "Auditivo"@pt, "Auditivo"@es ;
    skos:notation "auditory" ;
    skos:definition "The auditory sensory modality: perception of sound via the ear and auditory pathway. The primary BSC delivery channel."@en ;
    sstim:platformDeliverable "true"^^xsd:boolean .

sstim-v:modalityVisual a owl:NamedIndividual, sstim:SensoryModality, skos:Concept ;
    skos:inScheme sstim-v:SensoryModalityScheme ;
    skos:prefLabel "Visual"@en, "Visivo"@it, "Visual"@pt, "Visual"@es ;
    skos:notation "visual" ;
    skos:definition "The visual sensory modality: perception of light, color, and motion via the eye and visual pathway."@en ;
    sstim:platformDeliverable "true"^^xsd:boolean .

sstim-v:modalitySomatosensory a owl:NamedIndividual, sstim:SensoryModality, skos:Concept ;
    skos:inScheme sstim-v:SensoryModalityScheme ;
    skos:prefLabel "Somatosensory / Haptic"@en, "Somatosensoriale / Aptico"@it, "Somatossensorial / Háptico"@pt, "Somatosensorial / Háptico"@es ;
    skos:notation "somatosensory" ;
    sstim:platformDeliverable "true"^^xsd:boolean ;
    skos:scopeNote "Deliverable via Web Vibration API on Android; not available on iOS Safari."@en .

sstim-v:modalityInteroceptive a owl:NamedIndividual, sstim:SensoryModality, skos:Concept ;
    skos:inScheme sstim-v:SensoryModalityScheme ;
    skos:prefLabel "Interoceptive"@en, "Interocettivo"@it, "Interoceptivo"@pt, "Interoceptivo"@es ;
    skos:notation "interoceptive" ;
    sstim:platformDeliverable "true"^^xsd:boolean ;
    skos:scopeNote "Delivered indirectly via paced breathing guidance that engages respiratory and cardiac interoception."@en .

sstim-v:modalityVestibular a owl:NamedIndividual, sstim:SensoryModality, skos:Concept ;
    skos:inScheme sstim-v:SensoryModalityScheme ;
    skos:prefLabel "Vestibular"@en, "Vestibolare"@it, "Vestibular"@pt, "Vestibular"@es ;
    skos:notation "vestibular" ;
    sstim:platformDeliverable "false"^^xsd:boolean ;
    skos:scopeNote "Requires dedicated hardware (e.g. galvanic vestibular stimulation). Outside current BSC scope."@en .

sstim-v:modalityOlfactory a owl:NamedIndividual, sstim:SensoryModality, skos:Concept ;
    skos:inScheme sstim-v:SensoryModalityScheme ;
    skos:prefLabel "Olfactory"@en, "Olfattivo"@it, "Olfativo"@pt, "Olfativo"@es ;
    skos:notation "olfactory" ;
    sstim:platformDeliverable "false"^^xsd:boolean ;
    skos:scopeNote "Requires dedicated hardware. Outside current BSC scope."@en .


###########################################################################
# Part 7 — Stimulation Mechanism Scheme
###########################################################################

sstim-v:StimulationMechanismScheme a skos:ConceptScheme ;
    skos:prefLabel "SSTIM Stimulation Mechanism Vocabulary"@en ;
    skos:hasTopConcept sstim-v:mechFFR, sstim-v:mechThalamocortical, sstim-v:mechAutonomic,
        sstim-v:mechStochastic, sstim-v:mechAttentional, sstim-v:mechGamma40, sstim-v:mechASSR,
        sstim-v:mechAuditoryMotor, sstim-v:mechClosedLoopPhase, sstim-v:mechMasking,
        sstim-v:mechMechanoreceptive, sstim-v:mechStartle, sstim-v:mechUltrasonic,
        sstim-v:mechSSVEP, sstim-v:mechSSSEP, sstim-v:mechMultisensory .

sstim-v:mechFFR a owl:NamedIndividual, sstim:StimulationMechanism, skos:Concept ;
    skos:inScheme sstim-v:StimulationMechanismScheme ;
    skos:prefLabel "Frequency-Following Response"@en,
                   "Risposta di Inseguimento della Frequenza"@it,
                   "Resposta de Seguimento de Frequência"@pt,
                   "Respuesta de Seguimiento de Frecuencia"@es ;
    skos:notation "FFR" ;
    skos:definition "Subcortical brainstem and inferior colliculus response that tracks the envelope of a periodic acoustic stimulus. Best-supported mechanistic claim for binaural beats and isochronic tones."@en .

sstim-v:mechThalamocortical a owl:NamedIndividual, sstim:StimulationMechanism, skos:Concept ;
    skos:inScheme sstim-v:StimulationMechanismScheme ;
    skos:prefLabel "Thalamocortical Entrainment"@en,
                   "Trascinamento Talamocorticale"@it,
                   "Arrastamento Talamocortical"@pt,
                   "Arrastre Talamocortical"@es ;
    skos:notation "THALCORT" ;
    skos:definition "Proposed propagation of frequency-following response from subcortical centers to cortical oscillatory networks via thalamocortical loops. More contested than subcortical FFR."@en .

sstim-v:mechAutonomic a owl:NamedIndividual, sstim:StimulationMechanism, skos:Concept ;
    skos:inScheme sstim-v:StimulationMechanismScheme ;
    skos:prefLabel "Autonomic Respiratory Entrainment"@en,
                   "Trascinamento Respiratorio Autonomo"@it,
                   "Arrastamento Respiratório Autonômico"@pt,
                   "Arrastre Respiratorio Autonómico"@es ;
    skos:notation "AUTONOMIC" ;
    skos:definition "Paced breathing at resonance frequency modulates respiratory sinus arrhythmia (RSA) and HRV via baroreflex. Primary mechanism for Martigli breathing oscillation. Evidence base: Lehrer & Gevirtz (2014), Zaccaro et al. (2018)."@en .

sstim-v:mechStochastic a owl:NamedIndividual, sstim:StimulationMechanism, skos:Concept ;
    skos:inScheme sstim-v:StimulationMechanismScheme ;
    skos:prefLabel "Stochastic Resonance"@en,
                   "Risonanza Stocastica"@it,
                   "Ressonância Estocástica"@pt,
                   "Resonancia Estocástica"@es ;
    skos:notation "SR" ;
    skos:definition "Calibrated noise improves subthreshold signal detection via threshold dynamics. Not entrainment; no periodic forcing required."@en .

sstim-v:mechAttentional a owl:NamedIndividual, sstim:StimulationMechanism, skos:Concept ;
    skos:inScheme sstim-v:StimulationMechanismScheme ;
    skos:prefLabel "Attentional Anchoring"@en,
                   "Ancoraggio Attentivo"@it,
                   "Ancoragem Atencional"@pt,
                   "Anclaje Atencional"@es ;
    skos:notation "ATTN" ;
    skos:definition "Structured but undemanding sensory content occupies default mode network processing, reducing mind-wandering without requiring executive attention. Proposed mechanism for ambient Symmetry voices."@en .

sstim-v:mechGamma40 a owl:NamedIndividual, sstim:StimulationMechanism, skos:Concept ;
    skos:inScheme sstim-v:StimulationMechanismScheme ;
    skos:prefLabel "Gamma-40 Neuroimmune Modulation"@en,
                   "Modulazione Neuroimmune Gamma-40"@it,
                   "Modulação Neuroimune Gama-40"@pt,
                   "Modulación Neuroinmune Gamma-40"@es ;
    skos:notation "GAMMA40NI" ;
    skos:definition "Proposed mechanism from GENUS/Iaccarino literature: 40 Hz multisensory entrainment triggers microglial activation and amyloid clearance. Preclinical evidence in mice; early human studies ongoing. Contested and modality-specific (primarily visual in original studies)."@en .


sstim-v:mechASSR a owl:NamedIndividual, sstim:StimulationMechanism, skos:Concept ;
    skos:inScheme sstim-v:StimulationMechanismScheme ;
    skos:prefLabel "Auditory Steady-State Response"@en,
                   "Risposta Uditiva di Stato Stazionario"@it,
                   "Resposta Auditiva de Estado Estacionário"@pt,
                   "Respuesta Auditiva de Estado Estacionario"@es ;
    skos:notation "ASSR" ;
    skos:definition "Sustained, phase-locked EEG/MEG response to a periodically modulated sound (amplitude-modulated tones, click trains, isochronic tones), most robust near 40 Hz. The canonical electrophysiological correlate of auditory entrainment; related to but distinct from the subcortical Frequency-Following Response."@en .

sstim-v:mechAuditoryMotor a owl:NamedIndividual, sstim:StimulationMechanism, skos:Concept ;
    skos:inScheme sstim-v:StimulationMechanismScheme ;
    skos:prefLabel "Auditory-Motor Coupling"@en,
                   "Accoppiamento Uditivo-Motorio"@it,
                   "Acoplamento Áudio-Motor"@pt,
                   "Acoplamiento Audio-Motor"@es ;
    skos:notation "AUDMOT" ;
    skos:definition "Synchronization of movement timing and motor-cortical activity to an external auditory beat (beat-based timing, sensorimotor synchronization). Primary proposed mechanism for rhythmic auditory cueing of gait and cadence."@en .

sstim-v:mechClosedLoopPhase a owl:NamedIndividual, sstim:StimulationMechanism, skos:Concept ;
    skos:inScheme sstim-v:StimulationMechanismScheme ;
    skos:prefLabel "Phase-Targeted Closed-Loop Reinforcement"@en,
                   "Rinforzo a Circuito Chiuso Mirato alla Fase"@it,
                   "Reforço em Malha Fechada Direcionado à Fase"@pt,
                   "Refuerzo en Lazo Cerrado Dirigido a la Fase"@es ;
    skos:notation "CLPHASE" ;
    skos:definition "Delivery of a stimulus time-locked to a measured phase of an ongoing endogenous oscillation (e.g. sound bursts at the up-phase of sleep slow oscillations) to reinforce that rhythm. Requires real-time sensing; the basis of closed-loop auditory stimulation."@en .

sstim-v:mechMasking a owl:NamedIndividual, sstim:StimulationMechanism, skos:Concept ;
    skos:inScheme sstim-v:StimulationMechanismScheme ;
    skos:prefLabel "Auditory Masking and Lateral Inhibition"@en,
                   "Mascheramento Uditivo e Inibizione Laterale"@it,
                   "Mascaramento Auditivo e Inibição Lateral"@pt,
                   "Enmascaramiento Auditivo e Inhibición Lateral"@es ;
    skos:notation "MASK" ;
    skos:definition "Reduction of the perceptual salience of a target sound (or tinnitus percept) by overlapping or spectrally shaped sound, and reshaping of tonotopic activity via lateral inhibition. Proposed basis for masking and notched-sound approaches."@en .

sstim-v:mechMechanoreceptive a owl:NamedIndividual, sstim:StimulationMechanism, skos:Concept ;
    skos:inScheme sstim-v:StimulationMechanismScheme ;
    skos:prefLabel "Vibrotactile Mechanoreceptor Activation"@en,
                   "Attivazione dei Meccanocettori Vibrotattili"@it,
                   "Ativação de Mecanorreceptores Vibrotáteis"@pt,
                   "Activación de Mecanorreceptores Vibrotáctiles"@es ;
    skos:notation "MECHANO" ;
    skos:definition "Activation of skin and deep-tissue mechanoreceptors (e.g. Pacinian corpuscles) by low-frequency vibration delivered through body transducers. Couples a somatosensory pathway alongside any auditory percept; primary mechanism for vibroacoustic stimulation."@en .

sstim-v:mechStartle a owl:NamedIndividual, sstim:StimulationMechanism, skos:Concept ;
    skos:inScheme sstim-v:StimulationMechanismScheme ;
    skos:prefLabel "Acoustic Startle Reflex"@en,
                   "Riflesso di Trasalimento Acustico"@it,
                   "Reflexo de Sobressalto Acústico"@pt,
                   "Reflejo de Sobresalto Acústico"@es ;
    skos:notation "STARTLE" ;
    skos:definition "A fast brainstem-mediated motor reflex to an intense, abrupt sound, and its modulation (e.g. prepulse inhibition). Used mainly as a research/clinical probe of sensorimotor gating rather than as a wellness stimulus."@en .

sstim-v:mechUltrasonic a owl:NamedIndividual, sstim:StimulationMechanism, skos:Concept ;
    skos:inScheme sstim-v:StimulationMechanismScheme ;
    skos:prefLabel "Ultrasonic Mechanical Neuromodulation"@en,
                   "Neuromodulazione Meccanica Ultrasonica"@it,
                   "Neuromodulação Mecânica Ultrassônica"@pt,
                   "Neuromodulación Mecánica Ultrasónica"@es ;
    skos:notation "USND" ;
    skos:definition "Modulation of neural activity by focused ultrasound via acoustic radiation force and mechanosensitive ion channels, without an audible percept. A genuine neuromodulation modality included for domain completeness; not ordinary auditory stimulation and not consumer-platform deliverable."@en .

# Steady-state evoked-potential family — visual and somatosensory counterparts of
# mechASSR — plus cross-modal integration (ADR 0015).
sstim-v:mechSSVEP a owl:NamedIndividual, sstim:StimulationMechanism, skos:Concept ;
    skos:inScheme sstim-v:StimulationMechanismScheme ;
    skos:prefLabel "Steady-State Visual Evoked Potential"@en,
                   "Potenziale Evocato Visivo di Stato Stazionario"@it,
                   "Potencial Evocado Visual de Estado Estacionário"@pt,
                   "Potencial Evocado Visual de Estado Estacionario"@es ;
    skos:notation "SSVEP" ;
    skos:definition "Sustained, phase-locked occipital EEG response to a periodically flickering visual stimulus — the visual counterpart of the ASSR and the canonical electrophysiological correlate of photic driving. A measurable response; downstream cognitive or wellness effects of driving it are less certain."@en .

sstim-v:mechSSSEP a owl:NamedIndividual, sstim:StimulationMechanism, skos:Concept ;
    skos:inScheme sstim-v:StimulationMechanismScheme ;
    skos:prefLabel "Steady-State Somatosensory Evoked Potential"@en,
                   "Potenziale Evocato Somatosensoriale di Stato Stazionario"@it,
                   "Potencial Evocado Somatossensorial de Estado Estacionário"@pt,
                   "Potencial Evocado Somatosensorial de Estado Estacionario"@es ;
    skos:notation "SSSEP" ;
    skos:definition "Sustained, phase-locked cortical response to periodic vibrotactile stimulation — the somatosensory counterpart of the ASSR and SSVEP. The electrophysiological correlate of vibrotactile entrainment; a measurable response whose downstream effects remain under study."@en .

sstim-v:mechMultisensory a owl:NamedIndividual, sstim:StimulationMechanism, skos:Concept ;
    skos:inScheme sstim-v:StimulationMechanismScheme ;
    skos:prefLabel "Multisensory Integration"@en,
                   "Integrazione Multisensoriale"@it,
                   "Integração Multissensorial"@pt,
                   "Integración Multisensorial"@es ;
    skos:notation "MULTISENS" ;
    skos:definition "Convergence and mutual enhancement of temporally congruent inputs across modalities (e.g. light and sound pulsed at the same rate), which can yield a larger or more reliable response than any single modality. Proposed basis for audiovisual and audio-tactile entrainment; the GENUS multisensory-over-unisensory finding rests on it. Contested in magnitude and modality-specific."@en .


###########################################################################
# Part 8 — Permutation Function Scheme
###########################################################################

sstim-v:PermutationFunctionScheme a skos:ConceptScheme ;
    skos:prefLabel "BSC Symmetry Permutation Function Vocabulary"@en ;
    skos:hasTopConcept sstim-v:permShuffle, sstim-v:permRotateForward,
        sstim-v:permRotateBackward, sstim-v:permReverse, sstim-v:permIdentity .

sstim-v:permShuffle a owl:NamedIndividual, sstim:PermutationFunction, skos:Concept ;
    skos:inScheme sstim-v:PermutationFunctionScheme ;
    skos:prefLabel "Shuffle"@en, "Shuffle"@it, "Shuffle"@pt, "Shuffle"@es ;
    skos:notation "0" ;
    skos:definition "Uniform random permutation (Fisher-Yates) at each cycle boundary. Maximum cross-cycle unpredictability. Highest cognitive engagement."@en .

sstim-v:permRotateForward a owl:NamedIndividual, sstim:PermutationFunction, skos:Concept ;
    skos:inScheme sstim-v:PermutationFunctionScheme ;
    skos:prefLabel "Rotate Forward"@en, "Rotazione in Avanti"@it,
                   "Rotação para Frente"@pt, "Rotación hacia Adelante"@es ;
    skos:notation "1" ;
    skos:definition "Cyclic left shift at each cycle boundary. Systematic upward pitch drift over N cycles."@en .

sstim-v:permRotateBackward a owl:NamedIndividual, sstim:PermutationFunction, skos:Concept ;
    skos:inScheme sstim-v:PermutationFunctionScheme ;
    skos:prefLabel "Rotate Backward"@en, "Rotazione all'Indietro"@it,
                   "Rotação para Trás"@pt, "Rotación hacia Atrás"@es ;
    skos:notation "2" ;
    skos:definition "Cyclic right shift. Systematic downward pitch drift over N cycles."@en .

sstim-v:permReverse a owl:NamedIndividual, sstim:PermutationFunction, skos:Concept ;
    skos:inScheme sstim-v:PermutationFunctionScheme ;
    skos:prefLabel "Reverse"@en, "Inversione"@it, "Inversão"@pt, "Inversión"@es ;
    skos:notation "3" ;
    skos:definition "Alternating reversal — ascending and descending passes alternate with period 2 cycles."@en .

sstim-v:permIdentity a owl:NamedIndividual, sstim:PermutationFunction, skos:Concept ;
    skos:inScheme sstim-v:PermutationFunctionScheme ;
    skos:prefLabel "Identity"@en, "Identità"@it, "Identidade"@pt, "Identidad"@es ;
    skos:notation "4" ;
    skos:definition "No permutation. Pure repetition. Lowest cognitive engagement; habituation risk for long sessions."@en .


###########################################################################
# Part 9 — Caution Tag Scheme
###########################################################################

sstim-v:CautionTagScheme a skos:ConceptScheme ;
    skos:prefLabel "BSC Preset Caution Tag Vocabulary"@en ;
    skos:hasTopConcept sstim-v:cautionEpilepsyRisk, sstim-v:cautionStimulating,
        sstim-v:cautionDrowsyUse, sstim-v:cautionDrivingUnsafe, sstim-v:cautionNighttimeOnly,
        sstim-v:cautionFatigueSensitive, sstim-v:cautionEmotionallySensitive,
        sstim-v:cautionHighIntensity, sstim-v:cautionAdvancedUser,
        sstim-v:cautionOverloadSensitive, sstim-v:cautionUltraSlowBreathing .

sstim-v:cautionEpilepsyRisk a owl:NamedIndividual, sstim:CautionTag, skos:Concept ;
    skos:inScheme sstim-v:CautionTagScheme ;
    skos:prefLabel "Epilepsy Risk"@en, "Rischio di Epilessia"@it,
                   "Risco de Epilepsia"@pt, "Riesgo de Epilepsia"@es ;
    skos:notation "epilepsy-risk" ;
    skos:definition "Preset uses strobing visual stimulation; not safe for users with photosensitive epilepsy."@en .

sstim-v:cautionStimulating a owl:NamedIndividual, sstim:CautionTag, skos:Concept ;
    skos:inScheme sstim-v:CautionTagScheme ;
    skos:prefLabel "Stimulating"@en, "Stimolante"@it, "Estimulante"@pt, "Estimulante"@es ;
    skos:notation "stimulating" ;
    skos:definition "Activating preset; may not be suitable near sleep time."@en .

sstim-v:cautionDrowsyUse a owl:NamedIndividual, sstim:CautionTag, skos:Concept ;
    skos:inScheme sstim-v:CautionTagScheme ;
    skos:prefLabel "Drowsy Use"@en, "Uso in Sonnolenza"@it,
                   "Uso com Sonolência"@pt, "Uso con Somnolencia"@es ;
    skos:notation "drowsy-use" ;
    skos:definition "Produces drowsiness; unsafe while driving or operating machinery."@en .

sstim-v:cautionDrivingUnsafe a owl:NamedIndividual, sstim:CautionTag, skos:Concept ;
    skos:inScheme sstim-v:CautionTagScheme ;
    skos:prefLabel "Driving Unsafe"@en, "Non Sicuro alla Guida"@it,
                   "Inseguro ao Dirigir"@pt, "Inseguro al Conducir"@es ;
    skos:notation "driving-unsafe" ;
    skos:definition "Do not use while operating vehicles."@en .

sstim-v:cautionNighttimeOnly a owl:NamedIndividual, sstim:CautionTag, skos:Concept ;
    skos:inScheme sstim-v:CautionTagScheme ;
    skos:prefLabel "Nighttime Only"@en, "Solo Notturno"@it,
                   "Apenas à Noite"@pt, "Solo Nocturno"@es ;
    skos:notation "nighttime-only" ;
    skos:definition "Should only be used before sleep."@en .

sstim-v:cautionFatigueSensitive a owl:NamedIndividual, sstim:CautionTag, skos:Concept ;
    skos:inScheme sstim-v:CautionTagScheme ;
    skos:prefLabel "Fatigue Sensitive"@en, "Sensibile alla Fatica"@it,
                   "Sensível à Fadiga"@pt, "Sensible a la Fatiga"@es ;
    skos:notation "fatigue-sensitive" ;
    skos:definition "May increase fatigue in susceptible users."@en .

sstim-v:cautionEmotionallySensitive a owl:NamedIndividual, sstim:CautionTag, skos:Concept ;
    skos:inScheme sstim-v:CautionTagScheme ;
    skos:prefLabel "Emotionally Sensitive"@en, "Sensibile Emotivamente"@it,
                   "Sensível Emocionalmente"@pt, "Sensible Emocionalmente"@es ;
    skos:notation "emotionally-sensitive" ;
    skos:definition "May surface strong emotional responses."@en .

sstim-v:cautionHighIntensity a owl:NamedIndividual, sstim:CautionTag, skos:Concept ;
    skos:inScheme sstim-v:CautionTagScheme ;
    skos:prefLabel "High Intensity"@en, "Alta Intensità"@it,
                   "Alta Intensidade"@pt, "Alta Intensidad"@es ;
    skos:notation "high-intensity" ;
    skos:definition "Strong or overwhelming sensory impact; may not be suitable for first-time users."@en .

sstim-v:cautionAdvancedUser a owl:NamedIndividual, sstim:CautionTag, skos:Concept ;
    skos:inScheme sstim-v:CautionTagScheme ;
    skos:prefLabel "Advanced User"@en, "Utente Avanzato"@it,
                   "Usuário Avançado"@pt, "Usuario Avanzado"@es ;
    skos:notation "advanced-use" ;
    skos:definition "Not recommended as a first BSC experience."@en .

sstim-v:cautionOverloadSensitive a owl:NamedIndividual, sstim:CautionTag, skos:Concept ;
    skos:inScheme sstim-v:CautionTagScheme ;
    skos:prefLabel "Overload Sensitive"@en, "Sensibile al Sovraccarico"@it,
                   "Sensível à Sobrecarga"@pt, "Sensible a la Sobrecarga"@es ;
    skos:notation "overload-sensitive" ;
    skos:definition "May be too intense for sensory-sensitive users."@en .

sstim-v:cautionUltraSlowBreathing a owl:NamedIndividual, sstim:CautionTag, skos:Concept ;
    skos:inScheme sstim-v:CautionTagScheme ;
    skos:prefLabel "Ultra-Slow Breathing"@en, "Respirazione Ultra-Lenta"@it,
                   "Respiração Ultra-Lenta"@pt, "Respiración Ultra-Lenta"@es ;
    skos:notation "ultra-slow-breathing" ;
    skos:definition "Very slow breathing parameters (< 3 bpm). Consult physician if respiratory conditions are present."@en .

###########################################################################
# Part 10 — Stimulus Temporal Structure Scheme
#
# Formalizes the value list already stated in the skos:definition of
# sstim:StimulusTemporalStructure (sstim-core.ttl). Dual-typed so that
# sstim:hasStimulusTemporalStructure (range sstim:StimulusTemporalStructure)
# can be range-validated without RDFS inference.
###########################################################################

sstim-v:StimulusTemporalStructureScheme a skos:ConceptScheme ;
    skos:prefLabel "SSTIM Stimulus Temporal Structure Vocabulary"@en ;
    skos:hasTopConcept sstim-v:temporalPeriodic, sstim-v:temporalQuasiPeriodic,
                       sstim-v:temporalAperiodic, sstim-v:temporalAdaptive .

sstim-v:temporalPeriodic a owl:NamedIndividual, sstim:StimulusTemporalStructure, skos:Concept ;
    skos:inScheme sstim-v:StimulusTemporalStructureScheme ;
    skos:topConceptOf sstim-v:StimulusTemporalStructureScheme ;
    skos:prefLabel "Periodic"@en, "Periodico"@it, "Periódico"@pt, "Periódico"@es ;
    skos:notation "periodic" ;
    skos:definition "A stimulus repeating at a fixed period, e.g. an isochronic pulse train or a steady binaural beat."@en .

sstim-v:temporalQuasiPeriodic a owl:NamedIndividual, sstim:StimulusTemporalStructure, skos:Concept ;
    skos:inScheme sstim-v:StimulusTemporalStructureScheme ;
    skos:topConceptOf sstim-v:StimulusTemporalStructureScheme ;
    skos:prefLabel "Quasi-Periodic"@en, "Quasi-periodico"@it, "Quase-periódico"@pt, "Casi-periódico"@es ;
    skos:notation "quasi-periodic" ;
    skos:definition "A stimulus that is nearly periodic but slowly modulated, e.g. a Martigli sweep whose breathing period decelerates over the session."@en .

sstim-v:temporalAperiodic a owl:NamedIndividual, sstim:StimulusTemporalStructure, skos:Concept ;
    skos:inScheme sstim-v:StimulusTemporalStructureScheme ;
    skos:topConceptOf sstim-v:StimulusTemporalStructureScheme ;
    skos:prefLabel "Aperiodic"@en, "Aperiodico"@it, "Aperiódico"@pt, "Aperiódico"@es ;
    skos:notation "aperiodic" ;
    skos:definition "A stimulus with no repeating period, e.g. calibrated noise for stochastic resonance or a shuffled Symmetry sequence."@en .

sstim-v:temporalAdaptive a owl:NamedIndividual, sstim:StimulusTemporalStructure, skos:Concept ;
    skos:inScheme sstim-v:StimulusTemporalStructureScheme ;
    skos:topConceptOf sstim-v:StimulusTemporalStructureScheme ;
    skos:prefLabel "Adaptive"@en, "Adattivo"@it, "Adaptativo"@pt, "Adaptativo"@es ;
    skos:notation "adaptive" ;
    skos:definition "A closed-loop stimulus whose temporal structure is adjusted in response to a measured signal. Outside current BSC delivery scope; reserved for future biofeedback-driven implementations."@en .


###########################################################################
# Part 11 — Sensory Stimulation Technique Scheme
#
# A vendor-neutral controlled vocabulary of auditory and cross-modal
# sensory stimulation techniques. Each concept is dual-typed as a
# skos:Concept and an instance of sstim:SensoryStimulationTechnique (and,
# where the entrainment status is unambiguous, of sstim:EntrainmentBasedTechnique
# or sstim:NonEntrainmentTechnique — which are disjoint). Techniques carry
# their proposed mechanism (sstim:proposedMechanism), temporal structure
# (sstim:hasStimulusTemporalStructure), and delivery modality
# (sstim:techniqueModality). skos:scopeNote records neutral evidence/fit
# notes; no vendor- or product-specific judgements belong here.
###########################################################################

sstim-v:TechniqueScheme a skos:ConceptScheme ;
    skos:prefLabel "SSTIM Sensory Stimulation Technique Vocabulary"@en ,
                   "Vocabolario delle Tecniche di Stimolazione Sensoriale SSTIM"@it ,
                   "Vocabulário de Técnicas de Estimulação Sensorial SSTIM"@pt ,
                   "Vocabulario de Técnicas de Estimulación Sensorial SSTIM"@es ;
    skos:hasTopConcept sstim-v:techAmplitudeModulation, sstim-v:techClickTrain,
        sstim-v:techIsochronicTones, sstim-v:techMonauralBeats, sstim-v:techBinauralBeats,
        sstim-v:techFrequencyModulation, sstim-v:techGamma40Auditory,
        sstim-v:techRhythmicAuditoryCueing, sstim-v:techFractalRhythm,
        sstim-v:techMusicStructural, sstim-v:techBroadbandNoise, sstim-v:techNotchedSound,
        sstim-v:techSpatialAuditory, sstim-v:techClosedLoopAuditory, sstim-v:techSonification,
        sstim-v:techRoughness, sstim-v:techAuditoryIllusion, sstim-v:techASMR,
        sstim-v:techVoiceMantra, sstim-v:techVibroacoustic, sstim-v:techUltrasoundNeuromod,
        sstim-v:techAcousticStartle, sstim-v:techReferencePitchRetuning, sstim-v:techSubliminalAudio,
        sstim-v:techPhoticDriving, sstim-v:techAudiovisualEntrainment,
        sstim-v:techColorFieldStimulation, sstim-v:techVibrotactileEntrainment,
        sstim-v:techAudioTactile .

# ── Periodic auditory entrainment ───────────────────────────────────────

sstim-v:techAmplitudeModulation a owl:NamedIndividual, sstim:EntrainmentBasedTechnique, skos:Concept ;
    skos:inScheme sstim-v:TechniqueScheme ;
    skos:prefLabel "Amplitude-Modulated Tone/Noise Stimulation"@en,
                   "Stimolazione con Toni/Rumore a Modulazione di Ampiezza"@it,
                   "Estimulação com Tons/Ruído Modulados em Amplitude"@pt,
                   "Estimulación con Tonos/Ruido Modulados en Amplitud"@es ;
    skos:notation "amplitude-modulation" ;
    skos:definition "A carrier tone or noise whose amplitude (loudness) is sinusoidally modulated at a target rate. The canonical stimulus for evoking auditory steady-state responses at the modulation frequency."@en ;
    skos:scopeNote "Well-established ASSR/entrainment stimulus; the modulation rate, not the carrier, sets the response frequency."@en ;
    sstim:proposedMechanism sstim-v:mechASSR, sstim-v:mechFFR ;
    sstim:hasStimulusTemporalStructure sstim-v:temporalPeriodic ;
    sstim:techniqueModality sstim-v:modalityAuditory .

sstim-v:techClickTrain a owl:NamedIndividual, sstim:EntrainmentBasedTechnique, skos:Concept ;
    skos:inScheme sstim-v:TechniqueScheme ;
    skos:prefLabel "Click / Pulse Train Stimulation"@en,
                   "Stimolazione con Treni di Click/Impulsi"@it,
                   "Estimulação com Trens de Cliques/Pulsos"@pt,
                   "Estimulación con Trenes de Clics/Pulsos"@es ;
    skos:notation "click-train" ;
    skos:definition "Repeated short impulses (clicks, ticks, grains) presented at a target rate to drive steady-state responses."@en ;
    skos:scopeNote "Strong for probing entrainment, but clicks are perceptually salient and can become fatiguing relative to smoother stimuli."@en ;
    sstim:proposedMechanism sstim-v:mechASSR, sstim-v:mechFFR ;
    sstim:hasStimulusTemporalStructure sstim-v:temporalPeriodic ;
    sstim:techniqueModality sstim-v:modalityAuditory .

sstim-v:techIsochronicTones a owl:NamedIndividual, sstim:EntrainmentBasedTechnique, skos:Concept ;
    skos:inScheme sstim-v:TechniqueScheme ;
    skos:prefLabel "Isochronic Tone Stimulation"@en,
                   "Stimolazione con Toni Isocroni"@it,
                   "Estimulação com Tons Isócronos"@pt,
                   "Estimulación con Tonos Isócronos"@es ;
    skos:notation "isochronic-tones" ;
    skos:definition "A single tone switched on and off at evenly spaced intervals (a gated pulse train) at a target rate; a monaural, single-channel entrainment stimulus."@en ;
    sstim:proposedMechanism sstim-v:mechFFR, sstim-v:mechASSR ;
    sstim:hasStimulusTemporalStructure sstim-v:temporalPeriodic ;
    sstim:techniqueModality sstim-v:modalityAuditory ;
    skos:related sstim-v:voiceSymmetry .

sstim-v:techMonauralBeats a owl:NamedIndividual, sstim:EntrainmentBasedTechnique, skos:Concept ;
    skos:inScheme sstim-v:TechniqueScheme ;
    skos:prefLabel "Monaural Beat Stimulation"@en,
                   "Stimolazione con Battimenti Monoaurali"@it,
                   "Estimulação com Batimentos Monoauriculares"@pt,
                   "Estimulación con Pulsaciones Monoaurales"@es ;
    skos:notation "monaural-beats" ;
    skos:definition "Two close-frequency tones summed in a single channel, producing a physically present amplitude beat at their difference frequency. Distinct from binaural beats, where the beat is a neural construct from dichotic presentation."@en ;
    sstim:proposedMechanism sstim-v:mechFFR, sstim-v:mechASSR ;
    sstim:hasStimulusTemporalStructure sstim-v:temporalPeriodic ;
    sstim:techniqueModality sstim-v:modalityAuditory ;
    skos:related sstim-v:techBinauralBeats .

sstim-v:techBinauralBeats a owl:NamedIndividual, sstim:EntrainmentBasedTechnique, skos:Concept ;
    skos:inScheme sstim-v:TechniqueScheme ;
    skos:prefLabel "Binaural Beat Stimulation"@en,
                   "Stimolazione con Battimenti Binaurali"@it,
                   "Estimulação com Batimentos Binaurais"@pt,
                   "Estimulación con Pulsaciones Binaurales"@es ;
    skos:notation "binaural-beats" ;
    skos:definition "Two sine tones at slightly different frequencies presented dichotically (one per ear), producing a perceived beat at their difference frequency that arises centrally rather than in the air."@en ;
    skos:scopeNote "The most-studied consumer auditory-entrainment technique; effects on EEG and state are reported but mixed across studies."@en ;
    sstim:proposedMechanism sstim-v:mechFFR, sstim-v:mechThalamocortical ;
    sstim:hasStimulusTemporalStructure sstim-v:temporalPeriodic ;
    sstim:techniqueModality sstim-v:modalityAuditory ;
    skos:related sstim-v:voiceBinaural, sstim-v:techMonauralBeats .

sstim-v:techFrequencyModulation a owl:NamedIndividual, sstim:SensoryStimulationTechnique, skos:Concept ;
    skos:inScheme sstim-v:TechniqueScheme ;
    skos:prefLabel "Frequency-Modulated Tone / Chirp / Glide Stimulation"@en,
                   "Stimolazione con Toni a Modulazione di Frequenza/Glissati"@it,
                   "Estimulação com Tons Modulados em Frequência/Glissandos"@pt,
                   "Estimulación con Tonos Modulados en Frecuencia/Glissandos"@es ;
    skos:notation "frequency-modulation" ;
    skos:definition "A tone whose pitch sweeps over time — vibrato, chirps, adaptive glissandi. Spans both fast modulation (which can evoke frequency-following responses) and slow, breathing-rate modulation (which engages autonomic rather than entrainment pathways)."@en ;
    skos:scopeNote "Typed as the generic technique because entrainment status depends on rate. Slow breathing-paced FM should be distinguished from non-breathing FM voices."@en ;
    sstim:proposedMechanism sstim-v:mechFFR, sstim-v:mechAutonomic ;
    sstim:hasStimulusTemporalStructure sstim-v:temporalQuasiPeriodic ;
    sstim:techniqueModality sstim-v:modalityAuditory ;
    skos:related sstim-v:voiceMartigli .

sstim-v:techGamma40Auditory a owl:NamedIndividual, sstim:EntrainmentBasedTechnique, skos:Concept ;
    skos:inScheme sstim-v:TechniqueScheme ;
    skos:prefLabel "40 Hz Auditory Gamma Stimulation"@en,
                   "Stimolazione Gamma Uditiva a 40 Hz"@it,
                   "Estimulação Gama Auditiva de 40 Hz"@pt,
                   "Estimulación Gamma Auditiva de 40 Hz"@es ;
    skos:notation "gamma-40-auditory" ;
    skos:definition "Auditory entrainment specifically at 40 Hz — 40 Hz clicks, amplitude-modulated tones, or noise — associated with the GENUS neuroimmune research lineage."@en ;
    skos:scopeNote "Human auditory-only evidence is limited; the stronger findings are preclinical and multisensory. Frame as gamma/auditory support or research-facing, not as a treatment for any condition."@en ;
    sstim:proposedMechanism sstim-v:mechGamma40, sstim-v:mechASSR ;
    sstim:hasStimulusTemporalStructure sstim-v:temporalPeriodic ;
    sstim:techniqueModality sstim-v:modalityAuditory ;
    skos:related sstim-v:gamma40 .

# ── Rhythmic / musical ──────────────────────────────────────────────────

sstim-v:techRhythmicAuditoryCueing a owl:NamedIndividual, sstim:EntrainmentBasedTechnique, skos:Concept ;
    skos:inScheme sstim-v:TechniqueScheme ;
    skos:prefLabel "Rhythmic Auditory Cueing"@en,
                   "Stimolazione Ritmica Uditiva"@it,
                   "Estimulação Auditiva Rítmica"@pt,
                   "Estimulación Auditiva Rítmica"@es ;
    skos:notation "rhythmic-auditory-cueing" ;
    skos:definition "A metronome, drum, footstep, or music-based beat used to entrain movement timing and cadence (rhythmic auditory stimulation, RAS)."@en ;
    skos:scopeNote "Well studied for gait, notably Parkinsonian gait; relevant to movement, walking, and rehabilitation-adjacent uses."@en ;
    sstim:proposedMechanism sstim-v:mechAuditoryMotor ;
    sstim:hasStimulusTemporalStructure sstim-v:temporalPeriodic ;
    sstim:techniqueModality sstim-v:modalityAuditory .

sstim-v:techFractalRhythm a owl:NamedIndividual, sstim:NonEntrainmentTechnique, skos:Concept ;
    skos:inScheme sstim-v:TechniqueScheme ;
    skos:prefLabel "Fractal / Stochastic Rhythmic Stimulation"@en,
                   "Stimolazione Ritmica Frattale/Stocastica"@it,
                   "Estimulação Rítmica Fractal/Estocástica"@pt,
                   "Estimulación Rítmica Fractal/Estocástica"@es ;
    skos:notation "fractal-rhythm" ;
    skos:definition "Rhythms with long-range (1/f) correlated variability rather than rigid periodicity, often used to evoke a more natural sense of timing in movement cueing."@en ;
    skos:scopeNote "Recent gait-cueing work distinguishes regular beats from fractal variability; less direct as brainwave entrainment."@en ;
    sstim:proposedMechanism sstim-v:mechAuditoryMotor ;
    sstim:hasStimulusTemporalStructure sstim-v:temporalAperiodic ;
    sstim:techniqueModality sstim-v:modalityAuditory ;
    skos:related sstim-v:techRhythmicAuditoryCueing .

sstim-v:techMusicStructural a owl:NamedIndividual, sstim:EntrainmentBasedTechnique, skos:Concept ;
    skos:inScheme sstim-v:TechniqueScheme ;
    skos:prefLabel "Music-Structural Entrainment"@en,
                   "Trascinamento Strutturale Musicale"@it,
                   "Arrastamento Estrutural Musical"@pt,
                   "Arrastre Estructural Musical"@es ;
    skos:notation "music-structural" ;
    skos:definition "Entrainment to the higher-order structure of music — tempo, meter, groove, harmonic rhythm, and phrase cycles — rather than to a single modulation frequency."@en ;
    skos:scopeNote "High experiential value; less precise as EEG-band stimulation. Typically a musical layer around clearer entrainment voices."@en ;
    sstim:proposedMechanism sstim-v:mechAuditoryMotor, sstim-v:mechAttentional ;
    sstim:hasStimulusTemporalStructure sstim-v:temporalQuasiPeriodic ;
    sstim:techniqueModality sstim-v:modalityAuditory .

# ── Noise / spectral ────────────────────────────────────────────────────

sstim-v:techBroadbandNoise a owl:NamedIndividual, sstim:NonEntrainmentTechnique, skos:Concept ;
    skos:inScheme sstim-v:TechniqueScheme ;
    skos:prefLabel "Broadband / Colored-Noise Stimulation"@en,
                   "Stimolazione con Rumore a Banda Larga/Colorato"@it,
                   "Estimulação com Ruído de Banda Larga/Colorido"@pt,
                   "Estimulación con Ruido de Banda Ancha/Coloreado"@es ;
    skos:notation "broadband-noise" ;
    skos:definition "White, pink, or brown noise presented as a continuous broadband stimulus; a vehicle for stochastic resonance and for masking."@en ;
    sstim:proposedMechanism sstim-v:mechStochastic, sstim-v:mechMasking ;
    sstim:hasStimulusTemporalStructure sstim-v:temporalAperiodic ;
    sstim:techniqueModality sstim-v:modalityAuditory .

sstim-v:techNotchedSound a owl:NamedIndividual, sstim:NonEntrainmentTechnique, skos:Concept ;
    skos:inScheme sstim-v:TechniqueScheme ;
    skos:prefLabel "Notched / Gapped Sound Stimulation"@en,
                   "Stimolazione con Suono a Tacca/Intervallato"@it,
                   "Estimulação com Som Entalhado/Com Lacunas"@pt,
                   "Estimulación con Sonido con Muesca/Intervalado"@es ;
    skos:notation "notched-sound" ;
    skos:definition "Music or noise with a spectral notch removed around a target frequency, or otherwise spectrally tailored for masking and residual inhibition; associated with tinnitus-oriented sound approaches."@en ;
    skos:scopeNote "Condition-specific (tinnitus); evidence is mixed and claims need care. Not a generic wellness soundscape."@en ;
    sstim:proposedMechanism sstim-v:mechMasking ;
    sstim:hasStimulusTemporalStructure sstim-v:temporalAperiodic ;
    sstim:techniqueModality sstim-v:modalityAuditory .

# ── Spatial ─────────────────────────────────────────────────────────────

sstim-v:techSpatialAuditory a owl:NamedIndividual, sstim:NonEntrainmentTechnique, skos:Concept ;
    skos:inScheme sstim-v:TechniqueScheme ;
    skos:prefLabel "Spatial / Dichotic Auditory Stimulation"@en,
                   "Stimolazione Uditiva Spaziale/Dicotica"@it,
                   "Estimulação Auditiva Espacial/Dicótica"@pt,
                   "Estimulación Auditiva Espacial/Dicótica"@es ;
    skos:notation "spatial-auditory" ;
    skos:definition "Structured spatial trajectories of sound — HRTF motion, orbiting sources, lateral sweeps, dichotic streams, spatial alternation — rather than simple left/right crossfades."@en ;
    sstim:proposedMechanism sstim-v:mechAttentional ;
    sstim:hasStimulusTemporalStructure sstim-v:temporalQuasiPeriodic ;
    sstim:techniqueModality sstim-v:modalityAuditory .

# ── Closed-loop / adaptive ──────────────────────────────────────────────

sstim-v:techClosedLoopAuditory a owl:NamedIndividual, sstim:EntrainmentBasedTechnique, skos:Concept ;
    skos:inScheme sstim-v:TechniqueScheme ;
    skos:prefLabel "Closed-Loop Phase-Locked Auditory Stimulation"@en,
                   "Stimolazione Uditiva a Circuito Chiuso Sincronizzata in Fase"@it,
                   "Estimulação Auditiva em Malha Fechada Sincronizada em Fase"@pt,
                   "Estimulación Auditiva en Lazo Cerrado Sincronizada en Fase"@es ;
    skos:notation "closed-loop-auditory" ;
    skos:definition "Sounds delivered at a precise phase of a measured brain or sleep rhythm using EEG or sleep sensors, to reinforce that oscillation."@en ;
    skos:scopeNote "Strong conceptual fit for sleep slow-oscillation work; requires real-time sensing, so not a client-only lightweight feature."@en ;
    sstim:proposedMechanism sstim-v:mechClosedLoopPhase ;
    sstim:hasStimulusTemporalStructure sstim-v:temporalAdaptive ;
    sstim:techniqueModality sstim-v:modalityAuditory .

sstim-v:techSonification a owl:NamedIndividual, sstim:NonEntrainmentTechnique, skos:Concept ;
    skos:inScheme sstim-v:TechniqueScheme ;
    skos:prefLabel "Sonification / Auditory Biofeedback"@en,
                   "Sonificazione / Biofeedback Uditivo"@it,
                   "Sonificação / Biofeedback Auditivo"@pt,
                   "Sonificación / Biorretroalimentación Auditiva"@es ;
    skos:notation "sonification" ;
    skos:definition "Mapping a physiological or behavioral signal (heart rate, HRV, breathing, motion, gait, attention state) into sound, so the listener hears and can regulate that state."@en ;
    skos:scopeNote "Requires sensors or user interaction; well suited to adaptive sessions and research."@en ;
    sstim:proposedMechanism sstim-v:mechClosedLoopPhase, sstim-v:mechAttentional ;
    sstim:hasStimulusTemporalStructure sstim-v:temporalAdaptive ;
    sstim:techniqueModality sstim-v:modalityAuditory .

# ── Perceptual / aesthetic ──────────────────────────────────────────────

sstim-v:techRoughness a owl:NamedIndividual, sstim:NonEntrainmentTechnique, skos:Concept ;
    skos:inScheme sstim-v:TechniqueScheme ;
    skos:prefLabel "Psychoacoustic Roughness / Beating-Zone Stimulation"@en,
                   "Stimolazione con Ruvidità Psicoacustica/Zone di Battimento"@it,
                   "Estimulação com Aspereza Psicoacústica/Zonas de Batimento"@pt,
                   "Estimulación con Aspereza Psicoacústica/Zonas de Batido"@es ;
    skos:notation "roughness" ;
    skos:definition "Intentional auditory roughness from closely spaced frequencies, deep amplitude modulation, or harmonic interference, used as a textural/affective device."@en ;
    skos:scopeNote "A perceptual/aesthetic device; can be activating, so it is generally avoided in calming, sleep, or overload-sensitive contexts."@en ;
    sstim:proposedMechanism sstim-v:mechAttentional ;
    sstim:hasStimulusTemporalStructure sstim-v:temporalQuasiPeriodic ;
    sstim:techniqueModality sstim-v:modalityAuditory .

sstim-v:techAuditoryIllusion a owl:NamedIndividual, sstim:NonEntrainmentTechnique, skos:Concept ;
    skos:inScheme sstim-v:TechniqueScheme ;
    skos:prefLabel "Auditory Illusion Stimulation"@en,
                   "Stimolazione con Illusioni Uditive"@it,
                   "Estimulação com Ilusões Auditivas"@pt,
                   "Estimulación con Ilusiones Auditivas"@es ;
    skos:notation "auditory-illusion" ;
    skos:definition "Stimuli built around auditory illusions — Shepard tones, the missing fundamental, combination tones, binaural spatial illusions — used compositionally."@en ;
    skos:scopeNote "Mostly aesthetic/compositional; not evidence-bearing neuromodulation unless validated separately."@en ;
    sstim:proposedMechanism sstim-v:mechAttentional ;
    sstim:hasStimulusTemporalStructure sstim-v:temporalQuasiPeriodic ;
    sstim:techniqueModality sstim-v:modalityAuditory .

sstim-v:techASMR a owl:NamedIndividual, sstim:NonEntrainmentTechnique, skos:Concept ;
    skos:inScheme sstim-v:TechniqueScheme ;
    skos:prefLabel "ASMR-Like Micro-Texture Stimulation"@en,
                   "Stimolazione con Micro-Texture tipo ASMR"@it,
                   "Estimulação com Microtexturas tipo ASMR"@pt,
                   "Estimulación con Microtexturas tipo ASMR"@es ;
    skos:notation "asmr" ;
    skos:definition "Whisper-like textures, close foley, brushing, and tapping sounds intended to evoke an autonomous sensory meridian response."@en ;
    skos:scopeNote "High affective value, low scientific precision; suited to experiential rather than clean-entrainment contexts."@en ;
    sstim:proposedMechanism sstim-v:mechAttentional ;
    sstim:hasStimulusTemporalStructure sstim-v:temporalAperiodic ;
    sstim:techniqueModality sstim-v:modalityAuditory .

sstim-v:techVoiceMantra a owl:NamedIndividual, sstim:NonEntrainmentTechnique, skos:Concept ;
    skos:inScheme sstim-v:TechniqueScheme ;
    skos:prefLabel "Voice / Mantra / Chant Guided Audio"@en,
                   "Audio Guidato con Voce/Mantra/Canto"@it,
                   "Áudio Guiado por Voz/Mantra/Canto"@pt,
                   "Audio Guiado por Voz/Mantra/Canto"@es ;
    skos:notation "voice-mantra" ;
    skos:definition "Semantic or phonetic vocal stimulation — guided audio, breath counting, mantra or chant repetition — which can also pace breathing."@en ;
    skos:scopeNote "Powerful experiential layer but semantically intrusive; many designs avoid voice by default to keep stimuli non-distracting."@en ;
    sstim:proposedMechanism sstim-v:mechAttentional, sstim-v:mechAutonomic ;
    sstim:hasStimulusTemporalStructure sstim-v:temporalQuasiPeriodic ;
    sstim:techniqueModality sstim-v:modalityAuditory .

# ── Cross-modal acoustic ────────────────────────────────────────────────

sstim-v:techVibroacoustic a owl:NamedIndividual, sstim:NonEntrainmentTechnique, skos:Concept ;
    skos:inScheme sstim-v:TechniqueScheme ;
    skos:prefLabel "Vibroacoustic Stimulation"@en,
                   "Stimolazione Vibroacustica"@it,
                   "Estimulação Vibroacústica"@pt,
                   "Estimulación Vibroacústica"@es ;
    skos:notation "vibroacoustic" ;
    skos:definition "Low-frequency sound delivered through body transducers, chairs, beds, or wearables, so it is felt as well as heard."@en ;
    skos:scopeNote "Cross-modal: auditory plus tactile-mechanical. Studied in contexts such as fibromyalgia; best treated as its own (partly somatosensory) modality, not pure audio."@en ;
    sstim:proposedMechanism sstim-v:mechMechanoreceptive, sstim-v:mechFFR ;
    sstim:hasStimulusTemporalStructure sstim-v:temporalPeriodic ;
    sstim:techniqueModality sstim-v:modalityAuditory, sstim-v:modalitySomatosensory .

sstim-v:techUltrasoundNeuromod a owl:NamedIndividual, sstim:NonEntrainmentTechnique, skos:Concept ;
    skos:inScheme sstim-v:TechniqueScheme ;
    skos:prefLabel "Ultrasound Neuromodulation"@en,
                   "Neuromodulazione a Ultrasuoni"@it,
                   "Neuromodulação por Ultrassom"@pt,
                   "Neuromodulación por Ultrasonido"@es ;
    skos:notation "ultrasound-neuromodulation" ;
    skos:definition "Modulation of neural activity by focused ultrasound, with no audible percept. A genuine neuromodulation field, included for domain completeness."@en ;
    skos:scopeNote "Not ordinary auditory stimulation and not consumer web/mobile feasible; requires dedicated hardware. Catalogued so the ontology can describe it, not because it is a lightweight delivery method."@en ;
    sstim:proposedMechanism sstim-v:mechUltrasonic ;
    sstim:hasStimulusTemporalStructure sstim-v:temporalPeriodic ;
    skos:editorialNote "Deliberately catalogued for domain completeness. Has no perceived sensory modality (direct neuromodulation with no audible percept), so it is exempt from the techniqueModality requirement; the exposure module captures its delivery/perception profile."@en .

sstim-v:techAcousticStartle a owl:NamedIndividual, sstim:NonEntrainmentTechnique, skos:Concept ;
    skos:inScheme sstim-v:TechniqueScheme ;
    skos:prefLabel "Acoustic Startle / Reflex Protocol"@en,
                   "Protocollo di Trasalimento/Riflesso Acustico"@it,
                   "Protocolo de Sobressalto/Reflexo Acústico"@pt,
                   "Protocolo de Sobresalto/Reflejo Acústico"@es ;
    skos:notation "acoustic-startle" ;
    skos:definition "Intense, abrupt sounds (with or without a prepulse) used to elicit and probe the acoustic startle reflex and sensorimotor gating."@en ;
    skos:scopeNote "A research/clinical assessment domain (e.g. prepulse inhibition), not a comfortable wellness experience."@en ;
    sstim:proposedMechanism sstim-v:mechStartle ;
    sstim:hasStimulusTemporalStructure sstim-v:temporalAperiodic ;
    sstim:techniqueModality sstim-v:modalityAuditory .

# ── Visual & cross-modal (ADR 0015) ─────────────────────────────────────

sstim-v:techPhoticDriving a owl:NamedIndividual, sstim:EntrainmentBasedTechnique, skos:Concept ;
    skos:inScheme sstim-v:TechniqueScheme ;
    skos:prefLabel "Photic / Flicker Visual Driving"@en,
                   "Stimolazione Visiva Fotica/con Sfarfallio"@it,
                   "Estimulação Visual Fótica/com Cintilação"@pt,
                   "Estimulación Visual Fótica/con Parpadeo"@es ;
    skos:notation "photic-driving" ;
    skos:definition "Periodic visual flicker — a light source or whole-screen field switched or modulated at a target rate — used to drive occipital rhythms at the flicker frequency. The visual counterpart of isochronic/amplitude-modulated auditory entrainment; at alpha rates it can also evoke stroboscopic imagery (the 'flicker' / Dreamachine phenomenon)."@en ;
    skos:scopeNote "Subject to photosensitivity exposure limits — model the flicker rate and the photosensitivity comfort boundary via the exposure module (sstim-ex:hasFlickerRateHz, sstim-ex:boundaryPhotosensitivity, ADR 0011). Avoid high-contrast full-field flicker around 15–25 Hz in unscreened users. At 40 Hz this is the GENUS visual-gamma case (preclinical-strongest, contested in humans), which additionally invokes sstim-v:mechGamma40."@en ;
    sstim:proposedMechanism sstim-v:mechSSVEP, sstim-v:mechGamma40 ;
    sstim:hasStimulusTemporalStructure sstim-v:temporalPeriodic ;
    sstim:techniqueModality sstim-v:modalityVisual ;
    skos:related sstim-v:techIsochronicTones, sstim-v:gamma40 .

sstim-v:techAudiovisualEntrainment a owl:NamedIndividual, sstim:EntrainmentBasedTechnique, skos:Concept ;
    skos:inScheme sstim-v:TechniqueScheme ;
    skos:prefLabel "Audiovisual Entrainment"@en,
                   "Trascinamento Audiovisivo"@it,
                   "Arrastamento Audiovisual"@pt,
                   "Arrastre Audiovisual"@es ;
    skos:notation "audiovisual-entrainment" ;
    skos:definition "Light and sound pulsed at the same target rate (the classic 'mind machine' / AVE configuration), so auditory and visual driving reinforce one another. Cross-modal: it engages auditory and visual steady-state responses together with multisensory integration."@en ;
    skos:scopeNote "Combines the auditory and visual flicker constraints; the visual channel is subject to photosensitivity limits. Reported effects on state and EEG are mixed across studies; frame conservatively. At 40 Hz this is the multisensory GENUS configuration."@en ;
    sstim:proposedMechanism sstim-v:mechASSR, sstim-v:mechSSVEP, sstim-v:mechMultisensory ;
    sstim:hasStimulusTemporalStructure sstim-v:temporalPeriodic ;
    sstim:techniqueModality sstim-v:modalityAuditory, sstim-v:modalityVisual ;
    skos:related sstim-v:techPhoticDriving, sstim-v:techGamma40Auditory, sstim-v:techIsochronicTones .

sstim-v:techColorFieldStimulation a owl:NamedIndividual, sstim:NonEntrainmentTechnique, skos:Concept ;
    skos:inScheme sstim-v:TechniqueScheme ;
    skos:prefLabel "Color / Chromatic Field Stimulation"@en,
                   "Stimolazione con Campo Cromatico/di Colore"@it,
                   "Estimulação com Campo Cromático/de Cor"@pt,
                   "Estimulación con Campo Cromático/de Color"@es ;
    skos:notation "color-field" ;
    skos:definition "A steady or slowly changing full-field colour — a coloured light wash or whole-screen field, e.g. a Ganzfeld — used as an ambient visual environment rather than as a periodic driver."@en ;
    skos:scopeNote "Aesthetic/ambient device; any calming effect is attentional and contextual. A steady (non-flickering) field is not entrainment."@en ;
    skos:editorialNote "Catalogued to allow an explicit negative assertion: there is no established neurophysiological mechanism and no controlled evidence that any specific colour produces a specific physiological or therapeutic effect ('chromotherapy' / 'colour therapy'). Use aesthetically and honestly; do not attach colour-specific health claims."@en ;
    sstim:proposedMechanism sstim-v:mechAttentional ;
    sstim:hasStimulusTemporalStructure sstim-v:temporalAperiodic ;
    sstim:techniqueModality sstim-v:modalityVisual .

sstim-v:techVibrotactileEntrainment a owl:NamedIndividual, sstim:EntrainmentBasedTechnique, skos:Concept ;
    skos:inScheme sstim-v:TechniqueScheme ;
    skos:prefLabel "Vibrotactile Pulse Entrainment"@en,
                   "Trascinamento con Impulsi Vibrotattili"@it,
                   "Arrastamento com Pulsos Vibrotáteis"@pt,
                   "Arrastre con Pulsos Vibrotáctiles"@es ;
    skos:notation "vibrotactile-entrainment" ;
    skos:definition "Rhythmic vibrotactile pulses delivered to the skin (wrist, fingertips, torso, or a wearable) at a target rate to drive somatosensory cortical rhythms. The tactile counterpart of isochronic auditory entrainment; deliverable on consumer hardware via the Web Vibration API."@en ;
    skos:scopeNote "Distinct from vibroacoustic stimulation: here the pulse rate — not low-frequency audio energy — is the driver, and the percept is primarily tactile. Web Vibration API is Android-only; absent on iOS Safari (sstim-v:modalitySomatosensory scope note)."@en ;
    sstim:proposedMechanism sstim-v:mechSSSEP, sstim-v:mechMechanoreceptive ;
    sstim:hasStimulusTemporalStructure sstim-v:temporalPeriodic ;
    sstim:techniqueModality sstim-v:modalitySomatosensory ;
    skos:related sstim-v:techVibroacoustic, sstim-v:techIsochronicTones .

sstim-v:techAudioTactile a owl:NamedIndividual, sstim:EntrainmentBasedTechnique, skos:Concept ;
    skos:inScheme sstim-v:TechniqueScheme ;
    skos:prefLabel "Audio-Tactile Entrainment"@en,
                   "Trascinamento Audio-Tattile"@it,
                   "Arrastamento Áudio-Tátil"@pt,
                   "Arrastre Audio-Táctil"@es ;
    skos:notation "audio-tactile" ;
    skos:definition "An auditory pulse train (isochronic, monaural, or binaural) and a vibrotactile pulse delivered in phase at the same target rate, so hearing and touch are driven together. Cross-modal: auditory and somatosensory steady-state responses plus multisensory integration."@en ;
    skos:scopeNote "A natural pairing for the BSC breathing/haptic pulse — the isOn breathing-reference voice already drives both the visual breathing animation and the haptic pulse. The tactile channel is Android-only via the Web Vibration API."@en ;
    sstim:proposedMechanism sstim-v:mechFFR, sstim-v:mechSSSEP, sstim-v:mechMultisensory ;
    sstim:hasStimulusTemporalStructure sstim-v:temporalPeriodic ;
    sstim:techniqueModality sstim-v:modalityAuditory, sstim-v:modalitySomatosensory ;
    skos:related sstim-v:techVibrotactileEntrainment, sstim-v:techIsochronicTones, sstim-v:techBinauralBeats .

# ── Reference-pitch / low-evidence tunings (ADR 0017) ───────────────────

# Reference-pitch retuning (432 Hz etc.) is a CARRIER/absolute-pitch claim,
# orthogonal to the modulation/beat frequency the FrequencyBand evidence model is
# about. It is modeled NonEntrainment, with its own (weak) evidence kept disjoint
# from EntrainmentBasedTechnique/FrequencyBand evidence — the carrier-vs-modulation
# firewall. Carrier-tuning parameters live on sstim-ex:StimulusChannel.
sstim-v:techReferencePitchRetuning a owl:NamedIndividual, sstim:NonEntrainmentTechnique, skos:Concept ;
    skos:inScheme sstim-v:TechniqueScheme ;
    skos:prefLabel "Reference-Pitch Retuning"@en,
                   "Riaccordatura del Diapason"@it,
                   "Reafinação do Diapasão"@pt,
                   "Reafinación del Diapasón"@es ;
    skos:notation "reference-pitch-retuning" ;
    skos:definition "Music or tones retuned so that a named reference note (commonly A4) is set to a non-standard frequency such as 432 Hz instead of the standard 440 Hz."@en ;
    skos:scopeNote "A property of the carrier / absolute pitch, orthogonal to any modulation or beat frequency — not brainwave entrainment. Parametrize a stimulus channel with sstim-ex:referencePitchNote / referencePitchHz / retunedFromReferenceHz / pitchShiftCents. Any effect claim must be modeled as music-listening / tuning-preference / psychoacoustic / expectation-mediated, with its own EvidenceClaim kept disjoint from EntrainmentBasedTechnique and FrequencyBand evidence."@en ;
    skos:editorialNote "Catalogued to allow an explicit negative assertion. There is no established mechanism and no robust controlled evidence that any specific tuning (432 Hz, 'cosmic/healing frequency', Verdi tuning) produces a specific physiological effect beyond ordinary music, relaxation, and expectancy. A 432 Hz pseudoscience literature exists; use only as a warm aesthetic tuning option, framed honestly — never as a feature benefit or healing claim."@en ;
    sstim:evidenceNotes "Honest ceiling: tier 2-3, claim direction mixed/inconclusive. The few small double-blind crossover pilots (e.g. ~4.79 bpm heart-rate reduction for 432 vs 440 Hz, n=33) tested full transposed MUSIC, confounding absolute tuning with overall pitch-lowering and tempo, and none tested a 432 Hz carrier under a binaural/isochronic beat — a modality/population mismatch that discounts any transfer to BSC's use case. At least one 2025 athlete study found 440 Hz more effective for several outcomes. Audit citation venues before use."@en ;
    sstim:proposedMechanism sstim-v:mechAttentional ;
    sstim:hasStimulusTemporalStructure sstim-v:temporalQuasiPeriodic ;
    sstim:techniqueModality sstim-v:modalityAuditory .

# ── Catalogued but NOT evidence-bearing (flagged via skos:editorialNote) ─

sstim-v:techSolfeggioTuning a owl:NamedIndividual, sstim:NonEntrainmentTechnique, skos:Concept ;
    skos:inScheme sstim-v:TechniqueScheme ;
    skos:prefLabel "Solfeggio / Mystical Tuning Stimulation"@en,
                   "Stimolazione con Frequenze Solfeggio/Accordatura Mistica"@it,
                   "Estimulação com Frequências Solfeggio/Afinação Mística"@pt,
                   "Estimulación con Frecuencias Solfeggio/Afinación Mística"@es ;
    skos:notation "solfeggio-tuning" ;
    skos:broader sstim-v:techReferencePitchRetuning ;
    skos:definition "Music or tones tuned to so-called 'Solfeggio frequencies' (e.g. 432 Hz, 528 Hz) or other arbitrary tunings claimed to carry special healing properties. A specific folk-claim case of reference-pitch retuning."@en ;
    skos:editorialNote "Catalogued for transparency and to allow an explicit negative assertion. There is no established neurophysiological mechanism and no controlled evidence that any specific tuning produces specific effects beyond ordinary music/relaxation. Not an evidence-bearing technique; any use should be framed aesthetically and honestly."@en ;
    sstim:hasStimulusTemporalStructure sstim-v:temporalPeriodic ;
    sstim:techniqueModality sstim-v:modalityAuditory .

sstim-v:techSubliminalAudio a owl:NamedIndividual, sstim:NonEntrainmentTechnique, skos:Concept ;
    skos:inScheme sstim-v:TechniqueScheme ;
    skos:prefLabel "Semantic Subliminal Audio"@en,
                   "Audio Subliminale Semantico"@it,
                   "Áudio Subliminar Semântico"@pt,
                   "Audio Subliminal Semántico"@es ;
    skos:notation "subliminal-audio" ;
    skos:definition "Below-threshold or masked spoken messages (affirmations, suggestions) intended to influence behavior or mood without conscious perception."@en ;
    skos:editorialNote "Catalogued for transparency and explicit negative assertion. Evidence for durable behavioral or mood change from semantic subliminal audio is weak to absent. Not an evidence-bearing technique."@en ;
    sstim:hasStimulusTemporalStructure sstim-v:temporalAperiodic ;
    sstim:techniqueModality sstim-v:modalityAuditory .


