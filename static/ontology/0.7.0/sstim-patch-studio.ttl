###########################################################################
#
#  SSTIM Parameter Properties  —  sstim-patch-studio.ttl
#
#  Namespace:  https://w3id.org/sstim
#  Version:    0.7.0
#  Date:       2026-07-15
#  Author:     Renato Fabbri <renato@junto.space>
#  License:    CC BY 4.0
#
#  Datatype properties that quantify a voice (sstim:Voice) and a session
#  authoring configuration (sstim:SessionSpecification). These are the
#  numeric parameter properties shared by the BSC preset catalog model and
#  the live Patch Studio authoring model; all terms are in the sstim#
#  namespace and are part of the SSTIM ontology (rdfs:isDefinedBy
#  <https://w3id.org/sstim>). The SHACL voice shapes in sstim-shapes.ttl
#  constrain the voice properties below.
#
#  Protected file — do not modify without explicit maintainer instruction.
#
###########################################################################

@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix sstim: <https://w3id.org/sstim#> .
@prefix dct:   <http://purl.org/dc/terms/> .


###########################################################################
# Module metadata
###########################################################################

<https://w3id.org/sstim/patch-studio> a owl:Ontology ;
    owl:versionInfo "0.7.0" ;
    dct:title "SSTIM Patch Studio Parameter Module"@en ;
    dct:description "Datatype properties for reproducibly specifying SSTIM audio voices and Patch Studio session-authoring parameters."@en ;
    dct:isPartOf <https://w3id.org/sstim> ;
    dct:requires <https://w3id.org/sstim> ;
    dct:creator <https://orcid.org/0000-0002-9699-629X> ;
    dct:publisher <https://github.com/laBioSynCare> ;
    dct:created "2026-06-17"^^xsd:date ;
    dct:issued "2026-06-17"^^xsd:date ;
    dct:modified "2026-07-15"^^xsd:date ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> .


###########################################################################
# Voice parameter datatype properties (domain sstim:Voice)
###########################################################################

sstim:carrierFreqLeft a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain sstim:Voice ;
    rdfs:range xsd:decimal ;
    rdfs:label "left carrier frequency"@en ;
    skos:definition "Left-ear carrier frequency for binaural presentation, in Hz."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim> .

sstim:carrierFreqRight a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain sstim:Voice ;
    rdfs:range xsd:decimal ;
    rdfs:label "right carrier frequency"@en ;
    skos:definition "Right-ear carrier frequency for binaural presentation, in Hz."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim> .

sstim:initialVolume a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain sstim:Voice ;
    rdfs:range xsd:decimal ;
    rdfs:label "initial volume"@en ;
    skos:definition "Initial output gain or amplitude for a voice."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim> .

sstim:panPosition a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain sstim:Voice ;
    rdfs:range xsd:decimal ;
    rdfs:label "pan position"@en ;
    skos:definition "Stereo position from left to right."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim> .

sstim:baseFrequency a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain sstim:Voice ;
    rdfs:range xsd:decimal ;
    rdfs:label "base frequency"@en ;
    skos:definition "Base, carrier, or center frequency for a voice, in Hz."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim> .

sstim:beatHz a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain sstim:Voice ;
    rdfs:range xsd:decimal ;
    rdfs:label "beat frequency"@en ;
    skos:definition "Driven or perceived beat frequency in Hz."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim> .

sstim:pulseRateHz a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain sstim:Voice ;
    rdfs:range xsd:decimal ;
    rdfs:label "pulse rate"@en ;
    skos:definition "Rhythmic pulse or sequence step rate in Hz."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim> .

sstim:noteDurationFraction a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain sstim:Voice ;
    rdfs:range xsd:decimal ;
    rdfs:label "note duration fraction"@en ;
    skos:definition "Fraction of a rhythmic pulse occupied by the active note envelope."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim> .

sstim:noteCount a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain sstim:Voice ;
    rdfs:range xsd:integer ;
    rdfs:label "note count"@en ;
    skos:definition "Number of notes or sequence positions in a Symmetry cycle."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim> .

sstim:octaveSpan a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain sstim:Voice ;
    rdfs:range xsd:decimal ;
    rdfs:label "octave span"@en ;
    skos:definition "Pitch span covered by a Symmetry sequence."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim> .

sstim:cycleDuration a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain sstim:Voice ;
    rdfs:range xsd:decimal ;
    rdfs:label "cycle duration"@en ;
    skos:definition "Duration of one repeated control or sequence cycle, in seconds."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim> .

sstim:permutationFunction a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain sstim:Voice ;
    rdfs:range xsd:integer ;
    rdfs:label "permutation function"@en ;
    skos:definition "Permutation function selector for sequence ordering. Values match the skos:notation of sstim-v:PermutationFunctionScheme members (0=shuffle, 1=rotate forward, 2=rotate backward, 3=reverse, 4=identity)."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim> .

sstim:breathingPhaseRatio a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain sstim:Voice ;
    rdfs:range xsd:decimal ;
    rdfs:label "breathing phase ratio"@en ;
    skos:definition "Fraction of a breathing cycle assigned to the inhale phase."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim> .

sstim:breathingAmplitude a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain sstim:Voice ;
    rdfs:range xsd:decimal ;
    rdfs:label "breathing amplitude"@en ;
    skos:definition "Depth or excursion of a breathing-shaped control signal."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim> .


###########################################################################
# Martigli voice oscillation parameters (Martigli & Martigli-Binaural voices)
#
# Per-voice authored parameters of the Martigli breathing arc, distinct from the
# session-level sstim:breathingPeriod* override properties (domain
# SessionSpecification). Domain is the broad sstim:Voice, matching the other voice
# parameters above; the SHACL Martigli voice shapes enforce which subtype must
# carry which parameter. See ADR 0012 and docs/technical/BREATHING_MODEL.md.
###########################################################################

sstim:martigliCenterFreq a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain sstim:Voice ;
    rdfs:range xsd:decimal ;
    rdfs:label "Martigli center frequency"@en ;
    skos:definition "Center frequency (mf0) of a Martigli voice's oscillating tone, in Hz; the frequency sweeps mf0 ± ma. Martigli voices only — Martigli-Binaural uses the carrier pair."@en ;
    rdfs:seeAlso <https://github.com/laBioSynCare/laBioSynCare.github.io/blob/main/docs/decisions/0012-martigli-voice-parameters.md> ;
    rdfs:isDefinedBy <https://w3id.org/sstim> .

sstim:martigliAmplitude a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain sstim:Voice ;
    rdfs:range xsd:decimal ;
    rdfs:label "Martigli oscillation amplitude"@en ;
    skos:definition "Frequency-sweep amplitude (ma) of a Martigli oscillation, in Hz; the carrier(s) sweep ± ma around the center."@en ;
    rdfs:seeAlso <https://github.com/laBioSynCare/laBioSynCare.github.io/blob/main/docs/decisions/0012-martigli-voice-parameters.md> ;
    rdfs:isDefinedBy <https://w3id.org/sstim> .

sstim:martigliPeriodInitial a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain sstim:Voice ;
    rdfs:range xsd:decimal ;
    rdfs:label "Martigli initial period"@en ;
    skos:definition "Initial breathing-cycle duration (mp0) of a Martigli oscillation, in seconds. Must be >= 3 s when the voice is the breathing reference (isOn)."@en ;
    rdfs:seeAlso <https://github.com/laBioSynCare/laBioSynCare.github.io/blob/main/docs/decisions/0012-martigli-voice-parameters.md> ;
    rdfs:isDefinedBy <https://w3id.org/sstim> .

sstim:martigliPeriodFinal a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain sstim:Voice ;
    rdfs:range xsd:decimal ;
    rdfs:label "Martigli final period"@en ;
    skos:definition "Final breathing-cycle duration (mp1) of a Martigli oscillation after the transition, in seconds."@en ;
    rdfs:seeAlso <https://github.com/laBioSynCare/laBioSynCare.github.io/blob/main/docs/decisions/0012-martigli-voice-parameters.md> ;
    rdfs:isDefinedBy <https://w3id.org/sstim> .

sstim:martigliTransitionDuration a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain sstim:Voice ;
    rdfs:range xsd:decimal ;
    rdfs:label "Martigli transition duration"@en ;
    skos:definition "Time (md) over which the breathing cycle interpolates linearly from mp0 to mp1, in seconds; mp1 is held afterwards."@en ;
    rdfs:seeAlso <https://github.com/laBioSynCare/laBioSynCare.github.io/blob/main/docs/decisions/0012-martigli-voice-parameters.md> ;
    rdfs:isDefinedBy <https://w3id.org/sstim> .

sstim:isBreathReference a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain sstim:Voice ;
    rdfs:range xsd:boolean ;
    rdfs:label "is breath reference"@en ;
    skos:definition "True iff this voice is the breathing reference (isOn): its oscillation drives the visual breathing animation and haptic pulse. At most one voice per preset may be the breathing reference."@en ;
    rdfs:seeAlso <https://github.com/laBioSynCare/laBioSynCare.github.io/blob/main/docs/decisions/0012-martigli-voice-parameters.md> ;
    rdfs:isDefinedBy <https://w3id.org/sstim> .


###########################################################################
# Session authoring parameter datatype properties
# (domain sstim:SessionSpecification — visual, haptic, and tempo authoring)
###########################################################################

sstim:rotationSpeed a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain sstim:SessionSpecification ;
    rdfs:range xsd:decimal ;
    rdfs:label "rotation speed"@en ;
    skos:definition "Visual rotation rate or angular speed."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim> .

sstim:visualSideCount a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain sstim:SessionSpecification ;
    rdfs:range xsd:integer ;
    rdfs:label "visual side count"@en ;
    skos:definition "Number of sides used by a geometric visual form."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim> .

sstim:visualDensity a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain sstim:SessionSpecification ;
    rdfs:range xsd:decimal ;
    rdfs:label "visual density"@en ;
    skos:definition "Density of rendered visual elements."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim> .

sstim:stimulationIntensity a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain sstim:SessionSpecification ;
    rdfs:range xsd:decimal ;
    rdfs:label "stimulation intensity"@en ;
    skos:definition "Strength of haptic or sensory output."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim> .

sstim:hapticPattern a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain sstim:SessionSpecification ;
    rdfs:range xsd:integer ;
    rdfs:label "haptic pattern"@en ;
    skos:definition "Pattern index or selector for haptic delivery."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim> .

sstim:tempoBpm a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain sstim:SessionSpecification ;
    rdfs:range xsd:decimal ;
    rdfs:label "tempo BPM"@en ;
    skos:definition "Optional authoring tempo in beats per minute."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim> .

sstim:beatsPerBar a owl:DatatypeProperty, owl:FunctionalProperty ;
    rdfs:domain sstim:SessionSpecification ;
    rdfs:range xsd:integer ;
    rdfs:label "beats per bar"@en ;
    skos:definition "Number of beats in one authoring tempo bar."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim> .

###########################################################################
# End of sstim-patch-studio.ttl
###########################################################################
