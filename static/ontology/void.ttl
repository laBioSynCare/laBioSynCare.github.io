###########################################################################
#
#  SSTIM — VoID + DCAT dataset description  —  void.ttl
#
#  Namespace:  https://w3id.org/sstim
#  Date:       2026-07-24
#  License:    CC BY 4.0
#
#  Machine-readable dataset metadata (VoID + DCAT) for the published SSTIM
#  ontology graph set — distributions, formats, uriSpace, vocabularies used,
#  and example resources. Targets LOV review and DBpedia Archivo's metadata
#  star (PUBLICATION_AND_INTERLINKING_PLAN B3).
#
#  This file describes the dataset; it is NOT part of the versioned term-space
#  (not snapshotted by `make snapshot`, not in the export ONTOLOGY_FILES list).
#  Once merged to `main` and deployed, it is served verbatim at
#  https://labiosyncare.github.io/ontology/void.ttl, and — after the staged
#  /sstim/void w3id rule ships in a perma-id PR — at https://w3id.org/sstim/void.
#
#  Whole-set counts are checked by scripts/sstim-quality-audit.py so metadata
#  drift fails validation instead of silently reaching publication.
#
###########################################################################

@prefix void:  <http://rdfs.org/ns/void#> .
@prefix dcat:  <http://www.w3.org/ns/dcat#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix foaf:  <http://xmlns.com/foaf/0.1/> .
@prefix schema: <https://schema.org/> .
@prefix org:   <http://www.w3.org/ns/org#> .
@prefix cc:    <http://creativecommons.org/ns#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .

# IANA media types and W3C format IRIs used below:
#   text/turtle          https://www.iana.org/assignments/media-types/text/turtle
#   application/ld+json  https://www.iana.org/assignments/media-types/application/ld+json
#   application/rdf+xml  https://www.iana.org/assignments/media-types/application/rdf+xml

<https://w3id.org/sstim/void>
    a void:Dataset, dcat:Dataset ;
    dct:title "Sensory Stimulation Ontology (SSTIM) — dataset"@en ;
    dct:description "FAIR dataset description for SSTIM: an OWL 2 ontology, multilingual SKOS vocabulary, SHACL shapes, external alignments, exposure/experiment, Patch Studio, and ecosystem modules; version-controlled public BSC Lab instances; and a separately hosted mutable live-only ecosystem projection. Turtle is the editable ontology master; JSON-LD and RDF/XML module serializations are generated for publication."@en ;
    dct:creator <https://orcid.org/0000-0002-9699-629X> ;
    dct:publisher <https://github.com/laBioSynCare> ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    cc:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:issued "2026-04-12"^^xsd:date ;
    dct:modified "2026-07-24"^^xsd:date ;
    dct:identifier "10.5281/zenodo.21286974" ;
    # RDF-01 policy resolution (2026-07-24 audit): void.ttl is the designated,
    # non-snapshotted sidecar (see this file's own header), so it is the
    # authoritative place for the version-specific DOI Zenodo mints only after
    # the release exists. sstim-core.ttl, which IS snapshotted, deliberately
    # does not carry it — the chicken-and-egg problem is real (Zenodo cannot
    # mint a DOI for a release that has not been cut yet), and updating the
    # live core.ttl post-freeze would only diverge it from the already-frozen
    # static/ontology/0.11.0/ copy without fixing anything.
    dct:hasVersion <https://doi.org/10.5281/zenodo.21536124> ;
    dct:conformsTo <https://www.w3.org/TR/owl2-overview/>,
        <https://www.w3.org/TR/skos-reference/>,
        <https://www.w3.org/TR/shacl/>,
        <https://www.w3.org/TR/prov-o/> ;
    dcat:version "0.11.0" ;
    foaf:homepage <https://labiosyncare.github.io/> ;
    dcat:landingPage <https://labiosyncare.github.io/> ;
    # WIDOCO reference documentation — generated per release in CI, never
    # committed (ADR 0023). The landing page above stays the interactive app.
    foaf:page <https://labiosyncare.github.io/ontology/docs/> ;
    foaf:primaryTopic <https://w3id.org/sstim> ;
    void:rootResource <https://w3id.org/sstim> ;
    void:uriSpace "https://w3id.org/sstim" ;
    void:triples 10253 ;
    void:classes 139 ;
    void:properties 232 ;
    dcat:keyword "sensory stimulation", "ontology", "SKOS vocabulary",
        "brainwave entrainment", "binaural beats", "isochronic tones",
        "audio-visual entrainment", "vibrotactile stimulation", "paced breathing",
        "multisensory integration", "wellness", "evidence tiers", "SHACL" ;
    void:feature <http://www.w3.org/ns/formats/Turtle>,
        <http://www.w3.org/ns/formats/JSON-LD>,
        <http://www.w3.org/ns/formats/RDF_XML> ;
    void:vocabulary <http://www.w3.org/2002/07/owl#>,
        <http://www.w3.org/2000/01/rdf-schema#>,
        <http://www.w3.org/2004/02/skos/core#>,
        <http://purl.org/dc/terms/>,
        <http://www.w3.org/2001/XMLSchema#>,
        <http://purl.org/vocab/vann/>,
        <http://purl.org/vocommons/voaf#>,
        <http://creativecommons.org/ns#>,
        <http://www.w3.org/ns/shacl#>,
        <http://www.w3.org/ns/prov#>,
        <https://schema.org/>,
        <http://www.w3.org/ns/org#>,
        <http://xmlns.com/foaf/0.1/>,
        <http://purl.obolibrary.org/obo/>,
        <http://www.wikidata.org/entity/> ;
    void:exampleResource <https://w3id.org/sstim#SensoryStimulation>,
        <https://w3id.org/sstim#EvidenceClaim>,
        <https://w3id.org/sstim/vocab#alpha>,
        <https://w3id.org/sstim/exposure#ExposureProfile>,
        <https://w3id.org/sstim/ecosystem#EcosystemAgent> ;
    void:subset <https://w3id.org/sstim/void#core>,
        <https://w3id.org/sstim/void#vocab>,
        <https://w3id.org/sstim/void#shapes>,
        <https://w3id.org/sstim/void#alignments>,
        <https://w3id.org/sstim/void#patch-studio>,
        <https://w3id.org/sstim/void#exposure>,
        <https://w3id.org/sstim/void#ecosystem>,
        <https://w3id.org/sstim/void#instances> ;
    # Primary distribution: the core OWL module in Turtle.
    dcat:distribution [
        a dcat:Distribution ;
        dct:title "SSTIM core ontology (Turtle)"@en ;
        dcat:mediaType <https://www.iana.org/assignments/media-types/text/turtle> ;
        dcat:accessURL <https://w3id.org/sstim> ;
        dcat:downloadURL <https://labiosyncare.github.io/ontology/sstim-core.ttl> ] .

###########################################################################
# Module subsets — one void:Dataset per published module, each with Turtle
# (master) plus JSON-LD and RDF/XML distributions.
###########################################################################

<https://w3id.org/sstim/void#core>
    a void:Dataset ;
    dct:title "SSTIM Core ontology"@en ;
    dct:description "OWL 2 classes, object/datatype properties, and annotation properties."@en ;
    void:dataDump <https://labiosyncare.github.io/ontology/sstim-core.ttl> ;
    dcat:landingPage <https://w3id.org/sstim> ;
    dcat:distribution
        [ a dcat:Distribution ; dct:title "Turtle" ; dcat:mediaType <https://www.iana.org/assignments/media-types/text/turtle> ; dcat:accessURL <https://w3id.org/sstim> ; dcat:downloadURL <https://labiosyncare.github.io/ontology/sstim-core.ttl> ] ,
        [ a dcat:Distribution ; dct:title "JSON-LD" ; dcat:mediaType <https://www.iana.org/assignments/media-types/application/ld+json> ; dcat:downloadURL <https://labiosyncare.github.io/ontology/sstim-core.jsonld> ] ,
        [ a dcat:Distribution ; dct:title "RDF/XML" ; dcat:mediaType <https://www.iana.org/assignments/media-types/application/rdf+xml> ; dcat:downloadURL <https://labiosyncare.github.io/ontology/sstim-core.rdf> ] .

<https://w3id.org/sstim/void#vocab>
    a void:Dataset ;
    dct:title "SSTIM SKOS Vocabulary"@en ;
    dct:description "Multilingual SKOS concepts for frequency bands, preset groups, techniques, mechanisms, modalities, evidence governance, public claim levels, cautions, session-report phases, and implementation metadata."@en ;
    void:dataDump <https://labiosyncare.github.io/ontology/sstim-vocab.ttl> ;
    dcat:landingPage <https://w3id.org/sstim/vocab> ;
    dcat:distribution
        [ a dcat:Distribution ; dct:title "Turtle" ; dcat:mediaType <https://www.iana.org/assignments/media-types/text/turtle> ; dcat:accessURL <https://w3id.org/sstim/vocab> ; dcat:downloadURL <https://labiosyncare.github.io/ontology/sstim-vocab.ttl> ] ,
        [ a dcat:Distribution ; dct:title "JSON-LD" ; dcat:mediaType <https://www.iana.org/assignments/media-types/application/ld+json> ; dcat:downloadURL <https://labiosyncare.github.io/ontology/sstim-vocab.jsonld> ] ,
        [ a dcat:Distribution ; dct:title "RDF/XML" ; dcat:mediaType <https://www.iana.org/assignments/media-types/application/rdf+xml> ; dcat:downloadURL <https://labiosyncare.github.io/ontology/sstim-vocab.rdf> ] .

<https://w3id.org/sstim/void#shapes>
    a void:Dataset ;
    dct:title "SSTIM SHACL Shapes"@en ;
    dct:description "SHACL Core and SHACL-SPARQL constraints validating module metadata, SKOS integrity, techniques, evidence, safety, protocols, implementations, presets, exposure profiles, sessions, and references."@en ;
    void:dataDump <https://labiosyncare.github.io/ontology/sstim-shapes.ttl> ;
    dcat:landingPage <https://w3id.org/sstim/shapes> ;
    dcat:distribution
        [ a dcat:Distribution ; dct:title "Turtle" ; dcat:mediaType <https://www.iana.org/assignments/media-types/text/turtle> ; dcat:accessURL <https://w3id.org/sstim/shapes> ; dcat:downloadURL <https://labiosyncare.github.io/ontology/sstim-shapes.ttl> ] ,
        [ a dcat:Distribution ; dct:title "JSON-LD" ; dcat:mediaType <https://www.iana.org/assignments/media-types/application/ld+json> ; dcat:downloadURL <https://labiosyncare.github.io/ontology/sstim-shapes.jsonld> ] ,
        [ a dcat:Distribution ; dct:title "RDF/XML" ; dcat:mediaType <https://www.iana.org/assignments/media-types/application/rdf+xml> ; dcat:downloadURL <https://labiosyncare.github.io/ontology/sstim-shapes.rdf> ] .

<https://w3id.org/sstim/void#alignments>
    a void:Dataset ;
    dct:title "SSTIM External Alignments"@en ;
    dct:description "Conservatively scoped links from SSTIM terms to verified BFO/IAO/OBI/COB and Wikidata resources."@en ;
    void:dataDump <https://labiosyncare.github.io/ontology/sstim-alignments.ttl> ;
    dcat:landingPage <https://w3id.org/sstim/alignments> ;
    dcat:distribution
        [ a dcat:Distribution ; dct:title "Turtle" ; dcat:mediaType <https://www.iana.org/assignments/media-types/text/turtle> ; dcat:accessURL <https://w3id.org/sstim/alignments> ; dcat:downloadURL <https://labiosyncare.github.io/ontology/sstim-alignments.ttl> ] ,
        [ a dcat:Distribution ; dct:title "JSON-LD" ; dcat:mediaType <https://www.iana.org/assignments/media-types/application/ld+json> ; dcat:downloadURL <https://labiosyncare.github.io/ontology/sstim-alignments.jsonld> ] ,
        [ a dcat:Distribution ; dct:title "RDF/XML" ; dcat:mediaType <https://www.iana.org/assignments/media-types/application/rdf+xml> ; dcat:downloadURL <https://labiosyncare.github.io/ontology/sstim-alignments.rdf> ] .

<https://w3id.org/sstim/void#patch-studio>
    a void:Dataset ;
    dct:title "SSTIM Patch Studio Model"@en ;
    dct:description "Datatype properties for reproducible Patch Studio voice and session-authoring parameters."@en ;
    void:dataDump <https://labiosyncare.github.io/ontology/sstim-patch-studio.ttl> ;
    dcat:landingPage <https://w3id.org/sstim/patch-studio> ;
    dcat:distribution
        [ a dcat:Distribution ; dct:title "Turtle" ; dcat:mediaType <https://www.iana.org/assignments/media-types/text/turtle> ; dcat:accessURL <https://w3id.org/sstim/patch-studio> ; dcat:downloadURL <https://labiosyncare.github.io/ontology/sstim-patch-studio.ttl> ] ,
        [ a dcat:Distribution ; dct:title "JSON-LD" ; dcat:mediaType <https://www.iana.org/assignments/media-types/application/ld+json> ; dcat:downloadURL <https://labiosyncare.github.io/ontology/sstim-patch-studio.jsonld> ] ,
        [ a dcat:Distribution ; dct:title "RDF/XML" ; dcat:mediaType <https://www.iana.org/assignments/media-types/application/rdf+xml> ; dcat:downloadURL <https://labiosyncare.github.io/ontology/sstim-patch-studio.rdf> ] .

<https://w3id.org/sstim/void#exposure>
    a void:Dataset ;
    dct:title "SSTIM Exposure & Experiment Module"@en ;
    dct:description "Separates physical delivery medium, perceived modality, device capability, body placement, comfort boundary, experiment context, effect claims, and knowledge status."@en ;
    void:dataDump <https://labiosyncare.github.io/ontology/sstim-exposure.ttl> ;
    dcat:landingPage <https://w3id.org/sstim/exposure> ;
    dcat:distribution
        [ a dcat:Distribution ; dct:title "Turtle" ; dcat:mediaType <https://www.iana.org/assignments/media-types/text/turtle> ; dcat:accessURL <https://w3id.org/sstim/exposure> ; dcat:downloadURL <https://labiosyncare.github.io/ontology/sstim-exposure.ttl> ] ,
        [ a dcat:Distribution ; dct:title "JSON-LD" ; dcat:mediaType <https://www.iana.org/assignments/media-types/application/ld+json> ; dcat:downloadURL <https://labiosyncare.github.io/ontology/sstim-exposure.jsonld> ] ,
        [ a dcat:Distribution ; dct:title "RDF/XML" ; dcat:mediaType <https://www.iana.org/assignments/media-types/application/rdf+xml> ; dcat:downloadURL <https://labiosyncare.github.io/ontology/sstim-exposure.rdf> ] .

<https://w3id.org/sstim/void#ecosystem>
    a void:Dataset ;
    dct:title "SSTIM Ecosystem Module"@en ;
    dct:description "Neutral ecosystem-agent types, controlled relationship categories, provenance, engagement, notification, response, and archival-consent metadata."@en ;
    void:dataDump <https://labiosyncare.github.io/ontology/sstim-ecosystem.ttl> ;
    dcat:landingPage <https://w3id.org/sstim/ecosystem> ;
    dcat:distribution
        [ a dcat:Distribution ; dct:title "Turtle" ; dcat:mediaType <https://www.iana.org/assignments/media-types/text/turtle> ; dcat:accessURL <https://w3id.org/sstim/ecosystem> ; dcat:downloadURL <https://labiosyncare.github.io/ontology/sstim-ecosystem.ttl> ] ,
        [ a dcat:Distribution ; dct:title "JSON-LD" ; dcat:mediaType <https://www.iana.org/assignments/media-types/application/ld+json> ; dcat:downloadURL <https://labiosyncare.github.io/ontology/sstim-ecosystem.jsonld> ] ,
        [ a dcat:Distribution ; dct:title "RDF/XML" ; dcat:mediaType <https://www.iana.org/assignments/media-types/application/rdf+xml> ; dcat:downloadURL <https://labiosyncare.github.io/ontology/sstim-ecosystem.rdf> ] .

<https://w3id.org/sstim/void#instances>
    a void:Dataset ;
    dct:title "BSC Lab public SSTIM instance data"@en ;
    dct:description "Public, non-clinical BSC Lab framework, implementation, protocol, preset, evidence, reference, experiment, synthetic session, and synthetic ecosystem contract records, plus a separately hosted mutable reviewed ecosystem subset. The void:triples value counts only the version-controlled static instances; the mutable subset deliberately omits volatile counts. Private BioSynCare catalog data, real participant records, correspondence, contact channels, and raw consent evidence are excluded."@en ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    void:triples 1787 ;
    void:uriSpace "https://w3id.org/sstim/implementation/bsclab/",
        "https://w3id.org/sstim/framework/",
        "https://w3id.org/sstim/ref/",
        "https://w3id.org/sstim/organization/",
        "https://w3id.org/sstim/specialist/",
        "https://w3id.org/sstim/ecosystem-record/" ;
    void:vocabulary <https://w3id.org/sstim>, <https://w3id.org/sstim/vocab>,
        <https://w3id.org/sstim/exposure>, <https://w3id.org/sstim/ecosystem>,
        <http://www.w3.org/ns/prov#>, <https://schema.org/>,
        <http://www.w3.org/ns/org#>, <http://xmlns.com/foaf/0.1/> ;
    void:exampleResource <https://w3id.org/sstim/framework/bsc>,
        <https://w3id.org/sstim/implementation/bsclab>,
        <https://w3id.org/sstim/implementation/biosyncare>,
        <https://w3id.org/sstim/implementation/bsclab/component/patch-studio>,
        <https://w3id.org/sstim/implementation/bsclab/protocol/auditory-observation-reference>,
        <https://w3id.org/sstim/implementation/bsclab/preset/perform-alpha-10-seed>,
        <https://w3id.org/sstim/implementation/bsclab/session/synthetic-reference-001>,
        <https://w3id.org/sstim/specialist/synthetic-alex-rivera>,
        <https://w3id.org/sstim/specialist/renato-fabbri> ;
    void:subset <https://w3id.org/sstim/graph/ecosystem-agents>,
        <https://w3id.org/sstim/graph/ecosystem-fixture> ;
    dcat:landingPage <https://github.com/laBioSynCare/laBioSynCare.github.io/tree/main/static/ontology/instances> .


# Mutable runtime named graph for reviewed real ecosystem records. Its public
# projection is kept outside the versioned/Zenodo-tracked repository so removal
# and replacement remain operationally possible. Volatile counts are omitted.
<https://w3id.org/sstim/graph/ecosystem-agents>
    a void:Dataset ;
    dct:title "SSTIM reviewed ecosystem-agent instance graph"@en ;
    dct:description "Mutable public projection for reviewed real people, organizations, qualified relationships, and approved public-safe engagement state. It excludes private correspondence, contact channels, authentication identifiers, raw consent evidence, and the separate synthetic fixture graph; complete audit history remains access-controlled."@en ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    void:dataDump <https://biosyncare-lab.web.app/current.ttl> ;
    void:uriSpace "https://w3id.org/sstim/organization/",
        "https://w3id.org/sstim/specialist/",
        "https://w3id.org/sstim/ecosystem-record/" ;
    void:vocabulary <https://w3id.org/sstim>,
        <https://w3id.org/sstim/ecosystem>,
        <https://schema.org/>,
        <http://www.w3.org/ns/org#>,
        <http://xmlns.com/foaf/0.1/>,
        <http://www.w3.org/ns/prov#> ;
    dcat:landingPage <https://biosyncare-lab.web.app/current.ttl> .


# Runtime named graph for synthetic contract fixtures. Counts and complete dump
# coverage are machine-checked independently from the reserved real graph.
<https://w3id.org/sstim/graph/ecosystem-fixture>
    a void:Dataset ;
    dct:title "SSTIM synthetic ecosystem contract fixture graph"@en ;
    dct:description "Synthetic, non-personal contract data exercising distinct people, organizations, qualified ORG memberships, implementation responsibility, and approved public-safe engagement outcomes. It contains no real named person, correspondence, contact channel, authentication identifier, or raw consent evidence."@en ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    void:triples 266 ;
    void:classPartition
        [ void:class <https://w3id.org/sstim/ecosystem#EcosystemAgent> ; void:entities 3 ],
        [ void:class <https://w3id.org/sstim/ecosystem#EcosystemRelationship> ; void:entities 6 ],
        [ void:class <https://w3id.org/sstim/ecosystem#OrganizationMembership> ; void:entities 2 ],
        [ void:class <https://w3id.org/sstim/ecosystem#ImplementationResponsibility> ; void:entities 2 ],
        [ void:class <https://w3id.org/sstim/ecosystem#EngagementActivity> ; void:entities 14 ],
        [ void:class <http://www.w3.org/ns/org#Role> ; void:entities 2 ] ;
    void:uriSpace "https://w3id.org/sstim/organization/",
        "https://w3id.org/sstim/specialist/",
        "https://w3id.org/sstim/ecosystem-record/",
        "https://w3id.org/sstim/implementation/bsclab/" ;
    void:vocabulary <https://w3id.org/sstim>,
        <https://w3id.org/sstim/ecosystem>,
        <https://schema.org/>,
        <http://www.w3.org/ns/org#>,
        <http://xmlns.com/foaf/0.1/>,
        <http://www.w3.org/ns/prov#> ;
    void:exampleResource <https://w3id.org/sstim/specialist/synthetic-alex-rivera>,
        <https://w3id.org/sstim/organization/synthetic-aurora-lab>,
        <https://w3id.org/sstim/ecosystem-record/relationship/synthetic-alex-membership-aurora>,
        <https://w3id.org/sstim/implementation/bsclab/synthetic-ecosystem-player> ;
    void:dataDump <https://labiosyncare.github.io/ontology/instances/ecosystem/fixtures/synthetic-ecosystem.ttl> ;
    dcat:landingPage <https://github.com/laBioSynCare/laBioSynCare.github.io/tree/main/static/ontology/instances/ecosystem/fixtures> .
