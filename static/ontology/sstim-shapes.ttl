###########################################################################
#
#  SSTIM SHACL Shapes  —  sstim-shapes.ttl
#
#  Namespace:  https://w3id.org/sstim/shapes#
#  Version:    0.3.0
#  Date:       2026-06-17
#  Author:     Renato Fabbri <renato@junto.space>
#  License:    CC BY 4.0
#
#  SHACL validation shapes for presets, evidence claims, session
#  specifications, and voice specifications. The pre-commit hook and
#  the export pipeline run these shapes before any preset is committed
#  or exported to dist/presets.json.
#
#  Protected file — do not modify without explicit maintainer instruction.
#
###########################################################################

@prefix sstim:    <https://w3id.org/sstim#> .
@prefix sstim-v:  <https://w3id.org/sstim/vocab#> .
@prefix sstim-sh: <https://w3id.org/sstim/shapes#> .
@prefix sstim-ex: <https://w3id.org/sstim/exposure#> .

@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix dct:   <http://purl.org/dc/terms/> .


###########################################################################
# Preset Shape
###########################################################################

sstim-sh:PresetShape a sh:NodeShape ;
    sh:targetClass sstim:Preset ;
    sh:name "Preset"@en ;

    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Preset must have at least one rdfs:label."@en ;
    ] ;

    sh:property [
        sh:path sstim:targetsFrequencyBand ;
        sh:minCount 1 ;
        sh:maxCount 2 ;
        sh:class sstim:FrequencyBand ;
        sh:message "Preset must target 1–2 frequency bands from sstim:FrequencyBand."@en ;
    ] ;

    sh:property [
        sh:path sstim:inGroup ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class sstim:PresetGroup ;
        sh:message "Preset must belong to exactly one group from sstim:PresetGroup."@en ;
    ] ;

    sh:property [
        sh:path sstim:hasBreathGuide ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
        sh:message "Preset must declare hasBreathGuide as a boolean."@en ;
    ] ;

    sh:property [
        sh:path sstim:presetVersion ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^\\d+\\.\\d+\\.\\d+$" ;
        sh:message "presetVersion must be a semantic version string X.Y.Z."@en ;
    ] ;

    sh:property [
        sh:path sstim:composedOf ;
        sh:minCount 1 ;
        sh:class sstim:Voice ;
        sh:message "Preset must be composed of at least one Voice."@en ;
    ] ;

    # CLAUDE.md §4.5: hasBreathGuide is true iff exactly one composed voice is the
    # breathing reference (isBreathReference = true); at most one voice may be.
    # SHACL-SPARQL is required because the rule counts across the preset's voices —
    # a per-voice property shape cannot express it. Full IRIs avoid an sh:prefixes
    # block.
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "hasBreathGuide must be true iff exactly one composed voice has isBreathReference=true (found {?n} breathing-reference voice(s) for hasBreathGuide={?guide})."@en ;
        sh:select """
            SELECT $this ?guide (COUNT(?v) AS ?n) WHERE {
                $this <https://w3id.org/sstim#hasBreathGuide> ?guide .
                OPTIONAL {
                    $this <https://w3id.org/sstim#composedOf> ?v .
                    ?v <https://w3id.org/sstim#isBreathReference> true .
                }
            }
            GROUP BY $this ?guide
            HAVING ( ( ?guide && COUNT(?v) != 1 ) || ( !?guide && COUNT(?v) != 0 ) )
        """ ;
    ] .


###########################################################################
# Voice Shapes
###########################################################################

sstim-sh:VoiceShape a sh:NodeShape ;
    sh:targetClass sstim:Voice ;
    sh:name "Voice"@en ;
    # A Voice must be exactly one of the four disjoint subtypes. sh:xone enforces
    # this at the data level (pyshacl runs without OWL inference, so the
    # owl:AllDisjointClasses axiom alone would not be checked).
    sh:xone (
        [ sh:class sstim:BinauralVoice ]
        [ sh:class sstim:MartigliVoice ]
        [ sh:class sstim:MartigliBinauralVoice ]
        [ sh:class sstim:SymmetryVoice ]
    ) ;
    sh:message "Voice must be typed as exactly one of the four subtypes: Binaural, Martigli, Martigli-Binaural, or Symmetry."@en .


sstim-sh:BinauralVoiceShape a sh:NodeShape ;
    sh:targetClass sstim:BinauralVoice ;
    sh:name "BinauralVoice"@en ;

    sh:property [
        sh:path sstim:carrierFreqLeft ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minExclusive 0 ; sh:maxExclusive 1000 ;
        sh:message "fl must be a positive decimal less than 1000 Hz."@en ;
    ] ;

    sh:property [
        sh:path sstim:carrierFreqRight ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minExclusive 0 ; sh:maxExclusive 1000 ;
        sh:message "fr must be a positive decimal less than 1000 Hz."@en ;
    ] ;

    sh:property [
        sh:path sstim:initialVolume ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ; sh:maxExclusive 1 ;
        sh:message "iniVolume must be in [0, 1)."@en ;
    ] .


sstim-sh:SymmetryVoiceShape a sh:NodeShape ;
    sh:targetClass sstim:SymmetryVoice ;
    sh:name "SymmetryVoice"@en ;

    sh:property [
        sh:path sstim:baseFrequency ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 50 ;
        sh:message "f0 must be >= 50 Hz."@en ;
    ] ;

    sh:property [
        sh:path sstim:noteCount ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 2 ;
        sh:message "nnotes must be an integer >= 2."@en ;
    ] ;

    sh:property [
        sh:path sstim:octaveSpan ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
        sh:message "noctaves must be a non-negative decimal."@en ;
    ] ;

    sh:property [
        sh:path sstim:cycleDuration ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minExclusive 0 ;
        sh:message "d must be a positive decimal (seconds)."@en ;
    ] ;

    sh:property [
        sh:path sstim:permutationFunction ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ; sh:maxInclusive 4 ;
        sh:message "permfunc must be 0, 1, 2, 3, or 4."@en ;
    ] .


# Martigli & Martigli-Binaural voice parameter properties live in
# sstim-patch-studio.ttl (domain sstim:Voice); these shapes enforce which subtype
# requires which parameter. See ADR 0012 and docs/technical/{BREATHING_MODEL,
# MARTIGLI_BINAURAL}.md for parameter ranges.

sstim-sh:MartigliVoiceShape a sh:NodeShape ;
    sh:targetClass sstim:MartigliVoice ;
    sh:name "MartigliVoice"@en ;

    sh:property [
        sh:path sstim:martigliCenterFreq ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 80 ; sh:maxInclusive 400 ;
        sh:message "mf0 must be a decimal in [80, 400] Hz."@en ;
    ] ;
    sh:property [
        sh:path sstim:martigliAmplitude ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 1 ; sh:maxInclusive 400 ;
        sh:message "ma must be a decimal in [1, 400] Hz."@en ;
    ] ;
    sh:property [
        sh:path sstim:martigliPeriodInitial ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0.1 ; sh:maxInclusive 120 ;
        sh:message "mp0 must be a decimal in [0.1, 120] s."@en ;
    ] ;
    sh:property [
        sh:path sstim:martigliPeriodFinal ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0.1 ; sh:maxInclusive 240 ;
        sh:message "mp1 must be a decimal in [0.1, 240] s."@en ;
    ] ;
    sh:property [
        sh:path sstim:martigliTransitionDuration ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0.1 ; sh:maxInclusive 3600 ;
        sh:message "md must be a decimal in [0.1, 3600] s."@en ;
    ] ;
    sh:property [
        sh:path sstim:isBreathReference ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
        sh:message "isOn must be a boolean."@en ;
    ] ;
    sh:property [
        sh:path sstim:initialVolume ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ; sh:maxExclusive 1 ;
        sh:message "iniVolume must be in [0, 1)."@en ;
    ] ;
    # A Martigli voice is a single tone — the carrier pair belongs to Martigli-Binaural.
    sh:property [
        sh:path sstim:carrierFreqLeft ; sh:maxCount 0 ;
        sh:message "Martigli voice must not declare carrierFreqLeft (use Martigli-Binaural)."@en ;
    ] ;
    sh:property [
        sh:path sstim:carrierFreqRight ; sh:maxCount 0 ;
        sh:message "Martigli voice must not declare carrierFreqRight (use Martigli-Binaural)."@en ;
    ] ;
    # CLAUDE.md §4.5: when this voice is the breathing reference, mp0 must be >= 3 s.
    sh:or (
        [ sh:not [ sh:path sstim:isBreathReference ; sh:hasValue true ] ]
        [ sh:path sstim:martigliPeriodInitial ; sh:minInclusive 3 ]
    ) ;
    sh:message "When isOn=true (breathing reference), mp0 must be >= 3 s."@en .


sstim-sh:MartigliBinauralVoiceShape a sh:NodeShape ;
    sh:targetClass sstim:MartigliBinauralVoice ;
    sh:name "MartigliBinauralVoice"@en ;

    sh:property [
        sh:path sstim:carrierFreqLeft ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minExclusive 0 ; sh:maxExclusive 1000 ;
        sh:message "fl must be a positive decimal less than 1000 Hz."@en ;
    ] ;
    sh:property [
        sh:path sstim:carrierFreqRight ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minExclusive 0 ; sh:maxExclusive 1000 ;
        sh:message "fr must be a positive decimal less than 1000 Hz."@en ;
    ] ;
    sh:property [
        sh:path sstim:martigliAmplitude ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 1 ; sh:maxInclusive 400 ;
        sh:message "ma must be a decimal in [1, 400] Hz."@en ;
    ] ;
    sh:property [
        sh:path sstim:martigliPeriodInitial ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0.1 ; sh:maxInclusive 120 ;
        sh:message "mp0 must be a decimal in [0.1, 120] s."@en ;
    ] ;
    sh:property [
        sh:path sstim:martigliPeriodFinal ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0.1 ; sh:maxInclusive 240 ;
        sh:message "mp1 must be a decimal in [0.1, 240] s."@en ;
    ] ;
    sh:property [
        sh:path sstim:martigliTransitionDuration ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0.1 ; sh:maxInclusive 3600 ;
        sh:message "md must be a decimal in [0.1, 3600] s."@en ;
    ] ;
    sh:property [
        sh:path sstim:isBreathReference ;
        sh:minCount 1 ; sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
        sh:message "isOn must be a boolean."@en ;
    ] ;
    sh:property [
        sh:path sstim:initialVolume ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ; sh:maxExclusive 1 ;
        sh:message "iniVolume must be in [0, 1)."@en ;
    ] ;
    # Martigli-Binaural uses the carrier pair (fl/fr), not a single-tone center.
    sh:property [
        sh:path sstim:martigliCenterFreq ; sh:maxCount 0 ;
        sh:message "Martigli-Binaural voice must not declare martigliCenterFreq (uses the fl/fr carrier pair)."@en ;
    ] ;
    # CLAUDE.md §4.5: when this voice is the breathing reference, mp0 must be >= 3 s.
    sh:or (
        [ sh:not [ sh:path sstim:isBreathReference ; sh:hasValue true ] ]
        [ sh:path sstim:martigliPeriodInitial ; sh:minInclusive 3 ]
    ) ;
    sh:message "When isOn=true (breathing reference), mp0 must be >= 3 s."@en .


###########################################################################
# Evidence Claim Shape
###########################################################################

sstim-sh:EvidenceClaimShape a sh:NodeShape ;
    sh:targetClass sstim:EvidenceClaim ;
    sh:name "EvidenceClaim"@en ;

    sh:property [
        sh:path sstim:hasEvidenceTier ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class sstim:EvidenceTierValue ;
        sh:message "EvidenceClaim must have exactly one evidence tier from sstim:EvidenceTierValue."@en ;
    ] ;

    sh:property [
        sh:path sstim:hasModalityTag ;
        sh:minCount 1 ;
        sh:class sstim:EvidenceModalityTag ;
        sh:message "EvidenceClaim must have at least one modality tag from sstim:EvidenceModalityTag."@en ;
    ] .


###########################################################################
# Session Specification Shape
###########################################################################

sstim-sh:SessionSpecShape a sh:NodeShape ;
    sh:targetClass sstim:SessionSpecification ;
    sh:name "SessionSpecification"@en ;

    sh:property [
        sh:path sstim:referencesPreset ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class sstim:Preset ;
        sh:message "SessionSpecification must reference exactly one Preset."@en ;
    ] ;

    sh:property [
        sh:path sstim:durationSeconds ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 60 ;
        sh:maxInclusive 7200 ;
        sh:message "durationSeconds must be an integer between 60 and 7200."@en ;
    ] ;

    sh:property [
        sh:path sstim:masterVolume ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
        sh:maxInclusive 1 ;
        sh:message "masterVolume must be a decimal in [0, 1]."@en ;
    ] .


###########################################################################
# Session Instance Shape
###########################################################################

sstim-sh:SessionInstanceShape a sh:NodeShape ;
    sh:targetClass sstim:SessionInstance ;
    sh:name "SessionInstance"@en ;

    sh:property [
        sh:path sstim:usesSpecification ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class sstim:SessionSpecification ;
        sh:message "SessionInstance must use exactly one SessionSpecification."@en ;
    ] ;

    sh:property [
        sh:path sstim:actualDurationSeconds ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:message "actualDurationSeconds must be a non-negative integer."@en ;
    ] ;

    sh:property [
        sh:path sstim:completionStatus ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:in ( "completed" "interrupted" "abandoned" ) ;
        sh:message "completionStatus must be 'completed', 'interrupted', or 'abandoned'."@en ;
    ] .


###########################################################################
# Frequency Band Shape — validate hzMin <= hzMax (equality allowed for the
# single-point bands alpha-10 and gamma-40)
###########################################################################

sstim-sh:FrequencyBandShape a sh:NodeShape ;
    sh:targetClass sstim:FrequencyBand ;
    sh:name "FrequencyBand"@en ;

    sh:property [
        sh:path sstim:hzMin ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
        sh:lessThanOrEquals sstim:hzMax ;
        sh:message "FrequencyBand must have exactly one hzMin >= 0, and hzMin must be <= hzMax."@en ;
    ] ;

    sh:property [
        sh:path sstim:hzMax ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
        sh:message "FrequencyBand must have exactly one hzMax >= 0."@en ;
    ] .


###########################################################################
# Public-Safe Reference Shape
###########################################################################

sstim-sh:ReferenceShape a sh:NodeShape ;
    sh:targetClass sstim:PublicSafeReference ;
    sh:name "PublicSafeReference"@en ;

    sh:property [
        sh:path sstim:referenceKey ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:string ;
        sh:pattern "^[A-Z][A-Z0-9_]+_[0-9]{4}$" ;
        sh:message "referenceKey must match AUTHOR_YEAR pattern (e.g. INGENDOH_2023)."@en ;
    ] ;

    sh:property [
        sh:path dct:title ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "PublicSafeReference must have a dct:title."@en ;
    ] .

###########################################################################
# Self-Report Shape
#
# All fields are optional in the model (self-report is collected only with
# consent), so these constraints validate the value range when a field is
# present rather than requiring it.
###########################################################################

sstim-sh:SelfReportShape a sh:NodeShape ;
    sh:targetClass sstim:SelfReport ;
    sh:name "SelfReport"@en ;

    sh:property [
        sh:path sstim:primaryAffect ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1 ; sh:maxInclusive 5 ;
        sh:message "primaryAffect must be an integer 1–5."@en ;
    ] ;
    sh:property [
        sh:path sstim:focusRating ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1 ; sh:maxInclusive 5 ;
        sh:message "focusRating must be an integer 1–5."@en ;
    ] ;
    sh:property [
        sh:path sstim:sleepiness ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1 ; sh:maxInclusive 5 ;
        sh:message "sleepiness must be an integer 1–5."@en ;
    ] ;
    sh:property [
        sh:path sstim:subjectiveQuality ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 1 ; sh:maxInclusive 5 ;
        sh:message "subjectiveQuality must be an integer 1–5."@en ;
    ] ;
    sh:property [
        sh:path sstim:goalAchieved ;
        sh:maxCount 1 ;
        sh:datatype xsd:boolean ;
        sh:message "goalAchieved must be a boolean."@en ;
    ] .


###########################################################################
# Framework / Protocol / Implementation Shapes
#
# Minimal coverage: each must carry a human-readable rdfs:label, matching the
# label requirement already imposed on Preset. Closes the framework/protocol/
# implementation gap noted in docs/ontology/IMPROVEMENT_PLAN.md.
###########################################################################

sstim-sh:FrameworkShape a sh:NodeShape ;
    sh:targetClass sstim:SensoryStimulationFramework ;
    sh:name "SensoryStimulationFramework"@en ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:message "SensoryStimulationFramework must have at least one rdfs:label."@en ;
    ] .

sstim-sh:ProtocolShape a sh:NodeShape ;
    sh:targetClass sstim:SensoryStimulationProtocol ;
    sh:name "SensoryStimulationProtocol"@en ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:message "SensoryStimulationProtocol must have at least one rdfs:label."@en ;
    ] .

sstim-sh:ImplementationShape a sh:NodeShape ;
    sh:targetClass sstim:SensoryStimulationImplementation ;
    sh:name "SensoryStimulationImplementation"@en ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:message "SensoryStimulationImplementation must have at least one rdfs:label."@en ;
    ] .


###########################################################################
# Technique Shape (P1 item 1, partial)
#
# Every Sensory Stimulation Technique must declare a proposed mechanism, unless
# it is a catalogued non-evidence-bearing (folk) technique explicitly flagged
# with skos:editorialNote — sh:or admits either. Targets the base class;
# subclass instances (Entrainment-Based / Non-Entrainment) are covered via
# rdfs:subClassOf closure when the core ontology is in scope.
#
# Temporal-structure and delivery-modality requirements are intentionally NOT
# enforced here yet: the vocabulary techniques carry them, but the BSC framework
# technique instances do not (e.g. sstim-v:techUltrasoundNeuromod also lacks
# modality), so a rule would either break `make validate` (Violation) or require
# repo-wide --allow-warnings (Warning). Deferred to P2 item 4, which aligns the
# BSC framework technique instances with the vocabulary metadata model first.
###########################################################################

sstim-sh:TechniqueShape a sh:NodeShape ;
    sh:targetClass sstim:SensoryStimulationTechnique ;
    sh:name "SensoryStimulationTechnique"@en ;

    sh:or (
        [ sh:path sstim:proposedMechanism ; sh:minCount 1 ]
        [ sh:path skos:editorialNote ; sh:minCount 1 ]
    ) ;
    sh:message "Technique must declare a sstim:proposedMechanism, or be flagged as non-evidence-bearing with a skos:editorialNote."@en .


###########################################################################
# SKOS Concept Integrity Shape (P1 item 5, partial)
#
# Every controlled-vocabulary concept must sit in a scheme and carry an English
# preferred label (the cross-language anchor used by the knowledge browser).
# Top-concept structure for the remaining flat schemes is deferred (P2 item 1):
# several schemes still have no skos:hasTopConcept, so a top-concept rule would
# be premature and is tracked there instead.
###########################################################################

sstim-sh:ConceptIntegrityShape a sh:NodeShape ;
    sh:targetClass skos:Concept ;
    sh:name "SKOS Concept"@en ;

    sh:property [
        sh:path skos:inScheme ;
        sh:minCount 1 ;
        sh:message "Every skos:Concept must declare at least one skos:inScheme."@en ;
    ] ;
    sh:property [
        sh:path skos:prefLabel ;
        sh:qualifiedValueShape [ sh:languageIn ( "en" ) ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Every skos:Concept must have an English (@en) skos:prefLabel."@en ;
    ] .


###########################################################################
# Exposure module shapes (sstim-ex:)
#
# These target the exposure terms added in module 0.4.0 (ADR 0011). They are
# scoped narrowly to the new terms so that pre-0.4.0 committed instances are
# not retroactively invalidated. Runtime flicker enforcement lives in
# src/ui/safety/flashSafety.js; a conditional "UV/IR channel must declare an
# optical boundary" shape is tracked as future work in IMPROVEMENT_PLAN.
###########################################################################

sstim-sh:ExposureLimitShape a sh:NodeShape ;
    sh:targetClass sstim-ex:ExposureLimit ;
    sh:name "ExposureLimit"@en ;

    sh:property [
        sh:path sstim-ex:conformsToStandard ;
        sh:minCount 1 ;
        sh:message "ExposureLimit must cite at least one external standard via conformsToStandard."@en ;
    ] ;

    sh:property [
        sh:path sstim-ex:limitMaxFrequencyHz ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
        sh:message "limitMaxFrequencyHz must be a non-negative decimal (Hz)."@en ;
    ] ;

    sh:property [
        sh:path sstim-ex:limitValue ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
        sh:message "limitValue must be a non-negative decimal."@en ;
    ] .


# Any node carrying hasExposureLimit must point at a real ExposureLimit. This is
# safe across the per-file validation runs because it only targets subjects that
# actually use the property (the optical-radiation boundary's presence of a limit
# is asserted separately by the SPARQL sanity suite).
sstim-sh:ExposureLimitLinkShape a sh:NodeShape ;
    sh:targetSubjectsOf sstim-ex:hasExposureLimit ;
    sh:property [
        sh:path sstim-ex:hasExposureLimit ;
        sh:class sstim-ex:ExposureLimit ;
        sh:message "hasExposureLimit must point at an sstim-ex:ExposureLimit."@en ;
    ] .


# Range checks for the quantitative stimulus properties. Each shape targets only
# the subjects that actually use the property, so it never fires on instances
# that omit it.

sstim-sh:FlickerRateShape a sh:NodeShape ;
    sh:targetSubjectsOf sstim-ex:hasFlickerRateHz ;
    sh:property [
        sh:path sstim-ex:hasFlickerRateHz ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
        sh:message "hasFlickerRateHz must be a non-negative decimal (Hz)."@en ;
    ] .

sstim-sh:FrequencyShape a sh:NodeShape ;
    sh:targetSubjectsOf sstim-ex:hasFrequencyHz ;
    sh:property [
        sh:path sstim-ex:hasFrequencyHz ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
        sh:message "hasFrequencyHz must be a non-negative decimal (Hz)."@en ;
    ] .

sstim-sh:BeatFrequencyShape a sh:NodeShape ;
    sh:targetSubjectsOf sstim-ex:hasBeatFrequencyHz ;
    sh:property [
        sh:path sstim-ex:hasBeatFrequencyHz ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
        sh:message "hasBeatFrequencyHz must be a non-negative decimal (Hz)."@en ;
    ] .

sstim-sh:DutyCycleShape a sh:NodeShape ;
    sh:targetSubjectsOf sstim-ex:hasDutyCycle ;
    sh:property [
        sh:path sstim-ex:hasDutyCycle ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
        sh:maxInclusive 1 ;
        sh:message "hasDutyCycle must be a decimal in [0, 1]."@en ;
    ] .

sstim-sh:GainLevelShape a sh:NodeShape ;
    sh:targetSubjectsOf sstim-ex:hasGainLevel ;
    sh:property [
        sh:path sstim-ex:hasGainLevel ;
        sh:datatype xsd:decimal ;
        sh:minInclusive 0 ;
        sh:maxInclusive 1 ;
        sh:message "hasGainLevel must be a decimal in [0, 1]."@en ;
    ] .


