###########################################################################
# Characteristic delivery media
###########################################################################

sstim-v:techASMR sstim-ex:characteristicDeliveryMedium sstim-ex:mediumAirConductedSound .

sstim-v:techAcousticStartle sstim-ex:characteristicDeliveryMedium sstim-ex:mediumAirConductedSound .

sstim-v:techAmplitudeModulation sstim-ex:characteristicDeliveryMedium sstim-ex:mediumAirConductedSound .

sstim-v:techAudioTactile sstim-ex:characteristicDeliveryMedium sstim-ex:mediumAirConductedSound, sstim-ex:mediumMechanicalVibration .

sstim-v:techAudiovisualEntrainment sstim-ex:characteristicDeliveryMedium sstim-ex:mediumAirConductedSound, sstim-ex:mediumVisualLight .

sstim-v:techAuditoryIllusion sstim-ex:characteristicDeliveryMedium sstim-ex:mediumAirConductedSound .

sstim-v:techBinauralBeats sstim-ex:characteristicDeliveryMedium sstim-ex:mediumAirConductedSound .

sstim-v:techBroadbandNoise sstim-ex:characteristicDeliveryMedium sstim-ex:mediumAirConductedSound .

sstim-v:techClickTrain sstim-ex:characteristicDeliveryMedium sstim-ex:mediumAirConductedSound .

sstim-v:techClosedLoopAuditory sstim-ex:characteristicDeliveryMedium sstim-ex:mediumAirConductedSound .

sstim-v:techColorFieldStimulation sstim-ex:characteristicDeliveryMedium sstim-ex:mediumVisualLight .

sstim-v:techDBS sstim-ex:characteristicDeliveryMedium sstim-ex:mediumAppliedElectricCurrent .

sstim-v:techFractalRhythm sstim-ex:characteristicDeliveryMedium sstim-ex:mediumAirConductedSound .

sstim-v:techFrequencyModulation sstim-ex:characteristicDeliveryMedium sstim-ex:mediumAirConductedSound .

sstim-v:techGamma40Auditory sstim-ex:characteristicDeliveryMedium sstim-ex:mediumAirConductedSound .

sstim-v:techIntrathecalNeuromodulatoryAgentDelivery sstim-ex:characteristicDeliveryMedium sstim-ex:mediumPharmacologicalAgent .

sstim-v:techIsochronicTones sstim-ex:characteristicDeliveryMedium sstim-ex:mediumAirConductedSound .

sstim-v:techMonauralBeats sstim-ex:characteristicDeliveryMedium sstim-ex:mediumAirConductedSound .

sstim-v:techMusicStructural sstim-ex:characteristicDeliveryMedium sstim-ex:mediumAirConductedSound .

sstim-v:techNotchedSound sstim-ex:characteristicDeliveryMedium sstim-ex:mediumAirConductedSound .

sstim-v:techPhoticDriving sstim-ex:characteristicDeliveryMedium sstim-ex:mediumVisualLight .

sstim-v:techReferencePitchRetuning sstim-ex:characteristicDeliveryMedium sstim-ex:mediumAirConductedSound .

sstim-v:techRepetitiveTMS sstim-ex:characteristicDeliveryMedium sstim-ex:mediumAppliedMagneticField, sstim-ex:mediumAppliedElectricField .

sstim-v:techRhythmicAuditoryCueing sstim-ex:characteristicDeliveryMedium sstim-ex:mediumAirConductedSound .

sstim-v:techRoughness sstim-ex:characteristicDeliveryMedium sstim-ex:mediumAirConductedSound .

sstim-v:techSolfeggioTuning sstim-ex:characteristicDeliveryMedium sstim-ex:mediumAirConductedSound .

sstim-v:techSonification sstim-ex:characteristicDeliveryMedium sstim-ex:mediumAirConductedSound .

sstim-v:techSpatialAuditory sstim-ex:characteristicDeliveryMedium sstim-ex:mediumAirConductedSound .

sstim-v:techSubliminalAudio sstim-ex:characteristicDeliveryMedium sstim-ex:mediumAirConductedSound .

sstim-v:techTACS sstim-ex:characteristicDeliveryMedium sstim-ex:mediumAppliedElectricCurrent .

sstim-v:techTDCS sstim-ex:characteristicDeliveryMedium sstim-ex:mediumAppliedElectricCurrent .

sstim-v:techUltrasoundNeuromod sstim-ex:characteristicDeliveryMedium sstim-ex:mediumFocusedUltrasound .

sstim-v:techVagusNerveStimulation sstim-ex:characteristicDeliveryMedium sstim-ex:mediumAppliedElectricCurrent .

sstim-v:techVibroacoustic sstim-ex:characteristicDeliveryMedium sstim-ex:mediumAirConductedSound, sstim-ex:mediumContactAcousticVibration .

sstim-v:techVibrotactileEntrainment sstim-ex:characteristicDeliveryMedium sstim-ex:mediumMechanicalVibration .

sstim-v:techVoiceMantra sstim-ex:characteristicDeliveryMedium sstim-ex:mediumAirConductedSound .

sstim-v:techElectroconvulsiveTherapy sstim-ex:characteristicDeliveryMedium sstim-ex:mediumAppliedElectricCurrent .

sstim-v:techNeurofeedback sstim-ex:characteristicDeliveryMedium sstim-ex:mediumVisualLight, sstim-ex:mediumAirConductedSound .

sstim-v:techBiofeedback sstim-ex:characteristicDeliveryMedium sstim-ex:mediumVisualLight, sstim-ex:mediumAirConductedSound .


