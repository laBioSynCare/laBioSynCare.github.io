sstim-v:systemProprioceptive skos:closeMatch uberon:0025533 .

[] a owl:Axiom ;
    owl:annotatedSource sstim-v:systemProprioceptive ;
    owl:annotatedProperty skos:closeMatch ;
    owl:annotatedTarget uberon:0025533 ;
    dct:source <http://purl.obolibrary.org/obo/UBERON_0025533> ;
