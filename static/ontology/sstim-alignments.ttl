    owl:annotatedTarget wd:Q2370623 ;
    dct:source <http://www.wikidata.org/entity/Q2370623> ;
    dct:date "2026-08-15"^^xsd:date ;
    prov:wasAttributedTo <https://orcid.org/0000-0002-9699-629X> ;
    skos:editorialNote "Upgraded from closeMatch on the band to exactMatch on the rhythm (ADR 0049). The item describes a neural oscillation, which is what this concept now names; the earlier closeMatch was forced by the subject being a Hz interval. Quoted numeric bounds differ only as delimiting conventions differ."@en .

[] a owl:Axiom ;
