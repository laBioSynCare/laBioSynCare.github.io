###########################################################################
# Module metadata
###########################################################################

<https://w3id.org/sstim/alignments> a owl:Ontology ;
    owl:versionInfo "0.14.0-dev" ;
    dct:title "SSTIM External Alignments"@en ;
    dct:description "Conservatively scoped mappings from SSTIM classes and concepts to verified Wikidata and OBO Foundry resources."@en ;
    dct:isPartOf <https://w3id.org/sstim> ;
    dct:requires <https://w3id.org/sstim/common>, <https://w3id.org/sstim/evidence>, <https://w3id.org/sstim/session>, <https://w3id.org/sstim/technique>, <https://w3id.org/sstim/vocab> ;
    dct:creator <https://orcid.org/0000-0002-9699-629X> ;
    dct:publisher <https://github.com/laBioSynCare> ;
    dct:created "2026-04-12"^^xsd:date ;
    dct:issued "2026-08-04"^^xsd:date ;
    dct:modified "2026-08-04"^^xsd:date ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    skos:historyNote "0.6.0 narrows mappings that had conflated SSTIM's domain with brainwave-entrainment or therapy concepts, removes an unverified Music Ontology association, records the corrected MeSH audit, removes obsolete OBI_0000011, and limits OBI protocol alignment to the actual SSTIM protocol class."@en .


###########################################################################
# Wikidata alignments — frequency bands
###########################################################################

# All QIDs below were verified against live Wikidata (2026-06). The prior
# QIDs in this section were incorrect (they resolved to unrelated entities
# such as a Van Halen album and a stock exchange) and were replaced.
#
# Re-audited 2026-07-24 (RDF-08/RDF-17, 2026-07-24 audit; reviewer: Renato
# Fabbri). Downgraded exactMatch to closeMatch: each Wikidata item is the
# observed-EEG-oscillation sense of the band (a neurophysiological phenomenon),
# while sstim-v:alpha/delta/theta/beta/gamma are also used, unsplit, as
# stimulus-frequency targets (sstim:targetsFrequencyBand). SSTIM's own
# FrequencyBandScheme currently conflates those two senses (RDF-08); until
# they are split into distinct classes, extensional identity with the
# single-sense Wikidata items cannot be claimed with exactMatch's confidence.
# Revisit once RDF-08's oscillation-band/stimulus-target split lands.

# alpha wave: https://www.wikidata.org/wiki/Q2469782
sstim-v:alpha skos:closeMatch wd:Q2469782 .

# delta wave: https://www.wikidata.org/wiki/Q2623205
sstim-v:delta skos:closeMatch wd:Q2623205 .

# theta rhythm: https://www.wikidata.org/wiki/Q2370623
sstim-v:theta skos:closeMatch wd:Q2370623 .

# beta wave: https://www.wikidata.org/wiki/Q831014
sstim-v:beta skos:closeMatch wd:Q831014 .

# gamma wave: https://www.wikidata.org/wiki/Q2623017
sstim-v:gamma skos:closeMatch wd:Q2623017 .

# A BSC binaural voice is a parameter bundle that can realize binaural beats;
# it is not identical to the perceptual phenomenon or musical genre represented
# by Wikidata Q863539.
sstim-v:voiceBinaural skos:relatedMatch wd:Q863539 .

# isochronic tones: https://www.wikidata.org/wiki/Q98000061
sstim-v:voiceSymmetry skos:relatedMatch wd:Q98000061 .

# Technique vocabulary alignments (QIDs verified against live Wikidata, 2026-06).
# Other techniques (monaural beats, RAS, ASSR, vibroacoustic, ultrasound
# neuromodulation, etc.) are pending Wikidata alignment — tracked in TODO.md.
sstim-v:techIsochronicTones skos:closeMatch wd:Q98000061 .
sstim-v:techBinauralBeats skos:exactMatch wd:Q863539 .

# Multisensory integration: verified Wikidata concept Q17166073. SSTIM's term
# is a proposed-mechanism category, so relatedMatch is intentionally weaker
# than exactMatch.
sstim-v:mechMultisensory skos:relatedMatch wd:Q17166073 .

# Note: Wikidata items for Martigli oscillation, Sonic Symmetry permutation
# technique, and the SSTIM ontology itself are pending — Wikidata contribution
# work item tracked in TODO.md.


###########################################################################
# OBO Foundry class alignments
###########################################################################

# Sensory stimulation intervention → planned process.
# OBI_0000011 is obsolete and must not appear in live logical axioms. SSTIM
# uses the active, broader COB_0000082 'planned process' term because an
# intervention need not be completely executed (verified via OLS, 2026-07-10).
sstim:SensoryStimulationIntervention rdfs:subClassOf cob:0000082 .

# Technique → information content entity. OBI_0000272 requires enough detail
# for independent process reproduction; a reusable technique category is less
# specific and is therefore not an OBI protocol (ADR 0014 review disposition).
sstim:SensoryStimulationTechnique rdfs:subClassOf iao:0000030 .

# Protocol → OBI protocol. A preset is an information content entity that FOLLOWS
# a protocol via sstim:followsProtocol; it is not itself a protocol (see ADR 0014).
sstim:SensoryStimulationProtocol rdfs:subClassOf obi:0000272 .

# Session instance → PROV Activity (stated in sstim-session.ttl; repeated here
# for cross-reference in alignment context)
# sstim:SessionInstance rdfs:subClassOf prov:Activity .

# Evidence claim → IAO information content entity.
# (Was iao:0000001 'conditional specification' — wrong; an evidence claim is
# not a conditional specification. iao:0000030 is the correct generalization.)
sstim:EvidenceClaim rdfs:subClassOf iao:0000030 .

# Frequency band → IAO information content entity
sstim:FrequencyBand rdfs:subClassOf iao:0000030 .

# Reference → IAO document
sstim:PublicSafeReference rdfs:subClassOf iao:0000030 .

# SSTIM controlled-value classes (including SensoryModality,
# StimulationMechanism, and IntendedEffect) are information categories, not
# the real-world roles, processes, or dispositions they classify (ADR 0021).

# ECO (Evidence & Conclusion Ontology) classifies evidence by TYPE / provenance,
# not by strength, so it has no clean match for the SSTIM evidence-tier concepts
# (speculative…established), which are GRADE-style strength grades. The former
# `sstim-v:tierEstablished skos:closeMatch eco:0006151` mapping was removed:
# ECO_0006151 is "documented statement evidence", not a systematic review, and
# ECO has no review/meta-analysis strength term. Left unmapped intentionally.


###########################################################################
# External upper-ontology term labels (display stubs)
#
# Local rdfs:label assertions for the external BFO/OBI/IAO IRIs referenced
# above and across the semantic dependency modules, so the knowledge browser
# renders readable
# names instead of opaque numeric IRIs. These are display aids, not
# authoritative definitions — the canonical labels live in BFO/OBI/IAO.
###########################################################################

bfo:0000015 rdfs:label "process"@en .
bfo:0000016 rdfs:label "disposition"@en .
obi:0000272 rdfs:label "protocol"@en .
cob:0000082 rdfs:label "planned process"@en .
iao:0000030 rdfs:label "information content entity"@en .


