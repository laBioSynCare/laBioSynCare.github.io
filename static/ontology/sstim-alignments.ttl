    skos:editorialNote "A thin Wikidata item: it names the technique but supplies little intension, so closeMatch is the strongest defensible assertion."@en .

[] a owl:Axiom ;
    owl:annotatedSource sstim-v:techBinauralBeats ;
    owl:annotatedProperty skos:relatedMatch ;
    owl:annotatedTarget wd:Q863539 ;
    dct:source <http://www.wikidata.org/entity/Q863539> ;
    dct:date "2026-08-08"^^xsd:date ;
