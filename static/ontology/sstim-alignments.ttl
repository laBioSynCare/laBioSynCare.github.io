[] a owl:Axiom ;
    owl:annotatedSource sstim-v:techIsochronicTones ;
    owl:annotatedProperty skos:closeMatch ;
    owl:annotatedTarget wd:Q98000061 ;
    dct:source <http://www.wikidata.org/entity/Q98000061> ;
    dct:date "2026-08-08"^^xsd:date ;
    prov:wasAttributedTo <https://orcid.org/0000-0002-9699-629X> ;
    skos:editorialNote "The Wikidata item names the same technique. closeMatch rather than exactMatch because the item carries no definition boundary against neighbouring pulsed-tone techniques."@en .

[] a owl:Axiom ;
    owl:annotatedSource sstim-v:techMonauralBeats ;
    owl:annotatedProperty skos:closeMatch ;
    owl:annotatedTarget wd:Q6898437 ;
