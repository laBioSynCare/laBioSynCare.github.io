    owl:annotatedSource sstim-ex:mediumUltravioletRadiation ;
    owl:annotatedProperty skos:closeMatch ;
    owl:annotatedTarget mesh:D014466 ;
    dct:source <http://id.nlm.nih.gov/mesh/D014466> ;
