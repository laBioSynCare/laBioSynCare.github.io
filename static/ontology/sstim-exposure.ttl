    skos:topConceptOf sstim-ex:EffectDimensionScheme ;
    skos:prefLabel "body vibration"@en ;
    skos:notation "body-vibration" .

sstim-ex:effectImmersion a owl:NamedIndividual, sstim-ex:EffectDimension, skos:Concept ;
    skos:inScheme sstim-ex:EffectDimensionScheme ;
    skos:topConceptOf sstim-ex:EffectDimensionScheme ;
    skos:prefLabel "immersion"@en ;
    skos:notation "immersion" .

sstim-ex:effectSpatialPresence a owl:NamedIndividual, sstim-ex:EffectDimension, skos:Concept ;
