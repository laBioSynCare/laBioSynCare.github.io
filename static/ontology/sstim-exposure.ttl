###########################################################################
# Exposure limits (quantified safety thresholds, citing external standards)
#
# These record recognized thresholds against which a delivery is checked.
# They do not assert that any delivery is safe; runtime enforcement of the
# flicker limit lives in src/ui/safety/flashSafety.js (ADR 0011).
###########################################################################

sstim-ex:limitFlickerWcag a owl:NamedIndividual, sstim-ex:ExposureLimit ;
    rdfs:label "general-safe flash-rate limit"@en ;
    sstim-ex:limitQuantity "flash frequency" ;
    sstim-ex:limitMaxFrequencyHz "3"^^xsd:decimal ;
    sstim-ex:limitUnit "Hz" ;
    sstim-ex:appliesToPlacement sstim-ex:placementEyes ;
    sstim-ex:conformsToStandard <https://www.w3.org/TR/WCAG21/#three-flashes-or-below-threshold> ,
        <https://www.itu.int/rec/R-REC-BT.1702> ;
    skos:definition "No more than three general or red flashes per second; flashing above this rate (peak provocation roughly 15–25 Hz) requires explicit caution. Derived from WCAG 2.3.1 and ITU-R BT.1702 / Harding guidance."@en .

sstim-ex:limitHearingNiosh a owl:NamedIndividual, sstim-ex:ExposureLimit ;
    rdfs:label "recommended sound-exposure limit"@en ;
    sstim-ex:limitQuantity "sound pressure level" ;
    sstim-ex:limitValue "85"^^xsd:decimal ;
    sstim-ex:limitUnit "dBA" ;
    sstim-ex:limitAveragingTime "PT8H"^^xsd:duration ;
    sstim-ex:appliesToPlacement sstim-ex:placementEars ;
    sstim-ex:conformsToStandard <https://www.cdc.gov/niosh/topics/noise/> ;
    skos:definition "85 dBA averaged over 8 hours, with a 3 dB exchange rate (each +3 dB halves the safe duration). Derived from NIOSH recommended exposure limits. BSC Lab cannot measure delivered sound pressure level and treats this as advisory."@en .

sstim-ex:limitUvActinicIec a owl:NamedIndividual, sstim-ex:ExposureLimit ;
    rdfs:label "actinic ultraviolet exposure limit"@en ;
    sstim-ex:limitQuantity "effective radiant exposure" ;
    sstim-ex:limitValue "30"^^xsd:decimal ;
    sstim-ex:limitUnit "J/m2" ;
    sstim-ex:limitAveragingTime "PT8H"^^xsd:duration ;
    sstim-ex:appliesToPlacement sstim-ex:placementEyes , sstim-ex:placementWholeBody ;
    sstim-ex:conformsToStandard <https://webstore.iec.ch/publication/7076> ;
    skos:definition "Approximately 30 J/m2 spectrally-weighted effective ultraviolet radiant exposure per day for skin and eye, with photobiological risk groups per IEC 62471 and ICNIRP. Eyes are more vulnerable than skin. BSC Lab does not deliver ultraviolet radiation at the body."@en .


###########################################################################
# End of sstim-exposure.ttl
###########################################################################
