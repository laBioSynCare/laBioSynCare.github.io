@prefix sstim:    <https://w3id.org/sstim#> .
@prefix sstim-ex: <https://w3id.org/sstim/exposure#> .
@prefix sstim-v:  <https://w3id.org/sstim/vocab#> .

@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix iao:   <http://purl.obolibrary.org/obo/IAO_> .


###########################################################################
# Module metadata
###########################################################################

<https://w3id.org/sstim/exposure> a owl:Ontology ;
    owl:versionInfo "0.3.0" ;
    dct:title "SSTIM Exposure and Experiment Module"@en ;
    dct:description "Reusable SSTIM module for separating physical delivery medium, perceived modality, device capability, body placement, comfort boundary, experiment context, effect claims, and knowledge status."@en ;
    dct:isPartOf <https://w3id.org/sstim> ;
    dct:creator <https://orcid.org/0000-0002-9699-629X> ;
    dct:created "2026-06-18"^^xsd:date ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    rdfs:seeAlso <https://github.com/laBioSynCare/laBioSynCare.github.io/blob/main/docs/decisions/0010-exposure-delivery-modality.md> ;
    skos:historyNote "Initial exposure module for post-0.3.0 ontology work. The module does not assert physiological or health effects directly; those statements must be modeled as qualified claims with evidence or knowledge status."@en .


###########################################################################
# Core classes
###########################################################################

sstim-ex:ExposureProfile a owl:Class ;
    rdfs:subClassOf iao:0000030 ;
    rdfs:label "Exposure Profile"@en ;
    skos:definition "Information artifact describing how one exploratory or operational sensory-stimulation exposure is delivered, perceived, placed, bounded, and interpreted."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> ;
    rdfs:seeAlso <https://github.com/laBioSynCare/laBioSynCare.github.io/blob/main/docs/decisions/0010-exposure-delivery-modality.md> .

sstim-ex:StimulusChannel a owl:Class ;
    rdfs:subClassOf iao:0000030 ;
    rdfs:label "Stimulus Channel"@en ;
    skos:definition "A channel within an exposure profile, such as an audio, visual, haptic, respiratory, olfactory, gustatory, or electromagnetic exposure path."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:PhysicalDeliveryMedium a owl:Class ;
    rdfs:subClassOf iao:0000030 ;
    rdfs:label "Physical Delivery Medium"@en ;
    skos:definition "Controlled vocabulary class for the physical medium, energy, material, or environmental interface through which a stimulus or exposure reaches a person."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:PerceivedModality a owl:Class ;
    rdfs:subClassOf iao:0000030 ;
    rdfs:label "Perceived Modality"@en ;
    skos:definition "Controlled vocabulary class for the sensory, perceptual, behavioral, interoceptive, or social-perceptual channel engaged by an exposure."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:DeviceCapability a owl:Class ;
    rdfs:subClassOf iao:0000030 ;
    rdfs:label "Device Capability"@en ;
    skos:definition "Controlled vocabulary class for hardware or environmental capabilities required to deliver, separate, sense, or shape an exposure."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:BodyPlacement a owl:Class ;
    rdfs:subClassOf iao:0000030 ;
    rdfs:label "Body Placement"@en ;
    skos:definition "Controlled vocabulary class for where a device, medium, or exposure is placed on, in, or near the body."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:ComfortBoundary a owl:Class ;
    rdfs:subClassOf iao:0000030 ;
    rdfs:label "Comfort Boundary"@en ;
    skos:definition "A boundary or caution condition for comfort, discomfort, awareness, fatigue, or risk during an exposure."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:ExposureEffectClaim a owl:Class ;
    rdfs:subClassOf sstim:EvidenceClaim ;
    rdfs:label "Exposure Effect Claim"@en ;
    skos:definition "Qualified claim about a hypothesized, measured, observed, or risk-related effect dimension of an exposure. This class is used instead of direct unqualified health-benefit properties."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> ;
    rdfs:seeAlso <https://github.com/laBioSynCare/laBioSynCare.github.io/blob/main/docs/decisions/0010-exposure-delivery-modality.md> .

sstim-ex:ExperimentContext a owl:Class ;
    rdfs:subClassOf iao:0000030 ;
    rdfs:label "Experiment Context"@en ;
    skos:definition "Information artifact describing the local context of an exploratory protocol or exposure example."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:BiohackingContext a owl:Class ;
    rdfs:subClassOf sstim-ex:ExperimentContext ;
    rdfs:label "Biohacking Context"@en ;
    skos:definition "Experiment context for exploratory self-observation, sensory experimentation, or non-clinical biohacking practice."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:ExploratoryProtocol a owl:Class ;
    rdfs:subClassOf sstim:SensoryStimulationProtocol ;
    rdfs:label "Exploratory Protocol"@en ;
    skos:definition "Non-clinical protocol used to explore an exposure idea, capability boundary, or perceptual hypothesis without asserting treatment, diagnosis, cure, or guaranteed effect."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:PerceptualGain a owl:Class ;
    rdfs:subClassOf iao:0000030 ;
    rdfs:label "Perceptual Gain"@en ;
    skos:definition "A perceived capability, salience, immersion, or access gained by an exposure setup."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:PerceptualLoss a owl:Class ;
    rdfs:subClassOf iao:0000030 ;
    rdfs:label "Perceptual Loss"@en ;
    skos:definition "A perceived field, awareness, comfort, capability, or certainty lost or reduced by an exposure setup."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:KnowledgeStatus a owl:Class ;
    rdfs:subClassOf iao:0000030 ;
    rdfs:label "Knowledge Status"@en ;
    skos:definition "Local status vocabulary for distinguishing known SSTIM patterns, hypotheses, unknowns, lack of known SSTIM evidence, and BSC Lab capability boundaries."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:StimulusPattern a owl:Class ;
    rdfs:subClassOf iao:0000030 ;
    rdfs:label "Stimulus Pattern"@en ;
    skos:definition "Controlled vocabulary class for temporal, spatial, color, or stochastic stimulus patterns."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:AudioNoiseColor a owl:Class ;
    rdfs:subClassOf sstim-ex:StimulusPattern ;
    rdfs:label "Audio Noise Color"@en ;
    skos:definition "Controlled vocabulary class for named audio-noise color conventions. Names vary across communities and should be defined by spectral slope when possible."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:VisualNoiseType a owl:Class ;
    rdfs:subClassOf sstim-ex:StimulusPattern ;
    rdfs:label "Visual Noise Type"@en ;
    skos:definition "Controlled vocabulary class for visual noise, visual field, and simple visual stimulus types."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:EffectDimension a owl:Class ;
    rdfs:subClassOf iao:0000030 ;
    rdfs:label "Effect Dimension"@en ;
    skos:definition "Controlled vocabulary class for dimensions that an exposure effect claim can concern, including comfort, risk, perception, and physiological measures."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .


###########################################################################
# Core properties
###########################################################################

sstim-ex:hasExposureProfile a owl:ObjectProperty ;
    rdfs:range sstim-ex:ExposureProfile ;
    rdfs:label "has exposure profile"@en ;
    skos:definition "Links a protocol, technique, preset, or experiment instance to a structured exposure profile."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:usesStimulusChannel a owl:ObjectProperty ;
    rdfs:domain sstim-ex:ExposureProfile ;
    rdfs:range sstim-ex:StimulusChannel ;
    rdfs:label "uses stimulus channel"@en ;
    skos:definition "Links an exposure profile to a channel through which part of the exposure is delivered or modeled."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:deliveryMedium a owl:ObjectProperty ;
    rdfs:domain sstim-ex:StimulusChannel ;
    rdfs:range sstim-ex:PhysicalDeliveryMedium ;
    rdfs:label "delivery medium"@en ;
    skos:definition "Links a stimulus channel to the physical medium, energy, material, or interface used for delivery."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:perceivedModality a owl:ObjectProperty ;
    rdfs:domain sstim-ex:StimulusChannel ;
    rdfs:range sstim-ex:PerceivedModality ;
    rdfs:label "perceived modality"@en ;
    skos:definition "Links a stimulus channel to the sensory, perceptual, behavioral, interoceptive, or social-perceptual modality it engages."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:requiresDeviceCapability a owl:ObjectProperty ;
    rdfs:range sstim-ex:DeviceCapability ;
    rdfs:label "requires device capability"@en ;
    skos:definition "Links an exposure profile, stimulus channel, or protocol to a hardware or environmental capability required for delivery."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:hasBodyPlacement a owl:ObjectProperty ;
    rdfs:range sstim-ex:BodyPlacement ;
    rdfs:label "has body placement"@en ;
    skos:definition "Links an exposure profile, stimulus channel, or capability to a body or near-body placement."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:hasComfortBoundary a owl:ObjectProperty ;
    rdfs:range sstim-ex:ComfortBoundary ;
    rdfs:label "has comfort boundary"@en ;
    skos:definition "Links an exposure profile or stimulus channel to a comfort, discomfort, fatigue, awareness, or risk boundary."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:hasPerceptualGain a owl:ObjectProperty ;
    rdfs:range sstim-ex:PerceptualGain ;
    rdfs:label "has perceptual gain"@en ;
    skos:definition "Links an exposure profile or protocol to a perceived gain created by the setup."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:hasPerceptualLoss a owl:ObjectProperty ;
    rdfs:range sstim-ex:PerceptualLoss ;
    rdfs:label "has perceptual loss"@en ;
    skos:definition "Links an exposure profile or protocol to a perceived loss, cost, or limitation created by the setup."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:hasEffectClaim a owl:ObjectProperty ;
    rdfs:range sstim-ex:ExposureEffectClaim ;
    rdfs:label "has effect claim"@en ;
    skos:definition "Links an exposure profile or protocol to a qualified effect, measurement, hypothesis, or risk claim."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:hasExperimentContext a owl:ObjectProperty ;
    rdfs:range sstim-ex:ExperimentContext ;
    rdfs:label "has experiment context"@en ;
    skos:definition "Links an exploratory protocol or exposure profile to the context in which it is proposed or used."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:hasKnowledgeStatus a owl:ObjectProperty ;
    rdfs:range sstim-ex:KnowledgeStatus ;
    rdfs:label "has knowledge status"@en ;
    skos:definition "Links a protocol, exposure profile, channel, capability, or claim to its local SSTIM/BSC Lab knowledge or capability status."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:hasStimulusPattern a owl:ObjectProperty ;
    rdfs:domain sstim-ex:StimulusChannel ;
    rdfs:range sstim-ex:StimulusPattern ;
    rdfs:label "has stimulus pattern"@en ;
    skos:definition "Links a stimulus channel to a temporal, spatial, color, noise, or texture pattern."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .

sstim-ex:concernsEffectDimension a owl:ObjectProperty ;
    rdfs:domain sstim-ex:ExposureEffectClaim ;
    rdfs:range sstim-ex:EffectDimension ;
    rdfs:label "concerns effect dimension"@en ;
    skos:definition "Links an exposure effect claim to the comfort, risk, perception, or physiological dimension it concerns."@en ;
    rdfs:isDefinedBy <https://w3id.org/sstim/exposure> .


###########################################################################
# Controlled vocabulary schemes
###########################################################################

sstim-ex:DeliveryMediumScheme a skos:ConceptScheme ;
    skos:prefLabel "Delivery Medium Scheme"@en ;
    skos:definition "Physical media, energies, materials, and interfaces used to deliver or model an exposure."@en ;
    skos:hasTopConcept
        sstim-ex:mediumAirConductedSound,
        sstim-ex:mediumContactAcousticVibration,
        sstim-ex:mediumMechanicalVibration,
        sstim-ex:mediumVisualLight,
        sstim-ex:mediumElectromagneticField,
        sstim-ex:mediumRespiratoryCue,
        sstim-ex:mediumStereoscopicVisualPresentation,
        sstim-ex:mediumOlfactoryChemicalExposure,
        sstim-ex:mediumGustatoryChemicalExposure,
        sstim-ex:mediumLiquidGelImmersion,
        sstim-ex:mediumTextileClothingContact,
        sstim-ex:mediumRigidSurfaceContact,
        sstim-ex:mediumThermalContact,
        sstim-ex:mediumAirflow,
        sstim-ex:mediumFluidMotion .

sstim-ex:PerceivedModalityScheme a skos:ConceptScheme ;
    skos:prefLabel "Perceived Modality Scheme"@en ;
    skos:definition "Perceived or engaged modalities for SSTIM exposure profiles."@en ;
    skos:hasTopConcept
        sstim-ex:modalityAuditory,
        sstim-ex:modalityVisual,
        sstim-ex:modalityTactile,
        sstim-ex:modalitySomatosensory,
        sstim-ex:modalityInteroceptive,
        sstim-ex:modalityVestibular,
        sstim-ex:modalityProprioceptive,
        sstim-ex:modalityOlfactory,
        sstim-ex:modalityGustatory,
        sstim-ex:modalitySocialPerceptual,
        sstim-ex:modalityMultimodal,
        sstim-ex:modalityNotDirectlyPerceived .

sstim-ex:DeviceCapabilityScheme a skos:ConceptScheme ;
    skos:prefLabel "Device Capability Scheme"@en ;
    skos:definition "Hardware and environmental capabilities required for SSTIM exposure delivery, separation, sensing, or immersion."@en ;
    skos:hasTopConcept
        sstim-ex:capabilityHeadphones,
        sstim-ex:capabilityHrtfSpatialAudio,
        sstim-ex:capabilityStereoSeparation,
        sstim-ex:capabilityDisplayLightOutput,
        sstim-ex:capabilityDisplayFlicker,
        sstim-ex:capabilityFreeViewStereoscopy,
        sstim-ex:capabilityVrHeadset,
        sstim-ex:capabilityArGlasses,
        sstim-ex:capabilityFullVisualOcclusion,
        sstim-ex:capabilityPhoneVibration,
        sstim-ex:capabilityHapticActuator,
        sstim-ex:capabilityMultiDeviceBodyPlacement,
        sstim-ex:capabilitySensorInput,
        sstim-ex:capabilityAmbientRadioEmitter,
        sstim-ex:capabilityScentDelivery,
        sstim-ex:capabilityTasteDelivery,
        sstim-ex:capabilityLiquidGelTactileImmersion,
        sstim-ex:capabilityThermalActuation,
        sstim-ex:capabilityAirflowActuation,
        sstim-ex:capabilityJointForceActuation,
        sstim-ex:capabilityGravityCueing,
        sstim-ex:capabilityBodyPositionTracking,
        sstim-ex:capabilityRoomScaleTracking,
        sstim-ex:capabilityLocomotionInterface,
        sstim-ex:capabilityWearableSpeakerArray,
        sstim-ex:capabilityWearableLightArray .

sstim-ex:BodyPlacementScheme a skos:ConceptScheme ;
    skos:prefLabel "Body Placement Scheme"@en ;
    skos:definition "Body or near-body placements for exposure devices, media, and channels."@en ;
    skos:hasTopConcept
        sstim-ex:placementEars,
        sstim-ex:placementEyes,
        sstim-ex:placementNose,
        sstim-ex:placementMouth,
        sstim-ex:placementHands,
        sstim-ex:placementFeet,
        sstim-ex:placementTopOfHead,
        sstim-ex:placementTorso,
        sstim-ex:placementJoints,
        sstim-ex:placementWholeBody,
        sstim-ex:placementNearbyEnvironment .

sstim-ex:StimulusPatternScheme a skos:ConceptScheme ;
    skos:prefLabel "Stimulus Pattern Scheme"@en ;
    skos:definition "Temporal, spatial, stochastic, color, and texture patterns for stimulus channels."@en ;
    skos:hasTopConcept
        sstim-ex:patternContinuous,
        sstim-ex:patternPulsed,
        sstim-ex:patternBlinking,
        sstim-ex:patternMoving,
        sstim-ex:patternStatic,
        sstim-ex:patternStochastic,
        sstim-ex:patternAdaptive,
        sstim-ex:patternNoise,
        sstim-ex:patternFixedColor,
        sstim-ex:patternChangingColor,
        sstim-ex:patternRhythmic,
        sstim-ex:patternTextured .

sstim-ex:AudioNoiseColorScheme a skos:ConceptScheme ;
    skos:prefLabel "Audio Noise Color Scheme"@en ;
    skos:definition "Named audio-noise color conventions. Names vary across communities and should be defined by spectral slope when possible."@en ;
    skos:scopeNote "SSTIM should avoid assuming that color-noise names are exact scientific definitions unless spectral slope or generation method is documented."@en ;
    skos:hasTopConcept
        sstim-ex:audioNoiseWhite,
        sstim-ex:audioNoisePink,
        sstim-ex:audioNoiseBrownRed,
        sstim-ex:audioNoiseBlue,
        sstim-ex:audioNoiseVioletPurple,
        sstim-ex:audioNoiseGrey,
        sstim-ex:audioNoiseBlackSilence .

sstim-ex:VisualNoiseScheme a skos:ConceptScheme ;
    skos:prefLabel "Visual Noise Scheme"@en ;
    skos:definition "Visual noise and simple field stimuli for visual exposure channels."@en ;
    skos:hasTopConcept
        sstim-ex:visualNoiseLuminance,
        sstim-ex:visualNoiseChromatic,
        sstim-ex:visualNoisePixel,
        sstim-ex:visualNoiseMoving,
        sstim-ex:visualFieldStaticColor,
        sstim-ex:visualFieldBlack,
        sstim-ex:visualFieldWhite .

sstim-ex:EffectDimensionScheme a skos:ConceptScheme ;
    skos:prefLabel "Effect Dimension Scheme"@en ;
    skos:definition "Effect, risk, comfort, and measurement dimensions that exposure claims can concern."@en ;
    skos:hasTopConcept
        sstim-ex:effectPleasantness,
        sstim-ex:effectDiscomfort,
        sstim-ex:effectCalm,
        sstim-ex:effectStress,
        sstim-ex:effectArousal,
        sstim-ex:effectHeartRate,
        sstim-ex:effectBloodPressure,
        sstim-ex:effectBreathRate,
        sstim-ex:effectPhysiologicalResponse,
        sstim-ex:effectTactileSensation,
        sstim-ex:effectBodyVibration,
        sstim-ex:effectImmersion,
        sstim-ex:effectSpatialPresence,
        sstim-ex:effectProprioception,
        sstim-ex:effectEyeStrain,
        sstim-ex:effectHearingRisk,
        sstim-ex:effectPhotosensitivityRisk,
        sstim-ex:effectBalanceRisk,
        sstim-ex:effectSocialConnectedness,
        sstim-ex:effectTemperaturePerception,
        sstim-ex:effectGravityPerception .

sstim-ex:KnowledgeStatusScheme a skos:ConceptScheme ;
    skos:prefLabel "Knowledge Status Scheme"@en ;
    skos:definition "Local SSTIM/BSC Lab knowledge and delivery status markers. These statuses do not assert global scientific absence unless a separate literature review supports that claim."@en ;
    skos:hasTopConcept
        sstim-ex:knownInSSTIM,
        sstim-ex:hypothesisInSSTIM,
        sstim-ex:unknownToSSTIM,
        sstim-ex:noKnownEvidenceInSSTIM,
        sstim-ex:notCurrentlyUsedInBSCLab,
        sstim-ex:notCurrentlyDeliverableByBSCLab,
        sstim-ex:outsideBSCLabScope .

sstim-ex:ExperimentContextScheme a skos:ConceptScheme ;
    skos:prefLabel "Experiment Context Scheme"@en ;
    skos:definition "Reusable contexts for non-clinical exploratory protocol instances."@en ;
    skos:hasTopConcept
        sstim-ex:contextExploratoryNonClinical,
        sstim-ex:contextBiohacking,
        sstim-ex:contextBscLabPrototype,
        sstim-ex:contextSelfObservation,
        sstim-ex:contextSocialProtocol,
        sstim-ex:contextCapabilityBoundary .

sstim-ex:PerceptualGainScheme a skos:ConceptScheme ;
    skos:prefLabel "Perceptual Gain Scheme"@en ;
    skos:definition "Reusable perceptual gains for exposure examples."@en ;
    skos:hasTopConcept
        sstim-ex:gainStereoDepth,
        sstim-ex:gainAudioImmersion,
        sstim-ex:gainSpatialAudio,
        sstim-ex:gainSpatialPresence,
        sstim-ex:gainBodyVibration,
        sstim-ex:gainTactileImmersion,
        sstim-ex:gainThermalProximity,
        sstim-ex:gainSocialReflection .

sstim-ex:PerceptualLossScheme a skos:ConceptScheme ;
    skos:prefLabel "Perceptual Loss Scheme"@en ;
    skos:definition "Reusable perceptual losses, costs, or limitations for exposure examples."@en ;
    skos:hasTopConcept
        sstim-ex:lossHorizontalField,
        sstim-ex:lossEnvironmentalAwareness,
        sstim-ex:lossOutsideVision,
        sstim-ex:lossComfort,
        sstim-ex:lossDeliverability,
        sstim-ex:lossClaimCertainty,
        sstim-ex:lossDeviceFeasibility .

sstim-ex:ComfortBoundaryScheme a skos:ConceptScheme ;
    skos:prefLabel "Comfort Boundary Scheme"@en ;
    skos:definition "Reusable comfort, fatigue, awareness, and risk boundaries for exposure profiles."@en ;
    skos:hasTopConcept
        sstim-ex:boundaryEyeStrain,
        sstim-ex:boundaryHearingRisk,
        sstim-ex:boundaryPhotosensitivity,
        sstim-ex:boundaryThermalComfort,
        sstim-ex:boundaryBodyContactComfort,
        sstim-ex:boundaryEnvironmentalAwareness,
        sstim-ex:boundaryIsolation,
        sstim-ex:boundaryBalanceRisk .


###########################################################################
# Controlled vocabulary concepts
###########################################################################

sstim-ex:mediumAirConductedSound a owl:NamedIndividual, sstim-ex:PhysicalDeliveryMedium, skos:Concept ;
    skos:inScheme sstim-ex:DeliveryMediumScheme ;
    skos:topConceptOf sstim-ex:DeliveryMediumScheme ;
    skos:prefLabel "air-conducted sound"@en ;
    skos:notation "air-conducted-sound" ;
    skos:definition "Sound delivered through air before reaching the ear or body."@en .

sstim-ex:mediumContactAcousticVibration a owl:NamedIndividual, sstim-ex:PhysicalDeliveryMedium, skos:Concept ;
    skos:inScheme sstim-ex:DeliveryMediumScheme ;
    skos:topConceptOf sstim-ex:DeliveryMediumScheme ;
    skos:prefLabel "contact acoustic vibration"@en ;
    skos:notation "contact-acoustic-vibration" ;
    skos:definition "Acoustic energy delivered through contact with a vibrating object or surface."@en .

sstim-ex:mediumMechanicalVibration a owl:NamedIndividual, sstim-ex:PhysicalDeliveryMedium, skos:Concept ;
    skos:inScheme sstim-ex:DeliveryMediumScheme ;
    skos:topConceptOf sstim-ex:DeliveryMediumScheme ;
    skos:prefLabel "mechanical vibration"@en ;
    skos:notation "mechanical-vibration" ;
    skos:definition "Mechanical motion delivered by an actuator, transducer, surface, or object."@en .

sstim-ex:mediumVisualLight a owl:NamedIndividual, sstim-ex:PhysicalDeliveryMedium, skos:Concept ;
    skos:inScheme sstim-ex:DeliveryMediumScheme ;
    skos:topConceptOf sstim-ex:DeliveryMediumScheme ;
    skos:prefLabel "visual light"@en ;
    skos:notation "visual-light" ;
    skos:definition "Visible light delivered by a display, lamp, projector, or environment."@en .

sstim-ex:mediumElectromagneticField a owl:NamedIndividual, sstim-ex:PhysicalDeliveryMedium, skos:Concept ;
    skos:inScheme sstim-ex:DeliveryMediumScheme ;
    skos:topConceptOf sstim-ex:DeliveryMediumScheme ;
    skos:prefLabel "electromagnetic field"@en ;
    skos:notation "electromagnetic-field" ;
    skos:definition "Electromagnetic exposure modeled as a physical medium without asserting stimulation efficacy."@en .

sstim-ex:mediumRespiratoryCue a owl:NamedIndividual, sstim-ex:PhysicalDeliveryMedium, skos:Concept ;
    skos:inScheme sstim-ex:DeliveryMediumScheme ;
    skos:topConceptOf sstim-ex:DeliveryMediumScheme ;
    skos:prefLabel "respiratory cue"@en ;
