    skos:topConceptOf sstim-ex:EffectDimensionScheme ;
    skos:prefLabel "spatial presence"@en ;
    skos:notation "spatial-presence" ;
    skos:definition "Sense of being located in, moving through, or interacting with a spatial environment."@en .

sstim-ex:effectProprioception a owl:NamedIndividual, sstim-ex:EffectDimension, skos:Concept ;
    skos:inScheme sstim-ex:EffectDimensionScheme ;
    skos:topConceptOf sstim-ex:EffectDimensionScheme ;
    skos:prefLabel "proprioception"@en ;
    skos:notation "proprioception" .

sstim-ex:effectEyeStrain a owl:NamedIndividual, sstim-ex:EffectDimension, skos:Concept ;
    skos:inScheme sstim-ex:EffectDimensionScheme ;
    skos:topConceptOf sstim-ex:EffectDimensionScheme ;
    skos:prefLabel "eye strain"@en ;
    skos:notation "eye-strain" .

sstim-ex:effectHearingRisk a owl:NamedIndividual, sstim-ex:EffectDimension, skos:Concept ;
    skos:inScheme sstim-ex:EffectDimensionScheme ;
    skos:topConceptOf sstim-ex:EffectDimensionScheme ;
    skos:prefLabel "hearing risk"@en ;
    skos:notation "hearing-risk" .

sstim-ex:effectPhotosensitivityRisk a owl:NamedIndividual, sstim-ex:EffectDimension, skos:Concept ;
    skos:inScheme sstim-ex:EffectDimensionScheme ;
    skos:topConceptOf sstim-ex:EffectDimensionScheme ;
    skos:prefLabel "photosensitivity risk"@en ;
    skos:notation "photosensitivity-risk" .

sstim-ex:effectBalanceRisk a owl:NamedIndividual, sstim-ex:EffectDimension, skos:Concept ;
    skos:inScheme sstim-ex:EffectDimensionScheme ;
    skos:topConceptOf sstim-ex:EffectDimensionScheme ;
    skos:prefLabel "balance risk"@en ;
    skos:notation "balance-risk" .

sstim-ex:effectSocialConnectedness a owl:NamedIndividual, sstim-ex:EffectDimension, skos:Concept ;
    skos:inScheme sstim-ex:EffectDimensionScheme ;
    skos:topConceptOf sstim-ex:EffectDimensionScheme ;
    skos:prefLabel "social connectedness"@en ;
    skos:notation "social-connectedness" .

sstim-ex:effectTemperaturePerception a owl:NamedIndividual, sstim-ex:EffectDimension, skos:Concept ;
    skos:inScheme sstim-ex:EffectDimensionScheme ;
    skos:topConceptOf sstim-ex:EffectDimensionScheme ;
    skos:prefLabel "temperature perception"@en ;
    skos:notation "temperature-perception" .

sstim-ex:effectGravityPerception a owl:NamedIndividual, sstim-ex:EffectDimension, skos:Concept ;
