    skos:topConceptOf sstim-ex:DeviceCapabilityScheme ;
    skos:prefLabel "HRTF/spatial audio"@en ;
    skos:notation "hrtf-spatial-audio" .

sstim-ex:capabilityStereoSeparation a owl:NamedIndividual, sstim-ex:DeviceCapability, skos:Concept ;
