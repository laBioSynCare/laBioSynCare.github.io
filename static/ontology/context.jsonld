{
  "@context": {
    "sstim": "https://w3id.org/sstim#",
    "sstim-v": "https://w3id.org/sstim/vocab#",
    "sstim-sh": "https://w3id.org/sstim/shapes#",
    "sstim-ex": "https://w3id.org/sstim/exposure#",
    "bsc-fw": "https://w3id.org/sstim/framework/bsc/",
    "bsclab": "https://w3id.org/sstim/implementation/bsclab/",
    "biosyncare": "https://w3id.org/sstim/implementation/biosyncare/",

    "owl": "http://www.w3.org/2002/07/owl#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "sh": "http://www.w3.org/ns/shacl#",
    "dct": "http://purl.org/dc/terms/",
    "prov": "http://www.w3.org/ns/prov#",
    "voaf": "http://purl.org/vocommons/voaf#",
    "vann": "http://purl.org/vocab/vann/",
    "cc": "http://creativecommons.org/ns#",

    "wd": "http://www.wikidata.org/entity/",
    "bfo": "http://purl.obolibrary.org/obo/BFO_",
    "obi": "http://purl.obolibrary.org/obo/OBI_",
    "iao": "http://purl.obolibrary.org/obo/IAO_",

    "id": "@id",
    "type": "@type",
    "label": "rdfs:label",

    "prefLabel": { "@id": "skos:prefLabel", "@container": "@language" },
    "definition": { "@id": "skos:definition", "@container": "@language" },
    "scopeNote": { "@id": "skos:scopeNote", "@container": "@language" },
    "notation": { "@id": "skos:notation" },
    "inScheme": { "@id": "skos:inScheme", "@type": "@id" },
    "broader": { "@id": "skos:broader", "@type": "@id" },
    "narrower": { "@id": "skos:narrower", "@type": "@id" },
    "exactMatch": { "@id": "skos:exactMatch", "@type": "@id" },
    "closeMatch": { "@id": "skos:closeMatch", "@type": "@id" },

    "targetsFrequencyBand": { "@id": "sstim:targetsFrequencyBand", "@type": "@id" },
    "composedOf": { "@id": "sstim:composedOf", "@type": "@id" },
    "inGroup": { "@id": "sstim:inGroup", "@type": "@id" },
    "hasCautionTag": { "@id": "sstim:hasCautionTag", "@type": "@id" },
    "proposedMechanism": { "@id": "sstim:proposedMechanism", "@type": "@id" },
    "techniqueModality": { "@id": "sstim:techniqueModality", "@type": "@id" },
    "hasEvidenceTier": { "@id": "sstim:hasEvidenceTier", "@type": "@id" },
    "hasModalityTag": { "@id": "sstim:hasModalityTag", "@type": "@id" },
    "supportsRelation": { "@id": "sstim:supportsRelation", "@type": "@id" },
    "citesReference": { "@id": "sstim:citesReference", "@type": "@id" },

    "hzMin": { "@id": "sstim:hzMin", "@type": "xsd:decimal" },
    "hzMax": { "@id": "sstim:hzMax", "@type": "xsd:decimal" },
    "tierRank": { "@id": "sstim:tierRank", "@type": "xsd:integer" }
  }
}
