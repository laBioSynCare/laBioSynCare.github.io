# Guided breathing observation reference protocol
#
# A public BSC Lab reference protocol: an intentionally narrow method
# specification that supports reproducible demonstrations and observation.
# It does not prescribe treatment or promise a physiological outcome.

@prefix bsc-fw-tech:     <https://w3id.org/sstim/framework/bsc/technique/> .
@prefix bsclab-protocol: <https://w3id.org/sstim/implementation/bsclab/protocol/> .
@prefix dct:             <http://purl.org/dc/terms/> .
@prefix rdfs:            <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sstim:           <https://w3id.org/sstim#> .
@prefix xsd:             <http://www.w3.org/2001/XMLSchema#> .

bsclab-protocol:guided-breathing-observation-reference a sstim:SensoryStimulationProtocol ;
    rdfs:label "Guided breathing observation reference protocol"@en ;
    dct:description "Non-clinical reference protocol for an optional auditory breathing cue with a declared cadence, a single breathing-reference voice, an immediately available stop action, and pre/post self-report that is interpreted as observation rather than causal evidence."@en ;
    dct:creator <https://orcid.org/0000-0002-9699-629X> ;
    dct:created "2026-07-10"^^xsd:date ;
    dct:modified "2026-07-10"^^xsd:date ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    sstim:definedByFramework <https://w3id.org/sstim/framework/bsc> ;
    sstim:usesTechnique bsc-fw-tech:martigli-breathing-oscillation,
        bsc-fw-tech:martigli-binaural-hybrid .
