w2017:signal-01 a sstim:StimulationSignal ;
    rdfs:label "Target 1: 8.0 Hz sinusoid"@en ;
    sstim:hasSignalShape sstim-v:shapeSine ;
    sstim:hzMin "8.0"^^xsd:decimal ;
    sstim:hzMax "8.0"^^xsd:decimal .

w2017:rendering-01 a sstim:SignalRendering ;
    rdfs:label "Target 1's luminance, following its sinusoid frame by frame"@en ;
