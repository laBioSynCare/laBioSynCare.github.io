# 40-target SSVEP speller with joint frequency and phase coding, 8 to 15.8 Hz (Wang et al. 2017 benchmark dataset)
#
# A published sensory stimulation protocol, encoded from its source with
# SSTIM terms. It describes the method as the source reports it and asserts
# no effect: evidence about effects is a separate, authored claim (ADR 0027).
# The protocol cites its paper with dct:source instead of naming a framework
# (ADR 0064), its skos:editorialNote says what was read, and a level the
# source reports without a measurement point keeps the source's words in
# sstim:reportedAs at an unstated stage (ADR 0063). Why these protocols exist
# and how they are read: static/ontology/instances/README.md.

@prefix bfo:             <http://purl.obolibrary.org/obo/BFO_> .
@prefix obo:             <http://purl.obolibrary.org/obo/> .
@prefix dct:             <http://purl.org/dc/terms/> .
@prefix prov:            <http://www.w3.org/ns/prov#> .
@prefix rdfs:            <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:            <http://www.w3.org/2004/02/skos/core#> .
@prefix sstim:           <https://w3id.org/sstim#> .
@prefix sstim-ex:        <https://w3id.org/sstim/exposure#> .
@prefix sstim-v:         <https://w3id.org/sstim/vocab#> .
@prefix sstim-ref:       <https://w3id.org/sstim/ref/> .
@prefix xsd:             <http://www.w3.org/2001/XMLSchema#> .
@prefix bsclab-protocol: <https://w3id.org/sstim/implementation/bsclab/protocol/> .
@prefix w2017:           <https://w3id.org/sstim/implementation/bsclab/protocol/wang-2017-ssvep-40-target-speller#> .


###########################################################################
# 6. Wang, Chen, Gao and Gao 2017: SSVEP benchmark, 40-target speller
#    Dataset readme and Freq_Phase.mat from the authors' download page, and
#    the PubMed abstract. The 40 target channels are generated from
#    Freq_Phase.mat and follow this block.
###########################################################################

bsclab-protocol:wang-2017-ssvep-40-target-speller a sstim:SensoryStimulationProtocol ;
    rdfs:label "40-target SSVEP speller with joint frequency and phase coding, 8 to 15.8 Hz (Wang et al. 2017 benchmark dataset)"@en ;
    dct:description "A virtual keyboard of 40 characters flickers on a screen, each character at its own frequency from 8 to 15.8 Hz in 0.2 Hz steps, with an initial phase of 0, 0.5π, π or 1.5π assigned so that characters 0.2 Hz apart differ by 0.5π (joint frequency and phase modulation). Each trial shows a red square on the target for 0.5 s, then 5 s in which all 40 characters flicker together while a red triangle marks the target, then 0.5 s of blank screen. Each of 35 healthy participants completed 6 blocks of 40 trials, one per character in random order, with rests of several minutes between blocks, while 64-channel EEG was recorded. Frequencies and phases are the dataset's own (Freq_Phase.mat). The display, its refresh rate and the stimulus waveform are not recorded here, because the sources read do not state them. Recorded as a description of the published method; it asserts no effect."@en ;
    sstim:usesTechnique sstim-v:techPhoticDriving ;
    sstim:participantEngagementMode sstim-v:engagementGuidedFollowing ;
    sstim:hasStudyPopulation w2017:population ;
    sstim:hasSchedule w2017:schedule ;
    sstim-ex:hasExposureProfile w2017:profile ;
    dct:source sstim-ref:WANG_2017 ;
    skos:editorialNote "Encoded from the PubMed abstract (PMID 27849543), the dataset Readme.txt and Freq_Phase.mat from bci.med.tsinghua.edu.cn, read 2026-10-13. Without the waveform no StimulationSignal is asserted, so each target's rate and initial phase sit on its channel. Guided following is used for the instruction to shift gaze to the cued target."@en ;
    prov:wasAttributedTo <https://orcid.org/0000-0002-9699-629X> ;
    dct:created "2026-10-13"^^xsd:date ;
    dct:modified "2026-10-13"^^xsd:date ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> .

w2017:population a sstim:PopulationDescriptor ;
    rdfs:label "Healthy adults aged 17 to 34"@en ;
    dct:description "35 participants, 17 of them women, 8 experienced with SSVEP spellers and 27 naive."@en ;
    sstim:populationTaxon obo:NCBITaxon_9606 .

# One trial is the three segments in order; a block is 40 trials, one per
# target, and a session is six blocks.
w2017:schedule a sstim:StimulationSchedule ;
    sstim:trialsPerBlock 40 ;
    sstim:blocksPerSession 6 ;
    sstim:hasScheduleSegment w2017:segment-cue, w2017:segment-flicker, w2017:segment-blank .

w2017:segment-cue a sstim:ScheduleSegment ;
    sstim:segmentOrder 1 ;
    sstim:segmentDurationSeconds "0.5"^^xsd:decimal ;
    sstim:segmentRole sstim-v:segmentCue .

w2017:segment-flicker a sstim:ScheduleSegment ;
    sstim:segmentOrder 2 ;
    sstim:segmentDurationSeconds "5.0"^^xsd:decimal ;
    sstim:segmentRole sstim-v:segmentStimulation ;
    sstim:segmentStimulus w2017:stimulus .

w2017:segment-blank a sstim:ScheduleSegment ;
    sstim:segmentOrder 3 ;
    sstim:segmentDurationSeconds "0.5"^^xsd:decimal ;
    sstim:segmentRole sstim-v:segmentRest .

w2017:stimulus a sstim:StimulusSpecification ;
    rdfs:label "40-target flicker array, one 5 s trial (Wang et al. 2017)"@en ;
    sstim:stimulusRegime "determinate" ;
    sstim:hasStimulationTarget w2017:subject .

w2017:subject a bfo:0000040, obo:NCBITaxon_9606 ;
    rdfs:label "Human participant"@en .


###########################################################################
# 6 (continued). The 40 SSVEP targets of Wang et al. 2017, in the dataset's
# own target order. Rates and initial phases are the values of
# Freq_Phase.mat; sstim-ex:hasInitialPhase is the phase at stimulus onset as a
# fraction of a cycle.
###########################################################################

# Generated from Freq_Phase.mat (dataset target order). Do not edit by hand.
w2017:target-01 a sstim-ex:StimulusChannel ;
    rdfs:label "Target 1: 8.0 Hz, initial phase 0"@en ;
    sstim-ex:deliveryMedium sstim-ex:mediumVisualLight ;
    sstim-ex:perceivedModality sstim-ex:modalityVisual ;
    sstim-ex:hasBodyPlacement sstim-ex:placementNearbyEnvironment ;
    sstim-ex:requiresDeviceCapability sstim-ex:capabilityDisplayLightOutput, sstim-ex:capabilityDisplayFlicker ;
    sstim-ex:hasStimulusPattern sstim-ex:patternRhythmic ;
    sstim-ex:channelRole sstim-ex:roleIntendedIntervention ;
    sstim-ex:hasFlickerRateHz "8.0"^^xsd:decimal ;
    sstim-ex:hasInitialPhase "0.0"^^xsd:decimal ;
    sstim:channelDurationSeconds "5.0"^^xsd:decimal ;
    sstim-ex:hasComfortBoundary sstim-ex:boundaryPhotosensitivity .

