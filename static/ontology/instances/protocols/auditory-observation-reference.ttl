# Auditory rhythm observation reference protocol
#
# A public BSC Lab reference protocol: an intentionally narrow method
# specification that supports reproducible demonstrations and observation.
# It does not prescribe treatment or promise a physiological outcome.

@prefix bsc-fw-tech:     <https://w3id.org/sstim/framework/bsc/technique/> .
@prefix bsclab-protocol: <https://w3id.org/sstim/implementation/bsclab/protocol/> .
@prefix dct:             <http://purl.org/dc/terms/> .
@prefix rdfs:            <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sstim:           <https://w3id.org/sstim#> .
@prefix sstim-v:         <https://w3id.org/sstim/vocab#> .
@prefix xsd:             <http://www.w3.org/2001/XMLSchema#> .

bsclab-protocol:auditory-observation-reference a sstim:SensoryStimulationProtocol ;
    rdfs:label "Auditory rhythm observation reference protocol"@en ;
    dct:description "Non-clinical reference protocol for presenting one parameter-specified auditory rhythm technique at conservative gain, recording the exact session specification, and limiting public copy to descriptive or experiential statements."@en ;
    dct:creator <https://orcid.org/0000-0002-9699-629X> ;
    dct:created "2026-07-10"^^xsd:date ;
    dct:modified "2026-07-10"^^xsd:date ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    sstim:definedByFramework <https://w3id.org/sstim/framework/bsc> ;
    sstim:usesTechnique sstim-v:techBinauralBeats,
        bsc-fw-tech:symmetry-permutation-entrainment .
