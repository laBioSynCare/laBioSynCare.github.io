l1998:beta-audio a sstim-ex:StimulusChannel ;
    rdfs:label "Headphone audio: pink noise with binaural beats at 16 and 24 Hz"@en ;
    sstim-ex:deliveryMedium sstim-ex:mediumAirConductedSound ;
    sstim-ex:perceivedModality sstim-ex:modalityAuditory ;
    sstim-ex:hasBodyPlacement sstim-ex:placementEarLeft, sstim-ex:placementEarRight ;
    sstim-ex:requiresDeviceCapability sstim-ex:capabilityHeadphones, sstim-ex:capabilityStereoSeparation ;
    sstim-ex:hasStimulusPattern sstim-ex:patternContinuous, sstim-ex:audioNoisePink ;
    sstim-ex:channelRole sstim-ex:roleIntendedIntervention ;
    sstim:channelDurationSeconds "1800.0"^^xsd:decimal ;
    sstim:hasSignalRendering l1998:beat-16-rendering, l1998:beat-24-rendering .

l1998:theta-delta-audio a sstim-ex:StimulusChannel ;
    rdfs:label "Headphone audio: pink noise with binaural beats at 1.5 and 4 Hz"@en ;
    sstim-ex:deliveryMedium sstim-ex:mediumAirConductedSound ;
    sstim-ex:perceivedModality sstim-ex:modalityAuditory ;
    sstim-ex:hasBodyPlacement sstim-ex:placementEarLeft, sstim-ex:placementEarRight ;
    sstim-ex:requiresDeviceCapability sstim-ex:capabilityHeadphones, sstim-ex:capabilityStereoSeparation ;
    sstim-ex:hasStimulusPattern sstim-ex:patternContinuous, sstim-ex:audioNoisePink ;
    sstim-ex:channelRole sstim-ex:roleIntendedIntervention ;
    sstim:channelDurationSeconds "1800.0"^^xsd:decimal ;
    sstim:hasSignalRendering l1998:beat-1-5-rendering, l1998:beat-4-rendering .

l1998:control-audio a sstim-ex:StimulusChannel ;
    rdfs:label "Headphone audio: pink noise with simple tones and no beats"@en ;
    sstim-ex:deliveryMedium sstim-ex:mediumAirConductedSound ;
    sstim-ex:perceivedModality sstim-ex:modalityAuditory ;
    sstim-ex:hasBodyPlacement sstim-ex:placementEarLeft, sstim-ex:placementEarRight ;
    sstim-ex:hasStimulusPattern sstim-ex:patternContinuous, sstim-ex:audioNoisePink ;
    sstim-ex:channelRole sstim-ex:roleControlOrSham ;
    sstim:channelDurationSeconds "1800.0"^^xsd:decimal .

l1998:beat-16 a sstim:StimulationSignal ;
    rdfs:label "16 Hz binaural beat"@en ;
    sstim:hasSignalShape sstim-v:shapeSine ;
    sstim:hzMin "16.0"^^xsd:decimal ;
    sstim:hzMax "16.0"^^xsd:decimal ;
    sstim:signalWithinBand sstim-v:beta .

l1998:beat-24 a sstim:StimulationSignal ;
    rdfs:label "24 Hz binaural beat"@en ;
    sstim:hasSignalShape sstim-v:shapeSine ;
    sstim:hzMin "24.0"^^xsd:decimal ;
    sstim:hzMax "24.0"^^xsd:decimal ;
    sstim:signalWithinBand sstim-v:beta .

l1998:beat-1-5 a sstim:StimulationSignal ;
    rdfs:label "1.5 Hz binaural beat"@en ;
    sstim:hasSignalShape sstim-v:shapeSine ;
    sstim:hzMin "1.5"^^xsd:decimal ;
    sstim:hzMax "1.5"^^xsd:decimal ;
    sstim:signalWithinBand sstim-v:delta .

# 4 Hz is the shared bound of SSTIM's delta (0.5 to 4) and theta (4 to 8)
# bands, both inclusive, which is presumably why the authors call this
# condition theta/delta. Both containments are true and both are asserted.
l1998:beat-4 a sstim:StimulationSignal ;
    rdfs:label "4 Hz binaural beat"@en ;
    sstim:hasSignalShape sstim-v:shapeSine ;
    sstim:hzMin "4.0"^^xsd:decimal ;
    sstim:hzMax "4.0"^^xsd:decimal ;
    sstim:signalWithinBand sstim-v:delta, sstim-v:theta .

l1998:beat-16-rendering a sstim:SignalRendering ;
    rdfs:label "16 Hz binaural beat between the two ears' tones"@en ;
    sstim:rendersSignal l1998:beat-16 ;
    sstim:rendersOntoParameter sstim-v:paramFrequency ;
    sstim:hasRenderingMechanism sstim-v:mechanismBinauralBeat ;
    sstim:hasRenderingPresence sstim-v:presencePerceptual .

l1998:beat-24-rendering a sstim:SignalRendering ;
    rdfs:label "24 Hz binaural beat between the two ears' tones"@en ;
    sstim:rendersSignal l1998:beat-24 ;
    sstim:rendersOntoParameter sstim-v:paramFrequency ;
    sstim:hasRenderingMechanism sstim-v:mechanismBinauralBeat ;
    sstim:hasRenderingPresence sstim-v:presencePerceptual .

l1998:beat-1-5-rendering a sstim:SignalRendering ;
    rdfs:label "1.5 Hz binaural beat between the two ears' tones"@en ;
    sstim:rendersSignal l1998:beat-1-5 ;
    sstim:rendersOntoParameter sstim-v:paramFrequency ;
    sstim:hasRenderingMechanism sstim-v:mechanismBinauralBeat ;
    sstim:hasRenderingPresence sstim-v:presencePerceptual .

l1998:beat-4-rendering a sstim:SignalRendering ;
    rdfs:label "4 Hz binaural beat between the two ears' tones"@en ;
    sstim:rendersSignal l1998:beat-4 ;
    sstim:rendersOntoParameter sstim-v:paramFrequency ;
    sstim:hasRenderingMechanism sstim-v:mechanismBinauralBeat ;
    sstim:hasRenderingPresence sstim-v:presencePerceptual .

l1998:beta-stimulus a sstim:StimulusSpecification ;
    rdfs:label "Beta binaural-beat condition (Lane et al. 1998)"@en ;
    sstim:stimulusRegime "stochastic" ;
    sstim:hasSignal l1998:beat-16, l1998:beat-24 ;
    sstim:hasStimulusChannel l1998:beta-audio ;
    sstim:hasStimulationTarget l1998:subject .

l1998:theta-delta-stimulus a sstim:StimulusSpecification ;
    rdfs:label "Theta/delta binaural-beat condition (Lane et al. 1998)"@en ;
    sstim:stimulusRegime "stochastic" ;
    sstim:hasSignal l1998:beat-1-5, l1998:beat-4 ;
    sstim:hasStimulusChannel l1998:theta-delta-audio ;
    sstim:hasStimulationTarget l1998:subject .

l1998:control-stimulus a sstim:StimulusSpecification ;
    rdfs:label "Control condition: pink noise with simple tones (Lane et al. 1998)"@en ;
    sstim:stimulusRegime "stochastic" ;
    sstim:hasStimulusChannel l1998:control-audio ;
    sstim:hasStimulationTarget l1998:subject .

l1998:subject a bfo:0000040, obo:NCBITaxon_9606 ;
    rdfs:label "Human participant"@en .


###########################################################################
# 9. Thaut et al. 1996: rhythmic auditory stimulation for gait training
#    Abstract only.
###########################################################################

bsclab-protocol:thaut-1996-rhythmic-auditory-stimulation-gait a sstim:SensoryStimulationProtocol ;
    rdfs:label "Rhythmic auditory stimulation for 3 weeks of home-based gait training in Parkinson's disease (Thaut et al. 1996)"@en ;
    dct:description "People with Parkinson's disease (n = 15) trained their gait at home for 3 weeks while walking to audiotapes on which metronome pulses were embedded in the on-beat and off-beat structure of rhythmically accentuated instrumental music, used as a pacemaker. The comparison groups did no gait training or trained with internally self-paced walking. Gait was assessed without the rhythm, before and after training. Recorded as a description of the published method; it asserts no effect."@en ;
    sstim:usesTechnique sstim-v:techRhythmicAuditoryCueing ;
    sstim:participantEngagementMode sstim-v:engagementGuidedFollowing ;
    sstim:protocolStudyDesign sstim-v:designControlledTrial ;
    sstim:armAllocation sstim-v:allocationBetweenSubject ;
    sstim:hasStudyPopulation t1996:population ;
    sstim:hasSchedule t1996:schedule ;
    sstim:hasStudyArm t1996:arm-ras, t1996:arm-self-paced, t1996:arm-no-training ;
    dct:source sstim-ref:THAUT_1996 ;
    skos:editorialNote "Encoded from the PubMed abstract only (PMID 8684391). The tempi, how they progressed over the 3 weeks, the daily training time and the playback equipment are not encoded, so the arms name no stimulus and there is no exposure profile: the full text was not read. If the tempo was set from each patient's own cadence, sstim-v:referenceBaselineCadence now says so."@en ;
    prov:wasAttributedTo <https://orcid.org/0000-0002-9699-629X> ;
    dct:created "2026-10-13"^^xsd:date ;
    dct:modified "2026-10-13"^^xsd:date ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> .

t1996:population a sstim:PopulationDescriptor ;
    rdfs:label "People with Parkinson's disease"@en ;
    sstim:populationTaxon obo:NCBITaxon_9606 ;
    sstim:populationCondition mesh:D010300 .

t1996:schedule a sstim:StimulationSchedule ;
    sstim:courseDurationValue "3.0"^^xsd:decimal ;
    sstim:courseDurationUnit sstim-v:unitWeek .

t1996:arm-ras a sstim:StudyArm ;
    rdfs:label "Gait training with rhythmic auditory stimulation"@en ;
    sstim:armRole sstim-v:armExperimental .

t1996:arm-self-paced a sstim:StudyArm ;
    rdfs:label "Internally self-paced gait training, no rhythm"@en ;
    sstim:armRole sstim-v:armNoStimulation .

t1996:arm-no-training a sstim:StudyArm ;
    rdfs:label "No gait training"@en ;
    sstim:armRole sstim-v:armNoStimulation .


