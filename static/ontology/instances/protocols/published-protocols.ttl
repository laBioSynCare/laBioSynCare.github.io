###########################################################################
# 6. Wang, Chen, Gao and Gao 2017: SSVEP benchmark, 40-target speller
#    Dataset readme and Freq_Phase.mat from the authors' download page, and
#    the PubMed abstract. The 40 target channels are generated from
#    Freq_Phase.mat and follow this block.
###########################################################################

bsclab-protocol:wang-2017-ssvep-40-target-speller a sstim:SensoryStimulationProtocol ;
    rdfs:label "40-target SSVEP speller with joint frequency and phase coding, 8 to 15.8 Hz (Wang et al. 2017 benchmark dataset)"@en ;
    dct:description "A virtual keyboard of 40 characters flickers on a screen, each character at its own frequency from 8 to 15.8 Hz in 0.2 Hz steps, with an initial phase of 0, 0.5π, π or 1.5π assigned so that characters 0.2 Hz apart differ by 0.5π (joint frequency and phase modulation). Each trial shows a red square on the target for 0.5 s, then 5 s in which all 40 characters flicker together while a red triangle marks the target, then 0.5 s of blank screen. Each of 35 healthy participants completed 6 blocks of 40 trials, one per character in random order, with rests of several minutes between blocks, while 64-channel EEG was recorded. Frequencies and phases are the dataset's own (Freq_Phase.mat). The display, its refresh rate and the stimulus waveform are not recorded here, because the sources read do not state them. Recorded as a description of the published method; it asserts no effect."@en ;
    sstim:usesTechnique sstim-v:techPhoticDriving ;
    sstim:participantEngagementMode sstim-v:engagementGuidedFollowing ;
    sstim:hasStudyPopulation w2017:population ;
    sstim:hasSchedule w2017:schedule ;
    sstim-ex:hasExposureProfile w2017:profile ;
    dct:source sstim-ref:WANG_2017 ;
    skos:editorialNote "Encoded from the PubMed abstract (PMID 27849543), the dataset Readme.txt and Freq_Phase.mat from bci.med.tsinghua.edu.cn, read 2026-10-13. Without the waveform no StimulationSignal is asserted, so each target's rate and initial phase sit on its channel. Guided following is used for the instruction to shift gaze to the cued target."@en ;
    prov:wasAttributedTo <https://orcid.org/0000-0002-9699-629X> ;
    dct:created "2026-10-13"^^xsd:date ;
    dct:modified "2026-10-13"^^xsd:date ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> .

w2017:population a sstim:PopulationDescriptor ;
    rdfs:label "Healthy adults aged 17 to 34"@en ;
    dct:description "35 participants, 17 of them women, 8 experienced with SSVEP spellers and 27 naive."@en ;
    sstim:populationTaxon obo:NCBITaxon_9606 .

# One trial is the three segments in order; a block is 40 trials, one per
# target, and a session is six blocks.
w2017:schedule a sstim:StimulationSchedule ;
    sstim:trialsPerBlock 40 ;
    sstim:blocksPerSession 6 ;
    sstim:hasScheduleSegment w2017:segment-cue, w2017:segment-flicker, w2017:segment-blank .

w2017:segment-cue a sstim:ScheduleSegment ;
    sstim:segmentOrder 1 ;
    sstim:segmentDurationSeconds "0.5"^^xsd:decimal ;
    sstim:segmentRole sstim-v:segmentCue .

w2017:segment-flicker a sstim:ScheduleSegment ;
    sstim:segmentOrder 2 ;
    sstim:segmentDurationSeconds "5.0"^^xsd:decimal ;
    sstim:segmentRole sstim-v:segmentStimulation ;
    sstim:segmentStimulus w2017:stimulus .

w2017:segment-blank a sstim:ScheduleSegment ;
    sstim:segmentOrder 3 ;
    sstim:segmentDurationSeconds "0.5"^^xsd:decimal ;
    sstim:segmentRole sstim-v:segmentRest .

w2017:stimulus a sstim:StimulusSpecification ;
    rdfs:label "40-target flicker array, one 5 s trial (Wang et al. 2017)"@en ;
    sstim:stimulusRegime "determinate" ;
    sstim:hasStimulationTarget w2017:subject .

w2017:subject a bfo:0000040, obo:NCBITaxon_9606 ;
    rdfs:label "Human participant"@en .


###########################################################################
# 7. Ngo, Martinetz, Born and Mölle 2013: closed-loop auditory stimulation
#    of the sleep slow oscillation. Abstract only.
###########################################################################

bsclab-protocol:ngo-2013-closed-loop-auditory-slow-oscillation a sstim:SensoryStimulationProtocol ;
    rdfs:label "Closed-loop auditory stimulation in phase with sleep slow-oscillation up states (Ngo et al. 2013)"@en ;
    dct:description "In sleeping humans, sounds are delivered in phase with the ongoing rhythm of slow-oscillation up states, aimed at the slow-oscillation rhythm and the spindle activity coupled to it; a comparison condition stimulated out of phase with that rhythm. What reaches the sleeper depends on the sleeper's measured activity, so the stimulus specification is adaptive and is described by its control law: read the EEG, follow the slow oscillation, aim at its up state. Recorded as a description of the published method; it asserts no effect."@en ;
    sstim:usesTechnique sstim-v:techClosedLoopAuditory ;
    sstim:intendedNeuralPhenomenon sstim-v:phenomenonOscillatoryDynamics ;
    sstim:participantEngagementMode sstim-v:engagementPassiveReceptive ;
    sstim:protocolStudyDesign sstim-v:designControlledTrial ;
    sstim:hasStudyPopulation n2013:population ;
    sstim:hasStudyArm n2013:arm-in-phase, n2013:arm-out-of-phase ;
    dct:source sstim-ref:NGO_2013 ;
    skos:editorialNote "Encoded from the PubMed abstract only (PMID 23583623). The sound, its level, the detection threshold, the delays, the number of stimuli per detection and the stimulation period are not encoded: the full text was not read. The terms for each now exist on sstim:ControlLaw. EEG as the control input is inferred rather than read: the slow oscillation is an EEG rhythm, and the abstract does not name the recording."@en ;
    prov:wasAttributedTo <https://orcid.org/0000-0002-9699-629X> ;
    dct:created "2026-10-13"^^xsd:date ;
    dct:modified "2026-10-13"^^xsd:date ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> .

n2013:population a sstim:PopulationDescriptor ;
    rdfs:label "Sleeping adult humans"@en ;
    sstim:populationTaxon obo:NCBITaxon_9606 .

n2013:arm-in-phase a sstim:StudyArm ;
    rdfs:label "Stimulation in phase with slow-oscillation up states"@en ;
    sstim:armRole sstim-v:armExperimental ;
    sstim:armStimulus n2013:stimulus .

n2013:arm-out-of-phase a sstim:StudyArm ;
    rdfs:label "Stimulation out of phase with the slow-oscillation rhythm"@en ;
    sstim:armRole sstim-v:armActiveComparator .

n2013:stimulus a sstim:StimulusSpecification ;
    rdfs:label "Slow-oscillation phase-locked sound stimulation (Ngo et al. 2013)"@en ;
    sstim:stimulusRegime "adaptive" ;
    sstim:hasControlLaw n2013:control-law ;
    sstim:hasStimulationTarget n2013:subject .

n2013:control-law a sstim:ControlLaw ;
    sstim:controlInputSignal sstim-v:measuredEeg ;
    sstim:trackedOscillation sstim-v:slowOscillation ;
    sstim:targetOscillationPhase sstim-v:phaseUpState .

n2013:subject a bfo:0000040, obo:NCBITaxon_9606 ;
    rdfs:label "Sleeping human participant"@en .


###########################################################################
# 8. Lane, Kasian, Owens and Marsh 1998: binaural beats during a
#    vigilance task. Abstract only, partly encoded.
###########################################################################

bsclab-protocol:lane-1998-binaural-beats-vigilance a sstim:SensoryStimulationProtocol ;
    rdfs:label "Binaural beats in pink noise during a 30-minute vigilance task (Lane et al. 1998)"@en ;
    dct:description "Participants (n = 29) performed a 30-minute visual vigilance task on three different days while listening to pink noise that contained simple tones (the control), binaural beats in the beta range (16 and 24 Hz), or binaural beats in the theta/delta range (1.5 and 4 Hz). Participants were kept blind to the presence of binaural beats. Recorded as a description of the published method; it asserts no effect."@en ;
    sstim:usesTechnique sstim-v:techBinauralBeats, sstim-v:techBroadbandNoise ;
    sstim:participantEngagementMode sstim-v:engagementPassiveReceptive ;
    sstim:protocolStudyDesign sstim-v:designControlledTrial ;
    sstim:armAllocation sstim-v:allocationWithinSubject ;
    sstim:hasStudyPopulation l1998:population ;
    sstim:hasSchedule l1998:schedule ;
    sstim:hasStudyArm l1998:arm-beta, l1998:arm-theta-delta, l1998:arm-control ;
    sstim-ex:hasExposureProfile l1998:beta-profile, l1998:theta-delta-profile, l1998:control-profile ;
    dct:source sstim-ref:LANE_1998 ;
    skos:editorialNote "Encoded from the PubMed abstract only (PMID 9423966). The carrier frequencies, how the two beat frequencies of each condition were combined in time, the levels and the headphones are not encoded. Headphones are implied by the technique: a binaural beat needs one carrier per ear. The beat signals' sine shape follows from the binaural-beat definition, two tones, and should be checked against the full text."@en ;
    prov:wasAttributedTo <https://orcid.org/0000-0002-9699-629X> ;
    dct:created "2026-10-13"^^xsd:date ;
    dct:modified "2026-10-13"^^xsd:date ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> .

