# Concurrent 40 Hz light flicker and tone train, 1 hour a day for 7 days, in mice (Martorell et al. 2019)
#
# A published sensory stimulation protocol, encoded from its source with
# SSTIM terms. It describes the method as the source reports it and asserts
# no effect: evidence about effects is a separate, authored claim (ADR 0027).
# The protocol cites its paper with dct:source instead of naming a framework
# (ADR 0064), its skos:editorialNote says what was read, and a level the
# source reports without a measurement point keeps the source's words in
# sstim:reportedAs at an unstated stage (ADR 0063). Why these protocols exist
# and how they are read: static/ontology/instances/README.md.

@prefix bfo:             <http://purl.obolibrary.org/obo/BFO_> .
@prefix obo:             <http://purl.obolibrary.org/obo/> .
@prefix dct:             <http://purl.org/dc/terms/> .
@prefix prov:            <http://www.w3.org/ns/prov#> .
@prefix rdfs:            <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:            <http://www.w3.org/2004/02/skos/core#> .
@prefix sstim:           <https://w3id.org/sstim#> .
@prefix sstim-ex:        <https://w3id.org/sstim/exposure#> .
@prefix sstim-v:         <https://w3id.org/sstim/vocab#> .
@prefix sstim-ref:       <https://w3id.org/sstim/ref/> .
@prefix xsd:             <http://www.w3.org/2001/XMLSchema#> .
@prefix bsclab-protocol: <https://w3id.org/sstim/implementation/bsclab/protocol/> .
@prefix m2019av:         <https://w3id.org/sstim/implementation/bsclab/protocol/martorell-2019-40hz-audiovisual#> .


###########################################################################
# 4. Martorell et al. 2019: concurrent 40 Hz light and tones in mice
#    (combined GENUS). Full text: PMC author manuscript, STAR Methods.
###########################################################################

bsclab-protocol:martorell-2019-40hz-audiovisual a sstim:SensoryStimulationProtocol, sstim:SensoryRouteNeuromodulationProtocol ;
    rdfs:label "Concurrent 40 Hz light flicker and tone train, 1 hour a day for 7 days, in mice (Martorell et al. 2019)"@en ;
    dct:description "5XFAD mice in a dark chamber lit by an LED bulb receive 40 Hz light flicker (12.5 ms on, 12.5 ms off) together with a 40 Hz train of 1 ms, 10 kHz tones, for 1 hour a day over 7 days. Comparison conditions were dark and quiet, 40 Hz light alone, 40 Hz tones alone, and random light and tone stimulation; frequency-specificity tests also used combined stimulation at 80 Hz. In the electrophysiology sessions the light and tone pulses were aligned at each pulse onset; the chronic protocol says only that they were delivered simultaneously. The intended neural phenomenon is 40 Hz activity in auditory and visual cortex, hippocampal CA1 and medial prefrontal cortex. Recorded as a description of the published method; it asserts no effect."@en ;
    sstim:usesTechnique sstim-v:techAudiovisualEntrainment, sstim-v:techPhoticDriving, sstim-v:techGamma40Auditory, sstim-v:techIsochronicTones ;
    sstim:intendedNeuralPhenomenon sstim-v:phenomenonOscillatoryDynamics ;
    sstim:intendedNeuralSystem sstim-v:systemAuditory, sstim-v:systemVisual ;
    sstim:intendedNeuralTargetSite sstim-v:targetCortex ;
    sstim:neuralAccessRoute sstim-v:routeCanonicalSensoryTransductionAfferent ;
    sstim:stimulationDeliveryApproach sstim-v:approachExternal, sstim-v:approachEnvironmentalReceptorFacing ;
    sstim:participantEngagementMode sstim-v:engagementPassiveReceptive ;
    sstim:protocolStudyDesign sstim-v:designPreclinicalExperiment ;
    sstim:armAllocation sstim-v:allocationBetweenSubject ;
    sstim:hasStudyPopulation m2019av:population ;
    sstim:hasSchedule m2019av:schedule ;
    sstim:hasStudyArm m2019av:arm-40hz, m2019av:arm-dark-quiet ;
    sstim-ex:hasExposureProfile m2019av:profile ;
    dct:source sstim-ref:MARTORELL_2019 ;
    skos:editorialNote "Encoded from the PMC author manuscript (PMC6774262): STAR Methods, Concurrent 40 Hz auditory and visual stimulation protocol, with tone and flicker parameters from the auditory and visual protocol paragraphs and Results. The tone level is not restated for this protocol and is not encoded. No phase offset is asserted, because onset alignment is stated only for the electrophysiology sessions. Single-modality and random arms are only described."@en ;
    prov:wasAttributedTo <https://orcid.org/0000-0002-9699-629X> ;
    dct:created "2026-10-13"^^xsd:date ;
    dct:modified "2026-10-13"^^xsd:date ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> .

m2019av:population a sstim:PopulationDescriptor ;
    rdfs:label "5XFAD transgenic mice"@en ;
    sstim:populationTaxon obo:NCBITaxon_10090 .

m2019av:schedule a sstim:StimulationSchedule ;
    sstim:sessionDurationSeconds "3600.0"^^xsd:decimal ;
    sstim:sessionsPerDay "1.0"^^xsd:decimal ;
    sstim:sessionCount 7 ;
    sstim:courseDurationValue "7.0"^^xsd:decimal ;
    sstim:courseDurationUnit sstim-v:unitDay .

m2019av:arm-40hz a sstim:StudyArm ;
    rdfs:label "Concurrent 40 Hz light flicker and tone train"@en ;
    sstim:armRole sstim-v:armExperimental ;
    sstim:armStimulus m2019av:stimulus .

m2019av:arm-dark-quiet a sstim:StudyArm ;
    rdfs:label "Darkness and quiet"@en ;
    sstim:armRole sstim-v:armNoStimulation .

m2019av:profile a sstim-ex:ExposureProfile ;
    rdfs:label "One hour of concurrent 40 Hz LED flicker and 40 Hz tone pips"@en ;
    sstim-ex:usesStimulusChannel m2019av:light, m2019av:tones ;
    sstim-ex:hasKnowledgeStatus sstim-ex:knownInSSTIM .

m2019av:light a sstim-ex:StimulusChannel ;
    rdfs:label "LED bulb flickering at 40 Hz, 12.5 ms on and 12.5 ms off"@en ;
    sstim-ex:deliveryMedium sstim-ex:mediumVisualLight ;
    sstim-ex:perceivedModality sstim-ex:modalityVisual ;
    sstim-ex:hasBodyPlacement sstim-ex:placementNearbyEnvironment ;
    sstim-ex:hasStimulusPattern sstim-ex:patternBlinking ;
    sstim-ex:channelRole sstim-ex:roleIntendedIntervention ;
    sstim-ex:hasFlickerRateHz "40.0"^^xsd:decimal ;
    sstim-ex:hasDutyCycle "0.5"^^xsd:decimal ;
    sstim:channelDurationSeconds "3600.0"^^xsd:decimal ;
    sstim-ex:hasComfortBoundary sstim-ex:boundaryPhotosensitivity ;
    sstim:hasSignalRendering m2019av:luminance-rendering .

m2019av:tones a sstim-ex:StimulusChannel ;
    rdfs:label "10 kHz tone pips, 1 ms long, every 25 ms"@en ;
    sstim-ex:deliveryMedium sstim-ex:mediumAirConductedSound ;
    sstim-ex:perceivedModality sstim-ex:modalityAuditory ;
    sstim-ex:hasBodyPlacement sstim-ex:placementNearbyEnvironment ;
    sstim-ex:hasStimulusPattern sstim-ex:patternPulsed ;
    sstim-ex:channelRole sstim-ex:roleIntendedIntervention ;
    sstim-ex:hasCarrierFrequencyHz "10000.0"^^xsd:decimal ;
    sstim-ex:hasModulationFrequencyHz "40.0"^^xsd:decimal ;
    sstim-ex:hasDutyCycle "0.04"^^xsd:decimal ;
    sstim:channelDurationSeconds "3600.0"^^xsd:decimal ;
    sstim:hasSignalRendering m2019av:tone-rendering .

# One signal, two renderings: the assertion that light and sound carry the same
# 40 Hz, which is what the paper's "combined GENUS" means. Rendered at a 50%
# duty cycle in light and 4% in sound, which the channels state.
m2019av:signal a sstim:StimulationSignal ;
    rdfs:label "40 Hz pulse train shared by light and sound"@en ;
    sstim:hasSignalShape sstim-v:shapeSquare ;
    sstim:hzMin "40.0"^^xsd:decimal ;
    sstim:hzMax "40.0"^^xsd:decimal ;
    sstim:signalWithinBand sstim-v:gamma, sstim-v:gamma40 .

m2019av:luminance-rendering a sstim:SignalRendering ;
    rdfs:label "LED light switched on and off at the signal rate"@en ;
    sstim:rendersSignal m2019av:signal ;
    sstim:rendersOntoParameter sstim-v:paramLuminance ;
    sstim:hasRenderingMechanism sstim-v:mechanismDirectPresentation ;
    sstim:hasRenderingPresence sstim-v:presencePhysical .

m2019av:tone-rendering a sstim:SignalRendering ;
    rdfs:label "40 Hz gating of a 10 kHz tone"@en ;
    sstim:rendersSignal m2019av:signal ;
    sstim:rendersOntoParameter sstim-v:paramAmplitude ;
    sstim:hasRenderingMechanism sstim-v:mechanismAmplitudeModulation ;
    sstim:hasRenderingPresence sstim-v:presencePhysical ;
    sstim:renderingCarrierHz "10000.0"^^xsd:decimal .

m2019av:stimulus a sstim:StimulusSpecification ;
    rdfs:label "Concurrent 40 Hz light and tone stimulus (Martorell et al. 2019)"@en ;
    sstim:stimulusRegime "determinate" ;
    sstim:hasSignal m2019av:signal ;
    sstim:hasStimulusChannel m2019av:light, m2019av:tones ;
    sstim:hasStimulationTarget m2019av:subject .

m2019av:subject a bfo:0000040, obo:NCBITaxon_10090 ;
    rdfs:label "Mouse (Mus musculus)"@en .
