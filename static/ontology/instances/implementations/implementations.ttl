@prefix dct:    <http://purl.org/dc/terms/> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sstim:  <https://w3id.org/sstim#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix prov:   <http://www.w3.org/ns/prov#> .

@prefix bsclab-protocol: <https://w3id.org/sstim/implementation/bsclab/protocol/> .

<https://w3id.org/sstim/implementation/bsclab> a sstim:SensoryStimulationImplementation, prov:SoftwareAgent ;
    rdfs:label "BSC Lab" ;
    dct:description "Open research/reference implementation and knowledge platform for the BSC framework." ;
    dct:creator <https://orcid.org/0000-0002-9699-629X> ;
    dct:created "2026-06-17"^^xsd:date ;
    dct:modified "2026-07-10"^^xsd:date ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    sstim:implementsFramework <https://w3id.org/sstim/framework/bsc> ;
    sstim:implementsProtocol bsclab-protocol:auditory-observation-reference,
        bsclab-protocol:guided-breathing-observation-reference .

<https://w3id.org/sstim/implementation/biosyncare> a sstim:SensoryStimulationImplementation, prov:SoftwareAgent ;
    rdfs:label "BioSynCare" ;
    dct:description "Commercial application implementation for the BSC framework; its curated catalog is private and is not loaded by BSC Lab." ;
    dct:creator <https://orcid.org/0000-0002-9699-629X> ;
    dct:created "2026-06-17"^^xsd:date ;
    dct:modified "2026-07-10"^^xsd:date ;
    sstim:implementsFramework <https://w3id.org/sstim/framework/bsc> .
