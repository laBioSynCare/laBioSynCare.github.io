@prefix dct:    <http://purl.org/dc/terms/> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sstim:  <https://w3id.org/sstim#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix schema: <https://schema.org/> .

@prefix bsclab-protocol: <https://w3id.org/sstim/implementation/bsclab/protocol/> .

<https://w3id.org/sstim/implementation/bsclab> a sstim:SensoryStimulationImplementation, prov:SoftwareAgent ;
    rdfs:label "BSC Lab" ;
    dct:description "Open research/reference implementation and knowledge platform for the BSC framework. Developed and maintained within the Æterni Anima initiative." ;
    dct:creator <https://orcid.org/0000-0002-9699-629X> ;
    dct:contributor <https://w3id.org/sstim/organization/aeterni-anima> ;
    dct:created "2026-06-17"^^xsd:date ;
    dct:modified "2026-07-20"^^xsd:date ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:hasPart <https://w3id.org/sstim/implementation/bsclab/component/patch-studio> ;
    sstim:implementsFramework <https://w3id.org/sstim/framework/bsc> ;
    sstim:implementsProtocol bsclab-protocol:auditory-observation-reference,
        bsclab-protocol:guided-breathing-observation-reference .

<https://w3id.org/sstim/implementation/bsclab/component/patch-studio>
    a sstim:SensoryStimulationImplementation, prov:SoftwareAgent,
        schema:SoftwareApplication ;
    rdfs:label "Patch Studio"@en ;
    dct:description "The real-time multisensory authoring and preview component of BSC Lab; distinct from the SSTIM Patch Studio ontology module that describes its reproducible parameters. Developed and maintained within the Æterni Anima initiative."@en ;
    dct:creator <https://orcid.org/0000-0002-9699-629X> ;
    dct:contributor <https://w3id.org/sstim/organization/aeterni-anima> ;
    dct:created "2026-07-17"^^xsd:date ;
    dct:modified "2026-07-20"^^xsd:date ;
    dct:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    dct:isPartOf <https://w3id.org/sstim/implementation/bsclab> ;
    sstim:implementsFramework <https://w3id.org/sstim/framework/bsc> ;
    rdfs:seeAlso <https://w3id.org/sstim/patch-studio>,
        <https://github.com/laBioSynCare/laBioSynCare.github.io/blob/main/docs/technical/PATCH_STUDIO.md> .

<https://w3id.org/sstim/implementation/biosyncare> a sstim:SensoryStimulationImplementation, prov:SoftwareAgent ;
    rdfs:label "BioSynCare" ;
    dct:description "Commercial application implementation for the BSC framework; its curated catalog is private and is not loaded by BSC Lab. A product of the Æterni Anima initiative, which is responsible for it; there is no separate BioSynCare organization." ;
    dct:creator <https://orcid.org/0000-0002-9699-629X> ;
    dct:contributor <https://w3id.org/sstim/organization/aeterni-anima> ;
    dct:created "2026-06-17"^^xsd:date ;
    dct:modified "2026-07-20"^^xsd:date ;
    sstim:implementsFramework <https://w3id.org/sstim/framework/bsc> .
