@prefix dct:    <http://purl.org/dc/terms/> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sstim:  <https://w3id.org/sstim#> .
@prefix sstim-ex: <https://w3id.org/sstim/exposure#> .
@prefix sstim-v: <https://w3id.org/sstim/vocab#> .
@prefix bsclab-experiment: <https://w3id.org/sstim/implementation/bsclab/experiment/> .
@prefix this: <https://w3id.org/sstim/implementation/bsclab/experiment/multi-headphone-haptic#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

# ADR 0034: sstim-ex:ExploratoryProtocol no longer inherits a stimulation type,
# so a genuinely sensory exploratory protocol declares it explicitly. This one
# delivers structured input intended to engage canonical sensory transduction.
bsclab-experiment:multi-headphone-haptic a sstim-ex:ExploratoryProtocol, sstim:SensoryStimulationProtocol ;
    rdfs:label "Multi-headphone haptic placement"@en ;
    dct:description "Non-clinical exploratory setup for placing multiple audio devices near hands, feet, and the top of the head to model acoustic vibration as tactile or body-perceived stimulation."@en ;
    dct:creator <https://orcid.org/0000-0002-9699-629X> ;
    dct:modified "2026-07-10"^^xsd:date ;
    sstim:definedByFramework <https://w3id.org/sstim/framework/bsc> ;
    sstim:usesTechnique sstim-v:techAudioTactile, sstim-v:techVibroacoustic ;
    sstim-ex:hasExperimentContext sstim-ex:contextExploratoryNonClinical, sstim-ex:contextCapabilityBoundary ;
    sstim-ex:hasKnowledgeStatus sstim-ex:hypothesisInSSTIM, sstim-ex:notCurrentlyUsedInBSCLab ;
    sstim-ex:hasExposureProfile this:profile .

this:profile a sstim-ex:ExposureProfile ;
    rdfs:label "Multi-headphone haptic exposure profile"@en ;
    sstim-ex:hasKnowledgeStatus sstim-ex:hypothesisInSSTIM, sstim-ex:notCurrentlyUsedInBSCLab ;
    sstim-ex:usesStimulusChannel this:hand-channel, this:feet-channel, this:head-channel ;
    sstim-ex:requiresDeviceCapability sstim-ex:capabilityHeadphones, sstim-ex:capabilityMultiDeviceBodyPlacement ;
    sstim-ex:hasPerceptualGain sstim-ex:gainBodyVibration ;
    sstim-ex:hasComfortBoundary sstim-ex:boundaryHearingRisk, sstim-ex:boundaryBodyContactComfort ;
    sstim-ex:hasHypothesis this:tactile-audio-claim ;
    sstim-ex:hasBoundaryApplicability this:hearing-boundary-claim .

this:hand-channel a sstim-ex:StimulusChannel ;
    rdfs:label "Hand-placed acoustic vibration channel"@en ;
    sstim-ex:deliveryMedium sstim-ex:mediumAirConductedSound, sstim-ex:mediumContactAcousticVibration ;
    sstim-ex:perceivedModality sstim-ex:modalityTactile, sstim-ex:modalitySomatosensory ;
    sstim-ex:requiresDeviceCapability sstim-ex:capabilityHeadphones, sstim-ex:capabilityMultiDeviceBodyPlacement ;
    sstim-ex:hasBodyPlacement sstim-ex:placementHands ;
    sstim-ex:hasStimulusPattern sstim-ex:patternContinuous, sstim-ex:patternRhythmic .

this:feet-channel a sstim-ex:StimulusChannel ;
    rdfs:label "Feet-placed acoustic vibration channel"@en ;
    sstim-ex:deliveryMedium sstim-ex:mediumAirConductedSound, sstim-ex:mediumContactAcousticVibration ;
    sstim-ex:perceivedModality sstim-ex:modalityTactile, sstim-ex:modalitySomatosensory ;
    sstim-ex:requiresDeviceCapability sstim-ex:capabilityHeadphones, sstim-ex:capabilityMultiDeviceBodyPlacement ;
    sstim-ex:hasBodyPlacement sstim-ex:placementFeet ;
    sstim-ex:hasStimulusPattern sstim-ex:patternContinuous, sstim-ex:patternRhythmic .

this:head-channel a sstim-ex:StimulusChannel ;
    rdfs:label "Top-of-head acoustic vibration channel"@en ;
    sstim-ex:deliveryMedium sstim-ex:mediumAirConductedSound, sstim-ex:mediumContactAcousticVibration ;
    sstim-ex:perceivedModality sstim-ex:modalityTactile, sstim-ex:modalitySomatosensory ;
    sstim-ex:requiresDeviceCapability sstim-ex:capabilityHeadphones, sstim-ex:capabilityMultiDeviceBodyPlacement ;
    sstim-ex:hasBodyPlacement sstim-ex:placementTopOfHead ;
    sstim-ex:hasStimulusPattern sstim-ex:patternContinuous, sstim-ex:patternRhythmic ;
    sstim-ex:hasComfortBoundary sstim-ex:boundaryBodyContactComfort .

this:tactile-audio-claim a sstim-ex:ExposureHypothesis ;
    rdfs:label "Audio-as-tactile hypothesis"@en ;
    dct:description "Hypothesizes that sufficiently intense or contact-coupled audio may be perceived as tactile or body vibration. No comfort threshold or efficacy claim is asserted."@en ;
    sstim-ex:concernsEffectDimension sstim-ex:effectTactileSensation, sstim-ex:effectBodyVibration ;
    sstim-ex:hasKnowledgeStatus sstim-ex:hypothesisInSSTIM ;
    dct:modified "2026-07-13"^^xsd:date ;
    prov:wasAttributedTo <https://orcid.org/0000-0002-9699-629X> .

this:hearing-boundary-claim a sstim-ex:BoundaryApplicabilityStatement ;
    rdfs:label "Hearing comfort boundary"@en ;
    dct:description "Marks the need to separate body-vibration exploration from uncomfortable or unsafe hearing exposure."@en ;
    sstim-ex:appliesBoundary sstim-ex:boundaryHearingRisk ;
    sstim-ex:hasKnowledgeStatus sstim-ex:unknownToSSTIM ;
    dct:modified "2026-07-13"^^xsd:date ;
    prov:wasAttributedTo <https://orcid.org/0000-0002-9699-629X> .

