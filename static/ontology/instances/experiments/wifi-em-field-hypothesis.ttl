@prefix dct:    <http://purl.org/dc/terms/> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sstim:  <https://w3id.org/sstim#> .
@prefix sstim-ex: <https://w3id.org/sstim/exposure#> .
@prefix sstim-v: <https://w3id.org/sstim/vocab#> .
@prefix bsclab-experiment: <https://w3id.org/sstim/implementation/bsclab/experiment/> .
@prefix this: <https://w3id.org/sstim/implementation/bsclab/experiment/wifi-em-field-hypothesis#> .

bsclab-experiment:wifi-em-field-hypothesis a sstim-ex:ExploratoryProtocol ;
    rdfs:label "Wi-Fi electromagnetic-field exposure hypothesis"@en ;
    dct:description "Non-clinical modeling example for representing Wi-Fi, screen, cable, or nearby-device electromagnetic exposure as a physical delivery medium. It does not assert stimulation efficacy or physiological effect."@en ;
    sstim-ex:hasExperimentContext sstim-ex:contextExploratoryNonClinical, sstim-ex:contextCapabilityBoundary ;
    sstim-ex:hasKnowledgeStatus sstim-ex:unknownToSSTIM, sstim-ex:noKnownEvidenceInSSTIM ;
    sstim-ex:requiresDeviceCapability sstim-ex:capabilityAmbientRadioEmitter, sstim-ex:capabilitySensorInput ;
    sstim-ex:hasExposureProfile this:profile .

this:profile a sstim-ex:ExposureProfile ;
    rdfs:label "Wi-Fi/EM field exposure profile"@en ;
    sstim-ex:hasKnowledgeStatus sstim-ex:unknownToSSTIM, sstim-ex:noKnownEvidenceInSSTIM ;
    sstim-ex:usesStimulusChannel this:em-field-channel ;
    sstim-ex:hasPerceptualLoss sstim-ex:lossClaimCertainty ;
    sstim-ex:hasEffectClaim this:em-efficacy-claim, this:em-measurement-claim .

this:em-field-channel a sstim-ex:StimulusChannel ;
    rdfs:label "Electromagnetic-field exposure channel"@en ;
    sstim-ex:deliveryMedium sstim-ex:mediumElectromagneticField ;
    sstim-ex:perceivedModality sstim-ex:modalityNotDirectlyPerceived ;
    sstim-ex:requiresDeviceCapability sstim-ex:capabilityAmbientRadioEmitter, sstim-ex:capabilitySensorInput ;
    sstim-ex:hasBodyPlacement sstim-ex:placementNearbyEnvironment, sstim-ex:placementTorso ;
    sstim-ex:hasStimulusPattern sstim-ex:patternContinuous, sstim-ex:patternPulsed ;
    sstim-ex:hasKnowledgeStatus sstim-ex:unknownToSSTIM, sstim-ex:noKnownEvidenceInSSTIM .

this:em-efficacy-claim a sstim-ex:ExposureEffectClaim, sstim:EvidenceClaim ;
    rdfs:label "EM stimulation efficacy not asserted"@en ;
    dct:description "Records that SSTIM currently models this as an exposure hypothesis only; no stimulation efficacy is asserted here."@en ;
    sstim:hasEvidenceTier sstim-v:tierSpeculative ;
    sstim:hasModalityTag sstim-v:modalityGENERAL ;
    sstim-ex:concernsEffectDimension sstim-ex:effectPhysiologicalResponse ;
    sstim-ex:hasKnowledgeStatus sstim-ex:noKnownEvidenceInSSTIM .

this:em-measurement-claim a sstim-ex:ExposureEffectClaim, sstim:EvidenceClaim ;
    rdfs:label "EM exposure measurement requirement"@en ;
    dct:description "Marks electric/magnetic exposure estimation as a measurement prerequisite before any SSTIM claim can be reviewed."@en ;
    sstim:hasEvidenceTier sstim-v:tierSpeculative ;
    sstim:hasModalityTag sstim-v:modalityGENERAL ;
    sstim-ex:concernsEffectDimension sstim-ex:effectPhysiologicalResponse ;
    sstim-ex:hasKnowledgeStatus sstim-ex:unknownToSSTIM .
