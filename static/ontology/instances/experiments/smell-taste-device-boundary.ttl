@prefix dct:    <http://purl.org/dc/terms/> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sstim:  <https://w3id.org/sstim#> .
@prefix sstim-ex: <https://w3id.org/sstim/exposure#> .
@prefix sstim-v: <https://w3id.org/sstim/vocab#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix bsclab-experiment: <https://w3id.org/sstim/implementation/bsclab/experiment/> .
@prefix this: <https://w3id.org/sstim/implementation/bsclab/experiment/smell-taste-device-boundary#> .

# ADR 0034: deliberately NOT typed as any stimulation protocol — a capability-boundary document. Its own editorial note records that it
# intentionally maps to no supported stimulation technique, and every channel is
# not currently deliverable by BSC Lab, or outside its scope, in scoped assertions.
bsclab-experiment:smell-taste-device-boundary a sstim-ex:ExploratoryProtocol ;
    rdfs:label "Smell and taste device boundary"@en ;
    dct:description "Non-clinical modeling example that treats olfactory and gustatory modalities as SSTIM-relevant while marking ordinary phone smell, device taste, and perfume-on-device usage as outside current BSC Lab delivery capability."@en ;
    dct:creator <https://orcid.org/0000-0002-9699-629X> ;
    dct:modified "2026-10-06"^^xsd:date ;
    skos:editorialNote "Capability-boundary protocol: documents out-of-scope delivery paths and intentionally does not map them to a currently supported BSC stimulation technique."@en ;
    sstim:definedByFramework <https://w3id.org/sstim/framework/bsc> ;
    sstim-ex:hasExperimentContext sstim-ex:contextExploratoryNonClinical, sstim-ex:contextCapabilityBoundary ;
    sstim-ex:hasKnowledgeStatusAssertion this:status-protocol-not-currently-deliverable, this:status-protocol-outside-implementation-scope ;
    sstim-ex:hasExposureProfile this:profile .

this:profile a sstim-ex:ExposureProfile ;
    rdfs:label "Smell/taste boundary exposure profile"@en ;
    sstim-ex:hasKnowledgeStatusAssertion this:status-profile-not-currently-deliverable, this:status-profile-outside-implementation-scope ;
    sstim-ex:usesStimulusChannel this:phone-smell-channel, this:perfume-device-channel, this:device-taste-channel ;
    sstim-ex:requiresDeviceCapability sstim-ex:capabilityScentDelivery, sstim-ex:capabilityTasteDelivery ;
    sstim-ex:hasPerceptualLoss sstim-ex:lossDeliverability, sstim-ex:lossDeviceFeasibility  .
this:phone-smell-channel a sstim-ex:StimulusChannel ;
    rdfs:label "Phone smell channel"@en ;
    sstim-ex:deliveryMedium sstim-ex:mediumOlfactoryChemicalExposure ;
    sstim-ex:perceivedModality sstim-ex:modalityOlfactory ;
    sstim-ex:requiresDeviceCapability sstim-ex:capabilityScentDelivery ;
    sstim-ex:hasBodyPlacement sstim-ex:placementNose ;
    sstim-ex:hasKnowledgeStatusAssertion this:status-phone-smell-channel-not-currently-deliverable .

this:perfume-device-channel a sstim-ex:StimulusChannel ;
    rdfs:label "Perfume-on-device olfactory channel"@en ;
    sstim-ex:deliveryMedium sstim-ex:mediumOlfactoryChemicalExposure ;
    sstim-ex:perceivedModality sstim-ex:modalityOlfactory ;
    sstim-ex:requiresDeviceCapability sstim-ex:capabilityScentDelivery ;
    sstim-ex:hasBodyPlacement sstim-ex:placementNose ;
    sstim-ex:hasKnowledgeStatusAssertion this:status-perfume-device-channel-outside-implementation-scope .

this:device-taste-channel a sstim-ex:StimulusChannel ;
    rdfs:label "Device taste channel"@en ;
    sstim-ex:deliveryMedium sstim-ex:mediumGustatoryChemicalExposure ;
    sstim-ex:perceivedModality sstim-ex:modalityGustatory ;
    sstim-ex:requiresDeviceCapability sstim-ex:capabilityTasteDelivery ;
    sstim-ex:hasBodyPlacement sstim-ex:placementMouth ;
    sstim-ex:hasKnowledgeStatusAssertion this:status-device-taste-channel-not-currently-deliverable, this:status-device-taste-channel-outside-implementation-scope .


# Delivery statuses (ADR 0061). Each is scoped to the implementation it
# describes, BSC Lab, instead of being spelled into the vocabulary. They were
# re-expressed, not re-assessed: the as-of date is the record's own.

this:status-protocol-not-currently-deliverable a sstim-ex:KnowledgeStatusAssertion ;
    rdfs:label "BSC Lab delivery status of protocol: not currently deliverable"@en ;
    sstim-ex:hasKnowledgeStatus sstim-ex:notCurrentlyDeliverable ;
    sstim-ex:knowledgeAsOfDate "2026-07-10"^^xsd:date ;
    sstim-ex:knowledgeScope <https://w3id.org/sstim/implementation/bsclab> ;
    prov:wasGeneratedBy this:status-migration .

this:status-protocol-outside-implementation-scope a sstim-ex:KnowledgeStatusAssertion ;
