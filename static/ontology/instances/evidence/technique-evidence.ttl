# ── 2. FFR / monaural component applicability ────────────────────────────────

<https://w3id.org/sstim/implementation/bsclab/evidence/ffr-monaural-response/revision/1>
    a sstim:EvidenceAssessmentClaim, sstim:EvidenceClaim ;
    rdfs:label "Subcortical frequency-following response to acoustically periodic stimuli (assessment revision 1)" ;
    dct:description "Stimuli that carry a physical acoustic periodicity (monaural beats, isochronic tones) evoke a subcortical frequency-following response (FFR) that tracks the stimulus envelope. A measurable brainstem response; downstream cognitive or wellness effects are not asserted here." ;
    sstim:evaluatesSubject sstim-v:techMonauralBeats ;
    sstim:supportsRelation sstim-v:techMonauralBeats ;
    sstim:hasEvidenceTier sstim-v:tierStrong ;
    sstim:hasClaimDirection sstim-v:claimSupports ;
    sstim:assessesProposition <https://w3id.org/sstim/implementation/bsclab/evidence/ffr-monaural-response/revision/1/proposition> ;
    sstim:hasEvidenceBasis <https://w3id.org/sstim/implementation/bsclab/evidence/ffr-monaural-response/revision/1/basis-1> ;
    sstim:citesReference sstim-ref:SKOE_KRAUS_2010 ;
    prov:wasGeneratedBy <https://w3id.org/sstim/implementation/bsclab/evidence/ffr-monaural-response/revision/1/activity> ;
    prov:wasDerivedFrom bsclab-evidence:ffr-monaural-response ;
    dct:modified "2026-07-13"^^xsd:date ;
    prov:wasAttributedTo <https://orcid.org/0000-0002-9699-629X> .

<https://w3id.org/sstim/implementation/bsclab/evidence/ffr-monaural-response/revision/1/proposition>
    a sstim:AssessmentProposition ;
    sstim:propositionSubject sstim-v:techMonauralBeats ;
    sstim:propositionOutcome <https://w3id.org/sstim/implementation/bsclab/evidence/outcome/ffr-component-applicability> ;
    sstim:hasAssessmentScope <https://w3id.org/sstim/implementation/bsclab/evidence/ffr-monaural-response/revision/1/scope> ;
    sstim:hasPropositionForm sstim-v:formBoundedRelation ;
    sstim:propositionText "The acoustically periodic envelope produced by the monaural-beats technique can evoke an envelope-tracking subcortical frequency-following response; the tutorial covers complex periodic sounds generally, not every monaural-beat implementation."@en .

<https://w3id.org/sstim/implementation/bsclab/evidence/ffr-monaural-response/revision/1/scope>
    a sstim:AssessmentScope ;
    sstim:scopeSensoryModality sstim-v:modalityAuditory ;
    sstim:scopePopulationOrModel <https://w3id.org/sstim/implementation/bsclab/evidence/population/human-auditory-electrophysiology> ;
    sstim:scopeInterventionOrContext sstim-v:techMonauralBeats ;
    sstim:scopeComparator <https://w3id.org/sstim/implementation/bsclab/evidence/comparator/aperiodic-or-non-envelope-modulated> .

<https://w3id.org/sstim/implementation/bsclab/evidence/ffr-monaural-response/revision/1/basis-1>
    a sstim:EvidenceBasis ;
    sstim:basisSource sstim-ref:SKOE_KRAUS_2010 ;
    sstim:basisSensoryModality sstim-v:modalityAuditory ;
    sstim:basisStudyModel sstim-v:modelHuman ;
    sstim:basisStudyPopulation <https://w3id.org/sstim/implementation/bsclab/evidence/population/human-auditory-electrophysiology> ;
    sstim:basisStudyDesign sstim-v:designUnknownDesign ;
    sstim:basisSynthesisType sstim-v:synthesisTutorial ;
    sstim:basisObservedOutcome <https://w3id.org/sstim/implementation/bsclab/evidence/outcome/ffr-component-applicability> ;
    sstim:basisComparator <https://w3id.org/sstim/implementation/bsclab/evidence/comparator/aperiodic-or-non-envelope-modulated> ;
    sstim:basisOutcomeNote "Envelope-tracking FFR is reliably recorded to periodic/complex sounds; distinct from binaural beats, whose beat has no acoustic periodicity."@en .

<https://w3id.org/sstim/implementation/bsclab/evidence/ffr-monaural-response/revision/1/activity>
    a sstim:EvidenceAssessmentActivity ;
    prov:used <https://w3id.org/sstim/implementation/bsclab/evidence/ffr-monaural-response/revision/1/basis-1>,
        sstim-ref:SKOE_KRAUS_2010,
        <https://w3id.org/sstim/implementation/bsclab/evidence/method/adr-0027-migration/1> ;
    prov:endedAtTime "2026-07-13T21:00:00Z"^^xsd:dateTime ;
    prov:qualifiedAssociation [ a prov:Association ;
        prov:agent <https://orcid.org/0000-0002-9699-629X> ;
        prov:hadRole <https://w3id.org/sstim/implementation/bsclab/evidence/role/migration-editor> ] .

