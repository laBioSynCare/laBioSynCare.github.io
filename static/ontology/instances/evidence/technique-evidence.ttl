# ── 3. Binaural-beat state response (mixed) ──────────────────────────────────

<https://w3id.org/sstim/implementation/bsclab/evidence/binaural-beats-state-mixed/revision/1>
    a sstim:EvidenceAssessmentClaim, sstim:EvidenceClaim ;
    rdfs:label "Binaural-beat effects on EEG oscillatory activity and psychological state are mixed (assessment revision 1)" ;
    dct:description "A systematic review finds the effects of binaural-beat stimulation on brain oscillatory activity and on psychological/cognitive state to be inconsistent across studies. The perceived beat is a central construct with no acoustic periodicity, so the subcortical FFR does not straightforwardly transfer." ;
    sstim:evaluatesSubject sstim-v:techBinauralBeats ;
    sstim:supportsRelation sstim-v:techBinauralBeats ;
    sstim:hasEvidenceTier sstim-v:tierPreliminary ;
    sstim:hasClaimDirection sstim-v:claimMixed ;
    sstim:assessesProposition <https://w3id.org/sstim/implementation/bsclab/evidence/binaural-beats-state-mixed/revision/1/proposition> ;
    sstim:hasEvidenceBasis <https://w3id.org/sstim/implementation/bsclab/evidence/binaural-beats-state-mixed/revision/1/basis-1> ;
    sstim:citesReference sstim-ref:INGENDOH_2023 ;
    prov:wasGeneratedBy <https://w3id.org/sstim/implementation/bsclab/evidence/binaural-beats-state-mixed/revision/1/activity> ;
    prov:wasDerivedFrom bsclab-evidence:binaural-beats-state-mixed ;
    dct:modified "2026-07-13"^^xsd:date ;
    prov:wasAttributedTo <https://orcid.org/0000-0002-9699-629X> .

<https://w3id.org/sstim/implementation/bsclab/evidence/binaural-beats-state-mixed/revision/1/proposition>
    a sstim:AssessmentProposition ;
    sstim:propositionSubject sstim-v:techBinauralBeats ;
    sstim:propositionOutcome <https://w3id.org/sstim/implementation/bsclab/evidence/outcome/binaural-state-response-reliability> ;
    sstim:hasAssessmentScope <https://w3id.org/sstim/implementation/bsclab/evidence/binaural-beats-state-mixed/revision/1/scope> ;
    sstim:hasPropositionForm sstim-v:formBoundedRelation ;
    sstim:propositionText "The binaural-beats technique produces a reliable, generalizable modality-matched state response under sham or no-beat comparison."@en .

<https://w3id.org/sstim/implementation/bsclab/evidence/binaural-beats-state-mixed/revision/1/scope>
    a sstim:AssessmentScope ;
    sstim:scopeSensoryModality sstim-v:modalityAuditory ;
