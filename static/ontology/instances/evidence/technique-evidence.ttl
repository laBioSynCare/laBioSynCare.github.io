# ── 1. ASSR / isochronic component applicability ─────────────────────────────

<https://w3id.org/sstim/implementation/bsclab/evidence/assr-isochronic-response/revision/1>
    a sstim:EvidenceAssessmentClaim, sstim:EvidenceClaim ;
    rdfs:label "Auditory steady-state response to isochronic / amplitude-modulated auditory stimulation (assessment revision 1)" ;
    dct:description "Periodic auditory stimulation (isochronic tones, amplitude-modulated tones, click trains) reliably evokes a phase-locked auditory steady-state response (ASSR), most robust near 40 Hz. A measurable electrophysiological response — not a wellness outcome." ;
    sstim:evaluatesSubject sstim-v:techIsochronicTones ;
    sstim:supportsRelation sstim-v:techIsochronicTones ;
    sstim:hasEvidenceTier sstim-v:tierStrong ;
    sstim:hasClaimDirection sstim-v:claimSupports ;
    sstim:assessesProposition <https://w3id.org/sstim/implementation/bsclab/evidence/assr-isochronic-response/revision/1/proposition> ;
    sstim:hasEvidenceBasis <https://w3id.org/sstim/implementation/bsclab/evidence/assr-isochronic-response/revision/1/basis-1> ;
    sstim:citesReference sstim-ref:PICTON_2003 ;
    prov:wasGeneratedBy <https://w3id.org/sstim/implementation/bsclab/evidence/assr-isochronic-response/revision/1/activity> ;
    prov:wasDerivedFrom bsclab-evidence:assr-isochronic-response ;
    dct:modified "2026-07-13"^^xsd:date ;
    prov:wasAttributedTo <https://orcid.org/0000-0002-9699-629X> .

<https://w3id.org/sstim/implementation/bsclab/evidence/assr-isochronic-response/revision/1/proposition>
    a sstim:AssessmentProposition ;
    sstim:propositionSubject sstim-v:techIsochronicTones ;
    sstim:propositionOutcome <https://w3id.org/sstim/implementation/bsclab/evidence/outcome/assr-component-applicability> ;
    sstim:hasAssessmentScope <https://w3id.org/sstim/implementation/bsclab/evidence/assr-isochronic-response/revision/1/scope> ;
    sstim:hasPropositionForm sstim-v:formBoundedRelation ;
    sstim:propositionText "The periodic pulse or modulation component of the isochronic-tones technique, when delivered at a defined rate, can evoke a phase-locked auditory steady-state response at that rate; the source covers periodic auditory stimulation generally, not every isochronic implementation."@en .

<https://w3id.org/sstim/implementation/bsclab/evidence/assr-isochronic-response/revision/1/scope>
    a sstim:AssessmentScope ;
    sstim:scopeSensoryModality sstim-v:modalityAuditory ;
    sstim:scopePopulationOrModel <https://w3id.org/sstim/implementation/bsclab/evidence/population/human-auditory-electrophysiology> ;
    sstim:scopeInterventionOrContext sstim-v:techIsochronicTones ;
    sstim:scopeComparator <https://w3id.org/sstim/implementation/bsclab/evidence/comparator/unmodulated-or-no-periodic-stimulus> .

<https://w3id.org/sstim/implementation/bsclab/evidence/assr-isochronic-response/revision/1/basis-1>
    a sstim:EvidenceBasis ;
    sstim:basisSource sstim-ref:PICTON_2003 ;
    sstim:basisSensoryModality sstim-v:modalityAuditory ;
    sstim:basisStudyModel sstim-v:modelHuman ;
    sstim:basisStudyPopulation <https://w3id.org/sstim/implementation/bsclab/evidence/population/human-auditory-electrophysiology> ;
    sstim:basisStudyDesign sstim-v:designUnknownDesign ;
    sstim:basisSynthesisType sstim-v:synthesisNarrativeReview ;
    sstim:basisObservedOutcome <https://w3id.org/sstim/implementation/bsclab/evidence/outcome/assr-component-applicability> ;
    sstim:basisComparator <https://w3id.org/sstim/implementation/bsclab/evidence/comparator/unmodulated-or-no-periodic-stimulus> ;
    sstim:basisOutcomeNote "Reliable phase-locked ASSR at the modulation/pulse rate; the modulation rate (not the carrier) sets the response frequency."@en .

<https://w3id.org/sstim/implementation/bsclab/evidence/assr-isochronic-response/revision/1/activity>
    a sstim:EvidenceAssessmentActivity ;
    prov:used <https://w3id.org/sstim/implementation/bsclab/evidence/assr-isochronic-response/revision/1/basis-1>,
        sstim-ref:PICTON_2003,
        <https://w3id.org/sstim/implementation/bsclab/evidence/method/adr-0027-migration/1> ;
    prov:endedAtTime "2026-07-13T21:00:00Z"^^xsd:dateTime ;
    prov:qualifiedAssociation [ a prov:Association ;
        prov:agent <https://orcid.org/0000-0002-9699-629X> ;
        prov:hadRole <https://w3id.org/sstim/implementation/bsclab/evidence/role/migration-editor> ] .

