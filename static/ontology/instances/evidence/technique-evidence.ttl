# ── 7. Multisensory integration mechanism (indirect) ─────────────────────────

<https://w3id.org/sstim/implementation/bsclab/evidence/multisensory-integration-mechanism/revision/1>
    a sstim:EvidenceAssessmentClaim, sstim:EvidenceClaim ;
    rdfs:label "Convergent processing supports a multisensory integration mechanism (assessment revision 1)" ;
    dct:description "Conditional, indirect mechanism-applicability assessment: a neuroscience review supports integrative neural processing across sensory channels under context- and timing-dependent conditions. It does not establish audiovisual entrainment or a wellness benefit." ;
    sstim:evaluatesSubject sstim-v:techAudiovisualEntrainment ;
    sstim:supportsRelation sstim-v:techAudiovisualEntrainment ;
    sstim:hasEvidenceTier sstim-v:tierModerate ;
    sstim:hasClaimDirection sstim-v:claimSupports ;
    sstim:assessesProposition <https://w3id.org/sstim/implementation/bsclab/evidence/multisensory-integration-mechanism/revision/1/proposition> ;
    sstim:hasEvidenceBasis <https://w3id.org/sstim/implementation/bsclab/evidence/multisensory-integration-mechanism/revision/1/basis-1> ;
    sstim:citesReference sstim-ref:STEIN_STANFORD_2008 ;
    prov:wasGeneratedBy <https://w3id.org/sstim/implementation/bsclab/evidence/multisensory-integration-mechanism/revision/1/activity> ;
    prov:wasDerivedFrom bsclab-evidence:multisensory-integration-mechanism ;
    dct:modified "2026-07-13"^^xsd:date ;
    prov:wasAttributedTo <https://orcid.org/0000-0002-9699-629X> .

<https://w3id.org/sstim/implementation/bsclab/evidence/multisensory-integration-mechanism/revision/1/proposition>
    a sstim:AssessmentProposition ;
    sstim:propositionSubject sstim-v:techAudiovisualEntrainment ;
    sstim:propositionOutcome <https://w3id.org/sstim/implementation/bsclab/evidence/outcome/audiovisual-integration-mechanism-applicability> ;
    sstim:hasAssessmentScope <https://w3id.org/sstim/implementation/bsclab/evidence/multisensory-integration-mechanism/revision/1/scope> ;
    sstim:hasPropositionForm sstim-v:formBoundedRelation ;
    sstim:propositionText "The auditory and visual components of the audiovisual-entrainment technique fall within modalities that can participate in context- and timing-dependent multisensory integration; this indirect mechanism applicability does not establish entrainment or benefit."@en .

