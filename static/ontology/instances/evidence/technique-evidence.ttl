    sstim:scopeInterventionOrContext sstim-v:techBinauralBeats ;
    sstim:scopeComparator <https://w3id.org/sstim/implementation/bsclab/evidence/comparator/sham-or-no-beat> .

<https://w3id.org/sstim/implementation/bsclab/evidence/binaural-beats-state-mixed/revision/1/basis-1>
    a sstim:EvidenceBasis ;
    sstim:basisSource sstim-ref:INGENDOH_2023 ;
    sstim:basisSensoryModality sstim-v:modalityAuditory ;
    sstim:basisStudyModel sstim-v:modelHuman ;
    sstim:basisStudyPopulation <https://w3id.org/sstim/implementation/bsclab/evidence/population/healthy-human> ;
    sstim:basisStudyDesign sstim-v:designMixedDesigns ;
    sstim:basisSynthesisType sstim-v:synthesisSystematicReview ;
    sstim:basisObservedOutcome <https://w3id.org/sstim/implementation/bsclab/evidence/outcome/binaural-state-response-reliability> ;
    sstim:basisComparator <https://w3id.org/sstim/implementation/bsclab/evidence/comparator/sham-or-no-beat> ;
    sstim:basisOutcomeNote "Reported effects on EEG and state are mixed/inconsistent across the reviewed studies; no reliable modality-matched outcome established."@en .

