# ── 4. Slow-breathing component applicability (indirect) ─────────────────────

<https://w3id.org/sstim/implementation/bsclab/evidence/slow-breathing-physiology-review/revision/1>
    a sstim:EvidenceAssessmentClaim, sstim:EvidenceClaim ;
    rdfs:label "Slow breathing is associated with measurable psychophysiological correlates (assessment revision 1)" ;
    dct:description "Conditional, indirect component-applicability assessment: a systematic review of slow breathing in healthy participants reports measurable cardiorespiratory and central correlates. The source studies breathing behavior; it is not evidence about the Martigli auditory cue itself." ;
    sstim:evaluatesSubject bsc-fw-tech:martigli-breathing-oscillation ;
    sstim:supportsRelation bsc-fw-tech:martigli-breathing-oscillation ;
    sstim:hasEvidenceTier sstim-v:tierModerate ;
    sstim:hasClaimDirection sstim-v:claimSupports ;
    sstim:assessesProposition <https://w3id.org/sstim/implementation/bsclab/evidence/slow-breathing-physiology-review/revision/1/proposition> ;
    sstim:hasEvidenceBasis <https://w3id.org/sstim/implementation/bsclab/evidence/slow-breathing-physiology-review/revision/1/basis-1> ;
    sstim:citesReference sstim-ref:ZACCARO_2018 ;
    prov:wasGeneratedBy <https://w3id.org/sstim/implementation/bsclab/evidence/slow-breathing-physiology-review/revision/1/activity> ;
    prov:wasDerivedFrom bsclab-evidence:slow-breathing-physiology-review ;
    dct:modified "2026-07-13"^^xsd:date ;
    prov:wasAttributedTo <https://orcid.org/0000-0002-9699-629X> .

<https://w3id.org/sstim/implementation/bsclab/evidence/slow-breathing-physiology-review/revision/1/proposition>
    a sstim:AssessmentProposition ;
    sstim:propositionSubject bsc-fw-tech:martigli-breathing-oscillation ;
    sstim:propositionOutcome <https://w3id.org/sstim/implementation/bsclab/evidence/outcome/slow-breathing-component-applicability> ;
    sstim:hasAssessmentScope <https://w3id.org/sstim/implementation/bsclab/evidence/slow-breathing-physiology-review/revision/1/scope> ;
    sstim:hasPropositionForm sstim-v:formBoundedRelation ;
    sstim:propositionText "If the breathing component of the Martigli breathing-oscillation technique actually elicits slow breathing below ten cycles per minute, that breathing behavior is associated with measurable psychophysiological correlates in healthy humans relative to baseline, spontaneous, or faster breathing; the proposition does not assess the auditory guidance itself."@en .

<https://w3id.org/sstim/implementation/bsclab/evidence/slow-breathing-physiology-review/revision/1/scope>
    a sstim:AssessmentScope ;
    sstim:scopeSensoryModality sstim-v:scopeNotApplicable ;
    sstim:scopePopulationOrModel <https://w3id.org/sstim/implementation/bsclab/evidence/population/healthy-human> ;
    sstim:scopeInterventionOrContext bsc-fw-tech:martigli-breathing-oscillation ;
    sstim:scopeComparator <https://w3id.org/sstim/implementation/bsclab/evidence/comparator/baseline-spontaneous-or-faster-breathing> .

<https://w3id.org/sstim/implementation/bsclab/evidence/slow-breathing-physiology-review/revision/1/basis-1>
    a sstim:EvidenceBasis ;
    sstim:basisSource sstim-ref:ZACCARO_2018 ;
    sstim:basisModalityApplicability sstim-v:applicabilityNotApplicable ;
    sstim:basisIntervention <https://w3id.org/sstim/implementation/bsclab/evidence/intervention/paced-slow-breathing> ;
    sstim:basisStudyModel sstim-v:modelHuman ;
    sstim:basisStudyPopulation <https://w3id.org/sstim/implementation/bsclab/evidence/population/healthy-human> ;
    sstim:basisStudyDesign sstim-v:designMixedDesigns ;
    sstim:basisSynthesisType sstim-v:synthesisSystematicReview ;
