<https://w3id.org/sstim/implementation/bsclab/evidence/alpha-attention-memory/revision/1>
    a sstim:EvidenceAssessmentClaim, sstim:EvidenceClaim ;
    rdfs:label "Alpha oscillation and attentional access to stored information (assessment revision 1)" ;
    dct:description "Alpha-band activity covaries with attentional control and with access to stored information. An electrophysiological and cognitive-performance association observed in human scalp EEG — not a wellness outcome, and not a claim about stimulating at alpha frequencies." ;
    sstim:evaluatesSubject sstim-v:alphaOscillation ;
    sstim:supportsRelation sstim-v:alphaOscillation ;
    sstim:hasEvidenceTier sstim-v:tierModerate ;
    sstim:hasClaimDirection sstim-v:claimSupports ;
    sstim:assessesProposition <https://w3id.org/sstim/implementation/bsclab/evidence/alpha-attention-memory/revision/1/proposition> ;
    sstim:hasEvidenceBasis <https://w3id.org/sstim/implementation/bsclab/evidence/alpha-attention-memory/revision/1/basis-1> ;
    sstim:citesReference sstim-ref:KLIMESCH_2012 ;
    prov:wasGeneratedBy <https://w3id.org/sstim/implementation/bsclab/evidence/alpha-attention-memory/revision/1/activity> ;
    dct:modified "2026-08-15"^^xsd:date ;
    prov:wasAttributedTo <https://orcid.org/0000-0002-9699-629X> .

<https://w3id.org/sstim/implementation/bsclab/evidence/alpha-attention-memory/revision/1/proposition>
    a sstim:AssessmentProposition ;
    sstim:propositionSubject sstim-v:alphaOscillation ;
    sstim:propositionOutcome <https://w3id.org/sstim/implementation/bsclab/evidence/outcome/alpha-attention-access> ;
    sstim:hasAssessmentScope <https://w3id.org/sstim/implementation/bsclab/evidence/alpha-attention-memory/revision/1/scope> ;
    sstim:hasPropositionForm sstim-v:formBoundedRelation ;
    sstim:propositionText "Alpha-band oscillatory activity covaries with attentional control and controlled access to stored information in human scalp-EEG studies. The source is a review synthesising that literature; it concerns the endogenous rhythm and makes no claim about the effect of delivering stimulation at alpha frequencies."@en .

