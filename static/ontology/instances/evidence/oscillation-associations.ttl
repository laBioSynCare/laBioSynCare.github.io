###########################################################################
#
#  Neural oscillation associations  —  ADR 0049
#
#  The six frequency bands used to carry associations in their scope notes:
#  "Deep sleep, heavy down-regulation", "Relaxation, stress reduction, calm
#  alertness", and so on. Those were properties of a Hz interval, unsourced,
#  undated and with no indication of how well supported they were.
#
#  ADR 0049 moves them here, onto the rhythms, and requires each to be one of
#  two things and never a third. Either an evidence assessment with a tier and
#  a citation, or a dated knowledge-status assertion recording that no evidence
#  was found in the corpus. Restating them as prose on a better subject was
#  explicitly refused: a scope note carries no tier, no source and no date.
#
#  Six of the nine end at noKnownEvidenceInSSTIM. That is the result, not a
#  failure to finish: it records that a widely repeated association is not
#  evidenced here, which is exactly what the old scope notes concealed.
#
#  Note what is *not* in this file. "Alpha is prominent with the eyes closed"
#  and "delta is prominent in slow-wave sleep" are observation conditions, not
#  outcomes — they say when a rhythm is seen, not what targeting it does — and
#  they live on the concepts as sstim:hasOscillationStateContext.
#
#  Every DOI cited here was resolved through Crossref before being written.
#
###########################################################################

@prefix bsclab-evidence: <https://w3id.org/sstim/implementation/bsclab/evidence/> .
@prefix dct:       <http://purl.org/dc/terms/> .
@prefix owl:       <http://www.w3.org/2002/07/owl#> .
@prefix prov:      <http://www.w3.org/ns/prov#> .
@prefix rdfs:      <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sstim:     <https://w3id.org/sstim#> .
@prefix sstim-ex:  <https://w3id.org/sstim/exposure#> .
@prefix sstim-ref: <https://w3id.org/sstim/ref/> .
@prefix sstim-v:   <https://w3id.org/sstim/vocab#> .
@prefix xsd:       <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/sstim/implementation/bsclab/evidence/method/adr-0049-oscillation-association/1>
    rdfs:label "ADR 0049 oscillation-association assessment method, revision 1"@en ;
    dct:description "Each association previously asserted in a frequency-band scope note is assessed against literature located in 2026-08. Where a source is found and verified through Crossref, an assessment records it with a tier. Where none is found, a dated knowledge-status assertion records the absence rather than the association being deleted. No citation is asserted from memory. This method revision is immutable."@en ;
    dct:created "2026-08-15"^^xsd:date .

<https://w3id.org/sstim/implementation/bsclab/evidence/role/oscillation-association-editor>
    rdfs:label "Oscillation association editor"@en ;
    dct:description "Curator role for the ADR 0049 association pass."@en .

<https://w3id.org/sstim/implementation/bsclab/evidence/population/human-scalp-eeg>
    rdfs:label "Human scalp-EEG cognitive studies"@en ;
    dct:description "Adult human participants studied with scalp EEG in cognitive and memory paradigms."@en .

<https://w3id.org/sstim/implementation/bsclab/evidence/comparator/other-band-activity>
    rdfs:label "Activity in other frequency bands"@en ;
    dct:description "Comparison against activity outside the band under assessment, or against a task-free baseline."@en .


