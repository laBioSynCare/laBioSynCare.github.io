@prefix dct:       <http://purl.org/dc/terms/> .
@prefix foaf:      <http://xmlns.com/foaf/0.1/> .
@prefix org:       <http://www.w3.org/ns/org#> .
@prefix prov:      <http://www.w3.org/ns/prov#> .
@prefix rdfs:      <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema:    <https://schema.org/> .
@prefix sstim:     <https://w3id.org/sstim#> .
@prefix sstim-eco: <https://w3id.org/sstim/ecosystem#> .
@prefix xsd:       <http://www.w3.org/2001/XMLSchema#> .

@prefix activity: <https://w3id.org/sstim/ecosystem-record/activity/> .
@prefix record:   <https://w3id.org/sstim/ecosystem-record/relationship/> .
@prefix role:     <https://example.org/roles/> .

# Synthetic, non-personal, public-safe fixture graph for ADR 0031. Every identity,
# source, homepage, relationship, and lifecycle event is illustrative. The
# example.org documents do not identify a real person or organization. This
# graph grants no archival-publication permission and contains no private
# correspondence, contact channel, authentication identifier, or consent
# evidence.

<https://example.org/agent/synthetic-curator> a prov:Agent ;
    rdfs:label "Synthetic fixture curator"@en .


###########################################################################
# Synthetic identities
###########################################################################

<https://w3id.org/sstim/specialist/synthetic-alex-rivera>
    a sstim-eco:EcosystemAgent, prov:Agent, schema:Person, foaf:Person ;
    rdfs:label "Alex Rivera (synthetic fixture)"@en ;
    dct:description "A fictional person used to prove that several memberships and relationships remain separately qualified."@en ;
    dct:source <https://example.org/directory/people/alex-rivera> ;
    dct:created "2026-07-15"^^xsd:date ;
    dct:modified "2026-07-15"^^xsd:date ;
    schema:url <https://example.org/people/alex-rivera> ;
    prov:wasAttributedTo <https://example.org/agent/synthetic-curator> ;
    sstim-eco:hasEcosystemRelationship
        record:synthetic-alex-membership-aurora,
        record:synthetic-alex-membership-resonance,
        record:synthetic-alex-attribution-player,
        record:synthetic-alex-outreach-resonance .

<https://w3id.org/sstim/organization/synthetic-aurora-lab>
    a sstim-eco:EcosystemAgent, prov:Agent, schema:Organization, org:Organization ;
    rdfs:label "Aurora Lab (synthetic fixture)"@en ;
    dct:description "A fictional laboratory used only by the qualified-ecosystem contract fixture."@en ;
    dct:source <https://example.org/directory/organizations/aurora-lab> ;
    dct:created "2026-07-15"^^xsd:date ;
    dct:modified "2026-07-15"^^xsd:date ;
    schema:url <https://example.org/organizations/aurora-lab> ;
    prov:wasAttributedTo <https://example.org/agent/synthetic-curator> ;
    sstim-eco:hasEcosystemRelationship record:synthetic-aurora-develops-player .

<https://w3id.org/sstim/organization/synthetic-resonance-coop>
    a sstim-eco:EcosystemAgent, prov:Agent, schema:Organization, org:Organization ;
    rdfs:label "Resonance Cooperative (synthetic fixture)"@en ;
    dct:description "A fictional cooperative used only by the qualified-ecosystem contract fixture."@en ;
    dct:source <https://example.org/directory/organizations/resonance-coop> ;
    dct:created "2026-07-15"^^xsd:date ;
    dct:modified "2026-07-15"^^xsd:date ;
    schema:url <https://example.org/organizations/resonance-coop> ;
    prov:wasAttributedTo <https://example.org/agent/synthetic-curator> ;
    sstim-eco:hasEcosystemRelationship record:synthetic-resonance-provides-player .


###########################################################################
# Synthetic relationship targets and membership roles
###########################################################################

<https://w3id.org/sstim/implementation/bsclab/synthetic-ecosystem-player>
    a sstim:SensoryStimulationImplementation ;
    rdfs:label "Synthetic sensory player"@en ;
    dct:description "A fictional implementation used only to exercise qualified implementation responsibility."@en ;
    sstim:implementsFramework <https://w3id.org/sstim/framework/bsc> .

role:researcher a org:Role ;
    rdfs:label "Researcher (synthetic fixture role)"@en .

role:maintainer a org:Role ;
    rdfs:label "Maintainer (synthetic fixture role)"@en .


###########################################################################
# Two separately sourced, time-qualified memberships for the same person
###########################################################################

record:synthetic-alex-membership-aurora
    a sstim-eco:EcosystemRelationship, sstim-eco:OrganizationMembership,
        org:Membership ;
    rdfs:label "Alex Rivera synthetic membership in Aurora Lab"@en ;
    sstim-eco:relationshipAgent
        <https://w3id.org/sstim/specialist/synthetic-alex-rivera> ;
    sstim-eco:relationshipTarget
        <https://w3id.org/sstim/organization/synthetic-aurora-lab> ;
    sstim-eco:hasRelationshipType sstim-eco:organizationMember ;
    sstim-eco:relationshipPurpose sstim-eco:purposePublicDiscovery ;
    org:member <https://w3id.org/sstim/specialist/synthetic-alex-rivera> ;
    org:organization
        <https://w3id.org/sstim/organization/synthetic-aurora-lab> ;
    org:role role:researcher ;
    dct:source <https://example.org/sources/aurora-membership> ;
    dct:created "2026-07-15"^^xsd:date ;
    sstim-eco:reviewedOn "2026-07-15"^^xsd:date ;
    sstim-eco:validFrom "2024-01-10"^^xsd:date ;
    prov:wasAttributedTo <https://example.org/agent/synthetic-curator> ;
    sstim-eco:hasEngagementActivity
        activity:synthetic-aurora-membership-consent,
        activity:synthetic-aurora-membership-publication .

activity:synthetic-aurora-membership-consent
    a sstim-eco:EngagementActivity, sstim-eco:ConsentDecisionActivity,
        prov:Activity ;
    rdfs:label "Synthetic Aurora membership consent decision"@en ;
    sstim-eco:engagementFor record:synthetic-alex-membership-aurora ;
    sstim-eco:engagementPurpose sstim-eco:purposePublicDiscovery ;
    sstim-eco:engagementOutcome sstim-eco:outcomeConsentGranted ;
    prov:endedAtTime "2026-07-15T09:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith
        <https://w3id.org/sstim/specialist/synthetic-alex-rivera> .

activity:synthetic-aurora-membership-publication
    a sstim-eco:EngagementActivity, sstim-eco:PublicationDecisionActivity,
        prov:Activity ;
    rdfs:label "Synthetic Aurora membership publication decision"@en ;
    sstim-eco:engagementFor record:synthetic-alex-membership-aurora ;
    sstim-eco:engagementPurpose sstim-eco:purposePublicDiscovery ;
    sstim-eco:engagementOutcome sstim-eco:outcomePublicationApproved ;
    prov:endedAtTime "2026-07-15T09:01:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith <https://example.org/agent/synthetic-curator> .

