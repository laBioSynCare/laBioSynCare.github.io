@prefix dct:    <http://purl.org/dc/terms/> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix sstim:  <https://w3id.org/sstim#> .
@prefix sstim-ex: <https://w3id.org/sstim/exposure#> .
@prefix sstim-v: <https://w3id.org/sstim/vocab#> .
@prefix bsc-fw-tech: <https://w3id.org/sstim/framework/bsc/technique/> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .

# BSC is a framework over audio (Martigli respiratory waves, binaural beats,
# Symmetry permutations, soundscapes and colored noises) and visual cues matched
# to the Martigli oscillation.
#
# It *defines* only the three techniques it originated (Martigli, the
# Martigli-Binaural hybrid, and Symmetry permutation entrainment). The generic
# techniques it applies — binaural beats, isochronic tones, broadband/colored
# noise, photic driving, audiovisual and vibrotactile entrainment — are
# vendor-neutral and already live in the SSTIM vocabulary as dual-typed
# sstim-v:tech* concepts, so they are *incorporated*, not redefined here.
# Framework-scoped duplicates of those were removed in ADR 0033.
<https://w3id.org/sstim/framework/bsc> a sstim:SensoryStimulationFramework ;
    rdfs:label "BSC Framework" ;
    dct:description "Framework identity for the BSC family of sensory stimulation principles, techniques, evidence rules, grouping logic, and implementation guidance. Its originated techniques are the Martigli respiratory oscillation, the Martigli-Binaural hybrid, and Symmetry permutation entrainment; the generic techniques it applies are incorporated from the SSTIM vocabulary." ;
    dct:creator <https://orcid.org/0000-0002-9699-629X> ;
    dct:contributor <https://w3id.org/sstim/organization/aeterni-anima> ;
    dct:created "2026-06-17"^^xsd:date ;
    dct:modified "2026-07-19"^^xsd:date ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    sstim:definesTechnique
        bsc-fw-tech:martigli-breathing-oscillation,
        bsc-fw-tech:martigli-binaural-hybrid,
        bsc-fw-tech:symmetry-permutation-entrainment ;
    sstim:incorporatesTechnique
        sstim-v:techBinauralBeats,
        sstim-v:techIsochronicTones,
        sstim-v:techBroadbandNoise,
        sstim-v:techPhoticDriving,
        sstim-v:techAudiovisualEntrainment,
        sstim-v:techVibrotactileEntrainment .

bsc-fw-tech:martigli-breathing-oscillation a sstim:NonEntrainmentTechnique ;
    rdfs:label "Martigli breathing oscillation"@en ;
    dct:description "Auditory breathing-guide technique using a sinusoidal frequency sweep over a decelerating respiratory arc."@en ;
    skos:relatedMatch sstim-v:voiceMartigli ;
    sstim:proposedMechanism sstim-v:mechAutonomic ;
    sstim:hasStimulusTemporalStructure sstim-v:temporalQuasiPeriodic ;
    sstim:techniqueModality sstim-v:modalityAuditory, sstim-v:modalityInteroceptive ;
    sstim-ex:characteristicDeliveryMedium sstim-ex:mediumAirConductedSound ;
    rdfs:seeAlso <https://github.com/laBioSynCare/laBioSynCare.github.io/blob/main/docs/technical/BREATHING_MODEL.md> .

bsc-fw-tech:martigli-binaural-hybrid a sstim:SensoryStimulationTechnique ;
    rdfs:label "Martigli-Binaural hybrid"@en ;
    dct:description "Hybrid auditory technique combining a maintained binaural beat difference with Martigli carrier-frequency breathing motion."@en ;
    skos:relatedMatch sstim-v:voiceMartigliBinaural ;
    sstim:proposedMechanism sstim-v:mechAutonomic ;
    sstim:intendedNeuralPhenomenon sstim-v:phenomenonFrequencyFollowingResponse ;
    sstim:hasStimulusTemporalStructure sstim-v:temporalQuasiPeriodic ;
    sstim:techniqueModality sstim-v:modalityAuditory, sstim-v:modalityInteroceptive ;
    sstim-ex:characteristicDeliveryMedium sstim-ex:mediumAirConductedSound ;
    rdfs:seeAlso <https://github.com/laBioSynCare/laBioSynCare.github.io/blob/main/docs/technical/MARTIGLI_BINAURAL.md> .

bsc-fw-tech:symmetry-permutation-entrainment a sstim:EntrainmentBasedTechnique ;
    rdfs:label "Symmetry permutation entrainment"@en ;
    dct:description "Auditory technique using cyclic pitch permutations; the isochronic special case uses pulse rate as the target."@en ;
    skos:relatedMatch sstim-v:voiceSymmetry ;
    sstim:proposedMechanism sstim-v:mechAttentional ;
    sstim:intendedNeuralPhenomenon sstim-v:phenomenonFrequencyFollowingResponse ;
    sstim:hasStimulusTemporalStructure sstim-v:temporalPeriodic ;
    sstim:techniqueModality sstim-v:modalityAuditory ;
    sstim-ex:characteristicDeliveryMedium sstim-ex:mediumAirConductedSound ;
    rdfs:seeAlso <https://github.com/laBioSynCare/laBioSynCare.github.io/blob/main/docs/technical/SYMMETRY_SYSTEM.md> .

# Retired in ADR 0033 — these four were framework-scoped duplicates of concepts
# that already exist, vendor-neutral, in sstim-vocab.ttl. They are now
# incorporated by the framework above rather than redefined here:
#
#   bsc-fw-tech:binaural-beat-stimulation      → sstim-v:techBinauralBeats
#   bsc-fw-tech:photic-rhythm-stimulation      → sstim-v:techPhoticDriving
#   bsc-fw-tech:audiovisual-rhythm-coordination → sstim-v:techAudiovisualEntrainment
#   bsc-fw-tech:vibrotactile-rhythm-stimulation → sstim-v:techVibrotactileEntrainment
