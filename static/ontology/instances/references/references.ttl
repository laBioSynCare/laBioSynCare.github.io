# PubMed/Crossref audited 2026-07-10. Systematic review of slow breathing in
# healthy participants; used only for measurable psychophysiological correlates.
sstim-ref:ZACCARO_2018 a sstim:PublicSafeReference ;
    sstim:referenceKey "ZACCARO_2018" ;
    dct:title "How Breath-Control Can Change Your Life: A Systematic Review on Psycho-Physiological Correlates of Slow Breathing" ;
    dct:creator "Zaccaro, Andrea", "Piarulli, Andrea", "Laurino, Marco",
        "Garbella, Erika", "Menicucci, Danilo", "Neri, Bruno", "Gemignani, Angelo" ;
    dct:issued "2018-09-07"^^xsd:date ;
    dct:identifier "doi:10.3389/fnhum.2018.00353" ;
    dct:source <https://doi.org/10.3389/fnhum.2018.00353> .

# Crossref/PubMed audited 2026-07-10. Foundational SSVEP review in Progress in
# Neurobiology; supports the measurable response, not downstream benefit.
