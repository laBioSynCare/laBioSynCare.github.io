    sstim:referenceKey "VIALATTE_2010" ;
    dct:title "Steady-state visually evoked potentials: focus on essential paradigms and future perspectives" ;
    dct:creator "Vialatte, François-Benoît", "Maurice, Monique", "Dauwels, Justin", "Cichocki, Andrzej" ;
    dct:issued "2010"^^xsd:gYear ;
    dct:identifier "doi:10.1016/j.pneurobio.2009.11.005" ;
    dct:source <https://doi.org/10.1016/j.pneurobio.2009.11.005> .

