@prefix bsclab-preset:   <https://w3id.org/sstim/implementation/bsclab/preset/> .
@prefix dct:          <http://purl.org/dc/terms/> .
@prefix preset-local: <https://w3id.org/sstim/implementation/bsclab/preset/heal-theta-breathing-seed#> .
@prefix rdfs:         <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sstim:        <https://w3id.org/sstim#> .
@prefix sstim-v:      <https://w3id.org/sstim/vocab#> .
@prefix bsc-v:        <https://w3id.org/sstim/framework/bsc/vocab#> .
@prefix xsd:          <http://www.w3.org/2001/XMLSchema#> .
@prefix bsclab-protocol: <https://w3id.org/sstim/implementation/bsclab/protocol/> .

bsclab-preset:heal-theta-breathing-seed a sstim:Preset ;
    rdfs:label "Heal Theta Breathing Seed" ;
    dct:description "Minimal Phase 1 RDF preset seed exercising the Martigli-Binaural and Martigli voice shapes: a breathing-reference Martigli-Binaural voice plus a non-reference Martigli textural layer. Not a clinical, health, or performance claim." ;
    dct:created "2026-06-17"^^xsd:date ;
    dct:modified "2026-10-06"^^xsd:date ;
    sstim:targetsFrequencyBand sstim-v:theta ;
    sstim:primaryFrequencyBand sstim-v:theta ;
    bsc-v:inGroup bsc-v:groupHeal ;
    sstim:presetVersion "0.1.0" ;
    sstim:hasPublicClaimLevel sstim-v:claimC1Experiential ;
    sstim:hasCautionTag sstim-v:cautionDrivingUnsafe ;
    sstim:forImplementation <https://w3id.org/sstim/implementation/bsclab> ;
    sstim:followsProtocol bsclab-protocol:guided-breathing-observation-reference ;
    sstim:composedOfTrack preset-local:mb-voice, preset-local:martigli-voice ;
    sstim:breathGuideTrack preset-local:mb-voice .

# Breathing reference (isOn): constant 6 Hz theta beat, carriers sweep with breath.
preset-local:mb-voice a sstim:AudioTrack, bsc-v:Voice, bsc-v:MartigliBinauralVoice ;
    rdfs:label "Heal Theta Breathing Seed Martigli-Binaural voice" ;
    sstim:carrierFreqLeft 200.0 ;
    sstim:carrierFreqRight 206.0 ;
    bsc-v:martigliAmplitude 80.0 ;
    bsc-v:martigliPeriodInitial 4.0 ;
    bsc-v:martigliPeriodFinal 8.0 ;
    bsc-v:martigliTransitionDuration 600.0 ;
    sstim:initialVolume 0.25 .

# Non-reference Martigli textural layer (fast tremolo; isOn=false so mp0 < 3 is allowed).
preset-local:martigli-voice a sstim:AudioTrack, bsc-v:Voice, bsc-v:MartigliVoice ;
    rdfs:label "Heal Theta Breathing Seed Martigli textural voice" ;
    bsc-v:martigliCenterFreq 180.0 ;
    bsc-v:martigliAmplitude 60.0 ;
    bsc-v:martigliPeriodInitial 1.5 ;
    bsc-v:martigliPeriodFinal 2.0 ;
    bsc-v:martigliTransitionDuration 300.0 ;
    sstim:initialVolume 0.13 .
