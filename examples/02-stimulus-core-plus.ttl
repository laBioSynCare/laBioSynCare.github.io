# SSTIM by example, 2 of 4: the same stimulus, one profile step up.
#
# sstim-profile: core-plus
#
# This file is example 01 plus two lines. Run `diff examples/01-stimulus-core.ttl
# examples/02-stimulus-core-plus.ttl` and the profile boundary is the whole diff.
#
# Core already says what is delivered and at what rate. Core Plus adds the
# Common module, and with it calibrated levels: how loud the sound is at the
# subject's ear, in dB SPL, and how bright the screen is, in candelas per
# square metre. A normalized engine gain is not a level, and Core has no way to
# state one that is.
#
# Take Core when you need the description to travel with the fewest possible
# dependencies. Take Core Plus the moment anyone needs to know how much reached
# the subject. The rule is the smallest profile that carries what you assert.

@prefix ex:       <https://example.org/stimuli/> .
@prefix dct:      <http://purl.org/dc/terms/> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sstim:    <https://w3id.org/sstim#> .
@prefix sstim-ex: <https://w3id.org/sstim/exposure#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .

ex:alpha-audiovisual a sstim:StimulusSpecification ;
    rdfs:label "Ten minutes of 10 Hz stimulation, delivered through sound and light"@en ;
    dct:description "Engine-independent description of what reaches the subject. It states no intended effect, and asserting one would be a separate claim carrying its own evidence."@en ;
    sstim:stimulusRegime "determinate" ;
    sstim:hasSignal ex:alpha-signal ;
    sstim:hasStimulusChannel ex:audio-channel, ex:visual-channel .

# The signal is modality-free on purpose. It is not a sound and not a light;
# it is the thing both of them carry, and it states the extent it occupies.
ex:alpha-signal a sstim:StimulationSignal ;
    rdfs:label "10 Hz modulation"@en ;
    sstim:hzMin 10.0 ;
    sstim:hzMax 10.0 .

ex:audio-channel a sstim-ex:StimulusChannel ;
    rdfs:label "Audio channel, headphones"@en ;
    sstim:channelDurationSeconds 600.0 ;
    sstim:soundPressureLevelDb 60.0 ;
    sstim:hasSignalRendering ex:audio-rendering .

ex:visual-channel a sstim-ex:StimulusChannel ;
    rdfs:label "Visual channel, screen"@en ;
    sstim:channelDurationSeconds 600.0 ;
    sstim:luminanceCdM2 100.0 ;
    sstim:hasSignalRendering ex:visual-rendering .

# Carrier and modulation are different facts. The 200 Hz here is the tone being
# modulated, not the rate: the rate is the signal's, which is the whole reason
# the signal is a separate node.
ex:audio-rendering a sstim:SignalRendering ;
    rdfs:label "10 Hz amplitude modulation of a 200 Hz tone"@en ;
    sstim:rendersSignal ex:alpha-signal ;
    sstim:renderingCarrierHz 200.0 .

# A 10 Hz visual flicker is above the 3 Hz general-safe ceiling of WCAG 2.3.1
# and ITU-R BT.1702, and it sits below the highest-risk 15 to 25 Hz band.
# Describing it is exactly what a description standard is for. Delivering it is
# a different decision: see docs/technical/PHOTOSENSITIVITY_SAFETY.md, and
# sstim-ex:limitFlickerWcag, which models that ceiling in the Full profile.
ex:visual-rendering a sstim:SignalRendering ;
    rdfs:label "10 Hz luminance flicker"@en ;
    sstim:rendersSignal ex:alpha-signal .
