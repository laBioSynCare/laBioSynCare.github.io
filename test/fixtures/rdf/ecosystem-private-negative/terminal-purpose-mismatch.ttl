@prefix dct:       <http://purl.org/dc/terms/> .
@prefix prov:      <http://www.w3.org/ns/prov#> .
@prefix rdfs:      <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sstim-eco: <https://w3id.org/sstim/ecosystem#> .
@prefix xsd:       <http://www.w3.org/2001/XMLSchema#> .

@prefix private: <https://example.org/private-ledger-negative/purpose-mismatch/> .
@prefix record:  <https://w3id.org/sstim/ecosystem-record/relationship/> .

private:operator a prov:Agent .

record:purpose-mismatch a sstim-eco:EcosystemRelationship ;
    rdfs:label "Relationship snapshot with purpose mismatch"@en ;
    sstim-eco:relationshipAgent private:operator ;
    sstim-eco:relationshipTarget <https://example.org/public-target/purpose-mismatch> ;
    sstim-eco:hasRelationshipType sstim-eco:contributor ;
    sstim-eco:relationshipPurpose sstim-eco:purposePublicDiscovery ;
    dct:source <https://example.org/public-source/purpose-mismatch> ;
    dct:created "2026-07-15"^^xsd:date ;
    sstim-eco:reviewedOn "2026-07-15"^^xsd:date ;
    prov:wasAttributedTo private:operator ;
    sstim-eco:hasEngagementActivity private:prior, private:withdrawal .

private:prior a sstim-eco:EngagementActivity,
        sstim-eco:PublicationDecisionActivity, prov:Activity ;
    rdfs:label "Synthetic prior decision"@en ;
    sstim-eco:engagementFor record:purpose-mismatch ;
    sstim-eco:engagementPurpose sstim-eco:purposePublicDiscovery ;
    sstim-eco:engagementOutcome sstim-eco:outcomePublicationApproved ;
    prov:endedAtTime "2026-07-15T12:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith private:operator .

private:withdrawal a sstim-eco:EngagementActivity,
        sstim-eco:ConsentDecisionActivity, sstim-eco:WithdrawalActivity,
        prov:Activity ;
    rdfs:label "Invalid withdrawal under another purpose"@en ;
    sstim-eco:engagementFor record:purpose-mismatch ;
    sstim-eco:engagementPurpose sstim-eco:purposeOutreach ;
    sstim-eco:engagementOutcome sstim-eco:outcomeConsentWithdrawn ;
    prov:endedAtTime "2026-07-15T12:05:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith private:operator ;
    prov:wasInformedBy private:prior ;
    prov:invalidated record:purpose-mismatch .
