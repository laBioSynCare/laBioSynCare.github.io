@prefix prov:      <http://www.w3.org/ns/prov#> .
@prefix rdfs:      <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sstim-eco: <https://w3id.org/sstim/ecosystem#> .
@prefix xsd:       <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:        <https://example.org/negative/public-withdrawal/> .

<https://w3id.org/sstim/ecosystem-record/relationship/alex-membership-aurora>
    sstim-eco:hasEngagementActivity ex:withdrawal .

ex:withdrawal a sstim-eco:EngagementActivity,
        sstim-eco:ConsentDecisionActivity, sstim-eco:WithdrawalActivity,
        prov:Activity ;
    rdfs:label "Synthetic public withdrawal event"@en ;
    sstim-eco:engagementFor
        <https://w3id.org/sstim/ecosystem-record/relationship/alex-membership-aurora> ;
    sstim-eco:engagementPurpose sstim-eco:purposePublicDiscovery ;
    sstim-eco:engagementOutcome sstim-eco:outcomeConsentWithdrawn ;
    prov:endedAtTime "2026-07-15T13:00:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith
        <https://w3id.org/sstim/specialist/synthetic-alex-rivera> ;
    prov:wasInformedBy
        <https://w3id.org/sstim/ecosystem-record/activity/aurora-membership-consent> ;
    prov:invalidated
        <https://w3id.org/sstim/ecosystem-record/relationship/alex-membership-aurora> .
