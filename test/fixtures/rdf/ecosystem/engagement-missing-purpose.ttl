@prefix dct:       <http://purl.org/dc/terms/> .
@prefix prov:      <http://www.w3.org/ns/prov#> .
@prefix rdfs:      <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sstim-eco: <https://w3id.org/sstim/ecosystem#> .
@prefix xsd:       <http://www.w3.org/2001/XMLSchema#> .
@prefix ex:        <https://example.org/negative/engagement-missing-purpose/> .

# Overlay on the positive fixture. The relationship deliberately has no
# relationshipPurpose, even though its activity declares one.

<https://w3id.org/sstim/specialist/synthetic-alex-rivera>
    sstim-eco:hasEcosystemRelationship ex:relationship .

ex:relationship a sstim-eco:EcosystemRelationship ;
    rdfs:label "Purposeless synthetic relationship"@en ;
    sstim-eco:relationshipAgent
        <https://w3id.org/sstim/specialist/synthetic-alex-rivera> ;
    sstim-eco:relationshipTarget <https://example.org/targets/purposeless> ;
    sstim-eco:hasRelationshipType sstim-eco:contributor ;
    dct:source <https://example.org/sources/purposeless-relationship> ;
    dct:created "2026-07-15"^^xsd:date ;
    sstim-eco:reviewedOn "2026-07-15"^^xsd:date ;
    prov:wasAttributedTo <https://example.org/agent/synthetic-curator> ;
    sstim-eco:hasEngagementActivity ex:activity .

ex:activity a sstim-eco:EngagementActivity, prov:Activity ;
    rdfs:label "Activity for purposeless relationship"@en ;
    sstim-eco:engagementFor ex:relationship ;
    sstim-eco:engagementPurpose sstim-eco:purposePublicAttribution ;
    sstim-eco:engagementOutcome sstim-eco:outcomeAcknowledged ;
    prov:endedAtTime "2026-07-15T13:10:00Z"^^xsd:dateTime ;
    prov:wasAssociatedWith <https://example.org/agent/synthetic-curator> .
