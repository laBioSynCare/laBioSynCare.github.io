###########################################################################
# Positive SSTIM Core Profile fixture: a signal that states its frequency.
#
# hzMin and hzMax are Core terms from 0.21.0 (ADR 0067). Before that a Core
# description could state a rendering's 200 Hz carrier but not the 10 Hz
# signal it carries, so the rate that usually matters lived only in a label.
# A point signal states the same value twice.
###########################################################################

@prefix example:  <https://example.org/sstim/core-fixture/> .
@prefix sstim:    <https://w3id.org/sstim#> .
@prefix sstim-ex: <https://w3id.org/sstim/exposure#> .
@prefix dct:      <http://purl.org/dc/terms/> .
@prefix prov:     <http://www.w3.org/ns/prov#> .
@prefix rdfs:     <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:      <http://www.w3.org/2001/XMLSchema#> .

example:specification a sstim:StimulusSpecification ;
    rdfs:label "Ten minutes of a 10 Hz signal through sound"@en ;
    dct:identifier "core-positive-signal-frequency" ;
    dct:hasVersion "1" ;
    prov:wasAttributedTo example:author ;
    sstim:stimulusRegime "determinate" ;
    sstim:hasSignal example:signal ;
    sstim:hasStimulusChannel example:channel .

example:signal a sstim:StimulationSignal ;
    rdfs:label "10 Hz modulation"@en ;
    sstim:hzMin "10.0"^^xsd:decimal ;
    sstim:hzMax "10.0"^^xsd:decimal .

example:channel a sstim-ex:StimulusChannel ;
    rdfs:label "Audio channel"@en ;
    sstim:channelDurationSeconds "600.0"^^xsd:decimal ;
    sstim:hasSignalRendering example:rendering .

example:rendering a sstim:SignalRendering ;
    rdfs:label "10 Hz amplitude modulation of a 200 Hz tone"@en ;
    sstim:rendersSignal example:signal ;
    sstim:renderingCarrierHz "200.0"^^xsd:decimal .

example:author a prov:Agent ;
    rdfs:label "Example fixture author"@en .
