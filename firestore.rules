rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Annotations (GB-03). A note's full record belongs to its author and sits
    // under their account. A public note also has a public copy, under the same
    // id, holding only what a reader sees: the text, target, dates and, if the
    // author chose to sign, the name on their account. The copy never holds the
    // account ID, so a signed-out reader cannot obtain it. It holds an author
    // key, SHA-256 of a prefix, the account ID and the note's id, which these
    // rules recompute from the signed-in account: only the author can write or
    // withdraw the copy, and no reader can link two of an author's notes.
    match /users/{userId}/annotations/{annotationId} {
      allow read, delete: if signedIn() && userId == request.auth.uid;
      allow create, update: if signedIn()
        && userId == request.auth.uid
        && validOwnAnnotation();
    }

    match /publicAnnotations/{annotationId} {
      allow read: if true;
      allow create, update: if signedIn()
        && validPublicCopy(annotationId);
      // Deleting a copy that does not exist is allowed, and does nothing: the
      // app withdraws a copy whenever it saves or deletes a private note.
      allow delete: if signedIn()
        && (resource == null || resource.data.get('authorKey', '') == authorKey(annotationId));
    }

    function authorKey(annotationId) {
      return hashing.sha256('sstim-annotation-author:' + request.auth.uid + ':' + annotationId)
        .toHexString().lower();
    }

    function validPublicCopy(annotationId) {
      let path = /databases/$(database)/documents/users/$(request.auth.uid)/annotations/$(annotationId);
      let data = request.resource.data;
      let name = data.get('authorName', '');
      return data.keys().hasOnly([
          'targetIri', 'annotationType', 'annotationText', 'authorName', 'authorKey', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasAll(['targetIri', 'annotationType', 'annotationText', 'authorName', 'authorKey'])
        && data.authorKey == authorKey(annotationId)
        // An existing copy is changed only by the author who wrote it.
        && (resource == null || resource.data.get('authorKey', '') == authorKey(annotationId))
        && existsAfter(path)
        && getAfter(path).data.visibility == 'public'
        && data.targetIri == getAfter(path).data.targetIri
        && data.annotationType == getAfter(path).data.annotationType
        && data.annotationText == getAfter(path).data.annotationText
        && name is string
        // Unsigned, or signed by its author's choice with the name the account
        // carries, which may not be the email address's local part.
        && (name == ''
          || (getAfter(path).data.showName == true
            && name == request.auth.token.get('name', '')
            && name.lower() != request.auth.token.get('email', '').split('@')[0].lower()));
    }

    // Legacy annotations, from before GB-03, which hold the account ID and a
    // display name. TRANSITIONAL: while clients from before the change may still
    // be open, a public one stays readable and the legacy shape stays writable.
    // Once the current app is live the next deployment makes this collection
    // owner-only and closed to new documents. The app moves each owner's
    // documents out of it on their next visit.
    match /rdfAnnotations/{annotationId} {
      allow read: if resource.data.get('visibility', '') == 'public'
        || (signedIn() && resource.data.userId == request.auth.uid);

      allow create: if signedIn()
        && validAnnotationCreate();

      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && validAnnotationPayload();

      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if signedIn() && userId == request.auth.uid;
      allow write: if signedIn()
        && userId == request.auth.uid
        && validUserPayload();
    }

    match /patchStudioPatches/{patchId} {
      allow read: if signedIn()
        && resource.data.userId == request.auth.uid;

      allow create: if signedIn()
        && validPatchPayload();

      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && validPatchPayload();

      allow delete: if signedIn()
        && resource.data.userId == request.auth.uid;
    }

    // Server-admin-only SSTIM ecosystem audit ledger. Client SDK access is
    // denied even to authenticated users; publication uses Google Cloud IAM.
    match /sstimEcosystemAudit/{auditId} {
      allow read, write: if false;
    }
  }

  function signedIn() {
    return request.auth != null;
  }

  function validUserPayload() {
    return request.resource.data.keys().hasOnly([
      'displayName',
      'email',
      'bio',
      'affiliation',
      'updatedAt'
    ])
    && request.resource.data.get('displayName', '') is string
    && request.resource.data.get('displayName', '').size() <= 200
    && request.resource.data.get('bio', '') is string
    && request.resource.data.get('bio', '').size() <= 4000
    && request.resource.data.get('affiliation', '') is string
    && request.resource.data.get('affiliation', '').size() <= 200
    && request.resource.data.get('email', '') is string
    && request.resource.data.get('email', '').size() <= 200;
  }

  function validOwnAnnotation() {
    let data = request.resource.data;
    return data.keys().hasOnly([
        'targetIri', 'annotationType', 'annotationText', 'visibility', 'showName', 'createdAt', 'updatedAt'
      ])
      && data.keys().hasAll(['targetIri', 'annotationType', 'annotationText', 'visibility', 'showName'])
      && data.targetIri is string
      && data.targetIri.size() <= 2000
      && data.annotationType is string
      && data.annotationType.size() <= 40
      && data.annotationText is string
      && data.annotationText.size() > 0
      && data.annotationText.size() <= 4000
      && data.visibility in ['public', 'private']
      && data.showName is bool;
  }

  function validAnnotationCreate() {
    return request.resource.data.userId == request.auth.uid
      && validAnnotationPayload();
  }

  function validAnnotationPayload() {
    return request.resource.data.keys().hasOnly([
      'userId',
      'userDisplayName',
      'targetIri',
      'annotationType',
      'annotationText',
      'visibility',
      'createdAt',
      'updatedAt'
    ])
    && request.resource.data.targetIri is string
    && request.resource.data.annotationType is string
    && request.resource.data.annotationText is string
    && request.resource.data.annotationText.size() > 0
    && request.resource.data.annotationText.size() <= 4000
    && request.resource.data.visibility in ['public', 'private']
    && request.resource.data.get('userDisplayName', '') is string
    && request.resource.data.get('userDisplayName', '').size() <= 200;
  }

  function validPatchPayload() {
    return request.resource.data.keys().hasOnly([
      'userId',
      'patchName',
      'model',
      'patch',
      'createdAt',
      'updatedAt'
    ])
    && request.resource.data.userId == request.auth.uid
    && request.resource.data.patchName is string
    && request.resource.data.patchName.size() > 0
    && request.resource.data.patchName.size() <= 200
    && request.resource.data.model in [
      'patch-studio-model-1',
      'patch-studio-model-2',
      'patch-studio-model-3'
    ]
    && request.resource.data.patch is map
    && request.resource.data.patch.model == request.resource.data.model
    && request.resource.data.patch.patchName is string
    && request.resource.data.patch.patchName.size() > 0
    && request.resource.data.patch.patchName.size() <= 200
    && request.resource.data.patch.patchName == request.resource.data.patchName;
  }
}
